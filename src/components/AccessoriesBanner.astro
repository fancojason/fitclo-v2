---
---
<section class="bg-black py-12">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <div class="rounded-[20px] overflow-hidden border border-white/10 relative group bg-[#111111] shadow-2xl transition-all duration-500 hover:border-[#C9A84C]/30 lg:-ml-12 lg:-mr-12">
      <div class="relative aspect-[21/9] lg:aspect-[2.5/1] overflow-hidden bg-[#0A0A0A]">
        <img 
          src="https://sc02.alicdn.com/kf/H7d27da37e714412b9adb784a2f8645b1v.jpg" 
          alt="Custom Branding Accessories Showcase" 
          class="w-full h-full object-cover transition-all duration-700 group-hover:scale-[1.01] brightness-[0.7] group-hover:brightness-[0.8]" 
        />
        <!-- Overlay Content -->
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 bg-black/30">
          <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[10px] md:text-[12px] mb-2 uppercase font-['Century_Gothic',sans-serif]">
            Branding Accessories
          </h3>
          <h2 class="text-[20px] md:text-[28px] lg:text-[32px] font-bold text-white mb-4 font-['Montserrat',sans-serif] tracking-tight">
            Complete Branding Solutions
          </h2>
          <p class="text-gray-300 max-w-2xl mx-auto text-[13px] md:text-[14px] leading-relaxed font-['Century_Gothic',sans-serif]">
            Custom logos, wash labels, hang tags, and retail packaging bags. Everything you need to launch your private label collection with a professional finish.
          </p>
        </div>
        <!-- Metallic shimmer -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1500ms] ease-out pointer-events-none z-10"></div>
      </div>
    </div>
  </div>
</section>
