---
const articles = [
  {
    category: "SOURCING STRATEGY",
    title: "5 Red Flags to Watch When Sourcing Activewear from China",
    description: "Avoid common pitfalls. Learn how to identify real factories versus trading companies and protect your brand.",
    slug: "/blogs/sourcing-tips"
  },
  {
    category: "BRAND BUILDING",
    title: "How to Launch an Activewear Brand: A Step-by-Step Guide",
    description: "From technical sketches to mass production. A complete roadmap for emerging entrepreneurs looking to scale.",
    slug: "/blogs/launch-guide"
  },
  {
    category: "FABRIC GUIDE",
    title: "Nylon vs Polyester Leggings: Which Fabric Is Better?",
    description: "Compare comfort, stretch, durability and cost to choose the right fabric for your specific product line.",
    slug: "/blogs/leggings"
  },
  {
    category: "QUALITY CONTROL",
    title: "The 5-Point Quality Control Checklist for Activewear Brands",
    description: "Standardize your quality expectations. From stretch tests to seam strength, ensure your manufacturer meets standards.",
    slug: "/blogs/quality-control"
  },
  {
    category: "MANUFACTURING",
    title: "Private Label vs OEM Manufacturing: Which is Right for You?",
    description: "Compare structure, cost, customization depth and lead times to choose the right manufacturing model.",
    slug: "/blogs/private-label-vs-oem"
  },
  {
    category: "SUSTAINABILITY",
    title: "Sourcing Recycled Fabrics: The 2026 Eco-Activewear Guide",
    description: "Explore RPET, recycled nylon, and sustainable dyeing processes. How to build an eco-friendly brand.",
    slug: "/blogs/sustainability"
  }
];

---

<section id="blog-intelligence" class="py-24 bg-[#050505] text-white font-['Century_Gothic',sans-serif]">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="block text-[#C9A84C] text-[12px] font-[600] tracking-[0.25em] uppercase mb-4">
        ACTIVEWEAR INTELLIGENCE
      </span>
      <h2 class="text-[32px] md:text-[48px] font-bold leading-tight mb-6">
        Insights For <span class="text-[#C9A84C] italic">Growing Brands</span>
      </h2>
      <p class="text-[#A3A3A3] text-[15px] md:text-[16px] leading-[1.8] max-w-[720px] mx-auto">
        Learn everything about activewear sourcing, private label manufacturing and industry trends — straight from an experienced factory.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <a href={article.slug} class="group bg-[#090909] border border-[#C9A84C]/15 rounded-[20px] p-8 transition-all duration-300 hover:-translate-y-[5px] hover:border-[#C9A84C]">
          <div class="mb-4">
            <span class="text-[#C9A84C] text-[11px] font-bold tracking-widest uppercase">{article.category}</span>
          </div>
          <h3 class="text-[17px] md:text-[18px] font-bold mb-4 leading-tight group-hover:text-[#C9A84C] transition-colors">
            {article.title}
          </h3>
          <p class="text-[#A3A3A3] text-[14px] leading-relaxed mb-4">
            {article.description}
          </p>
          
          <div class="flex items-center text-[#C9A84C] text-[14px] font-bold group-hover:translate-x-1 transition-transform">
            Read Article 
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
