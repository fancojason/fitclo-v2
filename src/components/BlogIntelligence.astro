      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <a href={article.slug} class="group bg-[#090909] border border-[#C9A84C]/15 rounded-[20px] p-8 transition-all duration-300 hover:border-[#C9A84C]">
