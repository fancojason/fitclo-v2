---
const articles = [
  {
    category: "BUYER GUIDE",
    title: "How To Find A Reliable Activewear Manufacturer In China",
    description: "Learn how to evaluate factories, compare suppliers and avoid common sourcing mistakes.",
    slug: "#"
  },
  {
    category: "PRIVATE LABEL",
    title: "Private Label Activewear: The Complete Beginner Guide",
    description: "Everything you need to know about logos, labels, packaging and launching your own brand.",
    slug: "#"
  },
  {
    category: "FABRIC GUIDE",
    title: "Nylon vs Polyester Leggings: Which Fabric Is Better?",
    description: "Compare comfort, stretch, durability and cost to choose the right fabric.",
    slug: "#"
  },
  {
    category: "TREND REPORT",
    title: "Top Activewear Trends In 2026",
    description: "Explore the colors, styles and product categories shaping the next generation of activewear.",
    slug: "#"
  },
  {
    category: "BUSINESS GUIDE",
    title: "How To Start An Activewear Brand In 2026",
    description: "From product development to manufacturing, branding and shipping — here’s the complete roadmap.",
    slug: "#"
  },
  {
    category: "READY TO SHIP",
    title: "Ready-To-Ship vs OEM Activewear: Which Is Right For You?",
    description: "Compare lead times, MOQ, pricing and customization options to find the best solution.",
