---

<section id="customization" class="py-24 bg-black text-white border-t border-white/5">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16 text-center">
    <!-- Header Section -->
    <div class="mb-20">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[11px] md:text-[12px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
        PRIVATE LABEL & CUSTOMIZATION
      </h3>
      <h2 class="text-[32px] md:text-[42px] lg:text-[48px] font-bold text-white mb-6 font-['Montserrat',sans-serif] tracking-tight">
        Same Style. Completely Different Brand.
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Every branding detail shapes how customers see your products and remember your brand. We help activewear brands create products that stand out with factory-direct wholesale pricing.
      </p>
    </div>

    <!-- Branding Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-16 gap-x-12 text-left">
      {brandingOptions.map((option) => (
        <div class="group">
          <!-- Icon -->
          <div class="mb-6 p-3 w-12 h-12 rounded-xl bg-[#111111] border border-white/10 flex items-center justify-center transition-all duration-300 group-hover:border-[#C9A84C]/40 group-hover:shadow-[0_0_20px_rgba(201,168,76,0.1)]">
            <Fragment set:html={option.icon} />
          </div>
          
          <!-- Content -->
          <h4 class="text-[19px] font-bold text-white mb-3 font-['Montserrat',sans-serif] tracking-tight">
            {option.title}
          </h4>
          
          <p class="text-[#C9A84C] text-[11px] font-bold uppercase tracking-wider mb-3 font-['Century_Gothic',sans-serif]">
            Best for: <span class="text-gray-400 font-normal normal-case">{option.bestFor}</span>
          </p>
          
          <p class="text-gray-400 text-[14px] leading-relaxed font-['Century_Gothic',sans-serif] mb-4 line-clamp-2">
            {option.description}
          </p>

          <ul class="space-y-1.5">
            {option.features.map(feature => (
              <li class="flex items-center text-[12px] text-gray-500 font-['Century_Gothic',sans-serif]">
                <span class="w-1 h-1 rounded-full bg-[#C9A84C] mr-2"></span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA Button -->
    <div class="mt-24">
      <a 
        href="#inquiry" 
        class="inline-block px-10 py-4 rounded-lg text-[13px] font-bold text-white border border-white/20 hover:border-[#C9A84C] hover:text-[#C9A84C] transition-all duration-300 font-['Century_Gothic',sans-serif] tracking-[0.1em] uppercase"
      >
        Explore Custom Branding →
      </a>
    </div>
  </div>
</section>
