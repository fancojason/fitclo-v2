---
const brandingOptions = [
  {
    title: "Silicone Logo Patch",
    bestFor: "Yoga Sets • Sports Bras • Leggings",
    description: "Durable silicone logos with a premium look and feel, perfect for activewear brands seeking a modern identity.",
    features: ["Soft & Flexible", "Waterproof", "Premium 3D Appearance", "Pantone Color Matching"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2L4 5V11C4 16.19 7.41 21.05 12 22C16.59 21.05 20 16.19 20 11V5L12 2Z" fill="#C9A84C" fill-opacity="0.2" stroke="#C9A84C" stroke-width="1.2"/>
      <path d="M9 12L11 14L15 10" stroke="#4FB3FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="18" cy="6" r="2" fill="#FFD700">
        <animate attributeName="opacity" values="1;0.5;1" dur="2s" repeatCount="indefinite" />
      </circle>
    </svg>`
  },
  {
    title: "Woven Labels",
    bestFor: "Yoga Wear • Sportswear • Activewear Collections",
    description: "Premium woven labels designed to enhance your brand identity while ensuring comfort and durability.",
    features: ["Soft Touch", "Wash Resistant", "Custom Colors", "Multiple Folding Styles"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21.41 11.58L12.41 2.58A2 2 0 0 0 11 2H4A2 2 0 0 0 2 4V11A2 2 0 0 0 2.58 12.41L11.58 21.41A2 2 0 0 0 13 22A2 2 0 0 0 14.41 21.41L21.41 14.41A2 2 0 0 0 22 13A2 2 0 0 0 21.41 11.58Z" fill="#C9A84C" fill-opacity="0.1" stroke="#C9A84C" stroke-width="1.2"/>
      <circle cx="7" cy="7" r="1.5" fill="#FFFFFF"/>
      <path d="M13 13L17 17" stroke="#FF5C00" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`
  },
  {
    title: "Heat Transfer Printing",
    bestFor: "Seamless Yoga Sets • Sports Bras • Leggings",
    description: "Smooth and durable logo printing that maintains flexibility and comfort during workouts.",
    features: ["Lightweight", "Stretch Resistant", "Vibrant Colors", "Seamless Appearance"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M13 10V3L4 14H11V21L20 10H13Z" fill="#FFD700" fill-opacity="0.2" stroke="#FFD700" stroke-width="1.2"/>
      <path d="M13 10V3L4 14H11V21L20 10H13Z" fill="url(#paint0_linear_heat)" fill-opacity="0.8"/>
      <defs>
        <linearGradient id="paint0_linear_heat" x1="4" y1="3" x2="20" y2="21" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FF5C00"/>
          <stop offset="1" stop-color="#FFD700"/>
        </linearGradient>
      </defs>
    </svg>`
  },
  {
    title: "Custom Packaging",
    bestFor: "Fitness Brands • Retail Stores • Amazon Sellers",
    description: "Retail-ready packaging solutions designed to elevate your brand presentation and customer experience.",
    features: ["Poly Bags", "Hang Tags", "Color Boxes", "Zip Bags"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21 16.5V7.5L12 3L3 7.5V16.5L12 21L21 16.5Z" stroke="#4FB3FF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 12L21 7.5" stroke="#4FB3FF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 12V21" stroke="#4FB3FF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 12L3 7.5" stroke="#4FB3FF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M17 4.5L7 9.5" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="2 2"/>
    </svg>`
  },
  {
    title: "Blank Labels",
    bestFor: "Private Label Brands • Startups • Wholesalers",
    description: "Unbranded products ready for private labeling with flexible customization and low MOQ options.",
    features: ["Blank Neck Labels", "Tear-away Labels", "Custom Woven Labels"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="5" y="4" width="14" height="16" rx="2" stroke="#FFFFFF" stroke-width="1.2"/>
      <line x1="8" y1="8" x2="16" y2="8" stroke="#FFFFFF" stroke-opacity="0.3" stroke-width="1.2"/>
      <line x1="8" y1="12" x2="16" y2="12" stroke="#FFFFFF" stroke-opacity="0.3" stroke-width="1.2"/>
      <path d="M12 12V16" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`
  },
  {
    title: "Custom Colors",
    bestFor: "Yoga Sets • Leggings • Sports Bras",
    description: "Create exclusive collections with custom colors tailored to your brand and target market.",
    features: ["Pantone Color Matching", "Seasonal Colors", "Custom Dyeing", "Multi-color Collections"],
    icon: `<svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="url(#paint0_angular_rainbow)" stroke-width="1.5"/>
      <path d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z" fill="url(#paint0_linear_rainbow)"/>
      <defs>
        <linearGradient id="paint0_linear_rainbow" x1="6" y1="6" x2="18" y2="18" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FF5C00"/>
          <stop offset="0.5" stop-color="#4FB3FF"/>
          <stop offset="1" stop-color="#C9A84C"/>
        </linearGradient>
        <sweepGradient id="paint0_angular_rainbow" cx="12" cy="12" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#FF0000"/>
          <stop offset="0.2" stop-color="#FFFF00"/>
          <stop offset="0.4" stop-color="#00FF00"/>
          <stop offset="0.6" stop-color="#00FFFF"/>
          <stop offset="0.8" stop-color="#0000FF"/>
          <stop offset="1" stop-color="#FF00FF"/>
        </sweepGradient>
      </defs>
    </svg>`
  }
];
---

<section id="customization" class="py-24 bg-black text-white border-t border-white/5">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16 text-center">
    <!-- Header Section -->
    <div class="mb-20">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[11px] md:text-[12px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
        PRIVATE LABEL & CUSTOMIZATION
      </h3>
      <h2 class="text-[32px] md:text-[42px] lg:text-[48px] font-bold text-white mb-6 font-['Century_Gothic',sans-serif] tracking-tight">
        Same Style. Completely Different Brand.
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Every branding detail shapes how customers see your products and remember your brand. We help activewear brands create products that stand out with factory-direct wholesale pricing.
      </p>
    </div>

    <!-- Branding Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-16 gap-x-12 text-left">
      {brandingOptions.map((option) => (
        <div class="group">
          <!-- Icon - Removed background and border -->
          <div class="mb-6 flex items-center justify-start transition-all duration-300 group-hover:scale-110">
            <Fragment set:html={option.icon} />
          </div>
          
          <!-- Content -->
          <h4 class="text-[19px] font-bold text-white mb-3 font-['Century_Gothic',sans-serif] tracking-tight">
            {option.title}
          </h4>
          
          <p class="text-[#C9A84C] text-[12px] font-bold uppercase tracking-wider mb-3 font-['Century_Gothic',sans-serif]">
            Best for: <span class="text-[#C9A84C] font-bold normal-case">{option.bestFor}</span>
          </p>
          
          <p class="text-gray-400 text-[14px] leading-relaxed font-['Century_Gothic',sans-serif] mb-4 line-clamp-2">
            {option.description}
          </p>

          <ul class="space-y-2">
            {option.features.map(feature => (
              <li class="flex items-center text-[13px] text-gray-400 font-['Century_Gothic',sans-serif]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C9A84C] mr-2"></span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA Button - Styled with Gold text and Gold border matching Quote button -->
    <div class="mt-24">
      <a 
        href="/private-label" 
        class="inline-block px-10 py-4 rounded-lg text-[13px] font-bold text-[#C9A84C] border border-[#C9A84C]/30 hover:border-[#C9A84C] hover:bg-[#C9A84C] hover:text-black transition-all duration-300 font-['Century_Gothic',sans-serif] tracking-[0.1em] uppercase"
      >
        Explore Custom Branding →
      </a>
    </div>
  </div>
</section>
