  {
    title: "Silicone Logo Patch",
    bestFor: "Yoga Sets • Sports Bras • Leggings",
    description: "Durable silicone logos with a premium look and feel, perfect for activewear brands seeking a modern identity.",
    features: ["Soft & Flexible", "Waterproof", "Premium 3D Appearance", "Pantone Color Matching"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.744c0 5.57 4.082 10.185 9 10.996 4.918-.81 9-5.426 9-10.996 0-1.325-.214-2.599-.612-3.796A11.959 11.959 0 0112 2.714z"></path></svg>`
  },
  {
    title: "Woven Labels",
    bestFor: "Yoga Wear • Sportswear • Activewear Collections",
    description: "Premium woven labels designed to enhance your brand identity while ensuring comfort and durability.",
    features: ["Soft Touch", "Wash Resistant", "Custom Colors", "Multiple Folding Styles"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581a2.25 2.25 0 003.182 0l4.318-4.318a2.25 2.25 0 000-3.182L11.159 3.659A2.25 2.25 0 009.568 3z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 6h.008v.008H6V6z"></path></svg>`
  },
  {
    title: "Heat Transfer Printing",
    bestFor: "Seamless Yoga Sets • Sports Bras • Leggings",
    description: "Smooth and durable logo printing that maintains flexibility and comfort during workouts.",
    features: ["Lightweight", "Stretch Resistant", "Vibrant Colors", "Seamless Appearance"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"></path></svg>`
  },
  {
    title: "Custom Packaging",
    bestFor: "Fitness Brands • Retail Stores • Amazon Sellers",
    description: "Retail-ready packaging solutions designed to elevate your brand presentation and customer experience.",
    features: ["Poly Bags", "Hang Tags", "Color Boxes", "Zip Bags"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-10.5v10.5"></path></svg>`
  },
  {
    title: "Blank Labels",
    bestFor: "Private Label Brands • Startups • Wholesalers",
    description: "Unbranded products ready for private labeling with flexible customization and low MOQ options.",
    features: ["Blank Neck Labels", "Tear-away Labels", "Custom Woven Labels"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"></path></svg>`
  },
  {
    title: "Custom Colors",
    bestFor: "Yoga Sets • Leggings • Sports Bras",
    description: "Create exclusive collections with custom colors tailored to your brand and target market.",
    features: ["Pantone Color Matching", "Seasonal Colors", "Custom Dyeing", "Multi-color Collections"],
    icon: `<svg class="w-6 h-6 text-[#C9A84C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.098 19.903a9.2 9.2 0 003.04.525 9.042 9.042 0 005.32-1.72l3.882-3.881a4.129 4.129 0 10-5.841-5.841l-3.881 3.882a9.042 9.042 0 00-1.72 5.32 9.2 9.2 0 00.525 3.04zm1.236-1.236L14.85 9.15a1.629 1.629 0 112.304 2.304l-9.516 9.516"></path></svg>`
  }
