---
const cases = [
  {
    title: "Scaling a Venezuelan Activewear Brand via Miami Hub",
    category: "LOGISTICS & OEM",
    challenge: "High direct shipping costs to Venezuela and strict color accuracy requirements for a new private label launch.",
    solution: "Implemented the Miami Consolidation Strategy and used our Ready-to-Ship (RTS) program with custom branding. Provided 3 rounds of Lab Dips for precise color matching.",
    result: "Logistics costs reduced by 40%. Successfully launched with 200 sets delivered to the Miami forwarder within 10 days.",
    image: "https://sc02.alicdn.com/kf/Aaffbf3c90f7e49eebda1f448371cf402j.png"
  },
  {
    title: "From Tech Pack to Market: Developing a Boutique Yoga Collection",
    category: "PREMIUM CUSTOM OEM",
    challenge: "A US startup required high-stretch reflective silver logos and specific Pantone matching for a luxury yoga set.",
    solution: "Utilized High-Stretch Reflective Heat Transfer technology and sourced 230GSM Interlock fabric. Provided a dedicated account manager for 24/7 technical support.",
    result: "First sample approved immediately. Initial production of 500 pieces achieved zero defects and 100% customer satisfaction.",
    image: "https://sc02.alicdn.com/kf/A522f2892f89f483f9fce3d093333c94cQ.png"
  },
  {
    title: "Rapid Fulfillment for a High-End Fitness Chain in Miami",
    category: "READY-TO-SHIP",
    challenge: "A premium yoga studio chain needed custom branded instructor uniforms for a grand opening event within 10 days.",
    solution: "Selected our best-selling 230GSM Interlock ready-stock styles. Accelerated logo application and used express shipping to their Miami location.",
    result: "Order delivered in 8 days. 150+ sets utilized for the grand opening, leading to a long-term contract for seasonal staff uniforms.",
    image: "https://sc02.alicdn.com/kf/A8aca50d3b6aa4af8baf24646cf9ea658e.png"
  }
];
---

<section id="case-studies" class="py-24 bg-[#06060a] text-white">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
      <div class="max-w-2xl">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.15em] text-[13px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          PARTNER SUCCESS STORIES
        </h3>
        <h2 class="text-[30px] md:text-[40px] lg:text-[48px] font-bold text-white leading-[1.1] font-['Century_Gothic',sans-serif] tracking-tight">
          Helping Global Brands<br/>
          <span class="text-[#C9A84C] italic">Scale with Confidence</span>
        </h2>
      </div>
      <p class="text-white/60 max-w-md text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Real stories of how we solve logistics, technical, and production challenges for our B2B partners worldwide.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {cases.map((item) => (
        <div class="group bg-[#0D1526]/40 border border-white/5 rounded-[32px] overflow-hidden hover:border-[#C9A84C]/30 transition-all duration-500 flex flex-col h-full">
          <div class="aspect-[16/10] overflow-hidden relative">
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-all duration-500 z-10"></div>
            <img src={item.image} alt={item.title} class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:brightness-110" />
            <div class="absolute top-6 left-6 z-20">
              <span class="bg-[#C9A84C] text-black text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                {item.category}
              </span>
            </div>
          </div>
          
          <div class="p-8 flex-grow flex flex-col">
            <h4 class="text-[20px] font-bold text-white mb-6 leading-tight group-hover:text-[#C9A84C] transition-colors font-['Century_Gothic',sans-serif]">
              {item.title}
            </h4>
            
            <div class="space-y-6 mb-8 flex-grow">
              <div>
                <p class="text-[#C9A84C] text-[11px] font-bold tracking-widest uppercase mb-2">Challenge</p>
                <p class="text-white/70 text-[14px] leading-relaxed font-['Century_Gothic',sans-serif]">{item.challenge}</p>
              </div>
              <div>
                <p class="text-[#C9A84C] text-[11px] font-bold tracking-widest uppercase mb-2">Solution</p>
                <p class="text-white/70 text-[14px] leading-relaxed font-['Century_Gothic',sans-serif]">{item.solution}</p>
              </div>
            </div>

            <div class="pt-6 border-t border-white/10 mt-auto">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#C9A84C]/10 flex items-center justify-center">
                  <span class="text-[#C9A84C] text-[14px]">🏆</span>
                </div>
                <div>
                  <p class="text-[#C9A84C] text-[13px] font-bold font-['Century_Gothic',sans-serif]">The Result</p>
                  <p class="text-white/90 text-[14px] font-bold font-['Century_Gothic',sans-serif]">{item.result}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 text-center">
      <a 
        href="https://api.whatsapp.com/send?phone=8615218851638&text=Hello%20Fitclo%2C%20I%20read%20your%20case%20studies%20and%20would%20like%20to%20discuss%20a%20similar%20success%20for%20my%20brand." 
        target="_blank"
        class="inline-flex items-center gap-3 text-white font-bold text-[14px] tracking-widest uppercase font-['Century_Gothic',sans-serif] group"
      >
        <span>Discuss Your Project</span>
        <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-[#C9A84C] group-hover:border-[#C9A84C] group-hover:text-black transition-all">
          &rarr;
        </span>
      </a>
    </div>
  </div>
</section>
