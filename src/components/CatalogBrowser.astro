---
import { productCategories, getProductCategory } from '../data/productCategories';
import { productCatalog } from '../data/productCatalog';
import CatalogProductCard from './CatalogProductCard.astro';

interface Props {
  categorySlug?: string;
}

const { categorySlug } = Astro.props;
const activeCategory = categorySlug ? getProductCategory(categorySlug) : undefined;
const catalogProducts = activeCategory
  ? productCatalog.filter((product) => product.category === activeCategory.slug)
  : productCatalog;
---

<section id="catalog" class="bg-[#090909] py-14 text-white md:py-20" data-catalog-root data-catalog-category={activeCategory?.slug ?? 'all'} data-catalog-category-label={activeCategory?.navLabel ?? ''}>
  <div class="mx-auto max-w-[1320px] px-6 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[270px_minmax(0,1fr)] lg:gap-12">
      <aside class="lg:sticky lg:top-[106px] lg:max-h-[calc(100vh-132px)] lg:overflow-y-auto lg:pr-4">
        <div class="border-y border-white/15 py-5">
          <p class="text-[11px] font-bold tracking-[0.18em] text-white font-['Century_Gothic',sans-serif]">PRODUCT CATEGORIES</p>
          <a href="/products/#catalog" class={`mt-5 flex w-full items-center border-l-2 px-4 py-3 text-left text-[13px] font-bold font-['Century_Gothic',sans-serif] ${activeCategory ? 'border-white/15 bg-[#141414] text-white/70 transition-colors hover:border-[#c9a84c] hover:text-white' : 'border-[#c9a84c] bg-[#1d1d1d] text-white'}`}>All styles</a>
          <div class="mt-4 divide-y divide-white/10 border-y border-white/10">
            {productCategories.map((category) => (
              <div class="catalog-category-group">
                <div class={`flex items-center border-l-2 transition-colors ${category.slug === activeCategory?.slug ? 'border-[#c9a84c] bg-[#1d1d1d]' : 'border-transparent bg-[#141414] hover:border-[#c9a84c] hover:bg-[#1b1b1b]'}`}>
                  <a href={`/products/${category.slug}/#catalog`} class={`min-w-0 flex-1 px-4 py-4 text-left text-[14px] font-bold transition-colors font-['Century_Gothic',sans-serif] ${category.slug === activeCategory?.slug ? 'text-white' : 'text-white/78 hover:text-white'}`}>{category.navLabel}</a>
                  <button
                    type="button"
                    class="catalog-category-toggle grid h-[52px] w-11 shrink-0 place-items-center text-[22px] text-[#d8b456] transition-colors hover:text-white"
                    aria-label={`Show ${category.navLabel} subcategories`}
                    aria-controls={`catalog-category-panel-${category.slug}`}
                    aria-expanded={category.slug === activeCategory?.slug ? 'true' : 'false'}
                    data-catalog-category-toggle={category.slug}
                  >
                    <span class="catalog-category-arrow" aria-hidden="true">&rsaquo;</span>
                  </button>
                </div>
                <div
                  id={`catalog-category-panel-${category.slug}`}
                  class={`catalog-category-panel space-y-1 border-l border-white/15 bg-[#101010] py-3 pl-4 pr-3 ${category.slug === activeCategory?.slug ? '' : 'hidden'}`}
                  data-catalog-category-panel={category.slug}
                >
                  {category.styles.map((style) => (
                    <a
                      href={`/products/${category.slug}/?style=${style.id}#catalog`}
                      class="catalog-style-link block py-0.5 text-left text-[12px] leading-[1.45] text-white/55 transition-colors hover:text-[#d8b456] font-['Century_Gothic',sans-serif]"
                      data-catalog-style-category={category.slug}
                      data-catalog-style={style.id}
                    >
                      {style.name}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <div>
        <div class="border-b border-white/15 pb-7">
          <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
              {activeCategory ? (
                <>
                  <h2 class="text-[31px] font-bold leading-[1.12] text-white md:text-[43px] font-['Century_Gothic',sans-serif]" data-catalog-heading>{activeCategory.navLabel}</h2>
                  <nav class="mt-3 flex flex-wrap items-center gap-2 text-[13px] text-white/50 font-['Century_Gothic',sans-serif]" aria-label="Product category path">
                    <a href="/products/#catalog" class="transition-colors hover:text-[#d8b456]">All products</a>
                    <span aria-hidden="true">&rsaquo;</span>
                    <a href={`/products/${activeCategory.slug}/#catalog`} class="hidden transition-colors hover:text-[#d8b456]" data-catalog-parent-link>{activeCategory.navLabel}</a>
                    <span class="text-white/75" data-catalog-category-current>{activeCategory.navLabel}</span>
                    <span class="hidden" aria-hidden="true" data-catalog-child-separator>&rsaquo;</span>
                    <span class="hidden text-white/75" data-catalog-child-current></span>
                  </nav>
                </>
              ) : (
                <>
                  <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">FITCLO STYLE LIBRARY</p>
                  <h2 class="mt-3 text-[31px] font-bold leading-[1.12] text-white md:text-[43px] font-['Century_Gothic',sans-serif]">Browse activewear styles.</h2>
                </>
              )}
            </div>
            <p class="max-w-[400px] text-[14px] leading-[1.65] text-white/55 font-['Century_Gothic',sans-serif]">{activeCategory ? activeCategory.shortDescription : 'Choose a category to browse its dedicated style page, or search the complete catalog by style name, code or feature.'}</p>
          </div>

          <div class="mt-7 flex flex-col gap-3 md:flex-row">
            <label class="relative block min-w-0 flex-1">
              <span class="sr-only">Search product styles</span>
              <input type="search" placeholder="Search styles, codes or product features" class="w-full border border-white/15 bg-[#171717] px-5 py-4 pr-12 text-[14px] text-white outline-none transition-colors placeholder:text-white/35 focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" data-catalog-search-input />
              <button type="button" class="absolute right-3 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center text-[20px] text-[#d8b456] transition-colors hover:text-white" aria-label="Search product styles" data-catalog-search-submit>&#8981;</button>
            </label>
            <div class="inline-flex shrink-0 border border-white/15 bg-[#171717] p-1" role="group" aria-label="Product browsing layout">
              <button type="button" class="catalog-view-button grid h-12 w-12 place-items-center text-white/65 transition-colors hover:text-white" data-catalog-view-button="list" aria-label="Browse products in a vertical list" title="Vertical list view" aria-pressed="false">
                <span class="catalog-list-icon" aria-hidden="true"><i></i><i></i><i></i></span>
              </button>
              <button type="button" class="catalog-view-button grid h-12 w-12 place-items-center text-white transition-colors hover:text-white" data-catalog-view-button="grid" aria-label="Browse products in a horizontal grid" title="Four-column grid view" aria-pressed="true">
                <span class="catalog-grid-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              </button>
            </div>
          </div>
        </div>

        <div class="flex justify-end py-6">
          <a href="/ready-to-ship" class="text-[12px] font-bold tracking-[0.1em] text-[#d8b456] transition-colors hover:text-white font-['Century_Gothic',sans-serif]">READY-TO-SHIP PROGRAM &#8594;</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-catalog-grid>
          {catalogProducts.map((product) => <CatalogProductCard product={product} searchable />)}
        </div>
        <nav class="mt-10 hidden items-center justify-center gap-2" aria-label="Product catalog pagination" data-catalog-pagination></nav>
        <p class="hidden border-y border-white/15 py-10 text-center text-[15px] text-white/55 font-['Century_Gothic',sans-serif]" data-catalog-empty>No styles match that search. Try a broader term or contact Fitclo with your reference design.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const initCatalogBrowser = (root: HTMLElement) => {
    if (root.dataset.catalogReady === 'true') return;
    root.dataset.catalogReady = 'true';

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-product]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-catalog-search-input]');
    const searchSubmit = root.querySelector<HTMLButtonElement>('[data-catalog-search-submit]');
    const empty = root.querySelector<HTMLElement>('[data-catalog-empty]');
    const grid = root.querySelector<HTMLElement>('[data-catalog-grid]');
    const pagination = root.querySelector<HTMLElement>('[data-catalog-pagination]');
    const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-catalog-view-button]'));
    const styleLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-catalog-style]'));
    const categoryToggles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-catalog-category-toggle]'));
    const categoryPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-category-panel]'));
    const categoryHeading = root.querySelector<HTMLElement>('[data-catalog-heading]');
    const categoryParentLink = root.querySelector<HTMLAnchorElement>('[data-catalog-parent-link]');
    const categoryCurrent = root.querySelector<HTMLElement>('[data-catalog-category-current]');
    const categoryChildSeparator = root.querySelector<HTMLElement>('[data-catalog-child-separator]');
    const categoryChildCurrent = root.querySelector<HTMLElement>('[data-catalog-child-current]');
    const params = new URLSearchParams(window.location.search);
    const fixedCategory = root.dataset.catalogCategory || 'all';
    const fixedCategoryLabel = root.dataset.catalogCategoryLabel || '';
    let category = fixedCategory === 'all' ? params.get('category') || 'all' : fixedCategory;
    let subcategory = params.get('style') || '';
    const normalizeSearch = (value: string) => value.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
    let search = normalizeSearch(params.get('q') || '');
    let currentPage = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);
    const productsPerPage = 16;

    if (searchInput && search) {
      searchInput.value = search;
    }

    const hasInitialFilter = cards.some((card) => {
      const categoryMatches = category === 'all' || card.dataset.catalogCategory === category;
      const subcategoryMatches = !subcategory || card.dataset.catalogSubcategory === subcategory;
      return categoryMatches && subcategoryMatches;
    });

    if (!hasInitialFilter) {
      category = fixedCategory === 'all' ? 'all' : fixedCategory;
      subcategory = '';
    }

    const setOpenCategory = (categorySlug: string, shouldOpen: boolean, closeSiblings = true) => {
      categoryToggles.forEach((button) => {
        const isTarget = button.dataset.catalogCategoryToggle === categorySlug;
        if (!isTarget && closeSiblings) {
          button.setAttribute('aria-expanded', 'false');
          button.classList.remove('catalog-category-toggle-open');
          return;
        }
        if (isTarget) {
          button.setAttribute('aria-expanded', String(shouldOpen));
          button.classList.toggle('catalog-category-toggle-open', shouldOpen);
        }
      });

      categoryPanels.forEach((panel) => {
        const isTarget = panel.dataset.catalogCategoryPanel === categorySlug;
        if (!isTarget && closeSiblings) {
          panel.classList.add('hidden');
          return;
        }
        if (isTarget) {
          panel.classList.toggle('hidden', !shouldOpen);
        }
      });
    };

    const updatePageUrl = (mode: 'push' | 'replace' = 'replace') => {
      const next = new URL(window.location.href);
      if (currentPage > 1) {
        next.searchParams.set('page', String(currentPage));
      } else {
        next.searchParams.delete('page');
      }
      if (search) {
        next.searchParams.set('q', search);
      } else {
        next.searchParams.delete('q');
      }
      const target = `${next.pathname}${next.search}${next.hash}`;
      if (target === `${window.location.pathname}${window.location.search}${window.location.hash}`) return;
      window.history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', target);
    };

    const renderPagination = (visible: HTMLElement[]) => {
      if (!pagination) return;
      const pageSize = productsPerPage;
      const totalPages = Math.max(1, Math.ceil(visible.length / pageSize));
      currentPage = visible.length === 0 ? 1 : Math.min(currentPage, totalPages);
      pagination.innerHTML = '';
      pagination.classList.toggle('hidden', totalPages <= 1 || visible.length === 0);
      pagination.classList.toggle('flex', totalPages > 1 && visible.length > 0);

      if (totalPages <= 1 || visible.length === 0) return;

      const createButton = (label: string, page: number, options: { active?: boolean; disabled?: boolean; aria?: string } = {}) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.disabled = Boolean(options.disabled);
        button.setAttribute('aria-label', options.aria || `Go to page ${page}`);
        if (options.active) button.setAttribute('aria-current', 'page');
        button.className = [
          'catalog-page-button',
          options.active ? 'catalog-page-button-active' : '',
          options.disabled ? 'catalog-page-button-disabled' : '',
        ].filter(Boolean).join(' ');
        button.addEventListener('click', () => {
          if (options.disabled || currentPage === page) return;
          currentPage = page;
          updatePageUrl('push');
          refresh();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        return button;
      };

      const maxNumbers = 5;
      let start = Math.max(1, currentPage - Math.floor(maxNumbers / 2));
      const end = Math.min(totalPages, start + maxNumbers - 1);
      start = Math.max(1, end - maxNumbers + 1);

      pagination.appendChild(createButton('<', currentPage - 1, {
        disabled: currentPage === 1,
        aria: 'Go to previous product page',
      }));

      for (let page = start; page <= end; page += 1) {
        pagination.appendChild(createButton(String(page), page, { active: page === currentPage }));
      }

      pagination.appendChild(createButton('>', currentPage + 1, {
        disabled: currentPage === totalPages,
        aria: 'Go to next product page',
      }));
    };

    const refresh = () => {
      const filtered = cards.filter((card) => {
        const categoryMatches = category === 'all' || card.dataset.catalogCategory === category;
        const subcategoryMatches = !subcategory || card.dataset.catalogSubcategory === subcategory;
        const haystack = normalizeSearch(`${card.dataset.catalogSearch || ''} ${card.textContent || ''}`);
        const searchTerms = search.split(' ').filter(Boolean);
        const searchMatches = searchTerms.length === 0 || searchTerms.every((term) => haystack.includes(term));
        return categoryMatches && subcategoryMatches && searchMatches;
      });

      const pageSize = productsPerPage;
      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      currentPage = filtered.length === 0 ? 1 : Math.min(currentPage, totalPages);
      const pageStart = (currentPage - 1) * pageSize;
      const pageEnd = pageStart + pageSize;
      const paged = new Set(filtered.slice(pageStart, pageEnd));
      cards.forEach((card) => {
        const shouldShow = paged.has(card);
        card.hidden = !shouldShow;
        card.classList.toggle('catalog-product-hidden', !shouldShow);
        card.style.display = shouldShow ? '' : 'none';
      });

      styleLinks.forEach((link) => {
        const isActive = link.dataset.catalogStyleCategory === category && link.dataset.catalogStyle === subcategory;
        link.classList.toggle('catalog-style-link-active', isActive);
      });

      const activeStyleLink = styleLinks.find((link) => link.dataset.catalogStyleCategory === category && link.dataset.catalogStyle === subcategory);
      const activeStyleName = activeStyleLink?.textContent?.trim();
      const isSubcategory = Boolean(fixedCategory !== 'all' && activeStyleName);
      if (categoryHeading) categoryHeading.textContent = isSubcategory ? activeStyleName || fixedCategoryLabel : fixedCategoryLabel;
      categoryParentLink?.classList.toggle('hidden', !isSubcategory);
      categoryCurrent?.classList.toggle('hidden', isSubcategory);
      categoryChildSeparator?.classList.toggle('hidden', !isSubcategory);
      categoryChildCurrent?.classList.toggle('hidden', !isSubcategory);
      if (categoryChildCurrent && activeStyleName) categoryChildCurrent.textContent = activeStyleName;

      empty?.classList.toggle('hidden', filtered.length !== 0);
      renderPagination(filtered);
    };

    const setView = (view: 'grid' | 'list', resetPage = true) => {
      grid?.classList.toggle('catalog-list-view', view === 'list');
      viewButtons.forEach((button) => {
        const isActive = button.dataset.catalogViewButton === view;
        button.setAttribute('aria-pressed', String(isActive));
      });
      if (resetPage) {
        currentPage = 1;
        updatePageUrl('replace');
      }
      refresh();
    };

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setView(button.dataset.catalogViewButton === 'list' ? 'list' : 'grid');
      });
    });

    categoryToggles.forEach((button) => {
      button.addEventListener('click', () => {
        const categorySlug = button.dataset.catalogCategoryToggle || '';
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        setOpenCategory(categorySlug, !isOpen);
      });
    });

    searchInput?.addEventListener('input', () => {
      search = normalizeSearch(searchInput.value);
      currentPage = 1;
      updatePageUrl('replace');
      refresh();
    });

    searchSubmit?.addEventListener('click', () => {
      search = normalizeSearch(searchInput?.value || '');
      currentPage = 1;
      updatePageUrl('replace');
      refresh();
      searchInput?.focus();
    });

    searchInput?.addEventListener('search', () => {
      search = normalizeSearch(searchInput.value);
      currentPage = 1;
      updatePageUrl('replace');
      refresh();
    });

    window.addEventListener('popstate', () => {
      const nextParams = new URLSearchParams(window.location.search);
      const nextPage = Math.max(1, Number.parseInt(nextParams.get('page') || '1', 10) || 1);
      currentPage = nextPage;
      refresh();
    });

    setView('grid', false);
  };

  document.querySelectorAll<HTMLElement>('[data-catalog-root]').forEach(initCatalogBrowser);
</script>

<style>
  .catalog-style-link-active { color: #d8b456; }
  .catalog-view-button[aria-pressed='true'] { background: #d8b456; color: #080808; }
  .catalog-list-icon { display: grid; gap: 3px; width: 17px; }
  .catalog-list-icon i { display: block; height: 3px; border: 1px solid currentColor; }
  .catalog-grid-icon { display: grid; grid-template-columns: repeat(2, 6px); gap: 3px; }
  .catalog-grid-icon i { display: block; height: 6px; border: 1px solid currentColor; }
  .catalog-category-arrow {
    display: inline-block;
    transform: rotate(0deg);
    transition: transform 180ms ease, color 180ms ease;
  }
  .catalog-category-toggle[aria-expanded='true'] .catalog-category-arrow {
    transform: rotate(90deg);
  }
  .catalog-category-panel {
    box-shadow: inset 2px 0 0 rgba(216, 180, 86, 0.16);
  }
  :global(.catalog-product-hidden) { display: none !important; }
  :global(.catalog-page-button) {
    display: grid;
    min-width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(216, 180, 86, 0.22);
    border-radius: 8px;
    background: #151515;
    color: rgba(255, 255, 255, 0.76);
    font-family: 'Century Gothic', sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease;
  }
  :global(.catalog-page-button:hover) { border-color: #d8b456; color: #fff; transform: translateY(-1px); }
  :global(.catalog-page-button-active),
  :global(.catalog-page-button-active:hover) {
    border-color: #d8b456;
    background: #d8b456;
    color: #080808;
    box-shadow: 0 10px 24px rgba(216, 180, 86, 0.22);
    transform: none;
  }
  :global(.catalog-page-button-disabled),
  :global(.catalog-page-button-disabled:hover) {
    cursor: not-allowed;
    border-color: rgba(255, 255, 255, 0.08);
    background: #101010;
    color: rgba(255, 255, 255, 0.22);
    box-shadow: none;
    transform: none;
  }

  @media (min-width: 640px) {
    [data-catalog-grid].catalog-list-view { grid-template-columns: 1fr; }
    [data-catalog-grid].catalog-list-view .catalog-product { display: grid; grid-template-columns: minmax(160px, 220px) minmax(0, 1fr); align-items: stretch; }
    [data-catalog-grid].catalog-list-view .catalog-product > :first-child { align-self: stretch; aspect-ratio: auto; min-height: 160px; }
  }
</style>
