---
import type { CatalogProduct } from '../data/productCatalog';

interface Props {
  product: CatalogProduct;
  searchable?: boolean;
}

const { product, searchable = false } = Astro.props;
const productDetailLinks: Record<string, string> = {
  'women-yoga-set': '/products/womens-yoga-set/',
  'capri-workout-set': '/products/capri-workout-set/',
  'wide-leg-workout-set': '/products/wide-leg-workout-set/',
  'racerback-tennis-skirt-set': '/products/racerback-tennis-skirt-set/',
  'three-quarter-sleeve-capri-workout-set': '/products/three-quarter-sleeve-capri-workout-set/',
  'knee-length-capri-leggings-workout-set-tz7655-7': '/products/knee-length-capri-leggings-workout-set/',
  'premium-three-piece-yoga-set': '/products/premium-3-piece-yoga-set/',
  'womens-three-piece-activewear-set-tz4510-14': '/products/tz4510-14/',
  'three-quarter-wide-leg-yoga-pants-set-tz5555-4': '/products/tz5555-4/',
  'seamless-flare-leggings-set-tz2557-6': '/products/tz2557-6/',
  'contrast-trim-capri-set': '/products/tz4506-4/',
  'halter-neck-contrast-trim-flare-leggings-set-tz4506-3': '/products/tz4506-3/',
  'cross-back-leggings-set': '/products/tz5560-2/',
  'three-quarter-sleeve-flare-set-tz4535-12': '/products/tz4535-12/',
  'square-neck-tank-running-shorts-set-3708': '/products/3708/',
  'cross-back-sports-bra-leggings-set-0636': '/products/0636/',
};
const productDetailHref = productDetailLinks[product.id];
const whatsappMessage = encodeURIComponent(
  `Hello Fitclo, I am interested in ${product.name} (${product.styleCode}). Can you share stock availability, MOQ and wholesale pricing?`
);
const whatsappHref = `https://api.whatsapp.com/send?phone=8617160837538&text=${whatsappMessage}`;
---

<article
  class="catalog-product group flex h-full flex-col overflow-hidden rounded-[12px] bg-white shadow-[0_10px_30px_rgba(0,0,0,0.2)]"
  data-catalog-product={searchable ? '' : undefined}
  data-catalog-category={searchable ? product.category : undefined}
  data-catalog-subcategory={searchable ? product.subcategory : undefined}
  data-catalog-search={searchable ? `${product.name} ${product.styleCode} ${product.description} ${product.keywords.join(' ')}`.toLowerCase() : undefined}
  data-catalog-name={searchable ? product.name.toLowerCase() : undefined}
>
  {productDetailHref ? (
    <>
    <a href={productDetailHref} class="flex flex-col" aria-label={`View ${product.name} details`}>
      <div class="relative m-2 aspect-square overflow-hidden rounded-[9px] bg-[#eeeeee]">
        <img src={product.image} alt={product.name} class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.025]" loading="lazy" />
      </div>
      <div class="flex min-h-[56px] items-center justify-center border-t border-black/5 bg-white px-3 pt-3 text-center">
        <h3 class="catalog-product-name text-[14px] font-bold leading-[1.35] text-[#151515] transition-colors group-hover:text-[#9b7824] font-['Century_Gothic',sans-serif]">{product.name}</h3>
      </div>
    </a>
    <div class="mt-auto bg-white px-3 pb-4 pt-2">
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="catalog-chat-button inline-flex items-center justify-center rounded-full border border-[#151515] bg-white px-5 py-2 text-[14px] font-bold leading-none text-[#151515] transition-colors hover:border-[#d8b456] hover:bg-[#d8b456] hover:text-black font-['Century_Gothic',sans-serif]" aria-label={`Chat with Fitclo about ${product.name}`}>
        Chat Now
      </a>
    </div>
    </>
  ) : (
    <>
      <div class="relative m-2 aspect-square overflow-hidden rounded-[9px] bg-[#eeeeee]">
        <img src={product.image} alt={product.name} class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.025]" loading="lazy" />
      </div>
      <div class="flex min-h-[56px] items-center justify-center border-t border-black/5 bg-white px-3 pt-3 text-center">
        <h3 class="catalog-product-name text-[14px] font-bold leading-[1.35] text-[#151515] transition-colors group-hover:text-[#9b7824] font-['Century_Gothic',sans-serif]">{product.name}</h3>
      </div>
      <div class="mt-auto bg-white px-3 pb-4 pt-2">
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="catalog-chat-button inline-flex items-center justify-center rounded-full border border-[#151515] bg-white px-5 py-2 text-[14px] font-bold leading-none text-[#151515] transition-colors hover:border-[#d8b456] hover:bg-[#d8b456] hover:text-black font-['Century_Gothic',sans-serif]" aria-label={`Chat with Fitclo about ${product.name}`}>
          Chat Now
        </a>
      </div>
    </>
  )}
</article>

<style>
  .catalog-product-name {
    display: -webkit-box;
    min-height: calc(1.35em * 2);
    max-height: calc(1.35em * 2);
    overflow: hidden;
    text-overflow: ellipsis;
    overflow-wrap: normal;
    word-break: normal;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .catalog-chat-button {
    min-width: 118px;
    min-height: 36px;
  }
</style>
