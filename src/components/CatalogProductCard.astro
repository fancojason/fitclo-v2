---
import type { CatalogProduct } from '../data/productCatalog';

interface Props {
  product: CatalogProduct;
  searchable?: boolean;
}

const { product, searchable = false } = Astro.props;
const message = encodeURIComponent(
  `Hello Fitclo, I am interested in style ${product.styleCode} (${product.name}). Please confirm current availability, MOQ and branding options.`,
);
---

<article
  class="catalog-product group flex h-full flex-col border border-black/10 bg-white"
  data-catalog-product={searchable ? '' : undefined}
  data-catalog-category={searchable ? product.category : undefined}
  data-catalog-subcategory={searchable ? product.subcategory : undefined}
  data-catalog-search={searchable ? `${product.name} ${product.styleCode} ${product.description} ${product.keywords.join(' ')}`.toLowerCase() : undefined}
  data-catalog-name={searchable ? product.name.toLowerCase() : undefined}
>
  <div class="relative aspect-[4/5] overflow-hidden bg-[#f0f0ef]">
    <img src={product.image} alt={product.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]" loading="lazy" />
    <span class="absolute left-4 top-4 bg-black px-3 py-1.5 text-[10px] font-bold tracking-[0.12em] text-white font-['Century_Gothic',sans-serif]">{product.styleCode}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-[10px] font-bold tracking-[0.16em] text-[#a77c1c] font-['Century_Gothic',sans-serif]">MOQ {product.moq}</p>
    <h3 class="mt-3 text-[19px] font-bold leading-[1.28] text-[#161616] font-['Century_Gothic',sans-serif]">{product.name}</h3>
    <p class="mt-3 text-[14px] leading-[1.65] text-[#626262] font-['Century_Gothic',sans-serif]">{product.description}</p>
    <a href={`https://api.whatsapp.com/send?phone=8617160837538&text=${message}`} target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-2 text-[12px] font-bold tracking-[0.1em] text-[#b58b2c] transition-colors hover:text-black font-['Century_Gothic',sans-serif]">CHECK STYLE AVAILABILITY <span aria-hidden="true">&#8594;</span></a>
  </div>
</article>
