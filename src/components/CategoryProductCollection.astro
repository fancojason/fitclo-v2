---
import { getCatalogProductsForCategory } from '../data/productCatalog';
import { getProductCategory } from '../data/productCategories';
import CatalogProductCard from './CatalogProductCard.astro';

interface Props {
  categorySlug: string;
}

const { categorySlug } = Astro.props;
const category = getProductCategory(categorySlug);
const products = getCatalogProductsForCategory(categorySlug);
---

<section class="bg-[#f6f6f4] py-18 md:py-24">
  <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
    <div class="flex flex-col gap-5 border-b border-black/15 pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#a77c1c] font-['Century_Gothic',sans-serif]">AVAILABLE STYLE DIRECTION</p>
        <h2 class="mt-3 text-[31px] font-bold leading-[1.14] text-[#171717] md:text-[42px] font-['Century_Gothic',sans-serif]">Browse {category?.navLabel.toLowerCase()} styles.</h2>
      </div>
      <a href={`/products/?category=${categorySlug}#catalog`} class="text-[12px] font-bold tracking-[0.1em] text-[#a77c1c] transition-colors hover:text-black font-['Century_Gothic',sans-serif]">VIEW ALL IN PRODUCT CATALOG &#8594;</a>
    </div>
    {products.length ? (
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <CatalogProductCard product={product} />)}
      </div>
    ) : (
      <div class="mt-9 border border-dashed border-black/20 bg-white px-6 py-12 text-center text-[15px] leading-[1.7] text-[#626262] font-['Century_Gothic',sans-serif]">New {category?.navLabel.toLowerCase()} styles are being added. Send Fitclo a reference image or brief for current development and stock options.</div>
    )}
  </div>
</section>
