---
const certs = [
  {
    icon: "🌿",
    title: "OEKO-TEX",
    desc: "Standard 100"
  },
  {
    icon: "🛡️",
    title: "BSCI Audit",
    desc: "Ethical Sourcing"
  },
  {
    icon: "♻️",
    title: "GRS Certified",
    desc: "Recycled Content"
  },
  {
    icon: "🏆",
    title: "ISO 9001",
    desc: "Quality Management"
  },
  {
    icon: "🔬",
    title: "SGS Tested",
    desc: "Lab Verified"
  },
  {
    icon: "🇪🇺",
    title: "REACH",
    desc: "EU Compliant"
  }
];
---

<section id="certifications" class="py-20 bg-[#0E0E14] text-white border-t border-white/5">
  <div class="max-w-[1400px] mx-auto px-6 text-center">
    <!-- Header -->
    <div class="mb-10">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.15em] text-[10px] md:text-[11px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        CERTIFICATIONS & COMPLIANCE
      </h3>
      <h2 class="text-[28px] md:text-[38px] font-bold text-white font-['Century_Gothic',sans-serif] tracking-tight">
        Built to Global Standards
      </h2>
    </div>

    <!-- Certifications Row -->
    <div class="flex flex-wrap justify-center gap-6 md:gap-12 lg:gap-16">
      {certs.map((cert) => (
        <div class="flex flex-col items-center group">
          <!-- Circle Icon Container (Refined Size & Color) -->
          <div class="w-14 h-14 md:w-16 md:h-16 rounded-full border-2 border-[#C9A84C]/30 flex items-center justify-center bg-white/[0.01] transition-all duration-300 group-hover:border-[#C9A84C]/60 group-hover:bg-white/[0.04] group-hover:scale-105 mb-4">
            <span class="text-xl md:text-2xl filter saturate-[0.7] group-hover:saturate-100 transition-all">
              {cert.icon}
            </span>
          </div>
          
          <!-- Text Labels -->
          <div class="text-center">
            <h4 class="text-[12px] md:text-[13px] font-bold text-white tracking-widest uppercase font-['Century_Gothic',sans-serif] mb-1">
              {cert.title}
            </h4>
            <p class="text-[10px] md:text-[11px] font-bold text-white/30 tracking-wider uppercase font-['Century_Gothic',sans-serif]">
              {cert.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
