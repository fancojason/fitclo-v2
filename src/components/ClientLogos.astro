---
const logos = [
  { name: "Brand 1" },
  { name: "Brand 2" },
  { name: "Brand 3" },
  { name: "Brand 4" },
  { name: "Brand 5" }
];
---

<section class="py-12 bg-[#06060a] border-y border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <p class="text-[11px] font-bold tracking-[0.3em] text-white/30 uppercase mb-8 text-center font-['Century_Gothic',sans-serif]">
      Trusted by 500+ Global Activewear Brands
    </p>

    <div class="flex flex-wrap items-center justify-center gap-12 lg:gap-20 opacity-30 grayscale hover:opacity-60 transition-opacity duration-500">
      <!-- Placeholder Logos (using small factory icons or similar for style) -->
      {logos.map(logo => (
        <div class="h-8 md:h-10 flex items-center justify-center">
           <span class="text-white/40 font-bold text-lg md:text-xl tracking-tighter uppercase font-['Century_Gothic',sans-serif]">{logo.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
