---
import { coreLocales, corePageSlugs, corePath, type CoreLanguage } from '../content/core-locales';
import { getWhatsAppUrl } from '../lib/whatsapp';
const language = Astro.props.lang as CoreLanguage;
const copy = coreLocales[language];
---
<footer class="border-t border-[#C9A84C]/30 bg-[#06060a] px-6 py-12 text-white lg:px-16">
  <div class="mx-auto grid max-w-[1500px] gap-8 md:grid-cols-3">
    <div><p class="text-xl font-bold uppercase tracking-widest text-[#C9A84C]">Fitclo</p><p class="mt-4 max-w-sm text-sm leading-7 text-white/70">{copy.footer}</p></div>
    <nav aria-label={copy.name} class="flex flex-col gap-3 text-sm">{corePageSlugs.map((page) => <a class="hover:text-[#C9A84C]" href={corePath(language, page)}>{copy.nav[page]}</a>)}</nav>
    <div class="text-sm leading-7 text-white/70"><p>{copy.footerNote}</p><a class="mt-3 block text-[#C9A84C]" href="mailto:sales@fitcloo.com">sales@fitcloo.com</a><a class="mt-2 block text-[#C9A84C]" target="_blank" rel="noopener noreferrer" href={getWhatsAppUrl({ path: Astro.url.pathname, language })}>WhatsApp</a></div>
  </div>
  <p class="mx-auto mt-10 max-w-[1500px] border-t border-white/10 pt-5 text-xs text-white/45">© {new Date().getFullYear()} Fitclo</p>
</footer>
