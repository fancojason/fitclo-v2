---
import BaseLayout from '../layouts/BaseLayout.astro';
import { coreLocales, corePath, type CoreLanguage, type CorePage } from '../content/core-locales';
import { getAlternateLinks, localizedRoutePairs } from '../i18n/routes';
import { getWhatsAppUrl } from '../lib/whatsapp';

const { language, page } = Astro.props as { language: CoreLanguage; page: CorePage };
const copy = coreLocales[language];
const content = copy.pages[page];
const path = corePath(language, page);
const pair = localizedRoutePairs.find((route) => route[language] === path);
if (!pair) throw new Error(`Missing language equivalent for ${path}`);
const alternateLinks = getAlternateLinks(pair.en, pair.es);
const whatsappUrl = getWhatsAppUrl({ path, language });
---
<BaseLayout lang={language} title={content.title} description={content.description} canonicalURL={`https://www.fitcloo.com${path}`} alternateLinks={alternateLinks} image="https://www.fitcloo.com/images/intelligence/hero-activewear-intelligence.webp">
  <section class="relative bg-[#09090e] px-6 pb-20 pt-44 text-white md:pt-40">
    <div class="absolute inset-0 opacity-25"><img src="/images/intelligence/hero-activewear-intelligence.webp" alt="" class="h-full w-full object-cover" width="1440" height="810" /></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/75 to-black/40"></div>
    <div class="relative mx-auto max-w-6xl"><p class="text-xs font-bold tracking-[0.18em] text-[#C9A84C]">{content.eyebrow}</p><h1 class="mt-5 max-w-4xl text-4xl font-bold leading-tight md:text-6xl">{content.heading}</h1><p class="mt-7 max-w-3xl text-base leading-8 text-white/80 md:text-lg">{content.intro}</p><div class="mt-9 flex flex-wrap gap-4"><a href={corePath(language, 'contact') + '#inquiry'} class="bg-[#C9A84C] px-6 py-3 font-bold text-black hover:bg-[#dfc26c]">{content.cta}</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="border border-white/50 px-6 py-3 font-bold text-white hover:border-[#C9A84C]">WhatsApp</a></div></div>
  </section>
  <section class="bg-white px-6 py-20 text-[#17171b]"><div class="mx-auto max-w-6xl"><h2 class="text-3xl font-bold">{copy.labels.sections}</h2><div class="mt-9 grid gap-6 md:grid-cols-3">{content.sections.map((section, index) => <article class="border border-neutral-200 bg-[#faf9f6] p-7"><span class="text-sm font-bold text-[#9b7426]">0{index + 1}</span><h3 class="mt-4 text-xl font-bold">{section.heading}</h3><p class="mt-4 leading-7 text-neutral-700">{section.text}</p></article>)}</div></div></section>
  <section class="bg-[#0e0e12] px-6 py-20 text-white"><div class="mx-auto max-w-6xl"><h2 class="text-3xl font-bold">{copy.labels.process}</h2><ol class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{content.steps.map((step, index) => <li class="border-t border-[#C9A84C]/60 pt-4"><span class="text-sm font-bold text-[#C9A84C]">0{index + 1}</span><p class="mt-3 leading-7 text-white/85">{step}</p></li>)}</ol></div></section>
  <section class="bg-white px-6 py-20 text-[#17171b]"><div class="mx-auto max-w-5xl"><h2 class="text-3xl font-bold">{copy.labels.faq}</h2><div class="mt-8 space-y-4">{content.questions.map((item) => <details class="border border-neutral-200 p-5"><summary class="cursor-pointer font-bold">{item.question}</summary><p class="mt-4 leading-7 text-neutral-700">{item.answer}</p></details>)}</div><div class="mt-12 flex flex-wrap gap-4"><a href={corePath(language, 'contact') + '#inquiry'} class="bg-[#C9A84C] px-6 py-3 font-bold text-black">{content.cta}</a>{page !== 'home' && <a href={corePath(language, 'home')} class="border border-neutral-300 px-6 py-3 font-bold">{copy.nav.home}</a>}</div></div></section>
  {page === 'contact' && <section id="inquiry" class="bg-[#0e0e12] px-6 py-20 text-white"><div class="mx-auto max-w-3xl"><h2 class="text-3xl font-bold">{copy.labels.request}</h2><p class="mt-4 leading-7 text-white/70">{content.intro}</p>
    <form id="inquiry-form" class="mt-8 grid gap-5 sm:grid-cols-2" data-sending={copy.labels.sending} data-success={copy.labels.success} data-error={copy.labels.error} data-required={copy.labels.required} data-email-error={copy.labels.emailError} data-attachment-error={copy.labels.attachmentError}>
      <input name="website" class="absolute -left-[9999px]" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="language" value={language} /><input type="hidden" name="page_path" value={path} /><input type="hidden" name="page_url" value={`https://www.fitcloo.com${path}`} />
      <label class="space-y-2 text-sm"><span>{copy.labels.name} *</span><input name="name" required autocomplete="name" class="w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <label class="space-y-2 text-sm"><span>{copy.labels.company}</span><input name="company" autocomplete="organization" class="w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <label class="space-y-2 text-sm"><span>{copy.labels.email} *</span><input type="email" name="email" required autocomplete="email" class="w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <label class="space-y-2 text-sm"><span>{copy.labels.phone}</span><input name="phone" autocomplete="tel" class="w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <label class="space-y-2 text-sm"><span>{copy.labels.interest} *</span><select name="product_type" required class="w-full border border-white/25 bg-[#16161b] p-3 text-white"><option value="">{copy.labels.choose}</option><option value="Ready stock">{copy.nav['ready-stock-activewear']}</option><option value="Private label">{copy.nav['private-label-activewear']}</option><option value="OEM/ODM">OEM/ODM</option></select></label>
      <label class="space-y-2 text-sm"><span>{copy.labels.quantity}</span><input name="quantity" inputmode="numeric" class="w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <label class="space-y-2 text-sm sm:col-span-2"><span>{copy.labels.details}</span><textarea name="message" rows="5" class="w-full border border-white/25 bg-white/5 p-3 text-white"></textarea></label>
      <label class="space-y-2 text-sm sm:col-span-2"><span>{copy.labels.attachment}</span><span class="block text-xs text-white/60">{copy.labels.attachmentHelp}</span><input type="file" name="file" accept=".png,.ai,.pdf" class="block w-full border border-white/25 bg-white/5 p-3 text-white" /></label>
      <p class="text-sm text-white/60 sm:col-span-2">{copy.labels.privacy}</p><button type="submit" class="bg-[#C9A84C] px-6 py-3 font-bold text-black disabled:opacity-50 sm:col-span-2">{copy.labels.send}</button><p id="form-status" class="hidden text-sm sm:col-span-2" role="status" aria-live="polite"></p>
    </form>
  </div></section>}
  <script>
    import { submitInquiry } from '../lib/inquiry-client';
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    form?.addEventListener('invalid', (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return;
      field.setCustomValidity(field.validity.valueMissing ? form.dataset.required || '' : field.validity.typeMismatch ? form.dataset.emailError || '' : '');
    }, true);
    form?.addEventListener('input', (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.setCustomValidity('');
    });
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('#form-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!status || !button) return;
      const original = button.textContent || '';
      const file = form.querySelector<HTMLInputElement>('input[name="file"]')?.files?.[0];
      if (file && (!/\.(png|ai|pdf)$/i.test(file.name) || file.size > 10 * 1024 * 1024 || file.size === 0)) {
        status.classList.remove('hidden', 'text-green-400'); status.classList.add('text-red-400');
        status.textContent = form.dataset.attachmentError || ''; return;
      }
      status.classList.remove('hidden'); status.textContent = form.dataset.sending || '';
      button.disabled = true;
      try {
        const response = await submitInquiry(Object.fromEntries(new FormData(form)));
        const result = await response.json();
        if (!response.ok || !result?.success || !result?.id) throw new Error('Submission not accepted');
        form.reset(); status.textContent = form.dataset.success || ''; status.classList.remove('text-red-400'); status.classList.add('text-green-400');
      } catch {
        status.textContent = form.dataset.error || ''; status.classList.remove('text-green-400'); status.classList.add('text-red-400');
      } finally { button.disabled = false; button.textContent = original; }
    });
  </script>
</BaseLayout>
