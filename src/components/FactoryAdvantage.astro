---
const marketplaceItems = [
  {
    title: "Hundreds of Suppliers to Compare",
    desc: "Finding the right supplier takes time and often comes with uncertainty.",
  },
  {
    title: "Unclear Factory Background",
    desc: "Difficult to verify production capabilities and quality standards.",
  },
  {
    title: "Inconsistent Quality",
    desc: "Products may come from different factories with varying quality levels.",
  },
  {
    title: "Communication Delays",
    desc: "Messages often pass through multiple parties, slowing down projects.",
  },
  {
    title: "Higher Sourcing Costs",
    desc: "Platform fees and middlemen can increase overall purchasing costs.",
  }
];

const fitclooItems = [
  {
    title: "Verified Activewear Manufacturer",
    desc: "Specializing in yoga wear, sports bras, leggings, shorts, tank tops, and jumpsuits.",
  },
  {
    title: "Private Label & Custom Branding",
    desc: "Custom logos, woven labels, blank labels, packaging, and retail-ready solutions.",
  },
  {
    title: "Low MOQ",
    desc: "Flexible minimum order quantities for startups and growing activewear brands.",
  },
  {
    title: "Stable Production Capacity",
    desc: "Reliable manufacturing with strict quality control and consistent lead times.",
  },
  {
    title: "Factory-Direct Wholesale Pricing",
    desc: "No middlemen. Competitive wholesale pricing and long-term partnership support.",
  }
];
---

<section id="advantage" class="py-24 bg-black text-white border-t border-white/5 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16">
    <!-- Header -->
    <div class="mb-16 text-center">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[11px] md:text-[12px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
        THE FACTORY ADVANTAGE
      </h3>
      <h2 class="text-[32px] md:text-[42px] font-bold text-white mb-6 font-['Montserrat',sans-serif] tracking-tight">
        Why Brands Choose Factory-Direct Manufacturing
      </h2>
      <p class="text-gray-400 max-w-3xl mx-auto text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        More and more activewear brands are choosing direct manufacturing instead of relying on marketplaces or middlemen. Enjoy factory-direct pricing, flexible customization, and reliable production from a trusted activewear partner.
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch relative">
      <!-- Left: Marketplace -->
      <div class="bg-[#111111] rounded-2xl border border-white/5 p-8 md:p-12 transition-all duration-300">
        <h4 class="text-gray-500 text-[14px] font-bold tracking-[0.2em] mb-12 uppercase font-['Century_Gothic',sans-serif]">
          Sourcing Through Marketplaces
        </h4>
        <div class="space-y-10">
          {marketplaceItems.map((item) => (
            <div class="flex gap-5">
              <svg class="w-4 h-4 text-red-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <div>
                <h5 class="text-white text-[16px] font-bold mb-1.5 font-['Montserrat',sans-serif]">{item.title}</h5>
                <p class="text-gray-500 text-[13px] leading-relaxed font-['Century_Gothic',sans-serif]">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Fitcloo Direct -->
      <div class="bg-[#111111] rounded-2xl border border-[#C9A84C]/20 p-8 md:p-12 relative shadow-[0_0_40px_rgba(201,168,76,0.05)] transition-all duration-300 overflow-hidden">
        <!-- Corner Ribbon Badge - Luxopack Style -->
        <div class="absolute top-0 right-0 w-32 h-32 overflow-hidden pointer-events-none">
          <div class="absolute top-7 -right-8 w-40 bg-[#C9A84C] py-1 rotate-45 text-center shadow-lg">
            <span class="text-black text-[10px] font-black uppercase tracking-widest font-['Century_Gothic',sans-serif]">
              Best Value
            </span>
          </div>
        </div>

        <h4 class="text-[#C9A84C] text-[14px] font-bold tracking-[0.2em] mb-12 uppercase font-['Century_Gothic',sans-serif]">
          Fitcloo Factory-Direct
        </h4>
        <div class="space-y-10">
          {fitclooItems.map((item) => (
            <div class="flex gap-5">
              <div class="w-4 h-4 bg-green-500 rounded-sm flex items-center justify-center mt-1 flex-shrink-0">
                <svg class="w-3 h-3 text-black" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h5 class="text-white text-[16px] font-bold mb-1.5 font-['Montserrat',sans-serif]">{item.title}</h5>
                <p class="text-gray-400 text-[13px] leading-relaxed font-['Century_Gothic',sans-serif]">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Text & CTA -->
    <div class="mt-20 text-center">
      <p class="text-gray-500 text-[14px] mb-8 font-['Century_Gothic',sans-serif]">
        Looking for a reliable activewear manufacturer? Fitcloo helps fitness brands launch and grow.
      </p>
      <a 
        href="#inquiry" 
        class="inline-block px-10 py-2.5 rounded-lg text-[13px] font-bold text-black bg-[#C9A84C] hover:bg-white transition-all duration-300 font-['Century_Gothic',sans-serif] tracking-[0.1em] shadow-[0_10px_20px_rgba(201,168,76,0.15)]"
      >
        Switch to Factory-Direct & Save →
      </a>
    </div>
  </div>
</section>
