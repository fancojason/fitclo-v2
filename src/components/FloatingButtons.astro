---
---

<!-- Floating Controls (WhatsApp Left, Quote Right) -->
<div class="floating-controls">
  <!-- WhatsApp Left -->
  <div class="whatsapp-container">
    <button 
      id="wa-trigger"
      class="whatsapp-float"
      aria-label="Contact on WhatsApp"
    >
      <img src="/images/whatsapp-icon.webp" class="wa-img" alt="WhatsApp" />
    </button>
    <span class="wa-tooltip font-['Century_Gothic',sans-serif]">Contact Us</span>
  </div>

<script>
  const waTrigger = document.getElementById('wa-trigger');
  if (waTrigger) {
    waTrigger.addEventListener('click', () => {
      const waUrl = "https://api.whatsapp.com/send?phone=8615218851638&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F";
      window.open(waUrl, '_blank');
    });
  }
</script>

  <!-- Quote Right -->
  <a href="#inquiry" class="quote-float group">
    <span>Get a Free Quote</span>
    <svg class="group-hover:translate-x-1 transition-transform" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
      <line x1="7" y1="7" x2="7.01" y2="7"></line>
    </svg>
  </a>
</div>

<style is:global>
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  @keyframes pulse-gold-subtle {
    0% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0.3); }
    70% { box-shadow: 0 0 0 12px rgba(201, 168, 76, 0); }
    100% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0); }
  }
  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  .floating-controls {
    position: fixed;
    bottom: 40px;
    left: 40px;
    right: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 9999;
    pointer-events: none;
  }

  .whatsapp-container {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
  }

  .wa-tooltip {
    position: absolute;
    left: 80px;
    background: #25D366;
    color: white;
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: normal;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .whatsapp-container:hover .wa-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* Add arrow to tooltip */
  .wa-tooltip::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 6px solid #25D366;
  }

  .whatsapp-float {
    cursor: pointer;
    border: none;
    outline: none;
    width: 60px;
    height: 60px;
    background-color: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    animation: wa-pulse 2s infinite;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.3);
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
  }
  .whatsapp-float .wa-img {
    width: 65%;
    height: 65%;
    object-fit: contain;
    animation: wiggle 3.5s ease-in-out infinite;
  }

  .quote-float {
    pointer-events: auto;
    background-color: #C9A84C;
    color: #06060a;
    padding: 0 32px;
    height: 54px;
    border-radius: 4px;
    font-family: 'Century_Gothic', sans-serif;
    font-weight: bold;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    animation: pulse-gold-subtle 2.5s infinite;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .quote-float:hover {
    transform: translateY(-6px);
    background-color: #d4b55a;
    box-shadow: 0 15px 35px rgba(201, 168, 76, 0.25);
  }

  @media (max-width: 768px) {
    .floating-controls {
      bottom: 24px;
      left: 20px;
      right: 20px;
    }
    .whatsapp-float {
      width: 52px;
      height: 52px;
    }
    .quote-float {
      height: 48px;
      padding: 0 24px;
      font-size: 11px;
      gap: 10px;
      letter-spacing: 0.08em;
    }
    .quote-float svg {
      width: 16px;
      height: 16px;
    }
  }
</style>
