---
---

<!-- Floating Controls (WhatsApp Left, Quote Right) -->
<div class="floating-controls">
  <!-- WhatsApp Left -->
  <a 
    href="https://api.whatsapp.com/send?phone=8615218851638&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F" 
    target="_blank" 
    class="whatsapp-float"
  >
    <img src="/images/whatsapp-icon.webp" class="wa-img" alt="WhatsApp" />
  </a>

  <!-- Quote Right -->
  <a href="#inquiry" class="quote-float">
    <span>Get a Free Quote</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
      <line x1="7" y1="7" x2="7.01" y2="7"></line>
    </svg>
  </a>
</div>

<style is:global>
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  @keyframes pulse-gold {
    0% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0.5); }
    70% { box-shadow: 0 0 0 15px rgba(201, 168, 76, 0); }
    100% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0); }
  }
  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  .floating-controls {
    position: fixed;
    bottom: 32px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 9999;
    pointer-events: none;
  }

  .whatsapp-float {
    pointer-events: auto;
    width: 64px;
    height: 64px;
    background-color: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    animation: wa-pulse 2s infinite;
    overflow: hidden;
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
  }
  .whatsapp-float .wa-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: wiggle 3.5s ease-in-out infinite;
  }

  .quote-float {
    pointer-events: auto;
    background-color: #C9A84C;
    color: #000000;
    padding: 0 28px;
    height: 52px;
    border-radius: 50px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 14.08px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-transform: none;
    letter-spacing: 0.5px;
    text-decoration: none;
    animation: pulse-gold 2.5s infinite;
    transition: all 0.3s ease;
  }
  .quote-float:hover {
    transform: translateY(-5px);
    background-color: #d4b55a;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  }

  @media (max-width: 768px) {
    .floating-controls {
      bottom: 20px;
      left: 15px;
      right: 15px;
    }
    .whatsapp-float {
      width: 56px;
      height: 56px;
    }
    .quote-float {
      height: 46px;
      padding: 0 20px;
      font-size: 12px;
      gap: 8px;
    }
    .quote-float svg {
      width: 16px;
      height: 16px;
    }
  }
</style>
