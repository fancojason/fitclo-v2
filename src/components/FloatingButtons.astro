---
import { getUi } from '../i18n/ui';
import type { SiteLanguage } from '../i18n/routes';

const language: SiteLanguage = Astro.props.lang === 'es' ? 'es' : 'en';
const ui = getUi(language);
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(ui.whatsappMessage)}`;
---

<!-- Floating Controls (WhatsApp Left, Quote Right) -->
<div class="floating-controls">
  <!-- WhatsApp Left -->
  <div class="whatsapp-container">
    <button 
      id="wa-trigger"
      class="whatsapp-float"
      aria-label={ui.floating.aria}
      data-wa-url={whatsappUrl}
      data-language={language}
    >
      <img src="/images/whatsapp-icon.webp" class="wa-img" alt="WhatsApp" />
    </button>
    <span class="wa-tooltip font-['Century_Gothic',sans-serif]">{ui.floating.tooltip}</span>
  </div>

<script>
  const waTrigger = document.getElementById('wa-trigger');
  if (waTrigger) {
    waTrigger.addEventListener('click', () => {
      const waUrl = waTrigger.dataset.waUrl;
      if (!waUrl) return;
      const analyticsWindow = window as Window & { dataLayer?: Array<Record<string, string>> };
      analyticsWindow.dataLayer?.push({ event: 'whatsapp_click', language: waTrigger.dataset.language || 'en', page_path: window.location.pathname });
      window.open(waUrl, '_blank');
    });
  }
</script>

  <!-- Quote Right -->
  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="quote-float" data-wa-quote data-language={language}>
    <span>{ui.floating.quote}</span>
  </a>
</div>

<style is:global>
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  @keyframes pulse-gold {
    0% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0.5); }
    70% { box-shadow: 0 0 0 15px rgba(201, 168, 76, 0); }
    100% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0); }
  }
  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  .floating-controls {
    position: fixed;
    bottom: 32px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 9999;
    pointer-events: none;
  }

  .whatsapp-container {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
  }

  .wa-tooltip {
    position: absolute;
    left: 80px;
    background: #25D366;
    color: white;
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: normal;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .whatsapp-container:hover .wa-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* Add arrow to tooltip */
  .wa-tooltip::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 6px solid #25D366;
  }

  .whatsapp-float {
    cursor: pointer;
    border: none;
    outline: none;
    width: 64px;
    height: 64px;
    background-color: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    animation: wa-pulse 2s infinite;
    overflow: hidden;
  }
  .whatsapp-float:hover {
    transform: scale(1.1);
  }
  .whatsapp-float .wa-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: wiggle 3.5s ease-in-out infinite;
  }

  .quote-float {
    pointer-events: auto;
    background: linear-gradient(135deg, #C9A84C, #E5C77A);
    color: #000000;
    padding: 0 28px;
    height: 46px;
    border-radius: 50px;
    font-family: 'Century_Gothic', sans-serif;
    font-weight: 800;
    font-size: 14.08px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-transform: none;
    letter-spacing: 0.5px;
    text-decoration: none;
    animation: pulse-gold 2.5s infinite;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .quote-float:hover {
    transform: scale(1.1);
    background-color: #d4b55a;
    box-shadow: 0 15px 30px rgba(201, 168, 76, 0.4);
  }

  @media (max-width: 768px) {
    .floating-controls {
      bottom: 20px;
      left: 15px;
      right: auto;
      width: calc(100vw - 30px);
      max-width: calc(100vw - 30px);
    }
    .whatsapp-float {
      width: 56px;
      height: 56px;
    }
    .quote-float {
      height: 46px;
      padding: 0 20px;
      font-size: 12px;
      gap: 8px;
    }
    .quote-float svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-wa-quote]').forEach((link) => {
    link.addEventListener('click', () => {
      const analyticsWindow = window as Window & { dataLayer?: Array<Record<string, string>> };
      analyticsWindow.dataLayer?.push({ event: 'whatsapp_click', language: link.dataset.language || 'en', page_path: window.location.pathname });
    });
  });
</script>
