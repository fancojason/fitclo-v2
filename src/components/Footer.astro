---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 pt-24 pb-12">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-16 lg:gap-24 mb-24">
      <!-- Brand Section -->
      <div class="lg:col-span-1">
        <div class="text-[28px] font-bold tracking-tighter text-black mb-8 font-['Century_Gothic',sans-serif]">
          FC | <span class="text-[#C9A84C]">FITCLO</span>
        </div>
        <p class="text-gray-500 text-[15px] leading-relaxed max-w-xs font-['Century_Gothic',sans-serif] mb-8">
          Premium Private Label Activewear Manufacturer. From R&D to Global Fulfillment, we power the next generation of athletic brands.
        </p>
        <div class="flex space-x-6">
          <a href="#" class="text-gray-400 hover:text-[#C9A84C] transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </a>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="lg:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-12">
        <div>
          <h4 class="text-[13px] font-bold tracking-[0.2em] uppercase text-[#C9A84C] mb-8 font-['Century_Gothic',sans-serif]">
            Services
          </h4>
          <ul class="space-y-4">
            <li><a href="/products" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Core Collections</a></li>
            <li><a href="/private-label" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Private Label</a></li>
            <li><a href="/ready-to-ship" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Wholesale Solutions</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[13px] font-bold tracking-[0.2em] uppercase text-[#C9A84C] mb-8 font-['Century_Gothic',sans-serif]">
            Company
          </h4>
          <ul class="space-y-4">
            <li><a href="/about" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Our Factory</a></li>
            <li><a href="/certifications" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Certifications</a></li>
            <li><a href="/contact" class="text-gray-500 hover:text-black transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Contact Us</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[13px] font-bold tracking-[0.2em] uppercase text-[#C9A84C] mb-8 font-['Century_Gothic',sans-serif]">
            Contact
          </h4>
          <ul class="space-y-4">
            <li class="text-gray-500 text-[14px] font-['Century_Gothic',sans-serif]">sales@fitcloo.com</li>
            <li class="text-gray-500 text-[14px] font-['Century_Gothic',sans-serif]">Xiamen, China</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-12 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center text-[11px] font-bold tracking-[0.1em] uppercase font-['Century_Gothic',sans-serif] text-gray-400">
      <p>© {year} FITCLO APPAREL MFG. ALL RIGHTS RESERVED.</p>
    </div>
  </div>
</footer>