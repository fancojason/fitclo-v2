---
import { productCategories } from '../data/productCategories';

const year = new Date().getFullYear();
const footerCategories = [
  productCategories.find((category) => category.slug === 'matching-sets'),
  productCategories.find((category) => category.slug === 'sports-bras'),
  productCategories.find((category) => category.slug === 'leggings'),
  productCategories.find((category) => category.slug === 'gym-shorts'),
].filter(Boolean);
---

<footer class="bg-[#06060a] pt-24 pb-12 relative overflow-hidden">
  <!-- Subtle Gradient Border -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#C9A84C]/30 to-transparent"></div>

  <div class="max-w-[1700px] mx-auto px-6 lg:px-16 relative">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-16 lg:gap-24 mb-16">
      <!-- Brand & Newsletter Section -->
      <div class="lg:col-span-1">
        <div class="flex items-center space-x-2 mb-6">
          <div class="w-5 h-5 flex items-center justify-center select-none">
            <img src="/images/migrated/third-party/h8f27abddb40d4300874f693d698ed50dd-cadc7ea119.webp" alt="FITCLO Logo" class="w-full h-full object-contain" />
          </div>
          <div class="h-4 w-[1px] bg-white/20"></div>
          <div class="text-[20px] font-bold tracking-[0.1em] text-white font-['Century_Gothic',sans-serif] uppercase">
            Fit<span class="text-[#C9A84C]">clo</span>
          </div>
        </div>
        <p class="text-white/60 text-[15px] leading-relaxed max-w-xs font-['Century_Gothic',sans-serif] mb-6">
          China's trusted factory-direct manufacturer of premium activewear. Serving 500+ brands worldwide since 2010.
        </p>

        <!-- Minimal Newsletter -->
        <div class="max-w-xs relative group">
          <input
            type="email"
            placeholder="Subscribe for factory updates"
            class="w-full bg-transparent border-b border-white/20 py-3 text-[14px] text-white focus:outline-none focus:border-[#C9A84C] transition-colors font-['Century_Gothic',sans-serif] placeholder:text-white/40"
          />
          <button class="absolute right-0 top-1/2 -translate-y-1/2 text-[#C9A84C] hover:translate-x-1 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="lg:col-span-3 grid grid-cols-2 md:grid-cols-4 gap-12">
        <div>
          <h4 class="text-[14px] font-bold tracking-[0.05em] uppercase text-[#C9A84C] mb-4 font-['Century_Gothic',sans-serif]">
            Resources
          </h4>
          <ul class="space-y-2.5">
            {['B2B Insights Blog', 'Price Guide', 'MOQ Guide', 'Certifications'].map((item) => (
              <li>
                <a href={item === 'B2B Insights Blog' ? '/blogs' : item === 'Price Guide' ? '/blogs/pricing' : item === 'MOQ Guide' ? '/blogs/moq' : '/about'}
                   class="inline-block text-white/60 hover:text-white hover:translate-x-1 transition-all text-[14px] font-['Century_Gothic',sans-serif]">
                  {item}
                </a>
              </li>
            ))}
          </ul>

        </div>

        <div>
          <h4 class="text-[14px] font-bold tracking-[0.05em] uppercase text-[#C9A84C] mb-4 font-['Century_Gothic',sans-serif]">
            Top Categories
          </h4>
          <ul class="space-y-2.5">
            {footerCategories.map((category) => (
              <li>
                <a href={`/products/${category!.slug}/`} class="inline-block text-white/60 hover:text-white hover:translate-x-1 transition-all text-[14px] font-['Century_Gothic',sans-serif]">
                  {category!.navLabel}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-[14px] font-bold tracking-[0.05em] uppercase text-[#C9A84C] mb-4 font-['Century_Gothic',sans-serif]">
            Company
          </h4>
          <ul class="space-y-2.5">
            {['About Us', 'FAQ & Support', 'Consult Expert'].map((item) => (
              <li>
                <a href={item === 'About Us' ? '/about' : 'https://api.whatsapp.com/send?phone=8617160837538&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F'} target={item === 'Consult Expert' ? "_blank" : "_self"} class="inline-block text-white/60 hover:text-white hover:translate-x-1 transition-all text-[14px] font-['Century_Gothic',sans-serif]">
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-[14px] font-bold tracking-[0.05em] uppercase text-[#C9A84C] mb-4 font-['Century_Gothic',sans-serif]">
            Contact
          </h4>
          <ul class="space-y-2.5">
            <li>
              <a href="/inquiry/" class="inline-block text-white/60 hover:text-white hover:translate-x-1 transition-all text-[14px] font-['Century_Gothic',sans-serif]">
                Request a Quote
              </a>
            </li>
            <li class="text-white/60 text-[14px] font-['Century_Gothic',sans-serif] flex items-center">
              <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-3 animate-pulse"></span>
              sales@fitcloo.com
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[11px] font-black tracking-[0.1em] uppercase font-['Century_Gothic',sans-serif] text-white/40">
      <p>© {year} FITCLO APPAREL MFG. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 md:mt-0 flex items-center space-x-6">
        <span>Global Support: 24/7 Available</span>
        <div class="flex space-x-4">
          <a href="#" class="hover:text-white transition-colors">LinkedIn</a>
          <a href="#" class="hover:text-white transition-colors">Instagram</a>
        </div>
      </div>
    </div>
  </div>
</footer>
