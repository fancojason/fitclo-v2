          <li>sales@fitclo.com</li>
          <li>+86 (592) 888 9999</li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-gray-50 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-400">
      <p>© {year} FITCLO Apparel. All rights reserved.</p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a href="#" class="hover:text-gray-600">Privacy Policy</a>
        <a href="#" class="hover:text-gray-600">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
