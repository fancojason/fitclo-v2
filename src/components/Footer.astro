---
const year = new Date().getFullYear();
---
<footer class="bg-white border-t border-gray-100 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-1 md:col-span-2">
        <div class="text-2xl font-bold tracking-tighter text-primary mb-6">FITCLO</div>
        <p class="text-gray-500 max-w-sm leading-relaxed mb-6">
          Premium Private Label Activewear Manufacturer. From R&D to Global Fulfillment, we power the next generation of athletic brands.
        </p>
        <div class="flex space-x-4">
          <!-- Social Icons Placeholder -->
        </div>
      </div>
      
      <div>
        <h4 class="font-bold mb-6">Capabilities</h4>
        <ul class="space-y-4 text-gray-500 text-sm">
          <li><a href="/capabilities" class="hover:text-accent">OEM/ODM Service</a></li>
          <li><a href="/capabilities" class="hover:text-accent">Custom Fabric R&D</a></li>
          <li><a href="/capabilities" class="hover:text-accent">Sample Development</a></li>
          <li><a href="/capabilities" class="hover:text-accent">Quality Control</a></li>
        </ul>
