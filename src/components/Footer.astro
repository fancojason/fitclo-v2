            <li><a href="/products" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Core Collections</a></li>
            <li><a href="/private-label" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Private Label</a></li>
            <li><a href="/ready-to-ship" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Wholesale Solutions</a></li>
            <li><a href="/capabilities" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Fabric Sourcing</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[13px] font-bold tracking-[0.2em] uppercase text-[#C9A84C] mb-8 font-['Century_Gothic',sans-serif]">
            Company
          </h4>
          <ul class="space-y-4">
            <li><a href="/about" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Our Factory</a></li>
            <li><a href="/certifications" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Certifications</a></li>
            <li><a href="/how-it-works" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Process</a></li>
            <li><a href="/contact" class="text-white/50 hover:text-white transition-colors text-[14px] font-['Century_Gothic',sans-serif]">Contact Us</a></li>
          </ul>
        </div>

        <div class="col-span-2 md:col-span-1">
          <h4 class="text-[13px] font-bold tracking-[0.2em] uppercase text-[#C9A84C] mb-8 font-['Century_Gothic',sans-serif]">
            Contact Us
          </h4>
          <ul class="space-y-4">
            <li class="text-white/50 text-[14px] font-['Century_Gothic',sans-serif]">
              Factory Add: No. 128, Industrial Zone, Xiamen, Fujian, China
            </li>
            <li class="text-white/50 text-[14px] font-['Century_Gothic',sans-serif]">
              Email: sales@fitcloo.com
            </li>
            <li class="text-white/50 text-[14px] font-['Century_Gothic',sans-serif]">
              WhatsApp: +86 123 4567 8910
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[11px] font-bold tracking-[0.1em] uppercase font-['Century_Gothic',sans-serif] text-white/20">
      <p>© {year} FITCLO APPAREL MFG. ALL RIGHTS RESERVED.</p>
      <div class="flex space-x-8 mt-6 md:mt-0">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
