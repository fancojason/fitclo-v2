---
const countries = [
  { name: "USA", code: "us" },
  { name: "Canada", code: "ca" },
  { name: "UK", code: "gb" },
  { name: "Australia", code: "au" },
  { name: "Germany", code: "de" },
  { name: "France", code: "fr" },
  { name: "Spain", code: "es" },
  { name: "Italy", code: "it" },
  { name: "Netherlands", code: "nl" },
  { name: "Russia", code: "ru" },
  { name: "Mexico", code: "mx" },
  { name: "Costa Rica", code: "cr" },
  { name: "Honduras", code: "hn" },
  { name: "Japan", code: "jp" },
  { name: "South Korea", code: "kr" },
  { name: "Singapore", code: "sg" },
  { name: "UAE", code: "ae" },
  { name: "Saudi Arabia", code: "sa" },
  { name: "Israel", code: "il" },
  { name: "Brazil", code: "br" },
  { name: "Norway", code: "no" },
  { name: "Sweden", code: "se" },
  { name: "New Zealand", code: "nz" }
];
---

<section id="global-presence" class="py-16 bg-[#050505] overflow-hidden font-['Century_Gothic',sans-serif]">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="relative bg-[#0B0B0B] rounded-[32px] border border-white/5 p-8 md:p-16 overflow-hidden">
      <!-- Background Map Texture (SVG Placeholder) -->
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid slice">
          <path fill="currentColor" d="M150,150 Q200,100 250,150 T350,150" />
          <circle cx="200" cy="200" r="2" fill="#C9A84C" class="animate-pulse" />
          <circle cx="450" cy="150" r="3" fill="#C9A84C" class="animate-pulse" style="animation-delay: 1s" />
          <circle cx="700" cy="250" r="2" fill="#C9A84C" class="animate-pulse" style="animation-delay: 0.5s" />
          <circle cx="850" cy="180" r="4" fill="#C9A84C" class="animate-pulse" style="animation-delay: 1.5s" />
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="max-w-xl">
          <h3 class="text-[32px] md:text-[38px] font-bold text-white mb-6 leading-tight">
            Serving Brands <br/> <span class="text-[#C9A84C]">Worldwide</span>
          </h3>
          <p class="text-[#A3A3A3] text-[15px] leading-relaxed mb-8">
            Fitclo partners with activewear brands, distributors and retailers across multiple continents, providing ready-to-ship and private label solutions.
          </p>
          <div class="flex flex-wrap gap-3">
            {countries.map(c => (
              <div class="group relative cursor-help">
                <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-[#C9A84C]/30 group-hover:border-[#C9A84C] transition-all duration-300 shadow-[0_0_15px_rgba(201,168,76,0.1)]">
                  <img 
                    src={`https://flagcdn.com/w80/${c.code}.png`} 
                    alt={c.name}
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                  />
                </div>
                <!-- Tooltip for Country Name -->
                <div class="absolute -bottom-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-black/90 text-white text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-[#C9A84C]/20 z-20">
                  {c.name}
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Trust Badge / Visual (Back to right side) -->
        <div class="hidden md:block relative w-[240px] h-[240px] flex-shrink-0">
           <div class="absolute inset-0 bg-[#C9A84C]/5 rounded-full blur-[60px]"></div>
           <div class="absolute inset-0 flex items-center justify-center">
             <div class="w-full h-full border border-[#C9A84C]/10 rounded-full animate-spin-slow"></div>
             <div class="absolute w-4/5 h-4/5 border border-[#C9A84C]/5 rounded-full animate-reverse-spin"></div>
             <div class="absolute text-center">
                <div class="text-[54px] font-black text-[#C9A84C] leading-none">50+</div>
                <div class="text-[11px] font-bold tracking-[0.2em] text-white/50 uppercase mt-2">Countries Served</div>
             </div>
           </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes reverse-spin {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
  .animate-reverse-spin {
    animation: reverse-spin 15s linear infinite;
  }
</style>
