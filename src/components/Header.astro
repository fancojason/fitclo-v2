---
const navItems = [
  { name: 'PRODUCTS', href: '/products' },
  { name: 'READY TO SHIP', href: '/ready-to-ship' },
  { name: 'PRIVATE LABEL', href: '/private-label' },
  { name: 'MANUFACTURING', href: '/capabilities' },
];
---

<header class="fixed w-full z-50 bg-[#06060a]/92 backdrop-blur-md border-b border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between items-center h-[68px]">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-3 group">
          <!-- Exact Luxopack Style Logo Symbol -->
          <div class="flex items-center">
            <div class="border-2 border-white px-1 py-0.5 mr-1">
               <span class="text-white font-black text-sm">F</span>
            </div>
            <div class="border-2 border-accent px-1 py-0.5 -ml-2 bg-[#06060a]">
               <span class="text-accent font-black text-sm">C</span>
            </div>
          </div>
          <!-- Exact Luxopack Style Logo Text -->
          <div class="text-[18px] font-bold tracking-[0.1em] uppercase flex">
            <span class="text-white">FIT</span>
            <span class="text-accent">CLO</span>
          </div>
        </a>
      </div>
      <nav class="hidden md:flex space-x-7">
        {navItems.map(item => (
          <a href={item.href} class="text-[13.6px] font-semibold text-white/70 hover:text-white transition-colors uppercase tracking-[0.8px]">
            {item.name}
          </a>
        ))}
      </nav>
      <div class="md:hidden">
        <!-- Mobile menu button -->
      </div>
    </div>
  </div>
</header>
