---
const navItems = [
  { name: 'Products', href: '/products' },
  { name: 'Ready to Ship', href: '/ready-to-ship' },
  { name: 'Private Label', href: '/private-label' },
  { name: 'Manufacturing', href: '/capabilities' },
  { name: 'About Us', href: '/about' },
];
---

<header class="fixed w-full z-50 bg-black border-b border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between items-center h-[68px]">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-4 group">
          <!-- Reverted FC | Icon Part -->
          <div class="flex items-center font-black text-2xl tracking-tighter border-r border-white/50 pr-4 font-['Century_Gothic',sans-serif]">
            <span class="text-white">F</span>
            <span class="text-accent">C</span>
          </div>
          <!-- Reverted Logo Text Part -->
          <div class="text-[18px] font-black tracking-[0.2em] flex uppercase font-['Century_Gothic',sans-serif]">
            <span class="text-white">FIT</span>
            <span class="text-accent">CLO</span>
          </div>
        </a>
      </div>
      <nav class="hidden md:flex space-x-8 items-center">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="relative text-[15px] font-bold text-white/90 hover:text-[#C9A84C] transition-all duration-300 tracking-[1px] font-['Century_Gothic',sans-serif] pb-1.5 group"
          >
            {item.name}
            <!-- Luxurious Luxopack-style underline slider expanding from center -->
            <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#C9A84C] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
          </a>
        ))}
      </nav>
      <div class="md:hidden">
        <!-- Mobile menu button -->
      </div>
    </div>
  </div>
</header>
