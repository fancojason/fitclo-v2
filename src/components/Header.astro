---
const navItems = [
  { name: 'Products', href: '/products' },
  { name: 'Ready to Ship', href: '/ready-to-ship' },
  { name: 'Private Label', href: '/private-label' },
  { name: 'Manufacturing', href: '/capabilities' },
  { name: 'About Us', href: '/about' },
];

---

<header class="fixed w-full top-0 left-0 z-50 bg-black/95 backdrop-blur-md">
  <!-- Top Navigation Gold Gradient Line -->
  <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#C9A84C] to-transparent opacity-60"></div>
  
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between items-center h-[80px]">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-2 group no-underline">
          <div class="relative w-5 h-5 flex items-center justify-center select-none">
            <img src="https://sc01.alicdn.com/kf/H8f27abddb40d4300874f693d698ed50dd.png" alt="FITCLO Logo" class="w-full h-full object-contain brightness-110 transition-all group-hover:brightness-125" />
          </div>
          <div class="h-4 w-[1px] bg-white/30"></div>
          <div class="text-[20px] font-bold tracking-[0.1em] text-white font-['Century_Gothic',sans-serif] uppercase select-none flex items-center transition-all group-hover:text-white/90">
            Fit<span class="text-[#C9A84C] brightness-110">clo</span>
          </div>
        </a>
      </div>
      <nav class="hidden md:flex space-x-10 items-center">
        {navItems.map(item => (
          <a href={item.href} class="relative text-[17px] font-normal text-white/90 hover:text-[#C9A84C] hover:translate-y-[-2px] transition-all duration-300 tracking-[0.5px] font-['Century_Gothic',sans-serif] pb-1.5 group">
            {item.name}
            <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#C9A84C] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
          </a>
        ))}
        
        <!-- Language Selector Wrapper -->
        <div id="google_translate_element" class="opacity-0 w-0 h-0 overflow-hidden absolute"></div>
        <div class="relative group/lang flex items-center cursor-pointer ml-4 pl-4 border-l border-white/10">
          <svg class="w-4 h-4 text-white/60 group-hover/lang:text-[#C9A84C] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9-9H3m9 9L3 12m0 0l9-9m-9 9h18" />
          </svg>
          <span class="ml-2 text-[14px] font-bold text-white/60 group-hover/lang:text-white transition-colors font-['Century_Gothic',sans-serif] uppercase tracking-wider">EN</span>
          
          <!-- Dropdown simulation using Google Translate widget triggers -->
          <div class="absolute top-full right-0 mt-2 py-2 w-48 bg-[#0A0A0F] border border-white/10 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all duration-300 translate-y-2 group-hover/lang:translate-y-0 z-[60]">
            <div class="px-4 py-2 text-[11px] text-[#C9A84C] font-bold tracking-widest uppercase border-b border-white/5 mb-2">Select Language</div>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|en')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">English</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|fr')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Français</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|de')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Deutsch</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|es')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Español</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|it')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Italiano</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|pt')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Português</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|ru')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">Pусский</a>
            <a href="javascript:void(0)" onclick="window.doGTranslate('en|ar')" class="block px-4 py-2 text-[13px] text-white/80 hover:bg-white/5 hover:text-white transition-colors">العربية</a>
          </div>
        </div>
      </nav>
      <div class="md:hidden"></div>
    </div>
  </div>
</header>
