---
const navItems = [
  { name: 'PRODUCTS', href: '/products' },
  { name: 'READY TO SHIP', href: '/ready-to-ship' },
  { name: 'PRIVATE LABEL', href: '/private-label' },
  { name: 'MANUFACTURING', href: '/capabilities' },
  { name: 'ABOUT US', href: '/about' },
];
---

<header class="fixed w-full z-50 bg-[#06060a]/92 backdrop-blur-md border-b border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between items-center h-[68px]">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-4 group">
          <!-- Reverted FC| Icon Part -->
          <div class="flex items-center font-black text-2xl tracking-tighter border-r border-white/50 pr-4 font-['Montserrat',sans-serif]">
            <span class="text-white">F</span>
            <span class="text-accent">C</span>
          </div>
          <!-- Reverted Logo Text Part -->
          <div class="text-[18px] font-black tracking-[0.2em] flex uppercase font-['Montserrat',sans-serif]">
            <span class="text-white">FIT</span>
            <span class="text-accent">CLO</span>
          </div>
        </a>
      </div>
      <nav class="hidden md:flex space-x-7">
        {navItems.map(item => (
          <a href={item.href} class="text-[13.6px] font-semibold text-white/90 hover:text-white transition-colors uppercase tracking-[0.8px]">
            {item.name}
          </a>
        ))}
      </nav>
      <div class="md:hidden">
        <!-- Mobile menu button -->
      </div>
    </div>
  </div>
</header>
