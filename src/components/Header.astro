---
const navItems = [
  { name: 'PRODUCTS', href: '/products' },
  { name: 'READY TO SHIP', href: '/ready-to-ship' },
  { name: 'PRIVATE LABEL', href: '/private-label' },
  { name: 'MANUFACTURING', href: '/capabilities' },
];
---

<header class="fixed w-full z-50 bg-black/95 backdrop-blur-sm border-b border-white/5 py-1">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center space-x-4 group">
          <!-- Icon Part -->
          <div class="flex items-center font-black text-2xl tracking-tighter border-r border-white/20 pr-4">
            <span class="text-white">F</span>
            <span class="text-accent">C</span>
          </div>
          <!-- Text Part -->
          <div class="text-lg font-extrabold tracking-[0.4em] flex uppercase">
            <span class="text-white">FIT</span>
            <span class="text-accent">CLO</span>
          </div>
        </a>
      </div>
      <nav class="hidden md:flex space-x-12">
        {navItems.map(item => (
          <a href={item.href} class="text-[12px] font-bold text-gray-300 hover:text-accent transition-all tracking-[0.25em]">
            {item.name}
          </a>
        ))}
      </nav>
      <div class="md:hidden">
        <!-- Mobile menu button -->
      </div>
    </div>
  </div>
</header>
