---
const navItems = [
  { name: 'Products', href: '/#products' },
  { name: 'OEM/ODM', href: '/capabilities' },
  { name: 'About Factory', href: '/#factory' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold tracking-tighter text-primary">FITCLO</a>
      </div>
      <nav class="hidden md:flex space-x-8">
        {navItems.map(item => (
          <a href={item.href} class="text-sm font-medium text-gray-700 hover:text-accent transition-colors">
            {item.name}
          </a>
        ))}
      </nav>
      <div class="flex items-center space-x-4">
        <a href="/contact" class="bg-primary text-white px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-gray-800 transition-all shadow-lg shadow-black/5">
          Get Quote
        </a>
      </div>
    </div>
  </div>
</header>
