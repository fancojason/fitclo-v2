---
---
<section class="relative h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img 
      src="https://sc02.alicdn.com/kf/Adcc3c273ddd64a769249c8750f200979L.png" 
      alt="Premium Activewear" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
    <div class="max-w-2xl">
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-[1.1]">
        Manufacturing Activewear That <span class="text-accent italic">Moves Brands Forward.</span>
      </h1>
      <p class="text-xl text-gray-200 mb-10 max-w-xl">
        Private Label Activewear Manufacturer for Growing and Established Brands. Low MOQ (50 pcs) & Ready-To-Ship Solutions.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#inquiry" class="bg-accent text-white px-8 py-4 rounded-full text-lg font-bold hover:scale-105 transition-transform text-center shadow-xl shadow-accent/20">
          Inquire Factory Price
        </a>
        <a href="/ready-to-ship" class="backdrop-blur-md bg-white/10 border border-white/20 text-white px-8 py-4 rounded-full text-lg font-bold hover:bg-white/20 transition-all text-center">
          Ready-To-Ship Program
        </a>
      </div>
    </div>
  </div>
  
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
