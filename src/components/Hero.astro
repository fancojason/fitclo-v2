---
---
<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-[#06060a]">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://sc01.alicdn.com/kf/H884ba8683a5149558bb5623a0bc673b8T.png" 
      alt="Fitclo Factory" 
      class="w-full h-full object-cover"
    />
    <!-- Subtle gradient to ensure text readability on the left -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#06060a] via-[#06060a]/40 to-transparent"></div>
  </div>
  
  <div class="relative z-10 max-w-[1600px] mx-auto px-6 lg:px-10 w-full">
    <div class="max-w-[700px]">
      <!-- Top Small Tag (Luxopack Exact Match) -->
      <div class="badge inline-flex items-center px-[16px] py-[7px] border border-[rgba(201,168,76,0.4)] rounded-full bg-[rgba(201,168,76,0.1)] mb-[28px] animate-fade-in">
        <div class="pulse-dot"></div>
        <span class="text-[12px] font-[700] tracking-[2.5px] text-[#C9A84C] uppercase font-['Inter',sans-serif]">
          PRIVATE LABEL ACTIVEWEAR MANUFACTURER • SINCE 2010
        </span>
      </div>

      <!-- Main Heading (Luxopack Exact Typography) -->
      <h1 class="text-[40px] md:text-[51.2px] font-[900] leading-[1.1] mb-8 uppercase tracking-[-1px] font-['Montserrat',sans-serif] text-white">
        BUILD YOUR ACTIVEWEAR BRAND WITH FITCLO
      </h1>

      <!-- Subtitle (Luxopack Exact Typography) -->
      <div class="animate-fade-in" style="animation-delay: 0.2s">
        <p class="text-[18px] md:text-[20px] font-[400] text-[rgba(255,255,255,0.8)] mb-[32px] leading-[1.6] font-['Inter',sans-serif]">
          Custom Yoga Wear, Gym Wear & Athleisure Manufactured with Your Logo and Packaging.
        </p>
      </div>

      <!-- Value Props line -->
      <div class="flex items-center space-x-4 mb-10 animate-fade-in" style="animation-delay: 0.3s">
        <span class="text-[13px] font-extrabold tracking-[1px] text-[#C9A84C] uppercase font-['Montserrat',sans-serif]">
          MOQ from 100 pcs • Fast Sampling • Premium Quality
        </span>
      </div>

      <!-- Trust Badges Row (Luxopack Exact Pill Styles) -->
      <div class="flex flex-wrap gap-3 mb-16 animate-fade-in" style="animation-delay: 0.4s">
        {[
          { label: "MOQ:", value: "100 pcs", icon: "📦" },
          { label: "Sample in", value: "7 Days", icon: "⚡" },
          { label: "Ship", value: "Worldwide", icon: "🌍" },
          { label: "Free", value: "Design Support", icon: "🎨" }
        ].map(badge => (
          <div class="flex items-center space-x-2 bg-[rgba(255,255,255,0.07)] border border-[rgba(255,255,255,0.12)] px-[20px] py-[10px] rounded-full hover:bg-[rgba(255,255,255,0.12)] transition-all group cursor-default">
            <span class="text-sm">{badge.icon}</span>
            <span class="text-[12.8px] text-[rgba(255,255,255,0.8)] font-medium font-['Inter',sans-serif]">
              {badge.label} <strong class="text-[#C9A84C] font-[700] uppercase tracking-wider ml-1">{badge.value}</strong>
            </span>
          </div>
        ))}
      </div>

      <!-- Main CTA (Luxopack Exact Button Style) -->
      <div class="flex flex-col sm:flex-row items-center gap-8 animate-fade-in" style="animation-delay: 0.5s">
        <a href="#inquiry" class="group relative inline-flex items-center space-x-4 bg-[#C9A84C] text-[#0A0A0F] px-[36px] py-[16px] rounded-[4px] text-[16px] font-[900] uppercase tracking-wider transition-all hover:scale-[1.02] hover:bg-[#d4b55a] active:scale-95 shadow-[0_15px_30px_rgba(201,168,76,0.2)] font-['Montserrat',sans-serif]">
          <span class="relative z-10">Get Factory Pricing (Save 30-50%)</span>
          <svg class="w-5 h-5 relative z-10 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a href="#factory" class="group flex items-center space-x-3 text-[13px] font-bold uppercase tracking-[0.2em] text-white/40 hover:text-white transition-colors font-['Inter',sans-serif]">
          <span>Explore Factory</span>
          <div class="w-8 h-[1px] bg-white/20 group-hover:w-12 group-hover:bg-accent transition-all"></div>
        </a>
      </div>
    </div>
  </div>

  <!-- Luxopack Style Bottom Edge Decoration -->
  <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-[#06060a] to-transparent z-20"></div>
</section>

<style>
  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #C9A84C;
    border-radius: 50%;
    margin-right: 8px;
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .animate-fade-in {
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
