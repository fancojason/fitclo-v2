---
---
<section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-black">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://sc01.alicdn.com/kf/H9bae128272be49cc9736aad6ad51f06bV.png" 
      alt="Fitclo Factory" 
      class="w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-black/80"></div>
  </div>
  
  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 text-center text-white">
    <!-- Top Small Tag -->
    <div class="inline-block px-4 py-1.5 border border-accent/30 rounded-full bg-accent/5 mb-8 animate-fade-in">
       <span class="text-[11px] md:text-[13px] font-bold tracking-[0.25em] text-accent uppercase">
         PRIVATE LABEL ACTIVEWEAR MANUFACTURER • SINCE 2010
       </span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-[42px] md:text-[86px] lg:text-[100px] font-black leading-[1] mb-8 uppercase tracking-[-0.04em] font-['Montserrat',sans-serif]">
      BUILD YOUR <span class="text-accent italic">ACTIVEWEAR</span> BRAND WITH FITCLO
    </h1>

    <!-- Subtitle -->
    <div class="animate-fade-in" style="animation-delay: 0.2s">
      <p class="text-[18px] md:text-[24px] font-medium text-white/90 max-w-4xl mx-auto mb-6 leading-relaxed">
        Custom Yoga Wear, Gym Wear & Athleisure<br/>
        <span class="text-white/70">Manufactured with Your Logo and Packaging.</span>
      </p>
    </div>

    <!-- Value Props line -->
    <p class="text-[14px] md:text-[16px] font-bold tracking-[0.1em] text-accent uppercase mb-12 animate-fade-in" style="animation-delay: 0.3s">
      MOQ from 100 pcs • Fast Sampling • Premium Quality
    </p>

    <!-- Trust Badges Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 max-w-5xl mx-auto mb-16 animate-fade-in" style="animation-delay: 0.4s">
      {[
        { text: "MOQ: 100 pcs", icon: "📦" },
        { text: "Sample in 7 Days", icon: "⚡" },
        { text: "Ship Worldwide", icon: "🌍" },
        { text: "Free Design Support", icon: "🎨" }
      ].map(badge => (
        <div class="flex items-center justify-center space-x-3 bg-white/5 backdrop-blur-sm border border-white/10 px-6 py-4 rounded-2xl hover:bg-white/10 transition-all group">
          <span class="text-lg group-hover:scale-125 transition-transform">{badge.icon}</span>
          <span class="text-[13px] font-bold tracking-wider uppercase">{badge.text}</span>
        </div>
      ))}
    </div>

    <!-- Main CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in" style="animation-delay: 0.5s">
      <a href="#inquiry" class="group relative inline-flex items-center space-x-4 bg-accent text-black px-10 py-5 rounded-full text-[16px] font-black uppercase tracking-wider overflow-hidden transition-all hover:scale-105 active:scale-95 shadow-[0_0_40px_rgba(201,168,76,0.3)]">
        <span class="relative z-10">Get Factory Pricing (Save 30-50%)</span>
        <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a href="#factory" class="text-[14px] font-bold uppercase tracking-[0.2em] text-white/50 hover:text-white transition-colors">
        Take a Factory Tour
      </a>
    </div>
  </div>

  <!-- Animated Scroll Down -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center space-y-4 opacity-50">
    <span class="text-[10px] font-bold tracking-[0.4em] uppercase">Scroll</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-accent to-transparent"></div>
  </div>
</section>

<style>
  .animate-fade-in {
    animation: fadeIn 1s ease-out backwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
