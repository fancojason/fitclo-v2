---
---
<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-[#06060a]">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://sc01.alicdn.com/kf/H884ba8683a5149558bb5623a0bc673b8T.png" 
      alt="Fitclo 16,000sqm China Activewear Factory Production Line - Private Label Manufacturer" 
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- Subtle gradient to ensure text readability on the left -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#06060a] via-[#06060a]/40 to-transparent"></div>
  </div>
  
  <div class="relative z-10 max-w-[1600px] mx-auto px-6 lg:px-10 w-full antialiased text-white">
    <div class="max-w-[800px]">
      <!-- Top Small Tag -->
      <div class="badge inline-flex items-center px-[16px] py-[7px] border border-[rgba(201,168,76,0.4)] rounded-full bg-[rgba(201,168,76,0.1)] mb-[28px] animate-fade-in">
        <div class="pulse-dot"></div>
        <span class="text-[13px] font-[700] tracking-[1px] text-[#C9A84C] font-['Century_Gothic',sans-serif] uppercase">
          CHINA'S #1 ACTIVEWEAR MANUFACTURER · EST. 2010
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-[42px] md:text-[64px] font-[700] leading-[1.05] mb-[32px] uppercase tracking-[-0.04em] font-['Century_Gothic',sans-serif]">
        PRIVATE LABEL<br />
        <span class="text-[#C9A84C] italic">ACTIVEWEAR</span><br />
        MANUFACTURER<br />
        IN CHINA
      </h1>

      <!-- Subtitle -->
      <div class="animate-fade-in" style="animation-delay: 0.2s">
        <p class="text-[18px] md:text-[21px] font-[400] text-[rgba(255,255,255,0.85)] mb-[36px] max-w-xl leading-[1.6] font-['Century_Gothic',sans-serif]">
          Custom Yoga Wear, Gym Wear & Athleisure Manufactured with Your Logo and Professional Branding.
        </p>
      </div>

      <!-- Value Props line -->
      <div class="flex items-center space-x-4 mb-[36px] animate-fade-in" style="animation-delay: 0.3s">
        <span class="text-[14px] font-[700] tracking-[0.5px] text-[#C9A84C] font-['Century_Gothic',sans-serif]">
          MOQ From 100 Pcs • Fast Sampling • Premium Quality
        </span>
      </div>

      <!-- Trust Badges Row -->
      <div class="flex flex-wrap gap-3 mb-[36px] animate-fade-in" style="animation-delay: 0.4s">
        {[
          { label: "Moq:", value: "100 Pcs", icon: "📦" },
          { label: "Sample In", value: "7 Days", icon: "⚡" },
          { label: "Ship", value: "Worldwide", icon: "🌍" },
          { label: "Free", value: "Design Support", icon: "🎨" }
        ].map(badge => (
          <div class="flex items-center space-x-2 bg-[rgba(255,255,255,0.07)] border border-[rgba(255,255,255,0.12)] px-[20px] py-[10px] rounded-full hover:bg-[rgba(255,255,255,0.12)] transition-all group cursor-default">
            <span class="text-sm">{badge.icon}</span>
            <span class="text-[13px] text-[rgba(255,255,255,0.85)] font-bold font-['Century_Gothic',sans-serif]">
              {badge.label} <strong class="text-[#C9A84C] font-[700] ml-1">{badge.value}</strong>
            </span>
          </div>
        ))}
      </div>

      <!-- Main CTA -->
      <div class="flex flex-col sm:flex-row items-center gap-8 animate-fade-in" style="animation-delay: 0.5s">
        <a href="https://api.whatsapp.com/send?phone=8617160837538&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F" target="_blank" class="group relative inline-flex items-center space-x-4 bg-[#C9A84C] text-[#0A0A0F] px-[40px] py-[14px] rounded-lg text-[16px] font-[900] transition-all hover:scale-[1.02] hover:bg-[#d4b55a] active:scale-95 shadow-[0_15px_30px_rgba(201,168,76,0.2)] font-['Century_Gothic',sans-serif]">
          <span class="relative z-10">Chat on WhatsApp (Save 30-50%)</span>
          <svg class="w-5 h-5 relative z-10 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a href="#factory" class="group flex items-center space-x-3 text-[14px] font-bold tracking-[0.1em] text-white/60 hover:text-white transition-colors font-['Century_Gothic',sans-serif]">
          <span>Explore Factory</span>
          <div class="w-8 h-[1px] bg-white/20 group-hover:w-12 group-hover:bg-accent transition-all"></div>
        </a>
      </div>
    </div>
  </div>

  <!-- Luxopack Style Bottom Edge Decoration -->
  <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-[#06060a] to-transparent z-20"></div>
</section>

<style>
  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #C9A84C;
    border-radius: 50%;
    margin-right: 8px;
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .animate-fade-in {
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
