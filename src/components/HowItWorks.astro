---
const steps = [
  {
    number: "01",
    title: "Send Your Requirements",
    description: "Tell us what you’re looking for. Whether you need ready-to-ship styles, custom logos or OEM development, our team will guide you through the next steps.",
    subTitle: "WHAT YOU CAN SEND:",
    items: [
      "Product photos or references",
      "Logo files",
      "Required quantity",
      "Fabric preferences",
      "Packaging requirements",
      "Your own design sketches"
    ]
  },
  {
    number: "02",
    title: "Dedicated Account Manager",
    description: "One experienced account manager supports your project from inquiry to delivery. Fast communication, transparent pricing and reliable after-sales service.",
    subTitle: "YOU WILL RECEIVE:",
    items: [
      "Product recommendations",
      "Detailed quotation",
      "Fabric suggestions",
      "Logo customization options",
      "Sample arrangements",
      "Estimated production timeline"
    ]
  },
  {
    number: "03",
    title: "Confirm Order & Production",
    description: "After sample approval, production begins with strict quality control and regular progress updates at every manufacturing stage.",
    subTitle: "PRODUCTION PROCESS:",
    items: [
      "Fabric preparation",
      "Cutting & sewing",
      "Logo application",
      "Quality inspection",
      "Packing",
      "Final inspection"
    ]
  },
  {
    number: "04",
    title: "Delivery Worldwide",
    description: "Your products are carefully packed and shipped to your warehouse, store or fulfillment center via our global logistics network.",
    subTitle: "SHIPPING OPTIONS:",
    items: [
      "Express Shipping (DHL/FedEx)",
      "Air Freight",
      "Sea Freight",
      "DDP Shipping",
      "Amazon FBA Delivery",
      "Door-to-Door Service"
    ]
  }
];

const timeline = [
  { label: "Inquiry Response", value: "Within 24 Hours" },
  { label: "Sample Development", value: "3–7 Days" },
  { label: "Private Label Production", value: "15–25 Days" },
  { label: "Ready-To-Ship Orders", value: "3–7 Days" },
  { label: "Shipping", value: "Global Logistics Support" }
];
---

<section id="how-it-works" class="py-24 bg-[#0D1526] text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <!-- Header Section (Refined Sizes) -->
    <div class="text-center mb-16">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.15em] text-[13px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        HOW IT WORKS
      </h3>
      <h2 class="text-[28px] md:text-[36px] lg:text-[44px] font-bold leading-[1.1] font-['Century_Gothic',sans-serif] tracking-tight mb-6">
        From Idea to Launch<br/>
        <span class="text-[#C9A84C] italic">in 4 Simple Steps</span>
      </h2>
      <p class="text-white/40 max-w-[620px] mx-auto text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Whether you’re launching a new activewear brand or expanding your collection, Fitclo makes sourcing simple, fast and transparent — from your first inquiry to final delivery.
      </p>
    </div>

    <!-- Steps Grid (Refined Typography & Luxopack Style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-12 gap-y-16 mb-24">
      {steps.map((step) => (
        <div class="group relative">
          <!-- Step Number (Luxopack Style: Darker, Faded Gold, Montserrat) -->
          <div class="text-[42px] font-bold text-[#443B22] font-['Century_Gothic',sans-serif] leading-none mb-6">
            {step.number}
          </div>
          
          <div class="relative">
            <h4 class="text-[17px] font-bold text-white mb-3 font-['Century_Gothic',sans-serif]">
              {step.title}
            </h4>
            
            <p class="text-white/40 text-[13px] leading-relaxed font-['Century_Gothic',sans-serif] mb-8 min-h-[40px]">
              {step.description}
            </p>

            <div class="pt-8 border-t border-white/10">
              <h5 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
                {step.subTitle}
              </h5>
              <ul class="space-y-2.5">
                {step.items.map(item => (
                  <li class="flex items-start text-[12px] text-white/40 font-['Century_Gothic',sans-serif] leading-tight">
                    <span class="w-1 h-1 rounded-full bg-[#C9A84C]/30 mr-2 mt-1.5 flex-shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Luxopack Style CTA Button -->
    <div class="flex justify-center mb-24">
      <a 
        href="#inquiry" 
        class="inline-block px-12 py-3 bg-[#C9A84C] text-[#0A0A0F] text-[16px] font-bold rounded-lg hover:bg-white hover:scale-[1.05] active:scale-95 transition-all duration-300 font-['Century_Gothic',sans-serif] tracking-wide shadow-[0_15px_40px_rgba(201,168,76,0.3)]"
      >
        Start Step 1 Now — It's Free →
      </a>
    </div>

    <!-- Typical Timeline Module -->
    <div class="max-w-[1000px] mx-auto">
      <div class="bg-black/20 rounded-2xl border border-white/5 p-8 md:p-12 overflow-hidden relative">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#C9A84C]/50"></div>
        
        <div class="flex flex-col md:flex-row items-center justify-between mb-10 gap-6">
          <div class="text-center md:text-left">
            <h4 class="text-white text-[18px] font-bold font-['Century_Gothic',sans-serif] mb-2">Typical Timeline</h4>
            <p class="text-white/40 text-[13px] font-['Century_Gothic',sans-serif]">Transparent delivery times for every project stage.</p>
          </div>
          <a href="#inquiry" class="inline-block border border-[#C9A84C]/30 text-[#C9A84C] font-bold py-2.5 px-6 rounded-md hover:bg-[#C9A84C] hover:text-black transition-all text-[12px] uppercase tracking-widest font-['Century_Gothic',sans-serif]">
            Get Started Now
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-0">
          {timeline.map((item, index) => (
            <div class={`flex flex-col p-4 ${index !== timeline.length - 1 ? 'md:border-r border-white/5' : ''}`}>
              <span class="text-white/30 text-[10px] font-bold uppercase tracking-widest mb-2 font-['Century_Gothic',sans-serif]">{item.label}</span>
              <span class="text-[#C9A84C] text-[13px] font-bold font-['Century_Gothic',sans-serif]">{item.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
