---
const inStockProducts = [
  {
    name: "Premium Yoga Shorts Set",
    description: "High-waist sculpting shorts with supportive racerback bra. Available in multiple high-trend colors.",
    image: "/images/migrated/third-party/h772bb8cd8d0b43248173234fa5346f67p-e38ed6b562.webp",
    moq: "50 Pieces",
    features: ["4-way Stretch", "Squat Proof", "Logo Ready"]
  },
  {
    name: "Essential Yoga Leggings Set",
    description: "Classic high-compression leggings paired with a versatile scoop-neck sports bra.",
    image: "/images/migrated/third-party/h699564deaff04b57ab05c9d1e6b95066a-4d072dd4d4.webp",
    moq: "50 Pieces",
    features: ["Buttery Soft", "Tummy Control", "Neutral Colors"]
  },
  {
    name: "Luxury Criss-Cross Bra",
    description: "Elegant open-back design with supportive compression fabric. Ideal for yoga and gym.",
    image: "/images/migrated/third-party/hde2258a46c8d40f6b3a38098a28a49cfj-3aa9822627.webp",
    moq: "50 Pieces",
    features: ["Breathable", "Padded", "MN Monogram Compatible"]
  },
  {
    name: "Active Performance Dress",
    description: "Flattering activewear dress with built-in shorts and supportive racerback straps.",
    image: "/images/migrated/third-party/h9d1abad109d7478080461dad9271b7ecg-564616a33f.webp",
    moq: "50 Pieces",
    features: ["Quick Dry", "In-Stock", "10+ Colors Available"]
  }
];
---

<section id="in-stock" class="py-24 bg-[#0a0a0a] border-t border-white/5">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16">
    <div class="flex flex-col mb-12">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        In-Stock Collections
      </h3>
      <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        Ready-to-Brand <span class="text-[#C9A84C] italic">Styles</span>
      </h2>
      <p class="text-white/60 mt-4 max-w-xl text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Professional performance styles available for immediate private label application. Low 50-piece MOQ with premium logo printing and custom packaging.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {inStockProducts.map(product => (
        <div class="group bg-[#111111] rounded-[24px] overflow-hidden border border-white/5 hover:border-[#C9A84C]/30 transition-all duration-500">
          <div class="aspect-[4/5] overflow-hidden relative">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-[#C9A84C] text-black text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                MOQ: {product.moq}
              </span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="text-[18px] font-bold text-white mb-2 font-['Century_Gothic',sans-serif]">
              {product.name}
            </h3>
            <p class="text-white/40 text-[13px] leading-relaxed mb-4 line-clamp-2">
              {product.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-6">
              {product.features.map(feature => (
                <span class="text-[9px] text-white/60 border border-white/10 px-2 py-0.5 rounded uppercase tracking-widest font-bold">
                  {feature}
                </span>
              ))}
            </div>

            <a
              href="#quote"
              class="block w-full text-center border border-white/10 text-white py-3 rounded-lg text-[12px] font-bold uppercase tracking-widest hover:bg-[#C9A84C] hover:text-black hover:border-[#C9A84C] transition-all duration-300"
            >
              Get Free Quote
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
