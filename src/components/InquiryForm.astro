---
const language = Astro.url.pathname.startsWith('/es/') ? 'es' : 'en';
const isSpanish = language === 'es';
const copy = isSpanish ? {
  eyebrow: 'SOLICITA UNA COTIZACIÓN GRATUITA', title: 'Cotización gratuita +', mockup: 'Diseño de logo', timing: 'en 24 horas',
  intro: 'Sin compromiso y sin spam. Nuestro asesor de ropa deportiva se pondrá en contacto contigo con una propuesta de diseño gratuita y precio directo de fábrica.',
  consultant: 'Hola, soy Jason, tu asesor de ropa deportiva 👋', consultantText: 'Completa el formulario y responderé personalmente con tu cotización gratuita.',
  online: 'En línea · Respuesta media en 2 h', divider: '—— o completa el formulario —',
  name: 'NOMBRE *', company: 'EMPRESA', companyPlaceholder: 'Tu marca / empresa', email: 'CORREO ELECTRÓNICO *', phone: 'WHATSAPP / TELÉFONO',
  productType: 'TIPO DE PRODUCTO *', selectProduct: 'Selecciona el tipo de producto...', yogaSet: 'Conjunto de yoga', sportsBras: 'Sujetadores deportivos',
  leggings: 'Leggings', tshirt: 'Camiseta', yogaTop: 'Top de yoga', gymShorts: 'Shorts deportivos', multiple: 'Varios tipos / otros', quantity: 'CANTIDAD ESTIMADA *', selectQuantity: 'Selecciona la cantidad...',
  lowMoq: '100 - 300 UDS. (MOQ bajo)', midMoq: '300 - 1.000 unidades', largeMoq: '1.000 - 5.000 unidades', highVolume: 'Más de 5.000 UDS. (gran volumen)', fabric: 'TEJIDO Y COLOR', standard: 'Nylon/Spandex (estándar)',
  recycled: 'Poliéster reciclado', cotton: 'Mezcla de algodón', customFabric: 'Solicitud de tejido personalizado', logoPlacement: 'UBICACIÓN DEL LOGO',
  chest: 'Pecho / lado izquierdo', waistband: 'Cintura', leg: 'Pierna (laterales / espalda)', backNeck: 'Nuca', other: 'Otra / varias',
  more: 'CUÉNTANOS MÁS (OPCIONAL)', morePlaceholder: 'Indica el número de modelo que te interesa y si necesitas personalización de logo, diseños a medida o nuestro catálogo más reciente.',
  upload: 'SUBIR LOGO / IMAGEN DE REFERENCIA (OPCIONAL)', uploadHelp: 'Haz clic para subir PNG, AI o PDF · Máx. 10 MB', noFile: 'Ningún archivo seleccionado',
  send: 'ENVIAR MI SOLICITUD', profile: 'DESCARGAR PERFIL (PDF)', privacy: 'Tu información está protegida. Respondemos en un plazo de 24 horas laborables.',
  badges: ['Diseño de logo gratuito', 'Sin cargos ocultos', 'Muestra antes del pedido', 'Respuesta en 24 horas'],
  sending: 'ENVIANDO...', success: '¡ENVIADO! JASON RESPONDERÁ EN UN PLAZO DE 24 HORAS.', error: 'No pudimos enviar tu solicitud. Inténtalo de nuevo o contáctanos por WhatsApp.',
} : {
  eyebrow: 'GET A FREE QUOTE', title: 'Free Quote +', mockup: 'Logo Mockup', timing: 'in 24 Hours',
  intro: 'No commitment. No spam. Our activewear consultant will contact you directly with a free design mockup and factory-direct price.',
  consultant: "Hi, I'm Jason — your activewear consultant 👋", consultantText: "Fill the form below and I'll personally respond with your free quote.",
  online: 'Online · Avg. 2h reply', divider: '—— or fill the form below —',
  name: 'YOUR NAME *', company: 'COMPANY NAME', companyPlaceholder: 'Your Brand / Company', email: 'EMAIL ADDRESS *', phone: 'WHATSAPP / PHONE',
  productType: 'PRODUCT TYPE *', selectProduct: 'Select product type...', yogaSet: 'Yoga Set', sportsBras: 'Sport Bras', leggings: 'Leggings', tshirt: 'T-shirt', yogaTop: 'Yoga Top', gymShorts: 'Gym Shorts',
  multiple: 'Multiple Types / others', quantity: 'ESTIMATED QUANTITY *', selectQuantity: 'Select quantity...', lowMoq: '100 - 300 PCS (Low MOQ)', midMoq: '300 - 1,000 PCS', largeMoq: '1,000 - 5,000 PCS', highVolume: '5,000+ PCS (High Volume)',
  fabric: 'FABRIC & COLOR', standard: 'Nylon/Spandex (Standard)', recycled: 'Recycled Polyester', cotton: 'Cotton Blend', customFabric: 'Custom Fabric Request',
  logoPlacement: 'LOGO PLACEMENT', chest: 'Chest / Left Chest', waistband: 'Waistband', leg: 'Leg (Sides / Back)', backNeck: 'Back Neck', other: 'Other / Multiple',
  more: 'TELL US MORE (OPTIONAL)', morePlaceholder: "Please tell us the style number you're interested in, whether you need logo customization, custom designs, or our latest catalog.",
  upload: 'UPLOAD LOGO / REFERENCE IMAGE (OPTIONAL)', uploadHelp: 'Click to upload PNG, AI, PDF · Max 10MB', noFile: 'No file selected',
  send: 'SEND MY REQUEST', profile: 'DOWNLOAD PROFILE (PDF)', privacy: 'Your information is safe. We respond within 24 hours on business days.',
  badges: ['Free Design Mockup', 'No Hidden Fees', 'Sample Before Bulk', 'Reply in 24 Hours'],
  sending: 'SENDING...', success: 'SENT! JASON WILL REPLY WITHIN 24 HOURS.', error: "We couldn't send your request right now. Please try again or contact us on WhatsApp.",
};
---
<section id="inquiry" class="py-24 bg-[#0e0e12] text-white overflow-hidden">
  <div class="max-w-[1000px] mx-auto px-6 lg:px-10">
    <!-- Header Section (Replicated from Luxopack) -->
    <div class="text-center mb-10">
      <p class="text-[11px] font-[600] tracking-[0.3em] text-[#C9A84C] uppercase mb-2 font-['Century_Gothic',sans-serif]">
        {copy.eyebrow}
      </p>
      <div class="flex items-start justify-center space-x-4 mb-6">
        <span class="text-[32px] md:text-[44px] leading-none select-none mt-[4px] md:mt-[6px]">🎁</span>
        <h2 class="text-[28px] md:text-[44px] font-bold leading-[1.1] font-['Century_Gothic',sans-serif] tracking-tight text-left">
          {copy.title} <span class="text-white">{copy.mockup}</span> <br/>
          <div class="text-center w-full">
            <span class="text-[#C9A84C] italic">{copy.timing}</span>
          </div>
        </h2>
      </div>
      <p class="text-[14px] md:text-[15px] text-white/40 font-['Century_Gothic',sans-serif] max-w-2xl mx-auto leading-relaxed">
        {copy.intro}
      </p>
    </div>

    <div class="max-w-[800px] mx-auto">
      <!-- Consultant Card -->
      <div class="bg-[#131313] border border-[#3a3222] rounded-xl p-6 mb-4 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
        <div class="flex items-center space-x-4 z-10">
          <div class="w-12 h-12 bg-gradient-to-br from-[#E6C36A] via-[#C9A84C] to-[#9B7A30] rounded-full flex items-center justify-center text-black text-xl font-bold font-['Century_Gothic',sans-serif] shadow-lg">
            J
          </div>
          <div>
            <h3 class="text-[16px] font-bold text-white font-['Century_Gothic',sans-serif]">
              {copy.consultant}
            </h3>
            <p class="text-[13px] text-white/40 font-['Century_Gothic',sans-serif]">
              {copy.consultantText}
            </p>
          </div>
        </div>
        <div class="flex items-center space-x-2 z-10">
          <div class="w-2 h-2 bg-green-500 rounded-full"></div>
          <span class="text-[12px] text-white/40 font-['Century_Gothic',sans-serif]">{copy.online}</span>
        </div>
      </div>

      <div class="text-center mb-4 mt-[-8px]">
        <span class="text-[12px] font-medium tracking-[0.1em] text-white/50 font-['Century_Gothic',sans-serif]">
          {copy.divider}
        </span>
      </div>

      <!-- Inquiry Form -->
      <form id="inquiry-form" class="space-y-6 font-['Century_Gothic',sans-serif]" data-language={language} data-page-path={Astro.url.pathname} data-sending={copy.sending} data-success={copy.success} data-error={copy.error} data-no-file={copy.noFile}>
        <input type="hidden" name="language" value={language} />
        <input type="hidden" name="page_path" value={Astro.url.pathname} />
        <input type="hidden" name="page_url" value={Astro.url.href} />
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Row 1 -->
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.name}</label>
            <input 
              type="text" 
              name="name" 
              placeholder="John Smith" 
              required 
              class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/30 text-[14px]"
            />
          </div>
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.company}</label>
            <input 
              type="text" 
              name="company" 
              placeholder={copy.companyPlaceholder}
              class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/30 text-[14px]"
            />
          </div>

          <!-- Row 2 -->
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.email}</label>
            <input 
              type="email" 
              name="email" 
              placeholder="john@company.com" 
              required 
              class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/30 text-[14px]"
            />
          </div>
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.phone}</label>
            <input 
              type="text" 
              name="phone" 
              placeholder="+1 234 567 8900" 
              class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/30 text-[14px]"
            />
          </div>

          <!-- Row 3 -->
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.productType}</label>
            <div class="relative">
              <select name="product_type" required class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
                <option value="" disabled selected class="bg-[#0A0A0F]">{copy.selectProduct}</option>
                <option value="Yoga Set" class="bg-[#0A0A0F]">{copy.yogaSet}</option>
                <option value="Sport Bras" class="bg-[#0A0A0F]">{copy.sportsBras}</option>
                <option value="Leggings" class="bg-[#0A0A0F]">{copy.leggings}</option>
                <option value="Yoga Top" class="bg-[#0A0A0F]">{copy.yogaTop}</option>
                <option value="Gym Shorts" class="bg-[#0A0A0F]">{copy.gymShorts}</option>
                <option value="T-shirt" class="bg-[#0A0A0F]">{copy.tshirt}</option>
                <option value="Multiple Types / others" class="bg-[#0A0A0F]">{copy.multiple}</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.quantity}</label>
            <div class="relative">
              <select name="quantity" required class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
                <option value="" disabled selected class="bg-[#0A0A0F]">{copy.selectQuantity}</option>
                <option value="100-300 PCS" class="bg-[#0A0A0F]">{copy.lowMoq}</option>
                <option value="300-1000 PCS" class="bg-[#0A0A0F]">{copy.midMoq}</option>
                <option value="1000-5000 PCS" class="bg-[#0A0A0F]">{copy.largeMoq}</option>
                <option value="5000+ PCS" class="bg-[#0A0A0F]">{copy.highVolume}</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </div>
            </div>
          </div>

          <!-- Row 4 -->
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.fabric}</label>
            <div class="relative">
              <select name="material" class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
                <option value="Nylon/Spandex (Standard)" class="bg-[#0A0A0F]">{copy.standard}</option>
                <option value="Recycled Polyester" class="bg-[#0A0A0F]">{copy.recycled}</option>
                <option value="Cotton Blend" class="bg-[#0A0A0F]">{copy.cotton}</option>
                <option value="Custom Fabric Request" class="bg-[#0A0A0F]">{copy.customFabric}</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.logoPlacement}</label>
            <div class="relative">
              <select name="logo_placement" class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
                <option value="Chest/Left Chest" class="bg-[#0A0A0F]">{copy.chest}</option>
                <option value="Waistband" class="bg-[#0A0A0F]">{copy.waistband}</option>
                <option value="Leg (Sides/Back)" class="bg-[#0A0A0F]">{copy.leg}</option>
                <option value="Back Neck" class="bg-[#0A0A0F]">{copy.backNeck}</option>
                <option value="Other / Multiple" class="bg-[#0A0A0F]">{copy.other}</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Full Width Message -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.more}</label>
          <textarea 
            name="message" 
            rows="4" 
            placeholder={copy.morePlaceholder}
            class="w-full bg-[#15151a] border border-[#3f3f46] rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/30 text-[14px]"
          ></textarea>
        </div>

        <!-- Upload Section -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-[0.15em] text-white/95 uppercase">{copy.upload}</label>
          <div class="relative group cursor-pointer">
            <input type="file" name="file" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" />
            <div class="w-full border border-dashed border-[#C9A84C]/40 bg-[#15151a] rounded-lg py-8 flex flex-col items-center justify-center transition-all group-hover:border-[#C9A84C] group-hover:bg-[#1a1a21]">
              <div class="mb-3 text-[#C9A84C]/60 group-hover:text-[#C9A84C] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
              </div>
              <p class="text-[13px] text-white/60 mb-1 font-bold">{copy.uploadHelp}</p>
              <p class="text-[11px] text-[#C9A84C] font-bold" id="file-name">{copy.noFile}</p>
            </div>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-4">
          <button type="submit" class="flex-1 bg-[#C9A84C] text-[#0A0A0F] py-4 rounded-lg font-black text-[14px] md:text-[16px] uppercase tracking-[0.1em] hover:bg-[#d4b55a] transition-all shadow-[0_20px_40px_rgba(201,168,76,0.1)] active:scale-[0.98] font-['Century_Gothic',sans-serif] flex items-center justify-center space-x-3">
            <span>🚀</span>
            <span>{copy.send}</span>
          </button>
          <a href="#" class="flex-1 border border-[#C9A84C] text-[#C9A84C] py-4 rounded-lg font-black text-[14px] md:text-[16px] uppercase tracking-[0.1em] hover:bg-[#C9A84C] hover:text-[#0A0A0F] transition-all flex items-center justify-center space-x-3 font-['Century_Gothic',sans-serif]">
            <span>📄</span>
            <span>{copy.profile}</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="flex flex-col items-center space-y-2 pt-0 text-center">
          <div class="flex items-center justify-center space-x-2 text-[14px] font-medium text-white/60 font-['Century_Gothic',sans-serif]">
            <span>🔒</span>
            <span>{copy.privacy}</span>
          </div>
          
          <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 w-full">
            {copy.badges.map(badge => (
              <div class="flex items-center space-x-2">
                <div class="w-4 h-4 bg-green-600 rounded flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-[11px] md:text-[12px] font-medium text-white/50 font-['Century_Gothic',sans-serif] tracking-wide">{badge}</span>
              </div>
            ))}
          </div>
        </div>
        <p id="form-status" class="text-center text-sm hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const fileInput = form?.querySelector('input[type="file"]') as HTMLInputElement;
  const fileNameDisplay = document.getElementById('file-name');

  fileInput?.addEventListener('change', () => {
    if (fileNameDisplay && fileInput.files?.[0]) {
      fileNameDisplay.textContent = fileInput.files[0].name;
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalBtnContent = submitBtn.innerHTML;

    const sendingMessage = form.dataset.sending || 'SENDING...';
    const successMessage = form.dataset.success || 'SENT! JASON WILL REPLY WITHIN 24 HOURS.';
    const errorMessage = form.dataset.error || "We couldn't send your request right now. Please try again or contact us on WhatsApp.";
    const noFileMessage = form.dataset.noFile || 'No file selected';

    status.textContent = sendingMessage;
    status.classList.remove('hidden', 'text-red-500', 'text-green-500');
    status.classList.add('text-white/40');
    
    submitBtn.disabled = true;
    submitBtn.textContent = sendingMessage;

    const formData = new FormData(form);
    const data: any = Object.fromEntries(formData.entries());
    
    // Remove file object from JSON payload
    delete data.file;

    try {
      const res = await fetch('/submit', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (res.ok && result.success) {
        status.classList.add('hidden');
        submitBtn.innerHTML = `<span>✅</span> <span>${successMessage}</span>`;
        submitBtn.classList.remove('bg-[#C9A84C]', 'hover:bg-[#d4b55a]');
        submitBtn.classList.add('bg-green-700');
        form.reset();
        if (fileNameDisplay) fileNameDisplay.textContent = noFileMessage;
      } else {
        throw new Error(result.error || result.message || `Error ${res.status}`);
      }
    } catch (err: any) {
      console.error('Submission Error:', err);
      status.textContent = errorMessage;
      status.classList.replace('text-white/40', 'text-red-500');
      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnContent;
    }
  });
</script>
