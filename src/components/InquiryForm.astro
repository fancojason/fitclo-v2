    <!-- Inquiry Form (Luxopack High-Fidelity Style) -->
    <form id="inquiry-form" class="space-y-8 font-['Century_Gothic',sans-serif]">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Row 1 -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/70 uppercase">YOUR NAME *</label>
          <input 
            type="text" 
