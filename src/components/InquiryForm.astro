---
---

<section id="inquiry" class="py-24 bg-black relative overflow-hidden border-t border-white/5">
  <!-- Section Title -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-16 text-center">
    <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
      Request a Quote
    </h3>
    <h2 class="text-[32px] md:text-[48px] lg:text-[56px] font-bold text-white mb-6 leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
      Start Your <span class="text-[#C9A84C] italic">Brand Journey</span>
    </h2>
    <p class="text-[15px] md:text-[16px] text-white/50 font-['Century_Gothic',sans-serif] max-w-2xl mx-auto leading-relaxed">
      No commitment. No spam. Our Activewear consultant will contact you directly with a free design mockup and factory-direct price.
    </p>
  </div>

  <div class="max-w-[800px] mx-auto px-6 lg:px-8">
    <!-- Consultant Card -->
    <div class="bg-[#131313] border border-[#3a3222] rounded-xl p-6 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden group">
      <div class="flex items-center space-x-6 z-10">
        <div class="w-16 h-16 bg-[#C9A84C] rounded-full flex items-center justify-center text-black text-2xl font-black font-['Century_Gothic',sans-serif]">
          J
        </div>
        <div>
          <h3 class="text-[18px] font-bold text-white font-['Century_Gothic',sans-serif]">
            Hi, I'm Jason — your activewear consultant 👋
          </h3>
          <p class="text-[14px] text-white/40 font-['Century_Gothic',sans-serif] mt-1">
            Expert in fabric sourcing, technical construction, and B2B logistics.
          </p>
        </div>
      </div>
      <div class="flex items-center space-x-2 text-[#C9A84C] text-[13px] font-bold group-hover:translate-x-1 transition-transform z-10">
        <span>ONLINE NOW</span>
        <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.6)]"></div>
      </div>
      <div class="absolute top-0 right-0 w-32 h-32 bg-[#C9A84C]/5 blur-[60px] rounded-full"></div>
    </div>

    <!-- Main Form -->
    <form id="inquiry-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-[11px] font-bold text-[#C9A84C] uppercase tracking-[0.15em] ml-1">Full Name</label>
          <input type="text" name="name" required placeholder="Enter your name"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-[#C9A84C]/50 transition-all font-['Century_Gothic',sans-serif] text-[15px]" />
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold text-[#C9A84C] uppercase tracking-[0.15em] ml-1">Work Email</label>
          <input type="email" name="email" required placeholder="name@company.com"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-[#C9A84C]/50 transition-all font-['Century_Gothic',sans-serif] text-[15px]" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-[11px] font-bold text-[#C9A84C] uppercase tracking-[0.15em] ml-1">Product Type</label>
          <select name="product" required
            class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-[#C9A84C]/50 transition-all font-['Century_Gothic',sans-serif] text-[15px] appearance-none">
            <option value="" disabled selected>Select a category</option>
            <option value="Yoga Sets">Custom Yoga Sets</option>
            <option value="Leggings">High-Performance Leggings</option>
            <option value="Sports Bras">Sports Bras (High Support)</option>
            <option value="Shorts">Gym & Biker Shorts</option>
            <option value="Men's Wear">Men's Performance Wear</option>
            <option value="Other">Other Custom Activewear</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold text-[#C9A84C] uppercase tracking-[0.15em] ml-1">Estimated Quantity</label>
          <select name="quantity" required
            class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-[#C9A84C]/50 transition-all font-['Century_Gothic',sans-serif] text-[15px] appearance-none">
            <option value="" disabled selected>Select quantity range</option>
            <option value="50-100">50 - 100 pcs (Ready to Ship)</option>
            <option value="100-500">100 - 500 pcs (Commercial Scale)</option>
            <option value="500-1000">500 - 1000 pcs (Production Ready)</option>
            <option value="1000+">1000+ pcs (Wholesale/Enterprise)</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-[11px] font-bold text-[#C9A84C] uppercase tracking-[0.15em] ml-1">Your Vision & Tech Requirements</label>
        <textarea name="message" required rows="4" placeholder="Tell us about your fabric needs, custom logo placement, or design ideas..."
          class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-[#C9A84C]/50 transition-all font-['Century_Gothic',sans-serif] text-[15px] resize-none"></textarea>
      </div>

      <!-- File Upload (Optional) -->
      <div class="relative group">
        <input type="file" name="file" id="file-upload" class="hidden" />
        <label for="file-upload" class="flex items-center justify-center space-x-3 w-full border-2 border-dashed border-white/10 hover:border-[#C9A84C]/30 py-8 rounded-xl cursor-pointer transition-all bg-white/0 hover:bg-white/5 group">
          <svg class="w-6 h-6 text-white/30 group-hover:text-[#C9A84C] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <div class="text-left">
            <span class="block text-[14px] font-bold text-white/60 group-hover:text-white transition-colors">Upload Tech Pack / Logo (Optional)</span>
            <span id="file-name" class="block text-[12px] text-white/30">Max size 10MB. Formats: PDF, PNG, JPG</span>
          </div>
        </label>
      </div>

      <div class="pt-6">
        <button type="submit" 
          class="w-full bg-[#C9A84C] hover:bg-[#d4b55a] text-black font-black py-5 rounded-xl text-[14px] tracking-[0.2em] transition-all transform hover:scale-[1.01] flex items-center justify-center space-x-3 shadow-[0_10px_30px_rgba(201,168,76,0.2)] group">
          <span>SEND MY INQUIRY</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
        
        <!-- Trust Badges -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 w-full">
          {[
            'Free Design Mockup',
            'No Hidden Fees',
            'Sample Before Bulk',
            'Reply in 24 Hours'
          ].map(badge => (
            <div class="flex items-center space-x-2">
              <div class="w-4 h-4 bg-green-600 rounded flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-[11px] md:text-[12px] font-medium text-white/50 font-['Century_Gothic',sans-serif] tracking-wide">{badge}</span>
            </div>
          ))}
        </div>
      </div>
      <p id="form-status" class="text-center text-sm hidden"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const fileInput = form?.querySelector('input[type="file"]') as HTMLInputElement;
  const fileNameDisplay = document.getElementById('file-name');

  fileInput?.addEventListener('change', () => {
    if (fileNameDisplay && fileInput.files?.[0]) {
      fileNameDisplay.textContent = fileInput.files[0].name;
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalBtnContent = submitBtn.innerHTML;

    status.textContent = 'Sending...';
    status.classList.remove('hidden', 'text-red-500', 'text-green-500');
    status.classList.add('text-white/40');
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'SENDING...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Remove file object from JSON payload
    delete (data as any).file;

    try {
      const res = await fetch('/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const text = await res.text();
      let result;
      try {
        result = JSON.parse(text);
      } catch (e) {
        throw new Error(`Invalid Server Response: ${text.substring(0, 100)}`);
      }

      if (res.ok && result.success) {
        status.classList.add('hidden');
        submitBtn.innerHTML = `<span>✅</span> <span>SENT! JASON WILL REPLY WITHIN 24 HOURS.</span>`;
        submitBtn.classList.remove('bg-[#C9A84C]', 'hover:bg-[#d4b55a]');
        submitBtn.classList.add('bg-green-700');
        form.reset();
        if (fileNameDisplay) fileNameDisplay.textContent = 'No file selected';
      } else {
        throw new Error(result.error || result.message || `Error ${res.status}`);
      }
    } catch (err: any) {
      console.error('Submission Error:', err);
      status.textContent = `Error: ${err.message}`;
      status.classList.replace('text-white/40', 'text-red-500');
      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnContent;
    }
  });
</script>
