          <input 
            type="text" 
            name="phone" 
            placeholder="+1 234 567 8900" 
            class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all placeholder:text-white/30 text-[14px]"
          />
        </div>

        <!-- Row 3 (Updated Dropdowns) -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/70 uppercase">PRODUCT TYPE *</label>
          <div class="relative">
            <select name="product_type" required class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all text-[14px]">
              <option value="" disabled selected class="bg-[#0A0A0F]">Select product type...</option>
              <option value="Yoga Set" class="bg-[#0A0A0F]">Yoga Set</option>
              <option value="Sport Bras" class="bg-[#0A0A0F]">Sport Bras</option>
              <option value="Leggings" class="bg-[#0A0A0F]">Leggings</option>
              <option value="Yoga Top" class="bg-[#0A0A0F]">Yoga Top</option>
              <option value="Gym Shorts" class="bg-[#0A0A0F]">Gym Shorts</option>
              <option value="T-shirt" class="bg-[#0A0A0F]">T-shirt</option>
              <option value="Multiple Types / others" class="bg-[#0A0A0F]">Multiple Types / others</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/70 uppercase">ESTIMATED QUANTITY *</label>
          <div class="relative">
            <select name="quantity" required class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all text-[14px]">
              <option value="" disabled selected class="bg-[#0A0A0F]">Select quantity...</option>
              <option value="100-300 PCS" class="bg-[#0A0A0F]">100 - 300 PCS (Low MOQ)</option>
              <option value="300-1000 PCS" class="bg-[#0A0A0F]">300 - 1,000 PCS</option>
              <option value="1000-5000 PCS" class="bg-[#0A0A0F]">1,000 - 5,000 PCS</option>
              <option value="5000+ PCS" class="bg-[#0A0A0F]">5,000+ PCS (High Volume)</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>

