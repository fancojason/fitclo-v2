          <div class="relative">
            <select name="logo_placement" class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all text-[14px]">
              <option value="Chest/Left Chest" class="bg-[#0A0A0F]">Chest / Left Chest</option>
              <option value="Waistband" class="bg-[#0A0A0F]">Waistband</option>
              <option value="Leg (Sides/Back)" class="bg-[#0A0A0F]">Leg (Sides / Back)</option>
              <option value="Back Neck" class="bg-[#0A0A0F]">Back Neck</option>
              <option value="Other / Multiple" class="bg-[#0A0A0F]">Other / Multiple</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
