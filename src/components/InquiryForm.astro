            </div>
          </div>
        </div>
      </div>

      <!-- Full Width Message -->
      <div class="space-y-2">
        <label class="text-[11px] font-bold tracking-widest text-white/70 uppercase">TELL US MORE (OPTIONAL)</label>
          <textarea 
            name="message" 
            rows="4" 
            placeholder="Please tell us the style number you're interested in, whether you need logo customization, custom designs, or our latest catalog." 
            class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all placeholder:text-white/30 text-[14px]"
          ></textarea>
        </div>
  
        <!-- Upload Section (Luxopack Style) -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/70 uppercase">UPLOAD LOGO / REFERENCE IMAGE (OPTIONAL)</label>
          <div class="relative group cursor-pointer">
            <input type="file" name="file" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" />
            <div class="w-full border-2 border-dashed border-white/20 rounded-lg py-8 flex flex-col items-center justify-center transition-all group-hover:border-[#C9A84C]/50 group-hover:bg-white/5">
              <div class="mb-3 text-white/40 group-hover:text-[#C9A84C] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
              </div>
              <p class="text-[13px] text-white/60 mb-1 font-bold">Click to upload PNG, AI, PDF · Max 10MB</p>
              <p class="text-[11px] text-white/40 font-bold" id="file-name">No file selected</p>
            </div>
          </div>
        </div>
  
        <div class="pt-4">
          <button type="submit" class="w-full bg-[#C9A84C] text-[#0A0A0F] py-4 rounded-lg font-black text-[15px] md:text-[18px] uppercase tracking-widest hover:bg-[#d4b55a] transition-all shadow-[0_20px_40px_rgba(201,168,76,0.15)] active:scale-[0.98] font-['Century_Gothic',sans-serif] flex items-center justify-center space-x-3">
            <span>🚀</span>
            <span>SEND MY REQUEST — FREE & NO COMMITMENT</span>
          </button>
        </div>

      <!-- Trust Badges (Luxopack Style) -->
      <div class="flex flex-col items-center space-y-8 pt-4">
        <div class="flex items-center space-x-2 text-[12px] font-bold text-white/60 uppercase tracking-widest">
          <span>🔒</span>
          <span>Your information is safe. We respond within 24 hours on business days.</span>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-4 w-full">
          {[
