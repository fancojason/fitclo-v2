---
---
<section id="inquiry" class="py-24 bg-[#0A0A0F] text-white overflow-hidden">
  <div class="max-w-[1000px] mx-auto px-6 lg:px-10">
    <!-- Header Section (Replicated from Luxopack) -->
    <div class="text-center mb-16">
      <p class="text-[11px] font-[600] tracking-[0.3em] text-white/50 uppercase mb-8 font-['Century_Gothic',sans-serif]">
        GET A FREE QUOTE
      </p>
      <div class="flex items-center justify-center space-x-4 mb-6">
        <img src="https://sc02.alicdn.com/kf/H63372223405c483d86504a4f89531818B.png" alt="Gift Icon" class="w-12 h-12 md:w-16 md:h-16 object-contain" />
        <h2 class="text-[32px] md:text-[52px] font-bold leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
          Free Quote + <span class="text-white">Logo Mockup</span> <br/>
          <span class="text-[#C9A84C] italic font-serif">in 24 Hours</span>
        </h2>
      </div>
      <p class="text-[14px] md:text-[15px] text-white/40 font-['Century_Gothic',sans-serif] max-w-2xl mx-auto leading-relaxed">
        No commitment. No spam. Our activewear consultant will contact you directly with a free design mockup and factory-direct price.
      </p>
    </div>

    <!-- Consultant Card -->
    <div class="bg-[#111111] border border-white/5 rounded-xl p-6 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
      <div class="flex items-center space-x-4 z-10">
        <div class="w-12 h-12 bg-[#C9A84C] rounded-full flex items-center justify-center text-black text-xl font-bold font-['Century_Gothic',sans-serif]">
          J
        </div>
        <div>
          <h3 class="text-[16px] font-bold text-white font-['Century_Gothic',sans-serif]">
            Hi, I'm Jason — your activewear consultant 👋
          </h3>
          <p class="text-[13px] text-white/40 font-['Century_Gothic',sans-serif]">
            Fill the form below and I'll personally respond with your free quote.
          </p>
        </div>
      </div>
      <div class="flex items-center space-x-2 z-10">
        <div class="w-2 h-2 bg-green-500 rounded-full"></div>
        <span class="text-[12px] text-white/40 font-['Century_Gothic',sans-serif]">Online · Avg. 2h reply</span>
      </div>
    </div>

    <div class="text-center mb-12">
      <span class="text-[11px] font-medium tracking-[0.2em] text-white/30 uppercase font-['Century_Gothic',sans-serif]">
        — or fill the form below —
      </span>
    </div>

    <!-- Inquiry Form -->
    <form id="inquiry-form" class="space-y-6 font-['Century_Gothic',sans-serif]">
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Row 1 -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">YOUR NAME *</label>
          <input 
            type="text" 
            name="name" 
            placeholder="John Smith" 
            required 
            class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/20 text-[14px]"
          />
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">COMPANY NAME</label>
          <input 
            type="text" 
            name="company" 
            placeholder="Your Brand / Company" 
            class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/20 text-[14px]"
          />
        </div>

        <!-- Row 2 -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">EMAIL ADDRESS *</label>
          <input 
            type="email" 
            name="email" 
            placeholder="john@company.com" 
            required 
            class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/20 text-[14px]"
          />
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">WHATSAPP / PHONE</label>
          <input 
            type="text" 
            name="phone" 
            placeholder="+1 234 567 8900" 
            class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/20 text-[14px]"
          />
        </div>

        <!-- Row 3 -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">PRODUCT TYPE *</label>
          <div class="relative">
            <select name="product_type" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
              <option value="" disabled selected class="bg-[#0A0A0F]">Select product type...</option>
              <option value="Yoga Set" class="bg-[#0A0A0F]">Yoga Set</option>
              <option value="Sport Bras" class="bg-[#0A0A0F]">Sport Bras</option>
              <option value="Leggings" class="bg-[#0A0A0F]">Leggings</option>
              <option value="Yoga Top" class="bg-[#0A0A0F]">Yoga Top</option>
              <option value="Gym Shorts" class="bg-[#0A0A0F]">Gym Shorts</option>
              <option value="T-shirt" class="bg-[#0A0A0F]">T-shirt</option>
              <option value="Multiple Types / others" class="bg-[#0A0A0F]">Multiple Types / others</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">ESTIMATED QUANTITY *</label>
          <div class="relative">
            <select name="quantity" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
              <option value="" disabled selected class="bg-[#0A0A0F]">Select quantity...</option>
              <option value="100-300 PCS" class="bg-[#0A0A0F]">100 - 300 PCS (Low MOQ)</option>
              <option value="300-1000 PCS" class="bg-[#0A0A0F]">300 - 1,000 PCS</option>
              <option value="1000-5000 PCS" class="bg-[#0A0A0F]">1,000 - 5,000 PCS</option>
              <option value="5000+ PCS" class="bg-[#0A0A0F]">5,000+ PCS (High Volume)</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>

        <!-- Row 4 -->
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">FABRIC & COLOR</label>
          <div class="relative">
            <select name="material" class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
              <option value="Nylon/Spandex (Standard)" class="bg-[#0A0A0F]">Nylon/Spandex (Standard)</option>
              <option value="Recycled Polyester" class="bg-[#0A0A0F]">Recycled Polyester</option>
              <option value="Cotton Blend" class="bg-[#0A0A0F]">Cotton Blend</option>
              <option value="Custom Fabric Request" class="bg-[#0A0A0F]">Custom Fabric Request</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">LOGO PLACEMENT</label>
          <div class="relative">
            <select name="logo_placement" class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C]/50 outline-none transition-all text-[14px]">
              <option value="Chest/Left Chest" class="bg-[#0A0A0F]">Chest / Left Chest</option>
              <option value="Waistband" class="bg-[#0A0A0F]">Waistband</option>
              <option value="Leg (Sides/Back)" class="bg-[#0A0A0F]">Leg (Sides / Back)</option>
              <option value="Back Neck" class="bg-[#0A0A0F]">Back Neck</option>
              <option value="Other / Multiple" class="bg-[#0A0A0F]">Other / Multiple</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Full Width Message -->
      <div class="space-y-2">
        <label class="text-[11px] font-bold tracking-widest text-white/40 uppercase">TELL US MORE (OPTIONAL)</label>
        <textarea 
          name="message" 
          rows="4" 
          placeholder="Please tell us the style number you're interested in, whether you need logo customization, custom designs, or our latest catalog." 
          class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#C9A84C]/50 outline-none transition-all placeholder:text-white/20 text-[14px]"
        ></textarea>
      </div>

      <div class="pt-6">
        <button type="submit" class="w-full bg-[#C9A84C] text-[#0A0A0F] py-5 rounded-lg font-black text-[16px] md:text-[18px] uppercase tracking-[0.2em] hover:bg-[#d4b55a] transition-all shadow-[0_20px_40px_rgba(201,168,76,0.1)] active:scale-[0.98] font-['Century_Gothic',sans-serif]">
          SEND MY REQUEST — FREE & NO COMMITMENT
        </button>
      </div>
      <p class="text-[15px] md:text-[16px] text-white/50 font-['Century_Gothic',sans-serif] max-w-2xl mx-auto leading-relaxed">
        No commitment. No spam. Our Activewear consultant will contact you directly with a free design mockup and factory-direct price.
      </p>
    </div>

  <!-- Consultant Card (Replicated from Luxopack) -->
  <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden group">
    <div class="flex items-center space-x-6 z-10">
      <div class="w-16 h-16 bg-[#C9A84C] rounded-full flex items-center justify-center text-black text-2xl font-black font-['Century_Gothic',sans-serif]">
        J
      </div>
      <div>
        <h3 class="text-[18px] font-bold text-white font-['Century_Gothic',sans-serif]">
          Hi, I'm Jason — your Activewear consultant 👋
        </h3>
          <p class="text-[14px] text-white/60 font-['Century_Gothic',sans-serif]">
