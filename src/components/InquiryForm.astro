            <select name="material" class="w-full bg-white/5 border border-white/20 rounded-lg px-4 py-3 text-white appearance-none focus:border-[#C9A84C] focus:bg-white/10 outline-none transition-all text-[14px]">
              <option value="Nylon/Spandex (Standard)" class="bg-[#0A0A0F]">Nylon/Spandex (Standard)</option>
              <option value="Recycled Polyester" class="bg-[#0A0A0F]">Recycled Polyester</option>
              <option value="Cotton Blend" class="bg-[#0A0A0F]">Cotton Blend</option>
              <option value="Custom Fabric Request" class="bg-[#0A0A0F]">Custom Fabric Request</option>
            </select>
            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/20">
