---
const faqs = [
  {
    question: "How to find a reliable activewear manufacturer in China?",
    answer: "Look for manufacturers with proven export experience, transparent production processes and stable quality standards. A reliable partner should offer factory-direct communication, sample development, flexible customization and consistent lead times. Fitclo specializes in private label and OEM activewear manufacturing with customers across USA, Europe, Australia and the Middle East."
  },
  {
    question: "What is the MOQ for private label activewear?",
    answer: "MOQ depends on product type and customization requirements. For ready-to-ship styles with logo customization, MOQ starts from 50 pieces. For OEM activewear production, MOQ may vary depending on fabric and design complexity. Our team provides flexible solutions for both growing brands and established businesses."
  },
  {
    question: "Can I customize logo, labels and packaging?",
    answer: "Yes. Fitclo offers complete private label solutions including heat transfer logos, silicone logos, woven labels, care labels, hang tags, and custom packaging bags. Everything can be customized according to your brand identity."
  },
  {
    question: "How long does activewear production take?",
    answer: "Ready-to-ship products can usually be delivered within 7 days. Private label orders generally take 15–25 days depending on customization requirements. OEM development timelines vary according to fabric sourcing and sample approval. Our team provides a detailed timeline before production begins."
  },
  {
    question: "What fabrics do you use for activewear?",
    answer: "We offer a wide range of premium fabrics including Nylon-Spandex, Polyester-Spandex, Recycled Fabrics, Seamless Fabrics, Ribbed Fabrics, and Quick-Dry Fabrics. Fabric recommendations are based on your target market, product positioning and budget."
  },
  {
    question: "Why choose Fitclo over trading companies?",
    answer: "Fitclo is a factory-direct activewear manufacturer with in-house production and strict quality control. Customers work directly with our team throughout the entire process, ensuring faster communication, transparent pricing and consistent product quality. Our focus is to help brands grow through reliable manufacturing and long-term partnership."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="intelligence" class="py-24 bg-[#050505] text-white overflow-hidden font-['Century_Gothic',sans-serif]">
  <div class="container mx-auto px-6 max-w-4xl">
    <!-- Section Header -->
    <div class="mb-16 text-left max-w-3xl mx-auto md:ml-auto md:mr-6">
      <span class="block text-[#C9A84C] text-[12px] font-bold tracking-[0.25em] uppercase mb-4">
        FAQ
      </span>
      <h2 class="text-[30px] md:text-[44px] font-bold mb-6 leading-[1.1] tracking-tight">
        Questions We Get <span class="text-[#C9A84C] italic">All the Time</span>
      </h2>
      <p class="text-white/40 text-[15px] md:text-[16px] max-w-[700px] leading-relaxed">
        Everything you need to know before placing your first order.
      </p>
    </div>

    <!-- FAQ Accordion (Luxopack Style) -->
    <div class="border-t border-white/10 max-w-3xl mx-auto md:ml-auto md:mr-6">
      {faqs.map((faq) => (
        <details name="faq" class="group border-b border-white/10">
          <summary class="flex items-center justify-between py-8 cursor-pointer list-none">
            <h3 class="text-[16px] md:text-[19px] font-bold text-white group-hover:text-[#C9A84C] transition-colors duration-300 pr-4">
              {faq.question}
            </h3>
            <div class="relative w-7 h-7 flex-shrink-0 flex items-center justify-center border-2 border-[#C9A84C] rounded-full transition-all duration-300 group-hover:scale-110">
              <!-- Plus Icon (Bolder) -->
              <span class="absolute w-3 h-[2.5px] bg-[#C9A84C]"></span>
              <span class="absolute h-3 w-[2.5px] bg-[#C9A84C] group-open:hidden"></span>
            </div>
          </summary>
          <div class="pb-10 animate-fade-down">
            <p class="text-[#A3A3A3] text-[15px] md:text-[16px] leading-[1.8] max-w-4xl">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-down {
    animation: fade-down 0.4s ease-out forwards;
  }
</style>