---
const faqs = [
  {
    question: "What is your minimum order quantity (MOQ)?",
    answer: "MOQ starts from 50 pieces for ready-to-ship styles with logo customization. For OEM activewear production, MOQ varies depending on fabric and design complexity. We provide flexible solutions for both growing and established brands."
  },
  {
    question: "How long does production take?",
    answer: "Ready-to-ship products can usually be delivered within 7 days. Private label orders generally take 15–25 days depending on customization requirements. OEM development timelines vary according to fabric sourcing and sample approval."
  },
  {
    question: "Do you provide a physical sample before bulk production?",
    answer: "Yes, we always provide a physical pre-production sample for your approval before starting the bulk order. This ensures the fit, fabric, and branding are exactly as you envisioned."
  },
  {
    question: "Can I use my own design / Pantone colors?",
    answer: "Absolutely. We specialize in OEM customization. You can provide your own tech packs or design ideas, and we can match any Pantone color to ensure your brand's consistency."
  },
  {
    question: "What finishing options are available?",
    answer: "We offer complete private label solutions including heat transfer logos, silicone logos, woven labels, care labels, hang tags, and custom packaging bags to elevate your brand identity."
  },
  {
    question: "What are your payment terms?",
    answer: "We typically require a 30-50% deposit to start production, with the balance due before shipping. We accept major payment methods including T/T, Western Union, and Alibaba Trade Assurance."
  },
  {
    question: "Do you ship worldwide? What about customs?",
    answer: "Yes, we ship to over 50 countries via premium carriers like DHL, FedEx, and UPS, as well as sea freight. We handle all export documentation to ensure a smooth customs process."
  }
];
---

<section id="intelligence" class="py-24 bg-[#050505] text-white overflow-hidden font-['Century_Gothic',sans-serif]">
  <div class="container mx-auto px-6 max-w-4xl">
    <!-- Section Header -->
    <div class="mb-16 text-left max-w-2xl mx-auto md:ml-auto md:mr-16">
      <span class="block text-[#C9A84C] text-[12px] font-bold tracking-[0.25em] uppercase mb-4">
        FAQ
      </span>
      <h2 class="text-[30px] md:text-[44px] font-bold mb-6 leading-[1.1] tracking-tight">
        Questions We Get <span class="text-[#C9A84C] italic">All the Time</span>
      </h2>
      <p class="text-white/40 text-[15px] md:text-[16px] max-w-[700px] leading-relaxed">
        Everything you need to know before placing your first order.
      </p>
    </div>

    <!-- FAQ Accordion (Luxopack Style) -->
    <div class="border-t border-white/10 max-w-2xl mx-auto md:ml-auto md:mr-16">
      {faqs.map((faq) => (
        <details name="faq" class="group border-b border-white/10">
          <summary class="flex items-center justify-between py-8 cursor-pointer list-none">
            <h3 class="text-[16px] md:text-[18px] font-bold text-white group-hover:text-[#C9A84C] transition-colors duration-300 pr-12 leading-tight">
              {faq.question}
            </h3>
            <div class="relative w-7 h-7 flex-shrink-0 flex items-center justify-center border-[1.5px] border-[#C9A84C]/60 rounded-full transition-all duration-300 group-hover:scale-110 group-hover:border-[#C9A84C]">
              <!-- Plus Icon (Refined) -->
              <span class="absolute w-3 h-[2px] bg-[#C9A84C]"></span>
              <span class="absolute h-3 w-[2px] bg-[#C9A84C] group-open:hidden"></span>
            </div>
          </summary>
          <div class="pb-10 animate-fade-down">
            <p class="text-[#A3A3A3] text-[15px] md:text-[16px] leading-[1.8] max-w-4xl">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-down {
    animation: fade-down 0.4s ease-out forwards;
  }
</style>
