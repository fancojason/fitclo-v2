---
---

<section class="py-20 bg-black overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <!-- Left Content -->
      <div class="flex-1 text-center lg:text-left">
        <h3 class="text-[#C9A84C] font-bold tracking-widest text-sm mb-4 uppercase">
          Inside Our Factory
        </h3>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight font-['Montserrat',sans-serif]">
          See Your Clothing Being Made — <span class="text-[#C9A84C]">Live.</span>
        </h2>
        <p class="text-gray-400 text-lg mb-10 max-w-2xl leading-relaxed">
          12,000 sqm. 350+ skilled workers. 20+ Production lines. We send photo and video updates throughout your production — you'll never wonder what's happening to your order.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#factory-tour"
            class="bg-[#C9A84C] text-black font-bold py-4 px-8 rounded-md transition-all hover:bg-[#b39540] w-full sm:w-auto text-center"
          >
            🎬 Full Factory Tour
          </a>
          <a
            href="#inquiry"
            class="border-2 border-[#C9A84C] text-[#C9A84C] font-bold py-4 px-8 rounded-md transition-all hover:bg-[#C9A84C] hover:text-black w-full sm:w-auto text-center"
          >
            Get Free Quote &rarr;
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="flex-1 relative group w-full">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://sc01.alicdn.com/kf/Haa8f67d0115749baa82310229e2b476fX.jpg"
            alt="Fitclo Clothing Factory Production Line"
            class="w-full h-[400px] object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          
          <!-- Location Badge -->
          <div class="absolute bottom-6 left-6 bg-black/80 backdrop-blur-sm border border-[#C9A84C]/30 py-2 px-4 rounded-lg">
            <p class="text-[#C9A84C] text-xs font-bold tracking-widest flex items-center gap-2">
              <span class="text-red-500">📍</span> SHENZHEN, CHINA · LIVE PRODUCTION
            </p>
          </div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#C9A84C]/10 blur-3xl rounded-full"></div>
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-[#C9A84C]/5 blur-3xl rounded-full"></div>
      </div>
    </div>
  </div>
</section>
