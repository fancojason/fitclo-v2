---
---

<section class="py-24 bg-black overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 xl:gap-24">
      <!-- Left Content -->
      <div class="flex-1 text-center lg:text-left">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[11px] mb-6 uppercase font-['Montserrat',sans-serif]">
          Inside Our Factory
        </h3>
        <h2 class="text-[28px] md:text-[34px] lg:text-[40px] font-normal text-white mb-8 leading-tight font-['Oswald',sans-serif] whitespace-nowrap lg:-ml-10">
          See <span class="text-white">Your</span> Clothing Being Made — <span class="text-[#C9A84C]">Live.</span>
        </h2>
        <p class="text-gray-400 text-[17px] mb-12 max-w-xl leading-relaxed font-['Century_Gothic',sans-serif]">
          16,000 sqm. 350+ skilled workers. 20+ Production lines. We send photo and video updates throughout your production — you'll never wonder what's happening to your order.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5">
          <a
            href="#factory-tour"
            class="bg-[#C9A84C] text-black font-bold py-3.5 px-10 rounded-md transition-all hover:bg-[#b39540] w-full sm:w-auto text-center tracking-widest text-[13px] uppercase font-['Century_Gothic',sans-serif] shadow-lg shadow-[#C9A84C]/10"
          >
            🎬 Full Factory Tour
          </a>
          <a
            href="#inquiry"
            class="border border-[#C9A84C] text-[#C9A84C] font-bold py-3.5 px-10 rounded-md transition-all hover:bg-[#C9A84C] hover:text-black w-full sm:w-auto text-center tracking-widest text-[13px] uppercase font-['Century_Gothic',sans-serif]"
          >
            Get Free Quote &rarr;
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="flex-[1.4] relative group w-full lg:translate-x-10">
        <div class="relative rounded-xl overflow-hidden shadow-2xl">
          <img
            src="https://sc01.alicdn.com/kf/Ha16ea96d535245ac9951b70f83399e0eY.jpg"
            alt="Fitclo Clothing Factory Production Line"
            class="w-full h-[480px] object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
          
          <!-- Location Badge -->
          <div class="absolute bottom-6 left-6 bg-black/80 backdrop-blur-md border border-[#C9A84C]/20 py-2.5 px-5 rounded-lg">
            <p class="text-[#C9A84C] text-[11px] font-bold tracking-[0.2em] flex items-center gap-2.5 font-['Century_Gothic',sans-serif]">
              <span class="inline-block w-1.5 h-1.5 bg-red-600 rounded-full animate-pulse"></span>
              GUANGZHOU, CHINA · LIVE PRODUCTION
            </p>
          </div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute -top-16 -right-16 w-64 h-64 bg-[#C9A84C]/10 blur-[100px] rounded-full pointer-events-none opacity-50"></div>
        <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-[#C9A84C]/5 blur-[100px] rounded-full pointer-events-none opacity-30"></div>
      </div>
    </div>
  </div>
</section>
