---
---

<section class="pt-32 pb-12 bg-black overflow-hidden">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-32">
      <!-- Left Content -->
      <div class="w-full lg:w-[44%] text-center lg:text-left">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          Inside Our Factory
        </h3>
        <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white mb-6 leading-tight font-['Century_Gothic',sans-serif] tracking-tight whitespace-nowrap">
          See <span class="text-white">Your</span> Clothing Being Made — <span class="text-[#C9A84C] italic">Live.</span>
        </h2>
        <p class="text-white/60 text-[14px] md:text-[15px] mb-10 max-w-xl leading-relaxed font-['Century_Gothic',sans-serif]">
          16,000 sqm. 350+ skilled workers. 20+ Production lines. We send photo and video updates throughout your production — you'll never wonder what's happening to your order.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5">
          <a
            href="#factory-tour"
            class="bg-[#C9A84C] text-black font-extrabold py-[16px] px-10 rounded-md transition-all hover:bg-[#b39540] w-full sm:w-auto text-center tracking-wider text-[15px] font-['Century_Gothic',sans-serif] shadow-lg shadow-[#C9A84C]/10 hover:scale-[1.02] active:scale-95"
          >
            🎬 Full Factory Tour
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=8617160837538&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F"
            target="_blank"
            class="border border-[#C9A84C] text-[#C9A84C] font-extrabold py-[16px] px-10 rounded-md transition-all hover:bg-[#C9A84C] hover:text-black w-full sm:w-auto text-center tracking-wider text-[15px] font-['Century_Gothic',sans-serif] hover:scale-[1.02] active:scale-95"
          >
            Get Free Quote &rarr;
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="w-full lg:w-[48%] relative group lg:translate-x-12">
        <div class="relative rounded-xl overflow-hidden shadow-2xl">
          <img
            src="https://sc01.alicdn.com/kf/Ha16ea96d535245ac9951b70f83399e0eY.jpg"
            alt="Inside Fitclo Factory: Professional Yoga Wear Production Line and Quality Control"
            class="w-full h-[420px] object-cover transition-transform duration-1000 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute -top-16 -right-16 w-64 h-64 bg-[#C9A84C]/10 blur-[100px] rounded-full pointer-events-none opacity-50"></div>
        <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-[#C9A84C]/5 blur-[100px] rounded-full pointer-events-none opacity-30"></div>
      </div>
    </div>
  </div>
</section>
