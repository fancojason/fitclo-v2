---
---

<section class="py-24 bg-black overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col lg:flex-row items-center gap-20">
      <!-- Left Content -->
      <div class="flex-1 text-center lg:text-left">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-xs mb-6 uppercase font-['Montserrat',sans-serif]">
          Inside Our Factory
        </h3>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-white mb-8 leading-tight font-['Montserrat',sans-serif] whitespace-nowrap">
          See Your Clothing Being Made — <span class="text-[#C9A84C]">Live.</span>
        </h2>
        <p class="text-gray-400 text-lg mb-12 max-w-xl leading-relaxed font-['Century_Gothic',sans-serif]">
          16,000 sqm. 350+ skilled workers. 20+ Production lines. We send photo and video updates throughout your production — you'll never wonder what's happening to your order.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6">
          <a
            href="#factory-tour"
            class="bg-[#C9A84C] text-black font-extrabold py-5 px-12 rounded-md transition-all hover:bg-[#b39540] w-full sm:w-auto text-center tracking-wider text-sm uppercase shadow-lg shadow-[#C9A84C]/20"
          >
            🎬 Full Factory Tour
          </a>
          <a
            href="#inquiry"
            class="border-2 border-[#C9A84C] text-[#C9A84C] font-extrabold py-5 px-12 rounded-md transition-all hover:bg-[#C9A84C] hover:text-black w-full sm:w-auto text-center tracking-wider text-sm uppercase"
          >
            Get Free Quote &rarr;
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="flex-[1.2] relative group w-full">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://sc01.alicdn.com/kf/Haa8f67d0115749baa82310229e2b476fX.jpg"
            alt="Fitclo Clothing Factory Production Line"
            class="w-full h-[500px] object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          
          <!-- Location Badge -->
          <div class="absolute bottom-8 left-8 bg-black/80 backdrop-blur-md border border-[#C9A84C]/30 py-3 px-6 rounded-xl">
            <p class="text-[#C9A84C] text-xs font-bold tracking-[0.15em] flex items-center gap-3">
              <span class="inline-block w-2 h-2 bg-red-600 rounded-full animate-pulse"></span>
              GUANGZHOU, CHINA · LIVE PRODUCTION
            </p>
          </div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute -top-20 -right-20 w-64 h-64 bg-[#C9A84C]/10 blur-[120px] rounded-full pointer-events-none"></div>
        <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-[#C9A84C]/5 blur-[120px] rounded-full pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>
