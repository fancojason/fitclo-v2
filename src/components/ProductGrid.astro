---
const categories = [
  { 
    name: 'Sports Bra', 
    image: 'https://sc01.alicdn.com/kf/Hcd3a09975e5547b9baa61b4fb2cee8390.png',
    link: '/capabilities#sports-bra'
  },
  { 
    name: 'Women Top', 
    image: 'https://sc01.alicdn.com/kf/H61f072775f6642f3929f3a3c875b9eed4.jpg',
    link: '/capabilities#women-top'
  },
  { 
    name: 'Tank Top', 
    image: 'https://sc01.alicdn.com/kf/H11309037b38f454bb0de2db1a3dba2fbk.png',
    link: '/capabilities#tank-top'
  },
  { 
    name: 'Women Leggings', 
    image: 'https://sc01.alicdn.com/kf/H4837d48e3e704fc8a3173a9ed39554feK.png',
    link: '/capabilities#women-leggings'
  },
  { 
    name: 'Women Shorts', 
    image: 'https://sc01.alicdn.com/kf/H8def62b2f66c4877be38f2eeba3f0b85L.png',
    link: '/capabilities#women-shorts'
  },
  { 
    name: 'Sports Pants', 
    image: 'https://sc01.alicdn.com/kf/H6dea2380db0944b0957904c8458265c8H.png',
    link: '/capabilities#sports-pants'
  },
];
---

<section id="products" class="py-24 bg-black text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <!-- Header aligned perfectly with the first and third grid card edges (No translations, max-w-1200px) -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-8 gap-6">
      <div>
        <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          Featured Categories
        </h3>
        <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight whitespace-nowrap">
          Core <span class="text-[#C9A84C] italic">Collections</span>
        </h2>
        <p class="text-gray-400 mt-3 max-w-xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
          Crafted with advanced textile technology and ergonomic designs. Available for blank-label and custom manufacturing solutions.
        </p>
      </div>
      <div class="pb-1">
        <a href="/products" class="inline-block border border-[#C9A84C] text-[#C9A84C] font-bold py-2 px-5 rounded transition-all hover:bg-[#C9A84C] hover:text-black hover:scale-[1.02] active:scale-95 text-[12px] tracking-wider font-['Century_Gothic',sans-serif]">
          View Full Catalog
        </a>
      </div>
    </div>

    <!-- Categories Grid (Narrower card widths, fits perfectly on a single screen) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map(cat => (
        <a href={cat.link} class="group block bg-[#EEEEEE] p-4 rounded-[20px] border border-transparent hover:border-[#C9A84C]/30 hover:shadow-[0_10px_30px_rgba(201,168,76,0.12)] hover:-translate-y-1 transition-all duration-500">
          <!-- Compact Portrait Image frame (aspect-[4/5] + narrow container = stunning fit) -->
          <div class="relative aspect-[4/5] overflow-hidden rounded-[15px] bg-white">
            <img 
              src={cat.image} 
              alt={cat.name} 
              class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:brightness-[1.05]" 
            />
            <!-- Metallic Shimmer Sweep Light Effect on hover -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1000ms] ease-out pointer-events-none z-10"></div>
          </div>
          <!-- Label below -->
          <div class="mt-3 flex items-center justify-between px-1">
            <h3 class="text-[15px] md:text-[16px] font-bold text-black font-['Century_Gothic',sans-serif] tracking-wide transition-colors group-hover:text-[#C9A84C]">
              {cat.name} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5 ml-1">→</span>
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
