---
const categories = [
  { 
    name: 'Sports Bra', 
    image: 'https://sc01.alicdn.com/kf/Hcd3a09975e5547b9baa61b4fb2cee8390.png',
    link: '/capabilities#sports-bra'
  },
  { 
    name: 'Women Top', 
    image: 'https://images.unsplash.com/photo-1506152983158-b4a74a01c721?auto=format&fit=crop&w=800&q=80',
    link: '/capabilities#women-top'
  },
  { 
    name: 'Tank Top', 
    image: 'https://images.unsplash.com/photo-1518622358385-8ea7d0794bf6?auto=format&fit=crop&w=800&q=80',
    link: '/capabilities#tank-top'
  },
  { 
    name: 'Women Leggings', 
    image: 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=800&q=80',
    link: '/capabilities#women-leggings'
  },
  { 
    name: 'Women Shorts', 
    image: 'https://images.unsplash.com/photo-1591117207239-788cd82e427d?auto=format&fit=crop&w=800&q=80',
    link: '/capabilities#women-shorts'
  },
  { 
    name: 'Sports Pants', 
    image: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=800&q=80',
    link: '/capabilities#sports-pants'
  },
];
---

<section id="products" class="py-24 bg-black text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <!-- Header aligned perfectly with the first and third grid card edges (No translations, max-w-1200px) -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-8 gap-6">
      <div>
        <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[11px] md:text-[12px] mb-3 uppercase font-['Montserrat',sans-serif]">
          Featured Categories
        </h3>
        <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white leading-tight font-['Montserrat',sans-serif] tracking-tight whitespace-nowrap">
          Core <span class="text-[#C9A84C] italic">Collections</span>
        </h2>
        <p class="text-gray-400 mt-3 max-w-xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
          Crafted with advanced textile technology and ergonomic designs. All available for white-label and full customization.
        </p>
      </div>
      <div class="pb-1">
        <a href="/capabilities" class="inline-block border border-[#C9A84C] text-[#C9A84C] font-bold py-2 px-5 rounded transition-all hover:bg-[#C9A84C] hover:text-black hover:scale-[1.02] active:scale-95 text-[12px] tracking-wider font-['Century_Gothic',sans-serif]">
          View Full Catalog
        </a>
      </div>
    </div>

    <!-- Categories Grid (Narrower card widths, fits perfectly on a single screen) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map(cat => (
        <a href={cat.link} class="group block bg-[#EEEEEE] p-4 rounded-[20px] hover:scale-[1.01] transition-all duration-500 shadow-lg">
          <!-- Compact Portrait Image frame (aspect-[4/5] + narrow container = stunning fit) -->
          <div class="relative aspect-[4/5] overflow-hidden rounded-[15px] bg-white">
            <img 
              src={cat.image} 
              alt={cat.name} 
              class="w-full h-full object-cover grayscale transition-transform duration-1000 group-hover:scale-105 group-hover:grayscale-0" 
            />
          </div>
          <!-- Label below -->
          <div class="mt-3 flex items-center justify-between px-1">
            <h3 class="text-[15px] md:text-[16px] font-bold text-black font-['Century_Gothic',sans-serif] tracking-wide transition-colors group-hover:text-[#C9A84C]">
              {cat.name} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 ml-1">→</span>
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
