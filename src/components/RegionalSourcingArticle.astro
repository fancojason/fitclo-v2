---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappIntelligenceUrl } from '../data/intelligence';

const {
  title,
  description,
  type = 'Regional Sourcing Guide',
  publishedDate = 'July 15, 2026',
  readTime = '9 min read',
  faqs = [],
  image = 'https://www.fitcloo.com/images/intelligence/cover-factory-guide.png',
  canonicalPath,
  ctaTitle = 'Planning an activewear program for your market?',
  ctaText = 'Send Fitclo your target products, expected quantity, destination and reference direction. We can help you compare a ready-to-ship, private label or custom development route.',
} = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image,
  datePublished: '2026-07-15',
  dateModified: '2026-07-15',
  mainEntityOfPage: `https://www.fitcloo.com${canonicalPath}`,
  author: {
    '@type': 'Organization',
    name: 'FITCLO Team',
    url: 'https://www.fitcloo.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fitclo',
    url: 'https://www.fitcloo.com',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={`${title} | Fitclo Blog`}
  description={description}
  image={image}
  structuredData={[articleSchema, faqSchema]}
  autoArticleSchema={false}
>
  <article class="regional-article">
    <div class="regional-wrap">
      <span class="regional-tag">{type}</span>
      <h1>{title}</h1>
      <div class="regional-meta">
        <span class="regional-calendar" aria-hidden="true"></span>
        <span>{publishedDate}</span>
        <span>|</span>
        <span>{readTime}</span>
        <span>|</span>
        <span>By FITCLO Team</span>
      </div>

      <slot name="answer" />
      <slot />

      <h2>Frequently asked questions</h2>
      <div class="regional-faq-list">
        {faqs.map((item) => (
          <div class="regional-faq-item">
            <div class="regional-faq-q">{item.question}</div>
            <div class="regional-faq-a">{item.answer}</div>
          </div>
        ))}
      </div>

      <div class="regional-callout regional-cta-box">
        <strong>{ctaTitle}</strong>
        <span>{ctaText}</span>
        <a class="regional-cta" href={whatsappIntelligenceUrl} target="_blank" rel="noopener">Talk to Fitclo</a>
      </div>

      <slot name="related" />
    </div>
  </article>
</BaseLayout>

<style>
  :global(body) {
    background: #0a0a0f;
  }

  .regional-article {
    --regional-panel: #12121a;
    --regional-gold: #c9a84c;
    --regional-border: rgba(255, 255, 255, 0.08);
    --regional-muted: #a2a2ae;
    background: radial-gradient(circle at top left, rgba(201, 168, 76, 0.08), transparent 34rem), linear-gradient(180deg, #0a0a0f 0%, #09090d 100%);
    color: rgba(255, 255, 255, 0.85);
    font-family: "Century Gothic", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.8;
    min-height: 100vh;
  }

  .regional-wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 72px 24px 92px;
  }

  .regional-tag {
    display: inline-block;
    margin-bottom: 18px;
    padding: 5px 14px;
    border: 1px solid rgba(201, 168, 76, 0.32);
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.1);
    color: var(--regional-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .regional-article h1 {
    margin: 0 0 14px;
    color: #fff;
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .regional-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-bottom: 36px;
    color: var(--regional-muted);
    font-size: 0.85rem;
  }

  .regional-calendar {
    position: relative;
    display: inline-block;
    width: 13px;
    height: 13px;
    border-radius: 2px;
    background: #f3f0e8;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .regional-calendar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    border-radius: 2px 2px 0 0;
    background: #ef675c;
  }

  .regional-calendar::after {
    content: "";
    position: absolute;
    left: 3px;
    bottom: 3px;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--regional-gold);
    box-shadow: 4px 0 0 var(--regional-gold);
  }

  .regional-article :global(h2) {
    margin: 44px 0 14px;
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.48rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .regional-article :global(h3) {
    margin: 28px 0 10px;
    color: var(--regional-gold);
    font-size: 1.08rem;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .regional-article :global(p),
  .regional-article :global(li) {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    line-height: 1.8;
  }

  .regional-article :global(p) {
    margin: 0 0 1.15rem;
  }

  .regional-article :global(strong) {
    color: #fff;
    font-weight: 850;
  }

  .regional-article :global(a) {
    color: var(--regional-gold);
    font-weight: 800;
    text-decoration: none;
  }

  .regional-article :global(a:hover) {
    opacity: 0.82;
  }

  .regional-article :global(ul),
  .regional-article :global(ol) {
    margin: 16px 0 24px;
    padding-left: 1.25rem;
  }

  .regional-article :global(li) {
    margin: 8px 0;
    padding-left: 0.1rem;
  }

  .regional-article :global(.regional-answer),
  .regional-article :global(.regional-callout),
  .regional-callout {
    margin: 24px 0;
    padding: 18px 22px;
    border: 1px solid rgba(201, 168, 76, 0.25);
    border-left: 4px solid var(--regional-gold);
    border-radius: 10px;
    background: var(--regional-panel);
  }

  .regional-article :global(.regional-answer p) {
    margin-bottom: 0;
  }

  .regional-article :global(.regional-table-scroll) {
    overflow-x: auto;
    margin: 20px 0;
    -webkit-overflow-scrolling: touch;
  }

  .regional-article :global(table) {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 8px;
    background: var(--regional-panel);
    font-size: 0.92rem;
  }

  .regional-article :global(th),
  .regional-article :global(td) {
    border: 1px solid var(--regional-border);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .regional-article :global(th) {
    background: rgba(201, 168, 76, 0.1);
    color: var(--regional-gold);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .regional-article :global(td) {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
  }

  .regional-article :global(.regional-market-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 22px 0;
  }

  .regional-article :global(.regional-market-card) {
    padding: 18px;
    border: 1px solid var(--regional-border);
    border-radius: 8px;
    background: var(--regional-panel);
  }

  .regional-article :global(.regional-market-card strong),
  .regional-article :global(.regional-market-card span) {
    display: block;
  }

  .regional-article :global(.regional-market-card strong) {
    margin-bottom: 7px;
  }

  .regional-article :global(.regional-market-card span) {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  .regional-faq-list {
    margin-top: 8px;
  }

  .regional-faq-item {
    border-bottom: 1px solid var(--regional-border);
    padding: 18px 0;
  }

  .regional-faq-q {
    margin-bottom: 8px;
    color: #fff;
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.45;
  }

  .regional-faq-a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .regional-cta-box {
    display: grid;
    gap: 12px;
  }

  .regional-cta-box span {
    display: block;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .regional-cta {
    display: inline-block;
    justify-self: start;
    margin-top: 4px;
    padding: 13px 28px;
    border-radius: 6px;
    background: var(--regional-gold);
    color: #060608 !important;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .regional-wrap {
      padding: 52px 18px 72px;
    }

    .regional-article h1 {
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }

    .regional-article :global(.regional-market-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
