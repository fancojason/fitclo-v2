---
const stats = [
  { 
    label: '16+ Years Experience', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`
  },
  { 
    label: '12,000m² Production Plants', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>`
  },
  { 
    label: '350+ Staff & Equipments', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-8 0h-4V4h4v2zm0 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm4 7H8v-.5c0-1.38 2.24-2.5 4-2.5s4 1.12 4 2.5v.5z"/></svg>`
  },
  { 
    label: '450,000 Pcs Monthly Capacity', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>`
  },
];
---

<section id="factory" class="py-20 bg-white border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-0">
      {stats.map((stat, index) => (
        <div class="flex-1 w-full flex flex-col items-center justify-center relative">
          <!-- Icon -->
          <div class="text-black mb-6 hover:scale-110 transition-transform duration-300">
            <Fragment set:html={stat.icon} />
          </div>
          
          <!-- Label -->
          <div class="text-[14px] font-medium text-gray-500 text-center font-['Century_Gothic',sans-serif] tracking-wide px-4">
            {stat.label}
          </div>

          <!-- Vertical Divider (Hidden on mobile, shown on desktop for all but last) -->
          {index !== stats.length - 1 && (
            <div class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 w-[1px] h-24 bg-gray-200"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
