---
const stats = [
  { 
    label: '16+ Years Experience', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm3.36 15.5L12 15.27l-3.36 2.23.89-3.81-2.93-2.54 3.89-.33L12 7.27l1.51 3.55 3.89.33-2.93 2.54.89 3.81z"/></svg>`
  },
  { 
    label: '12,000m² Production Plants', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>`
  },
  { 
    label: '350+ Staff & Equipments', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-8 0h-4V4h4v2zm0 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm4 7H8v-.5c0-1.38 2.24-2.5 4-2.5s4 1.12 4 2.5v.5z"/></svg>`
  },
  { 
    label: '450,000 Pcs Monthly Capacity', 
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><path d="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/><path d="M4 12l5.4-5.4 4.1 4.1L20 4.1V9h2V2h-7v2h4.5l-6.1 6.1-4.1-4.1L3.3 11.3 4 12z"/></svg>`
  },
];
---

<section id="factory" class="py-24 bg-black border-y border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-12 md:gap-0">
      {stats.map((stat, index) => (
        <div class="flex-1 w-full flex flex-col items-center justify-center relative group">
          <!-- Icon Container -->
          <div class="text-white mb-8 transform group-hover:scale-110 group-hover:text-[#e60012] transition-all duration-300">
            <Fragment set:html={stat.icon} />
          </div>
          
          <!-- Label -->
          <div class="text-[16px] md:text-[18px] font-bold text-white text-center font-['Century_Gothic',sans-serif] tracking-wide px-4 group-hover:text-[#e60012] transition-colors duration-300">
            {stat.label}
          </div>

          <!-- Vertical Divider (Hidden on mobile, shown on desktop for all but last) -->
          {index !== stats.length - 1 && (
            <div class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 w-[1px] h-32 bg-gray-800"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
