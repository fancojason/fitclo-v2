---
const reviews = [
  {
    stars: "★★★★★",
    content: "“We started with private label yoga leggings and now purchase multiple collections every season. Fitclo is responsive, quality is stable, and delivery is always on schedule.”",
    name: "Verified Brand Owner",
    role: "Founder, Bloom & Co. Skincare",
    country: "US",
    avatar: "https://randomuser.me/api/portraits/women/44.jpg"
  },
  {
    stars: "★★★★★",
    content: "“After trying 3 other China factories, Fitclo is in a completely different league. The quality is consistent, communication is excellent, and they handled our custom size perfectly.”",
    name: "Luxury Apparel Retailer",
    role: "Procurement Manager, GiftCo Europe",
    country: "GB",
    avatar: "https://randomuser.me/api/portraits/men/32.jpg"
  },
  {
    stars: "★★★★★",
    content: "“We order 50,000 sets per quarter. Fitclo has never missed a deadline in 3 years. Their design team is fast and professional. The price-quality ratio is unmatched.”",
    name: "Amira Khalil",
    role: "Supply Chain Director, Luxe Beauty KSA",
    country: "SA",
    avatar: "https://randomuser.me/api/portraits/women/68.jpg"
  }
];

const stats = [
  { value: "8+", label: "Years Export Experience" },
  { value: "1000+", label: "Styles Available" },
  { value: "50+", label: "Countries Served" },
  { value: "7 Days", label: "Ready to Ship" }
];

const countries = [
  { code: "🇺🇸", name: "USA" },
  { code: "🇨🇦", name: "Canada" },
  { code: "🇬🇧", name: "UK" },
  { code: "🇪🇺", name: "Europe" },
  { code: "🇦🇺", name: "Australia" },
  { code: "🇦🇪", name: "Middle East" }
];
---

<section id="client-success" class="py-24 bg-[#050505] text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    
    <!-- Section Header (Left Aligned - Luxopack Style) -->
    <div class="flex flex-col mb-16 lg:-translate-x-12">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        CLIENT REVIEWS
      </h3>
      <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-5">
        What Our <span class="text-[#C9A84C] italic">Clients Say</span>
      </h2>
      <p class="text-gray-400 mt-2 max-w-xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Real feedback from brands who trust Fitclo for their activewear manufacturing and global supply chain.
      </p>
    </div>

    <!-- Testimonial Cards Grid (Wider, Shorter Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-24">
      {reviews.map((review) => (
        <div class="group relative bg-[#0D1526] border border-white/10 rounded-2xl p-8 md:p-10 transition-all duration-500 hover:border-[#C9A84C]/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.3)] flex flex-col justify-between min-h-[320px]">
          <!-- Gold Accent Line Animation -->
          <div class="absolute top-0 left-0 w-0 h-[2px] bg-[#C9A84C] transition-all duration-500 group-hover:w-full"></div>
          
          <div>
            <div class="text-[#D4AF37] text-[16px] mb-6 tracking-widest">{review.stars}</div>
            <blockquote class="text-[#A3A3A3] text-[15px] md:text-[16px] leading-[1.7] mb-8 font-['Century_Gothic',sans-serif]">
              {review.content}
            </blockquote>
          </div>
          
          <div class="flex items-center justify-between border-t border-white/5 pt-6">
            <div class="flex items-center space-x-4">
              <div class="w-10 h-10 rounded-full overflow-hidden border border-[#C9A84C]/20">
                <img src={review.avatar} alt={review.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <div class="text-white font-bold text-[14px] font-['Century_Gothic',sans-serif] tracking-tight">{review.name}</div>
                <div class="text-white/40 text-[11px] font-['Century_Gothic',sans-serif]">{review.role}</div>
              </div>
            </div>
            <div class="text-white/20 text-[12px] font-bold font-['Century_Gothic',sans-serif] tracking-widest uppercase">{review.country}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Numbers Section (Refined) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-16 border-y border-white/5">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="text-[36px] md:text-[44px] font-bold text-[#C9A84C] mb-1 font-['Century_Gothic',sans-serif]">
            {stat.value}
          </div>
          <div class="text-white/40 text-[11px] font-bold uppercase tracking-widest font-['Century_Gothic',sans-serif]">
            {stat.label}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>