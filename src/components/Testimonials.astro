---
const testimonials = [
  {
    quote: "Fitclo exceeded every expectation. The high-performance yoga sets arrived on time, perfectly finished. Our customers literally comment on the quality and stitching before they even wear them. Will definitely reorder.",
    author: "Sarah J. — Founder of Aura Athletics (USA)"
  },
  {
    quote: "After trying 5 other factories in China, Fitclo is in a completely different league. The consistency in fabric quality is excellent, and they handled our custom 3D silicone logos perfectly. Highly recommend for serious brands.",
    author: "Marc L. — Creative Director, Evolve Sport (Europe)"
  },
  {
    quote: "We order 20,000 pieces per quarter. Fitclo has never missed a deadline in 3 years. Their design team is fast and professional. The price-quality ratio is unmatched — I've compared over 30 suppliers.",
    author: "David K. — Procurement Manager, FlexFit (Australia)"
  }
];
---

<section class="py-24 bg-white text-black border-t border-gray-100">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16">
    <div class="mb-16">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.15em] text-[13px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
        TESTIMONIALS
      </h3>
      <h2 class="text-[32px] md:text-[44px] font-bold leading-[1.1] font-['Century_Gothic',sans-serif] tracking-tight mb-5">
        Real feedback from brands who <br/>
        <span class="text-[#C9A84C] italic text-black/90">trust Fitclo</span> for their activewear
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-12">
      {testimonials.map((t) => (
        <div class="flex flex-col justify-between">
          <div>
            <!-- Quote Icon -->
            <div class="mb-8 text-[#C9A84C] opacity-40">
              <svg width="40" height="30" viewBox="0 0 40 30" fill="currentColor">
                <path d="M0 30V15.5C0 11.2 0.7 7.7 2.1 5.1C3.5 2.5 5.5 0.8 8.1 0V5.8C6.9 6.4 6 7.3 5.3 8.6C4.6 9.9 4.3 11.3 4.3 12.8H10V30H0ZM17.1 30V15.5C17.1 11.2 17.8 7.7 19.2 5.1C20.6 2.5 22.6 0.8 25.2 0V5.8C24 6.4 23.1 7.3 22.4 8.6C21.7 9.9 21.4 11.3 21.4 12.8H27.1V30H17.1Z" />
              </svg>
            </div>
            <p class="text-[17px] md:text-[19px] leading-[1.7] text-black/70 italic font-['Century_Gothic',sans-serif] mb-10">
              "{t.quote}"
            </p>
          </div>
          <div class="border-t border-gray-100 pt-8">
            <p class="text-[#C9A84C] text-[14px] font-bold tracking-widest uppercase font-['Century_Gothic',sans-serif]">
              {t.author}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>