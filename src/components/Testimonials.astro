---
const reviews = [
  {
    stars: "★★★★★",
    content: "“We started with private label yoga leggings and now purchase multiple collections every season. Fitclo is responsive, quality is stable, and delivery is always on schedule. The cooperation has been smooth from day one.”",
    name: "Verified Yoga Brand Owner",
    role: "Founder, Boutique Activewear Brand",
    country: "US",
    avatar: "Y"
  },
  {
    stars: "★★★★★",
    content: "“After comparing several suppliers in China, Fitclo stood out for communication speed, fabric quality and flexibility. The team understands branding and makes customization easy.”",
    name: "Fitness Apparel Distributor",
    role: "Purchasing Manager",
    country: "UK",
    avatar: "F"
  },
  {
    stars: "★★★★★",
    content: "“We’ve been working with Fitclo for years. The production quality is consistent, and the team always provides solutions quickly. A reliable manufacturing partner we can trust.”",
    name: "Private Label Sportswear Brand",
    role: "Supply Chain Director",
    country: "AU",
    avatar: "P"
  }
];

const stats = [
  { value: "8+", label: "Years Export Experience" },
  { value: "1000+", label: "Styles Available" },
  { value: "50+", label: "Countries Served" },
  { value: "7 Days", label: "Ready to Ship" }
];

const countries = [
  { code: "🇺🇸", name: "USA" },
  { code: "🇨🇦", name: "Canada" },
  { code: "🇬🇧", name: "UK" },
  { code: "🇪🇺", name: "Europe" },
  { code: "🇦🇺", name: "Australia" },
  { code: "🇦🇪", name: "Middle East" }
];
---

<section id="client-success" class="py-32 bg-[#050505] text-white overflow-hidden border-t border-white/5">
  <div class="container mx-auto px-4 max-w-7xl">
    
    <!-- Section Header -->
    <div class="text-center mb-24">
      <span class="block text-[#C9A84C] text-[12px] font-bold tracking-[0.25em] uppercase mb-6 animate-fade-in font-['Century_Gothic',sans-serif]">
        CLIENT REVIEWS
      </span>
      <h2 class="text-[40px] md:text-[72px] font-bold mb-8 leading-[0.95] font-['Century_Gothic',sans-serif]">
        Global Brands <br/>
        <span class="text-[#C9A84C] italic">Trust Fitclo</span>
      </h2>
      <p class="text-[#A3A3A3] text-[18px] max-w-[700px] mx-auto font-['Century_Gothic',sans-serif] leading-relaxed">
        From startups to established activewear brands, customers worldwide choose Fitclo for reliable manufacturing, premium quality and long-term partnership.
      </p>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-32">
      {reviews.map((review) => (
        <div class="group relative bg-[#0B0B0B] border border-white/5 rounded-[24px] p-10 md:p-12 transition-all duration-500 hover:border-[#C9A84C]/20 hover:-translate-y-2 hover:shadow-[0_30px_60px_rgba(0,0,0,0.5)]">
          <!-- Gold Accent Line -->
          <div class="absolute top-0 left-0 w-0 h-[2px] bg-[#C9A84C] transition-all duration-500 group-hover:w-full"></div>
          
          <div class="text-[#D4AF37] text-[20px] mb-8 tracking-widest">{review.stars}</div>
          
          <blockquote class="text-[#A3A3A3] text-[16px] md:text-[18px] leading-[1.9] mb-12 font-['Century_Gothic',sans-serif] italic">
            {review.content}
          </blockquote>
          
          <div class="flex items-center justify-between border-t border-white/5 pt-8">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-[#C9A84C] rounded-full flex items-center justify-center text-[#0A0A0F] font-bold text-xl">
                {review.avatar}
              </div>
              <div>
                <div class="text-white font-bold text-[16px] font-['Century_Gothic',sans-serif]">{review.name}</div>
                <div class="text-white/40 text-[13px] font-['Century_Gothic',sans-serif]">{review.role}</div>
              </div>
            </div>
            <div class="text-white/20 text-[14px] font-bold font-['Century_Gothic',sans-serif] tracking-widest">{review.country}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Global Presence Section -->
    <div class="relative py-24 border-y border-white/5">
      <div class="absolute inset-0 opacity-10 flex items-center justify-center pointer-events-none">
        <!-- Simplified Map Representation -->
        <svg class="w-full max-w-5xl text-[#C9A84C]" viewBox="0 0 1000 500" fill="currentColor">
          <circle cx="200" cy="150" r="4" class="animate-pulse" /> <!-- US -->
          <circle cx="180" cy="120" r="4" class="animate-pulse" /> <!-- Canada -->
          <circle cx="480" cy="120" r="4" class="animate-pulse" /> <!-- Europe -->
          <circle cx="500" cy="140" r="4" class="animate-pulse" /> <!-- UK -->
          <circle cx="620" cy="220" r="4" class="animate-pulse" /> <!-- Middle East -->
          <circle cx="850" cy="380" r="4" class="animate-pulse" /> <!-- Australia -->
          <path d="M100,250 Q250,100 400,250 T700,250" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="5,5" />
        </svg>
      </div>

      <div class="relative z-10 text-center max-w-4xl mx-auto">
        <h3 class="text-[32px] md:text-[44px] font-bold mb-8 font-['Century_Gothic',sans-serif]">
          Serving <span class="text-[#C9A84C]">Brands</span> Worldwide
        </h3>
        <p class="text-[#A3A3A3] text-[16px] mb-12 font-['Century_Gothic',sans-serif]">
          Fitclo partners with activewear brands, distributors and retailers across multiple continents, providing ready-to-ship and private label solutions.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          {countries.map((c) => (
            <div class="bg-white/5 px-6 py-3 rounded-full border border-white/5 flex items-center space-x-3 transition-colors hover:border-[#C9A84C]/30 hover:bg-white/10">
              <span>{c.code}</span>
              <span class="text-[14px] font-bold tracking-widest uppercase font-['Century_Gothic',sans-serif] text-white/60">{c.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Trust Numbers Section -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-24">
      {stats.map((stat) => (
        <div class="text-center group transition-transform hover:scale-105">
          <div class="text-[48px] md:text-[56px] font-bold text-[#C9A84C] mb-2 font-['Century_Gothic',sans-serif] drop-shadow-[0_0_20px_rgba(201,168,76,0.3)]">
            {stat.value}
          </div>
          <div class="text-white text-[14px] md:text-[16px] font-bold uppercase tracking-widest font-['Century_Gothic',sans-serif] text-white/60">
            {stat.label}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
</style>