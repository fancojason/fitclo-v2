---
const reviews = [
  {
    stars: "★★★★★",
    content: "“We started with private label yoga leggings and now purchase multiple collections every season. Fitclo is responsive, quality is stable, and delivery is always on schedule. The cooperation has been smooth from day one.”",
    name: "Verified Yoga Brand Owner",
    role: "Founder, xxx Athletics",
    country: "US",
    avatar: "https://randomuser.me/api/portraits/women/44.jpg"
  },
  {
    stars: "★★★★★",
    content: "“After comparing several suppliers in China, Fitclo stood out for communication speed, fabric quality and flexibility. The team understands branding and makes customization easy.”",
    name: "Fitness Apparel Distributor",
    role: "Purchasing Manager, xxx Sport Europe",
    country: "GB",
    avatar: "https://randomuser.me/api/portraits/men/32.jpg"
  },
  {
    stars: "★★★★★",
    content: "“We’ve been working with Fitclo for years. The production quality is consistent, and the team always provides solutions quickly. A reliable manufacturing partner we can trust.”",
    name: "Private Label Sportswear Brand",
    role: "Supply Chain Director, xxx Australia",
    country: "AU",
    avatar: "https://randomuser.me/api/portraits/women/68.jpg"
  }
];

const stats = [
  { value: "8+", label: "Years Export Experience" },
  { value: "1000+", label: "Styles Available" },
  { value: "50+", label: "Countries Served" },
  { value: "7 Days", label: "Ready To Ship" }
];
---

<section id="testimonials" class="py-24 bg-[#050505] overflow-hidden">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <!-- Section Header (Left Aligned) -->
    <div class="flex flex-col mb-16 text-left">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        CLIENT REVIEWS
      </h3>
      <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-5">
        What Our <span class="text-[#C9A84C] italic">Clients Say</span>
      </h2>
      <p class="text-white/60 mt-2 max-w-xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Real feedback from brands who trust Fitclo for their activewear manufacturing and global supply chain.
      </p>
    </div>

    <!-- Testimonial Cards Grid (Centered, Wider & Shorter) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-24">
      {reviews.map((review) => (
        <div class="group relative bg-[#0D1526] border border-white/10 rounded-2xl p-6 md:p-8 transition-all duration-500 hover:border-[#C9A84C]/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.3)] flex flex-col justify-between min-h-[240px]">
          <!-- Gold Accent Line Animation -->
          <div class="absolute top-0 left-0 w-0 h-[2px] bg-[#C9A84C] transition-all duration-500 group-hover:w-full"></div>
          
          <div>
            <div class="text-[#D4AF37] text-[18px] md:text-[20px] mb-4 tracking-widest">{review.stars}</div>
            <blockquote class="text-white/80 text-[14px] md:text-[16px] italic leading-[1.6] mb-6 font-['Century_Gothic',sans-serif]">
              {review.content}
            </blockquote>
          </div>
          
          <div class="flex items-center justify-between border-t border-white/5 pt-5">
            <div class="flex items-center space-x-3">
              <div class="w-9 h-9 rounded-full overflow-hidden border border-[#C9A84C]/20">
                <img src={review.avatar} alt={review.name} class="w-full h-full object-cover" />
              </div>
              <div>
                <div class="text-white font-bold text-[13px] md:text-[14px] font-['Century_Gothic',sans-serif] tracking-tight leading-tight">{review.name}</div>
                <div class="text-white/60 text-[10px] md:text-[11px] font-['Century_Gothic',sans-serif]">{review.role}</div>
              </div>
            </div>
            <div class="text-white/50 text-[14px] md:text-[16px] font-bold font-['Century_Gothic',sans-serif] tracking-widest uppercase">{review.country}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Numbers Section (Refined) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-16 border-y border-white/5">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="text-[36px] md:text-[44px] font-bold text-[#C9A84C] mb-1 font-['Century_Gothic',sans-serif]">
            {stat.value}
          </div>
          <div class="text-white/60 text-[11px] font-bold uppercase tracking-widest font-['Century_Gothic',sans-serif]">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
