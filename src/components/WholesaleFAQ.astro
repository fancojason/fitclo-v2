---
import { businessFacts } from '../data/businessFacts';
const faqs = [
  {
    question: "What is the MOQ for custom activewear?",
    answer: `${businessFacts.readyStock.trial} ${businessFacts.oem.moq}`
  },
  {
    question: "Do you offer private label services?",
    answer: "Yes, we are a leading manufacturer of private label activewear. We offer various logo options (heat transfer, silicone, woven), custom labels, and branded packaging to match your brand's requirements."
  },
  {
    question: "Can I get a sample of my custom design?",
    answer: "Absolutely. We provide both digital mockups and physical pre-production samples. This ensures your custom activewear meets your exact specifications before mass production."
  },
  {
    question: "How long is shipping from your China factory?",
    answer: `${businessFacts.oem.bulkProduction} ${businessFacts.readyStock.dispatch} ${businessFacts.shipping}`
  }
];
---

<section id="wholesale-faq" class="py-24 bg-[#050505] text-white font-['Century_Gothic',sans-serif]">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="block text-[#C9A84C] text-[12px] font-[600] tracking-[0.25em] uppercase mb-4">
        WHOLESALE SUPPORT
      </span>
      <h2 class="text-[32px] md:text-[48px] font-bold leading-tight mb-6">
        Activewear Wholesale <span class="text-[#C9A84C] italic">FAQ</span>
      </h2>
      <p class="text-[#888888] text-[15px] md:text-[16px] leading-[1.8] max-w-[800px] mx-auto">
        Common questions about our wholesale activewear manufacturing and B2B ordering process.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12">
      {faqs.map((faq) => (
        <div class="group">
          <h3 class="text-[17px] md:text-[18px] font-bold mb-4 leading-tight group-hover:text-[#C9A84C] transition-colors">
            {faq.question}
          </h3>
          <p class="text-[#888888] text-[14px] md:text-[15px] leading-[1.8]">
            {faq.answer}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
