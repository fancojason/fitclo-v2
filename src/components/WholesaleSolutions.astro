<section id="wholesale" class="pt-24 pb-12 bg-black text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <!-- Header aligned perfectly with Left Image of Innovative Fabric R&D (shifted 48px left on desktop) -->
    <div class="flex flex-col mb-10 lg:-translate-x-12">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
        B2B Wholesale Solutions
      </h3>
      <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        Wholesale Activewear – <span class="text-[#C9A84C] italic">Custom Logo Available</span>
      </h2>
      <p class="text-gray-400 mt-4 max-w-3xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Premium fitness Apparel & Yoga Wear and custom branding solutions, engineered for fitness brands with factory-direct wholesale pricing.
      </p>
    </div>

    <!-- Wide Panoramic Banner Card matching Luxopack width, taller height, aligned perfectly to R&D (left) and Live Production (right) -->
    <div class="rounded-[20px] overflow-hidden border border-white/10 relative group bg-[#111111] shadow-2xl transition-all duration-500 hover:border-[#C9A84C]/30 hover:shadow-[0_15px_40px_rgba(201,168,76,0.1)] lg:-ml-12 lg:-mr-12">
      <div class="relative aspect-[16/9] md:aspect-[21/9] lg:aspect-[2.2/1] overflow-hidden bg-[#0A0A0A]">
        <img 
          src="https://sc02.alicdn.com/kf/Aa6c5bf20cc14428a9fb842b0adfd2820c.png" 
          alt="Premium Wholesale Activewear Custom Solutions" 
          class="w-full h-full object-cover transition-all duration-700 group-hover:scale-[1.01] group-hover:brightness-[1.03]" 
        />
        <!-- Metallic shimmer light sweep effect on hover -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1200ms] ease-out pointer-events-none z-10"></div>
        <!-- Shadow overlay for depth -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>

    <!-- 4-Column Premium Wholesale Products Grid replicating Luxopack, aligned perfectly left and right -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-16 lg:-ml-12 lg:-mr-12">
      {wholesaleProducts.map((product) => (
        <div class="rounded-2xl bg-[#111111] border border-white/10 overflow-hidden flex flex-col group transition-all duration-300 hover:border-[#C9A84C]/30 hover:translate-y-[-4px]">
          <!-- Card Image Container -->
          <div class="p-3">
            <div class="relative aspect-square overflow-hidden bg-[#18181B] rounded-xl flex items-center justify-center">
              <img 
                src={product.image} 
                alt={product.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" 
              />
            </div>
          </div>

          <!-- Product Details Content -->
          <div class="p-5 flex flex-col flex-grow text-left">
            <!-- Badge pill -->
            <div class="flex items-center mb-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#C9A84C]/10 text-[#C9A84C] border border-[#C9A84C]/20 font-['Century_Gothic',sans-serif]">
                {product.badge}
              </span>
            </div>

            <!-- Title -->
            <h4 class="text-[17px] md:text-[18px] font-bold text-white mb-2 font-['Century_Gothic',sans-serif] tracking-tight">
              {product.title}
            </h4>

            <!-- Description -->
            <p class="text-gray-400 text-[13px] leading-relaxed font-['Century_Gothic',sans-serif] mb-6 flex-grow line-clamp-3">
              {product.description}
            </p>

            <!-- Meta Information Row (Custom grid-cols-[auto_auto_1fr] to compress spacing and shift right columns left, keeping MOQ fixed) -->
            <div class="grid grid-cols-[auto_auto_1fr] gap-x-6 md:gap-x-8 border-t border-white/5 pt-4 mb-6 text-[10px] md:text-[11px] font-['Century_Gothic',sans-serif]">
              <div>
                <span class="block text-gray-500 uppercase tracking-wider mb-1">MOQ</span>
                <span class="block font-bold text-white text-[11px] md:text-[12px] whitespace-nowrap">{product.moq}</span>
              </div>
              <div>
                <span class="block text-gray-500 uppercase tracking-wider mb-1">Lead Time</span>
                <span class="block font-bold text-white text-[11px] md:text-[12px] whitespace-nowrap">{product.leadTime}</span>
              </div>
              <div class="min-w-0">
                <span class="block text-gray-500 uppercase tracking-wider mb-1">Customization</span>
                <span class="block font-bold text-white text-[11px] md:text-[12px] whitespace-nowrap overflow-hidden text-ellipsis" title={product.customization}>{product.customization}</span>
              </div>
            </div>

            <!-- Premium Gold Quote CTA Button Replicating Luxopack exactly (sleeker padding, subtle gold outline) -->
            <a 
              href="#inquiry" 
              data-product={product.selectValue}
              class="quote-product-btn mt-auto block w-full py-2.5 rounded-lg text-center text-[13px] font-bold text-[#C9A84C] border border-[#C9A84C]/30 hover:border-[#C9A84C] hover:bg-[#C9A84C] hover:text-black transition-all duration-300 font-['Century_Gothic',sans-serif] tracking-wider"
            >
              → Quote This Product
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Prefill Form Selection Script -->
<script>
  function initQuotePrefill() {
    const quoteBtns = document.querySelectorAll('.quote-product-btn');
    quoteBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const productType = btn.getAttribute('data-product');
        const select = document.querySelector('select[name="product_type"]') as HTMLSelectElement | null;
        if (select && productType) {
          select.value = productType;
        }
      });
    });
  }

  // Run on load and after standard navigations
  initQuotePrefill();
  document.addEventListener('astro:page-load', initQuotePrefill);
</script>
