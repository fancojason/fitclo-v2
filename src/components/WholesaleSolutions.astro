---
---

<section id="wholesale" class="py-24 bg-black text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <!-- Header aligned perfectly with ProductGrid edges (No translations, max-w-1200px) -->
    <div class="flex flex-col mb-10">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[11px] md:text-[12px] mb-3 uppercase font-['Montserrat',sans-serif]">
        B2B Wholesale Solutions |
      </h3>
      <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white leading-tight font-['Montserrat',sans-serif] tracking-tight">
        Wholesale Activewear – <span class="text-[#C9A84C] italic">Custom Logo Available</span>
      </h2>
      <p class="text-gray-400 mt-4 max-w-3xl text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
        Premium fitness Apparel & Yoga Wear and custom branding solutions, engineered for fitness brands with factory-direct wholesale pricing.
      </p>
    </div>

    <!-- Luxurious Banner Card mimicking high-end B2B styling -->
    <div class="rounded-[20px] overflow-hidden border border-white/10 relative group bg-[#111111] shadow-2xl transition-all duration-500 hover:border-[#C9A84C]/30 hover:shadow-[0_15px_40px_rgba(201,168,76,0.1)]">
      <div class="relative aspect-[16/9] md:aspect-[21/9] lg:aspect-[2.4/1] overflow-hidden bg-[#0A0A0A]">
        <img 
          src="https://sc02.alicdn.com/kf/Aa6c5bf20cc14428a9fb842b0adfd2820c.png" 
          alt="Premium Wholesale Activewear Custom Solutions" 
          class="w-full h-full object-cover transition-all duration-700 group-hover:scale-[1.01] group-hover:brightness-[1.03]" 
        />
        <!-- Metallic shimmer light sweep effect on hover -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-[1200ms] ease-out pointer-events-none z-10"></div>
        <!-- Shadow overlay for depth -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>
