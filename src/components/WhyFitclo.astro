---
const features = [
  {
    icon: "🏭",
    title: "16,000㎡ Integrated Factory",
    description: "Modern manufacturing facility with advanced equipment and experienced production teams."
  },
  {
    icon: "👥",
    title: "200+ Skilled Workers",
    description: "Dedicated teams for cutting, sewing, quality inspection and packaging."
  },
  {
    icon: "📜",
    title: "International Certifications",
    description: "Committed to global manufacturing standards and responsible production practices (OEKO-TEX, BSCI, GRS, ISO)."
  },
  {
    icon: "🌍",
    title: "Trusted By Customers Worldwide",
    description: "Serving activewear brands, wholesalers and distributors across USA, Europe, Australia and the Middle East."
  }
];
---

<section id="why-fitclo" class="py-24 bg-[#050505] text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-16">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      <!-- Left Side: Large Factory Image (Luxopack Style) -->
      <div class="w-full lg:w-1/2 relative group">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl aspect-[4/3] lg:aspect-auto lg:h-[650px]">
          <img 
            src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
            alt="FITCLO Integrated Factory" 
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
          
          <!-- Top Right Label -->
          <div class="absolute top-8 right-8 bg-black/40 backdrop-blur-md border border-white/10 px-4 py-2 rounded-md">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase font-['Century_Gothic',sans-serif] text-white/80">
              PREMIUM ACTIVEWEAR SOLUTIONS
            </span>
          </div>

          <!-- Overlay Badge - Bottom Left (Boxy Luxopack Style) -->
          <div class="absolute bottom-10 left-10 bg-[#111111] border border-white/10 px-8 py-6 rounded-xl shadow-2xl">
            <span class="block text-[#C9A84C] text-[42px] font-black font-['Montserrat',sans-serif] leading-none mb-2">
              16,000
            </span>
            <span class="block text-white/40 text-[10px] font-bold tracking-[0.2em] uppercase font-['Century_Gothic',sans-serif]">
              SQM PRODUCTION FACILITY
            </span>
          </div>
        </div>
      </div>

      <!-- Right Side: Content -->
      <div class="w-full lg:w-1/2">
        <div class="mb-12">
          <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[12px] mb-6 uppercase font-['Century_Gothic',sans-serif]">
            WHY FITCLO
          </h3>
          <h2 class="text-[40px] md:text-[56px] lg:text-[68px] font-bold leading-[1] font-['Montserrat',sans-serif] tracking-tight mb-8">
            Manufacturing Direct.<br/>
            <span class="text-[#C9A84C] italic">Zero Middlemen.</span>
          </h2>
          <p class="text-white/40 text-[16px] md:text-[18px] leading-relaxed font-['Century_Gothic',sans-serif] max-w-[550px]">
            When you work with Fitclo, you work directly with the people making your apparel — no agents, no markups, no surprises.
          </p>
        </div>

        <!-- Feature Cards (Luxopack High-Fidelity Style) -->
        <div class="space-y-4">
          {features.map((feature) => (
            <div class="bg-white/[0.03] border border-white/5 p-6 rounded-2xl transition-all duration-300 hover:border-[#C9A84C]/20 hover:bg-white/[0.05] group">
              <div class="flex items-center gap-6">
                <!-- Small Icon in Square Border -->
                <div class="w-10 h-10 rounded-lg bg-black/40 flex items-center justify-center text-xl flex-shrink-0 border border-white/10 transition-colors group-hover:border-[#C9A84C]/30">
                  {feature.icon}
                </div>
                <div>
                  <h4 class="text-white text-[16px] font-bold mb-1 font-['Montserrat',sans-serif]">
                    {feature.title}
                  </h4>
                  <p class="text-white/30 text-[13px] leading-relaxed font-['Century_Gothic',sans-serif]">
                    {feature.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
