---
const features = [
  {
    icon: "🏭",
    title: "16,000㎡ Multi-Location Factory",
    description: "Strategically located facilities in Dongguan, Guangzhou, and Yiwu for diverse production needs."
  },
  {
    icon: "👥",
    title: "350+ Skilled Workers",
    description: "Dedicated teams for cutting, sewing, quality inspection and packaging."
  },
  {
    icon: "📜",
    title: "International Certifications",
    description: "Committed to global manufacturing standards and responsible production practices (OEKO-TEX, BSCI, GRS, ISO)."
  },
  {
    icon: "🌍",
    title: "Trusted By Customers Worldwide",
    description: "Serving activewear brands and distributors across USA, Europe, Australia, Middle East and more worldwide."
  }
];
---

<section id="why-fitclo" class="py-24 bg-[#0A0A0F] text-white overflow-hidden border-t border-white/5">
  <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      <!-- Left Side: Large Factory Exterior Image (Expanded Width & Aligned) -->
      <div class="w-full lg:w-[55%] relative group lg:-translate-x-12">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl aspect-[4/3] lg:aspect-auto lg:h-[620px]">
          <img 
            src="https://sc01.alicdn.com/kf/H092634453c16476fb8d485cd1dcb4ab49.png" 
            alt="FITCLO Factory Exterior" 
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
          
          <!-- Top Right Label -->
          <div class="absolute top-6 right-6 bg-black/40 backdrop-blur-md border border-white/10 px-4 py-2 rounded-md">
            <span class="text-[9px] font-bold tracking-[0.2em] uppercase font-['Century_Gothic',sans-serif] text-white/80">
              PREMIUM ACTIVEWEAR SOLUTIONS
            </span>
          </div>

          <!-- Overlay Badge - Bottom Left (Refined Size) -->
          <div class="absolute bottom-8 left-8 bg-[#111111] border border-white/10 px-6 py-5 rounded-xl shadow-2xl">
            <span class="block text-[#C9A84C] text-[28px] font-black font-['Century_Gothic',sans-serif] leading-none mb-1.5">
              16,000
            </span>
            <span class="block text-white/40 text-[9px] font-bold tracking-[0.2em] uppercase font-['Century_Gothic',sans-serif]">
              TOTAL SQM ACROSS 3 LOCATIONS
            </span>
          </div>
        </div>
      </div>

      <!-- Right Side: Content (Refined Typography & Spacing) -->
      <div class="w-full lg:w-[40%]">
        <div class="flex flex-col mb-10">
          <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
            WHY FITCLO
          </h3>
          <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-5">
            Factory Direct.<br/>
            <span class="text-[#C9A84C] italic">Zero Middlemen.</span>
          </h2>
          <p class="text-gray-400 mt-2 max-w-[500px] text-[14px] md:text-[15px] leading-relaxed font-['Century_Gothic',sans-serif]">
            When you work with Fitclo, you work directly with the people making your apparel — no agents, no markups, no surprises.
          </p>
        </div>

        <!-- Feature Cards (Dark Blue Luxopack Style) -->
        <div class="space-y-3.5">
          {features.map((feature) => (
            <div class="bg-[#0D1526] border border-white/10 p-5 rounded-2xl transition-all duration-300 hover:border-[#C9A84C]/30 hover:bg-[#111C33] group">
              <div class="flex items-center gap-5">
                <!-- Icon Box -->
                <div class="w-10 h-10 rounded-lg bg-black/60 flex items-center justify-center text-xl flex-shrink-0 border border-white/25 transition-colors group-hover:border-[#C9A84C]/40">
                  {feature.icon}
                </div>
                <div>
                  <h4 class="text-white text-[15px] font-bold mb-0.5 font-['Century_Gothic',sans-serif]">
                    {feature.title}
                  </h4>
                  <p class="text-white/50 text-[12px] leading-relaxed font-['Century_Gothic',sans-serif]">
                    {feature.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
</div>

    </div>
  </div>
</section>
