---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title = "Fitclo | Private Label Activewear Manufacturer" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="Premium activewear manufacturer specializing in yoga wear, gym shorts, and sports bras. OEM/ODM services with low MOQ for global brands." />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Floating Buttons CSS - Exact Luxopack Replication -->
    <style is:global>
      @keyframes wa-pulse {
        0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
      }
      @keyframes pulse-gold {
        0% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0.5); }
        70% { box-shadow: 0 0 0 15px rgba(201, 168, 76, 0); }
        100% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0); }
      }
      @keyframes wiggle {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-8deg); }
        75% { transform: rotate(8deg); }
      }

      .floating-controls {
        position: fixed;
        bottom: 32px;
        left: 32px;
        right: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 9999;
        pointer-events: none;
      }

      .whatsapp-float {
        pointer-events: auto;
        width: 64px;
        height: 64px;
        background-color: #25D366;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: wa-pulse 2s infinite;
      }
      .whatsapp-float:hover {
        transform: scale(1.1);
      }
      .whatsapp-float svg {
        animation: wiggle 3.5s ease-in-out infinite;
      }

      .quote-float {
        pointer-events: auto;
        background-color: #C9A84C;
        color: #FFFFFF;
        padding: 0 28px;
        height: 52px;
        border-radius: 50px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 14.08px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        animation: pulse-gold 2.5s infinite;
        transition: all 0.3s ease;
        box-shadow: 0 8px 24px rgba(201, 168, 76, 0.3);
      }
      .quote-float:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(201, 168, 76, 0.4);
      }
    </style>
  </head>
  <body class="bg-white text-primary font-['Inter',sans-serif]">
    <Header />
    <main>
      <slot />
    </main>
    
    <div class="floating-controls">
      <!-- WhatsApp Left (Replicated SVG) -->
      <a href="https://api.whatsapp.com/send?phone=8615218851638&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F" class="whatsapp-float" target="_blank">
        <svg width="32" height="32" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
          <path d="M512 512m-512 0a512 512 0 1 0 1024 0 512 512 0 1 0-1024 0Z" fill="#4DC247"></path>
          <path d="M229.54 510.35c0-155.17 126.08-281.3 281.3-281.3v0.02c155.24 0 281.34 126.12 281.34 281.3a281.47 281.47 0 0 1-35.05 135.89c-75.13 136.06-246.35 185.49-382.44 110.35l-155.6 50.00 50.73-151.10a280.23 280.23 0 0 1-40.25-145.17z m281.3 234.34c129.15 0 234.36-105.21 234.36-234.36 0-129.04-105.25-234.24-234.36-234.24-129.1 0-234.32 105.21-234.32 234.28 0 49.34 15.14 95.14 44.8 137.3l-29.48 86.91 90.30-28.69c36.43 25.17 80.25 38.82 128.7 38.82z m75.73-197.76c-4.65 0-11.39 8.4-18.38 17.1-7.53 9.38-15.33 19.09-21.12 19.09a16.38 16.38 0 0 1-8.21-2.6c-20.9-10.47-39.16-21.29-56.32-37.69-14.2-13.44-29.86-33.6-38.05-51.11a11.09 11.09 0 0 1-1.87-5.61c0-3.75 4.9-8.96 10.47-14.76 7.14-7.5 15.29-16.06 15.29-24.04 0-3.73-19-54.44-21.67-60.8-3.71-9.7-5.54-12.69-15.61-12.69-2.3 0-4.7 0.2-7.25-0.59l-6.54-0.53c-7.87 0-13.8 2.98-19.43 8.21-17.92 16.78-26.88 34.32-27.6 58.96v2.96c-0.38 25.79 12.28 51.49 26.47 72.4 32.04 47.4 65.28 88.81 118.61 113.04 16.04 7.46 53.01 23.12 70.91 23.12 21.26 0 56-13.41 64.53-34.34 3.39-8.57 6.35-18.98 6.35-28.33 0-1.49 0-3.73-0.78-5.58-2.6-4.48-63.38-36.2-69.76-36.2z" fill="#FFFFFF"></path>
        </svg>
      </a>

      <!-- Quote Right (Replicated Tag SVG) -->
      <a href="#inquiry" class="quote-float">
        <span>Get a Free Quote</span>
        <svg width="22" height="22" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
          <path d="M89.64 582.09a29.15 29.15 0 0 0 0 41.22l316.07 316.07a29.15 29.15 0 0 0 41.20 0l390.14-390.09c6.07-6.09 9.14-14.5 8.43-23.06l-11.60-139.33a145.74 145.74 0 1 0-153.18-38.52l-30.18 30.15a188.41 188.41 0 0 1-43.15-186.27l-104.54-8.70c-8.55-0.73-16.99 2.36-23.04 8.43L89.64 582.09zM714.24 201.14a87.08 87.08 0 1 1 114.51 124.17l-7.55-90.84a29.15 29.15 0 0 0-26.62-26.62l-80.33-6.70z" fill="#FFFFFF"></path>
        </svg>
      </a>
    </div>

    <Footer />
  </body>
</html>
