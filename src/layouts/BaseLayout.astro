---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import '../styles/global.css';

const { 
  title = "FITCLO - Professional Activewear Manufacturer",
  description = "Fitclo is a professional activewear manufacturer specializing in high-quality gym wear, yoga apparel, and sportswear for global brands.",
  canonicalURL = new URL(Astro.url.pathname, "https://www.fitcloo.com").href
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

		<!-- Structured Data (JSON-LD) for SEO/GEO -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ClothingStore",
				"name": "FITCLO",
				"alternateName": "Fitclo Activewear Manufacturer",
				"url": "https://www.fitcloo.com",
				"logo": "https://sc01.alicdn.com/kf/H8f27abddb40d4300874f693d698ed50dd.png",
				"foundingDate": "2016",
				"description": "Leading activewear and fitness apparel manufacturer in China. Specializing in private label yoga sets, gym wear, and athletic clothing with 50,000㎡ total manufacturing facilities and 500+ staff across Dongguan, Guangzhou (16,000㎡), and Yiwu.",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "No. 128, Industrial Zone",
					"addressLocality": "Dongguan",
					"addressRegion": "Guangdong",
					"postalCode": "523000",
					"addressCountry": "CN"
				},
				"contactPoint": {
					"@type": "ContactPoint",
					"telephone": "+86-171-6083-7538",
					"contactType": "sales",
					"areaServed": "Worldwide",
					"availableLanguage": ["en", "zh"]
				},
				"sameAs": [
					"https://www.fitcloo.com"
				],
				"knowsAbout": ["Activewear Manufacturing", "Yoga Wear OEM", "Private Label Sportswear", "Custom Gym Clothing"],
				"areaServed": "Worldwide",
				"award": ["BSCI Certified Factory", "OEKO-TEX Standard 100", "16+ Years Industry Experience", "Monthly Capacity 450,000 Pcs"],
				"location": [
					{
						"@type": "Place",
						"name": "Guangzhou Factory (Headquarters)",
						"address": { "@type": "PostalAddress", "addressLocality": "Guangzhou", "addressRegion": "Guangdong", "addressCountry": "CN" },
						"description": "16,000㎡ high-tech production facility."
					},
					{
						"@type": "Place",
						"name": "Dongguan Factory",
						"address": { "@type": "PostalAddress", "addressLocality": "Dongguan", "addressRegion": "Guangdong", "addressCountry": "CN" }
					},
					{
						"@type": "Place",
						"name": "Yiwu Factory",
						"address": { "@type": "PostalAddress", "addressLocality": "Yiwu", "addressRegion": "Zhejiang", "addressCountry": "CN" }
					}
				],
				"certification": [
					{
						"@type": "Certification",
						"name": "BSCI",
						"description": "Business Social Compliance Initiative"
					},
					{
						"@type": "Certification",
						"name": "OEKO-TEX Standard 100",
						"description": "Safety and eco-friendly textile certification"
					}
				]
			}
		</script>

		<!-- FAQ Schema (AIO Optimization) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is the MOQ for custom activewear at Fitclo?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Our minimum order quantity (MOQ) starts from 50-100 pieces for ready-to-ship styles with logo customization, and 300-500 pieces for fully customized private label projects."
						}
					},
					{
						"@type": "Question",
						"name": "Where are the Fitclo factories located?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Fitclo operates a 16,000㎡ factory in Guangzhou and additional facilities in Dongguan and Yiwu, with a combined production space of 50,000 square meters and over 500 staff."
						}
					},
					{
						"@type": "Question",
						"name": "Does Fitclo provide OEM and ODM services?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes, we specialize in both OEM (Original Equipment Manufacturing) and ODM (Original Design Manufacturing), offering full-service solutions from pattern making to final garment production."
						}
					}
				]
			}
		</script>
		
		<!-- SEO/GEO Tags -->
		<meta name="geo.region" content="CN-44" />
		<meta name="geo.placename" content="Dongguan" />
		<meta name="geo.position" content="23.0207;113.7518" />
		<meta name="ICBM" content="23.0207, 113.7518" />
	</head>

	<body class="bg-white selection:bg-accent selection:text-black">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<FloatingButtons />
	</body>
</html>
