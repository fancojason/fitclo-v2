---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import LegacyBlogShell from '../components/LegacyBlogShell.astro';
import '../styles/global.css';

const {
  title = 'FITCLO - Professional Activewear Manufacturer',
  seoTitle,
  description = 'Fitclo is a professional activewear manufacturer specializing in high-quality gym wear, yoga apparel, and sportswear for global brands.',
  canonicalURL,
  lang = 'en',
  alternateLinks = [],
  image = 'https://www.fitcloo.com/images/intelligence/hero-activewear-intelligence.png',
  structuredData = [],
  autoArticleSchema = true,
  legacyShell,
  robots = 'index, follow',
  includeBreadcrumbSchema = true,
  preloadImage,
  publishedDate,
  modifiedDate,
} = Astro.props;

const siteUrl = 'https://www.fitcloo.com';
const canonicalPath =
  Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const pageUrl = canonicalURL ?? new URL(canonicalPath, siteUrl).href;
const schemaItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const isBlogDetail = canonicalPath.startsWith('/blogs/') && canonicalPath !== '/blogs/';
const cleanArticleTitle = title.replace(/\s\|\s.*$/, '').trim();
const createSeoTitle = (value: string) => {
  const cleanValue = value.trim();
  return /\|\s*fitclo(?:\s+blog)?$/i.test(cleanValue) ? cleanValue : `${cleanValue} | Fitclo`;
};
const normalizeMetaDescription = (value: string) => {
  let result = value.trim();
  if (result.length < 100) {
    result = `${result} Practical guidance for activewear buyers comparing materials, MOQ, production quality and sourcing risk.`;
  }
  if (result.length > 180) {
    result = `${result.slice(0, 177).replace(/\s+\S*$/, '').replace(/[,:;-]+$/, '')}.`;
  }
  return result;
};
const documentTitle = seoTitle ?? (isBlogDetail ? createSeoTitle(cleanArticleTitle) : title);
const metaDescription = isBlogDetail ? normalizeMetaDescription(description) : description;
const isBlogArticle = autoArticleSchema && isBlogDetail;
const shouldUseLegacyShell = legacyShell ?? isBlogArticle;
const pathSegments = canonicalPath.split('/').filter(Boolean);
const legacyContext = `${title} ${description}`.toLowerCase();
const legacyKind = /( vs |compare|comparison|difference)/.test(legacyContext)
  ? 'comparison-guide'
  : /(fabric|nylon|polyester|textile|compression)/.test(legacyContext)
    ? 'technical-guide'
    : /(private label|branding|logo|packaging|custom)/.test(legacyContext)
      ? 'private-label-guide'
      : /(trend|market|future|growth|2026)/.test(legacyContext)
        ? 'trend-report'
        : /(price|cost|margin|inventory|wholesale|scal|business|economics)/.test(legacyContext)
          ? 'business-guide'
          : /(factory|manufacturer|supplier|vetting|sourcing)/.test(legacyContext)
            ? 'buyer-guide'
            : 'manufacturing-guide';
const legacyType = legacyKind
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
const legacyFaqs = [
  {
    question: `What is the main buyer decision in ${title.replace(/\s\|\s.*$/, '').toLowerCase()}?`,
    answer: description,
  },
  {
    question: 'Can Fitclo turn this guidance into a production recommendation?',
    answer: 'Yes. Fitclo can compare fabric, MOQ, sampling, branding, quality control and shipping options for private label or OEM/ODM activewear projects.',
  },
  {
    question: 'What project information should a buyer send Fitclo?',
    answer: 'Send the product category, reference design or tech pack, target quantity, fabric direction, size range, logo method, destination market and required delivery date.',
  },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Fitclo',
  alternateName: 'FITCLO Activewear Manufacturer',
  url: siteUrl,
  logo: 'https://www.fitcloo.com/favicon.webp?v=3',
  foundingDate: '2010',
  email: 'sales@fitcloo.com',
  description:
    'Fitclo is a China-based activewear manufacturer for private label yoga wear, leggings, sports bras, gym clothing and OEM/ODM sportswear production.',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+86-171-6083-7538',
    email: 'sales@fitcloo.com',
    contactType: 'sales',
    areaServed: 'Worldwide',
    availableLanguage: ['English', 'Chinese'],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guangzhou',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  areaServed: [
    'Worldwide',
    'North America',
    'Latin America',
    'Europe',
    'Middle East',
    'Africa',
    'Asia-Pacific',
  ],
  knowsAbout: [
    'Private label activewear manufacturing',
    'OEM and ODM sportswear production',
    'Yoga leggings manufacturing',
    'Sports bra manufacturing',
    'Activewear fabric development',
    'Low MOQ activewear sourcing',
    'Seamless activewear production',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Fitclo Activewear Product Catalog',
    url: `${siteUrl}/products/`,
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Fitclo',
  url: siteUrl,
  inLanguage: 'en',
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    ...pathSegments.map((segment, index) => {
      const itemPath = `/${pathSegments.slice(0, index + 1).join('/')}/`;
      const label = segment
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');

      return {
        '@type': 'ListItem',
        position: index + 2,
        name: index === pathSegments.length - 1 ? title.replace(/\s\|\s.*$/, '') : label,
        item: new URL(itemPath, siteUrl).href,
      };
    }),
  ],
};

const autoArticle = isBlogArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: cleanArticleTitle,
      description: metaDescription,
      image,
      ...(publishedDate ? { datePublished: publishedDate } : {}),
      ...(modifiedDate ? { dateModified: modifiedDate } : {}),
      mainEntityOfPage: pageUrl,
      articleSection: legacyType,
      keywords: [title.replace(/\s\|\s.*$/, ''), 'activewear manufacturing', 'private label activewear', legacyType],
      author: {
        '@type': 'Organization',
        name: 'FITCLO Team',
        url: `${siteUrl}/about/`,
      },
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      about: [
        'activewear manufacturing',
        'private label sportswear',
        'OEM ODM activewear sourcing',
      ],
    }
  : null;

const legacyFaqSchema = isBlogArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: legacyFaqs.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const pageStructuredData = [
  organizationSchema,
  websiteSchema,
  ...(includeBreadcrumbSchema ? [breadcrumbSchema] : []),
  ...(autoArticle ? [autoArticle] : []),
  ...(legacyFaqSchema ? [legacyFaqSchema] : []),
  ...schemaItems.filter(Boolean),
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <meta name="generator" content={Astro.generator} />

    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={pageUrl} />
    {alternateLinks.map((link: { hreflang: string; href: string }) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta name="robots" content={robots} />

    <meta property="og:type" content={isBlogDetail ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Fitclo" />
    <meta property="og:locale" content={lang.toLowerCase().startsWith('ru') ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={isBlogDetail ? cleanArticleTitle : title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={isBlogDetail ? cleanArticleTitle : title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />

    <meta name="geo.region" content="CN-44" />
    <meta name="geo.placename" content="Guangzhou" />
    <meta name="geo.position" content="23.1291;113.2644" />
    <meta name="ICBM" content="23.1291, 113.2644" />
  </head>

  <body class="bg-white selection:bg-accent selection:text-black">
    <Header />
    <main>
      {shouldUseLegacyShell ? (
        <LegacyBlogShell title={title} description={description} articleKind={legacyKind} type={legacyType} faqs={autoArticleSchema ? legacyFaqs : []}>
          <slot />
        </LegacyBlogShell>
      ) : (
        <slot />
      )}
    </main>
    <Footer />
    <FloatingButtons />
  </body>
</html>
