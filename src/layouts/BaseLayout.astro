---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CoreLocaleHeader from '../components/CoreLocaleHeader.astro';
import CoreLocaleFooter from '../components/CoreLocaleFooter.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import LegacyBlogShell from '../components/LegacyBlogShell.astro';
import { localizeEnglishWhatsAppLinks, localizeMarkup, localizeSpanishInternalLinks, type TranslationPair } from '../i18n/localize';
import { getUi } from '../i18n/ui';
import { localizedRoutePairs, getAlternateLinks, isSpanishMirror } from '../i18n/routes';
import { coreLocales, type CoreLanguage } from '../content/core-locales';
import '../styles/global.css';

const routePair = localizedRoutePairs.find((pair) => Object.values(pair).includes(Astro.url.pathname));
const mirrorEnglishPath = Astro.url.pathname.startsWith('/es/') ? Astro.url.pathname.slice(3) : Astro.url.pathname;
const {
  title = 'FITCLO - Professional Activewear Manufacturer',
  seoTitle,
  description = 'Fitclo is a professional activewear manufacturer specializing in high-quality gym wear, yoga apparel, and sportswear for global brands.',
  canonicalURL,
  lang = 'en',
  alternateLinks = routePair ? getAlternateLinks(routePair.en, routePair.es) : isSpanishMirror(Astro.url.pathname) ? getAlternateLinks(mirrorEnglishPath, `/es${mirrorEnglishPath}`) : [],
  translations = [] as TranslationPair[],
  image = 'https://www.fitcloo.com/images/intelligence/hero-activewear-intelligence.webp',
  structuredData = [],
  autoArticleSchema = true,
  legacyShell,
  robots = 'index, follow',
  includeBreadcrumbSchema = true,
  preloadImage,
  publishedDate,
  modifiedDate,
  whatsappMessage,
  whatsappProductCode,
  whatsappProductName,
} = Astro.props;

const siteUrl = 'https://www.fitcloo.com';
const isCoreLocale = lang in coreLocales;
const canonicalPath =
  Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const pageUrl = canonicalURL ?? new URL(canonicalPath, siteUrl).href;
const schemaItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const isBlogDetail = canonicalPath.startsWith('/blogs/') && canonicalPath !== '/blogs/';
const cleanArticleTitle = title.replace(/\s\|\s.*$/, '').trim();
const createSeoTitle = (value: string) => {
  const cleanValue = value.trim();
  return /\|\s*fitclo(?:\s+blog)?$/i.test(cleanValue) ? cleanValue : `${cleanValue} | Fitclo`;
};
const normalizeMetaDescription = (value: string) => {
  let result = value.trim();
  if (result.length > 180) {
    result = `${result.slice(0, 177).replace(/\s+\S*$/, '').replace(/[,:;-]+$/, '')}.`;
  }
  return result;
};
const documentTitle = seoTitle ?? (isBlogDetail ? createSeoTitle(cleanArticleTitle) : title);
const metaDescription = isBlogDetail ? normalizeMetaDescription(description) : description;
const isBlogArticle = autoArticleSchema && isBlogDetail;
const shouldUseLegacyShell = legacyShell ?? isBlogArticle;
const legacyContext = `${title} ${description}`.toLowerCase();
const legacyKind = /( vs |compare|comparison|difference)/.test(legacyContext)
  ? 'comparison-guide'
  : /(fabric|nylon|polyester|textile|compression)/.test(legacyContext)
    ? 'technical-guide'
    : /(private label|branding|logo|packaging|custom)/.test(legacyContext)
      ? 'private-label-guide'
      : /(trend|market|future|growth|2026)/.test(legacyContext)
        ? 'trend-report'
        : /(price|cost|margin|inventory|wholesale|scal|business|economics)/.test(legacyContext)
          ? 'business-guide'
          : /(factory|manufacturer|supplier|vetting|sourcing)/.test(legacyContext)
            ? 'buyer-guide'
            : 'manufacturing-guide';
const legacyType = legacyKind
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Fitclo',
  alternateName: 'FITCLO Activewear Manufacturer',
  url: siteUrl,
  logo: 'https://www.fitcloo.com/favicon.webp?v=3',
  foundingDate: '2010',
  email: 'sales@fitcloo.com',
  description: isCoreLocale ? coreLocales[lang as CoreLanguage].footer : lang === 'es'
    ? 'Fitclo es un fabricante de ropa deportiva en China para marca privada, ropa de yoga, leggings, sujetadores deportivos y producción OEM/ODM.'
    : 'Fitclo is a China-based activewear manufacturer for private label yoga wear, leggings, sports bras, gym clothing and OEM/ODM sportswear production.',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+86-171-6083-7538',
    email: 'sales@fitcloo.com',
    contactType: 'sales',
    areaServed: lang === 'es' ? 'Internacional' : 'Worldwide',
    availableLanguage: lang === 'es' ? ['Spanish', 'English', 'Chinese'] : ['English', 'Chinese'],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guangzhou',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  areaServed: [
    'Worldwide',
    'North America',
    'Latin America',
    'Europe',
    'Middle East',
    'Africa',
    'Asia-Pacific',
  ],
  knowsAbout: lang === 'es'
    ? ['Fabricación de ropa deportiva de marca privada', 'Producción OEM y ODM de ropa deportiva', 'Fabricación de leggings de yoga', 'Fabricación de sujetadores deportivos', 'Desarrollo de tejidos deportivos', 'Abastecimiento de ropa deportiva con MOQ bajo', 'Producción de ropa deportiva sin costuras']
    : ['Private label activewear manufacturing', 'OEM and ODM sportswear production', 'Yoga leggings manufacturing', 'Sports bra manufacturing', 'Activewear fabric development', 'Low MOQ activewear sourcing', 'Seamless activewear production'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'es' ? 'Catálogo de ropa deportiva Fitclo' : 'Fitclo Activewear Product Catalog',
    url: `${siteUrl}/products/`,
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Fitclo',
  url: siteUrl,
  inLanguage: lang,
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: isCoreLocale ? coreLocales[lang as CoreLanguage].nav.home : lang === 'es' ? 'Inicio' : 'Home',
      item: isCoreLocale ? `${siteUrl}/${lang === 'pt-BR' ? 'pt-br' : lang}/` : lang === 'es' ? `${siteUrl}/es/` : `${siteUrl}/`,
    },
    ...(pageUrl === (isCoreLocale ? `${siteUrl}/${lang === 'pt-BR' ? 'pt-br' : lang}/` : lang === 'es' ? `${siteUrl}/es/` : `${siteUrl}/`)
      ? []
      : [{
          '@type': 'ListItem',
          position: 2,
          name: title.replace(/\s\|\s.*$/, ''),
          item: pageUrl,
        }]),
  ],
};

const autoArticle = isBlogArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: cleanArticleTitle,
      description: metaDescription,
      image,
      ...(publishedDate ? { datePublished: publishedDate } : {}),
      ...(modifiedDate ? { dateModified: modifiedDate } : {}),
      mainEntityOfPage: pageUrl,
      articleSection: legacyType,
      keywords: [title.replace(/\s\|\s.*$/, ''), 'activewear manufacturing', 'private label activewear', legacyType],
      author: {
        '@type': 'Organization',
        name: 'FITCLO Team',
        url: `${siteUrl}/about/`,
      },
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      about: [
        'activewear manufacturing',
        'private label sportswear',
        'OEM ODM activewear sourcing',
      ],
    }
  : null;

const pageStructuredData = [
  organizationSchema,
  websiteSchema,
  ...(includeBreadcrumbSchema && !schemaItems.some((item) => item?.['@type'] === 'BreadcrumbList') ? [breadcrumbSchema] : []),
  ...(autoArticle ? [autoArticle] : []),
  ...schemaItems.filter(Boolean),
];
const localizedContent = translations.length
  ? (lang === 'es' ? localizeSpanishInternalLinks : (html: string) => html)(localizeEnglishWhatsAppLinks(
      localizeMarkup(await Astro.slots.render('default'), translations),
      getUi('es').whatsappMessage,
    ))
  : null;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/css/language-menu.css?v=4" />
    <script is:inline src="/js/language-menu.js" defer></script>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {isBlogDetail && <link rel="preload" href="/fonts/zoho-puvi-bold.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="generator" content={Astro.generator} />

    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={pageUrl} />
    {alternateLinks.map((link: { hreflang: string; href: string }) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta name="robots" content={robots} />

    <meta property="og:type" content={isBlogDetail ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Fitclo" />
    <meta property="og:locale" content={lang === 'pt-BR' ? 'pt_BR' : lang === 'nl' ? 'nl_NL' : lang === 'de' ? 'de_DE' : lang.toLowerCase().startsWith('ru') ? 'ru_RU' : lang.toLowerCase().startsWith('es') ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={isBlogDetail ? cleanArticleTitle : title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={isBlogDetail ? cleanArticleTitle : title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />

    <meta name="geo.region" content="CN-44" />
    <meta name="geo.placename" content="Guangzhou" />
    <meta name="geo.position" content="23.1291;113.2644" />
    <meta name="ICBM" content="23.1291, 113.2644" />
    <script is:inline>
      // Keep local builds and deployment previews out of the production property.
      if (['www.fitcloo.com', 'fitcloo.com'].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-VT6KCKVKPD', { site_language: document.documentElement.lang });
        const googleTag = document.createElement('script');
        googleTag.async = true;
        googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-VT6KCKVKPD';
        document.head.appendChild(googleTag);
      }
    </script>
  </head>

  <body class="bg-white selection:bg-accent selection:text-black">
    {isCoreLocale ? <CoreLocaleHeader lang={lang as CoreLanguage} /> : <Header lang={lang} />}
    <main>
      {shouldUseLegacyShell ? (
        <LegacyBlogShell title={title} description={description} articleKind={legacyKind} type={legacyType} faqs={[]}>
          <slot />
        </LegacyBlogShell>
      ) : (
        localizedContent !== null ? <Fragment set:html={localizedContent} /> : <slot />
      )}
    </main>
    {isCoreLocale ? <CoreLocaleFooter lang={lang as CoreLanguage} /> : <Footer lang={lang} />}
    <FloatingButtons lang={lang} path={Astro.url.pathname} productCode={whatsappProductCode} productName={whatsappProductName} message={lang === 'es' ? whatsappMessage : undefined} />
    <script>
      import { initInquiryAttribution, initInquiryTracking } from '../lib/inquiry-client';
      import { initWebVitals } from '../lib/web-vitals';
      import { initWhatsAppLinks } from '../lib/whatsapp-client';
      initInquiryAttribution();
      initInquiryTracking();
      initWhatsAppLinks();
      initWebVitals();
    </script>
  </body>
</html>
