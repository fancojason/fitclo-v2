---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title = "Fitclo | Private Label Activewear Manufacturer" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="Premium activewear manufacturer specializing in yoga wear, gym shorts, and sports bras. OEM/ODM services with low MOQ for global brands." />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Floating Buttons CSS - Replicated Exact Luxopack Style -->
    <style is:global>
      @keyframes wa-pulse {
        0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
      }
      @keyframes pulse-gold {
        0%, 100% { box-shadow: 0 8px 32px rgba(201, 168, 76, 0.4); }
        50% { box-shadow: 0 8px 48px rgba(201, 168, 76, 0.85); }
      }
      @keyframes wiggle {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-5deg); }
        75% { transform: rotate(5deg); }
      }

      .floating-controls {
        position: fixed;
        bottom: 32px;
        left: 32px;
        right: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
        pointer-events: none;
      }

      .whatsapp-float {
        pointer-events: auto;
        width: 64px;
        height: 64px;
        background-color: #25d366;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: wa-pulse 2s infinite;
      }
      .whatsapp-float:hover {
        transform: scale(1.1) rotate(8deg);
      }
      .whatsapp-float svg {
        animation: wiggle 3s ease-in-out infinite;
      }

      .quote-float {
        pointer-events: auto;
        background-color: #c9a84c;
        color: #0a0a0f;
        padding: 0 26px;
        height: 48px;
        border-radius: 50px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 14.1px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-decoration: none;
        animation: pulse-gold 2.5s infinite;
        transition: all 0.3s ease;
      }
      .quote-float:hover {
        transform: scale(1.06);
      }
      .quote-float .tag-icon {
        font-size: 18px;
      }
    </style>
  </head>
  <body class="bg-white text-primary font-['Inter',sans-serif]">
    <Header />
    <main>
      <slot />
    </main>
    
    <div class="floating-controls">
      <!-- WhatsApp Left -->
      <a href="https://api.whatsapp.com/send?phone=8615218851638&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20premium%20activewear%20collection%20and%20would%20like%20to%20discuss%20a%20custom%20project.%20Can%20we%20chat%3F" class="whatsapp-float" target="_blank">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>

      <!-- Quote Right -->
      <a href="#inquiry" class="quote-float">
        <span>Get a Free Quote</span>
        <span class="tag-icon">🏷️</span>
      </a>
    </div>

    <Footer />
  </body>
</html>
