---
import EditorialArticleLayout from './EditorialArticleLayout.astro';

const {
  title,
  type = 'Activewear Manufacturing Guide',
  description: suppliedDescription,
  articleImage: suppliedArticleImage,
  quickAnswerTitle: suppliedQuickAnswerTitle,
  quickTakeaways: suppliedQuickTakeaways,
  planningTableTitle = 'What buyers should check before moving forward',
  planningRows: suppliedPlanningRows,
  faqs: suppliedFaqs,
  relatedReading: suppliedRelatedReading,
  date = 'July 11, 2026',
  readTime = '10 min read',
} = Astro.props;

const description = suppliedDescription ??
  `A practical Fitclo guide to ${title.toLowerCase()} for activewear buyers, covering product decisions, manufacturing risk, quality control and scalable production.`;

const context = `${title} ${type}`.toLowerCase();
const isFabric = /(fabric|nylon|polyester|gsm|moisture|wicking|textile|dye|colorfast|recycled)/.test(context);
const isBrand = /(private label|branding|logo|oem|odm|launch|business|scal|ecommerce|influencer|packaging)/.test(context);
const isLogistics = /(shipping|logistics|freight|import|ddp|duty|lead time|supply chain)/.test(context);
const isFactory = /(factory|manufacturer|manufacturing|quality|inspection|audit|production|sewing|construction)/.test(context);

const articleImage = suppliedArticleImage ?? (
  isFabric
    ? '/images/intelligence/cover-fabric-guide.png'
    : isBrand
      ? '/images/intelligence/cover-private-label.png'
      : /(trend|sustainable|eco)/.test(context)
        ? '/images/intelligence/cover-trend-report.png'
        : '/images/intelligence/cover-factory-guide.png'
);

const quickAnswerTitle = suppliedQuickAnswerTitle ?? (
  isFabric
    ? 'Choose activewear fabric by product use, knit structure, GSM, stretch recovery, opacity and wash performance. Approve swatches and a washed sample before bulk production.'
    : isBrand
      ? 'Choose the production route that matches your launch speed, MOQ, budget and need for product exclusivity. Approve every logo, label and packaging detail on one complete sample.'
      : isLogistics
        ? 'Plan shipping from the required delivery date backwards. Compare landed cost, transit time, customs responsibility and document requirements before confirming production.'
        : isFactory
          ? 'A reliable result depends on clear specifications, approved samples, controlled production and documented inspection. Verify each stage before paying for or shipping a bulk order.'
          : 'Use this guide to define the product goal, compare realistic options and confirm the key quality checks before sampling or bulk production.'
);

const quickTakeaways = suppliedQuickTakeaways ?? (
  isFabric
    ? [
        'Compare composition and GSM together; neither number proves performance by itself.',
        'Test opacity, recovery, pilling, shrinkage and colorfastness in the intended color.',
        'Approve fabric and garment fit together because stretch changes measurements and support.',
      ]
    : isBrand
      ? [
          'Define target customer, retail price, launch date and first-order quantity before sampling.',
          'Keep the first collection focused so fit, quality and cash flow are easier to control.',
          'Confirm logo files, labels, packaging and size information before bulk production begins.',
        ]
      : isLogistics
        ? [
            'Compare factory price and landed cost, including freight, duty and destination charges.',
            'Confirm carton data, HS codes and commercial documents before cargo leaves the factory.',
            'Allow time for final inspection, customs clearance and delivery instead of using transit time alone.',
          ]
        : [
            'Turn product expectations into measurable fabric, fit, stitching and packing standards.',
            'Approve a representative pre-production sample before bulk cutting starts.',
            'Use in-line and final inspection evidence to catch problems before shipment.',
          ]
);

const planningRows = suppliedPlanningRows ?? (
  isFabric
    ? [
        ['Fabric specification', 'Composition, GSM, knit structure, stretch direction, opacity and hand feel.', 'Request swatches plus a washed garment sample in the intended color.'],
        ['Performance testing', 'Recovery, pilling, shrinkage, colorfastness and squat-proof coverage.', 'Write acceptable results into the sample approval and QC checklist.'],
        ['Bulk consistency', 'Dye-lot variation, width, weight and finishing consistency.', 'Ask the supplier how bulk fabric is inspected and matched to the approved sample.'],
      ]
    : isBrand
      ? [
          ['Launch route', 'Ready-to-ship branding, private label stock or full OEM/ODM development.', 'Match product control to budget, MOQ and launch deadline.'],
          ['Brand assets', 'Logo method, labels, care content, packaging and size presentation.', 'Approve one complete branded sample before production.'],
          ['Commercial risk', 'SKU count, reorder plan, retail margin and unsold inventory exposure.', 'Start with focused styles and expand after fit and demand are proven.'],
        ]
      : isLogistics
        ? [
            ['Delivery plan', 'Required arrival date, production finish date and shipping method.', 'Build a buffer for inspection, customs and local delivery.'],
            ['Landed cost', 'Freight, duty, tax, brokerage and destination charges.', 'Compare quotations on the same Incoterm and carton assumptions.'],
            ['Documents', 'Invoice, packing list, HS code, labels and import requirements.', 'Confirm document responsibility before shipment.'],
          ]
        : [
            ['Supplier proof', 'Factory control, technical knowledge, capacity and relevant export experience.', 'Review real production evidence and ask process-specific questions.'],
            ['Sample approval', 'Fabric, measurements, fit, stitching, branding and packaging.', 'Keep written comments and approve the final reference sample.'],
            ['Quality control', 'In-line checks, final inspection, defect limits and corrective action.', 'Agree inspection standards before bulk production starts.'],
          ]
);

const faqs = suppliedFaqs ?? [
  {
    question: `What should buyers check first when researching ${title.toLowerCase()}?`,
    answer: quickAnswerTitle,
  },
  {
    question: 'Can Fitclo support low-MOQ private label and full OEM/ODM activewear?',
    answer: 'Yes. Fitclo supports ready-to-ship logo customization, private label programs and full OEM/ODM development for leggings, sports bras, yoga sets, gym wear and athleisure products.',
  },
  {
    question: 'What information should I send to receive a useful production recommendation?',
    answer: 'Share the product category, reference images or tech pack, target quantity, fabric preference, logo method, size range, delivery market and required launch date.',
  },
];

const relatedReading = suppliedRelatedReading ?? [
  {
    title: 'China Activewear Manufacturer Verification Checklist',
    desc: 'Verify factory capability, fabric knowledge, quality systems and delivery planning before ordering.',
    link: '/blogs/china-activewear-manufacturer-checklist',
  },
  {
    title: 'Activewear Fabric Guide',
    desc: 'Compare nylon, polyester, GSM, stretch recovery and squat-proof testing.',
    link: '/blogs/fabrics',
  },
  {
    title: 'Private Label Activewear Manufacturing',
    desc: 'Compare ready-to-ship branding, private label customization and OEM/ODM development.',
    link: '/private-label',
  },
  {
    title: 'Activewear Intelligence Hub',
    desc: 'Browse more sourcing guides, comparisons and manufacturing checklists.',
    link: '/activewear-intelligence/',
  },
];
---

<EditorialArticleLayout
  title={title}
  description={description}
  type={type}
  date={date}
  readTime={readTime}
  articleImage={articleImage}
  quickAnswerTitle={quickAnswerTitle}
  quickTakeaways={quickTakeaways}
  planningTableTitle={planningTableTitle}
  planningRows={planningRows}
  faqs={faqs}
  relatedReading={relatedReading}
>
  <slot />
</EditorialArticleLayout>
