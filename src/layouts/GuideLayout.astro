---
import BaseLayout from './BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { whatsappIntelligenceUrl } from '../data/intelligence';

const { title, type, description } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: 'Jason Chen',
    jobTitle: 'Founder of Fitclo, Activewear Manufacturing Specialist',
    description: 'Activewear manufacturing specialist with 8+ years of export experience.',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fitclo',
    url: 'https://www.fitcloo.com',
  },
  dateModified: '2026-07-07',
  mainEntityOfPage: Astro.url.href,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blogs', item: 'https://www.fitcloo.com/blogs/' },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};
---

<BaseLayout 
  title={`${title} | Fitclo Guides`}
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero -->
  <section class="relative py-32 bg-black overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black"></div>
    </div>
    <div class="max-w-[1200px] mx-auto px-6 relative z-10 text-center">
      <p class="text-[11px] font-bold tracking-[0.3em] text-[#C9A84C] uppercase mb-6 font-['Century_Gothic',sans-serif]">
        {type}
      </p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-8 leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-white/60 max-w-3xl mx-auto font-['Century_Gothic',sans-serif] leading-relaxed">
        {description}
      </p>
    </div>
  </section>

  <!-- Content Placeholder -->
  <section class="py-24 bg-white">
    <div class="max-w-[800px] mx-auto px-6">
      <!-- GEO Optimization: Key Takeaways for AI Search -->
      <div class="mb-12 p-8 bg-[#C9A84C]/5 border-l-4 border-[#C9A84C] rounded-r-xl font-['Century_Gothic',sans-serif]">
        <h2 class="text-[18px] font-bold text-black uppercase tracking-widest mb-4">Key Takeaways for Activewear Sourcing</h2>
        <ul class="space-y-3 text-[15px] text-gray-700">
          <li class="flex items-start">
            <span class="text-[#C9A84C] mr-2">✔</span>
            <span>Direct factory sourcing reduces costs by 30-50% compared to trading companies.</span>
          </li>
          <li class="flex items-start">
            <span class="text-[#C9A84C] mr-2">✔</span>
            <span>MOQ of 100 pcs is ideal for emerging private label brands to test the market.</span>
          </li>
          <li class="flex items-start">
            <span class="text-[#C9A84C] mr-2">✔</span>
            <span>SGS & ISO certifications ensure quality compliance for global distribution.</span>
          </li>
        </ul>
      </div>

      <div class="prose prose-lg max-w-none font-['Century_Gothic',sans-serif] text-gray-700 leading-relaxed">
        <slot />

        <div class="not-prose mt-16 p-8 bg-white border border-gray-100 rounded-2xl shadow-[0_18px_50px_rgba(15,23,42,0.06)] font-['Century_Gothic',sans-serif]">
          <p class="text-[#C9A84C] text-[11px] font-black tracking-[0.18em] uppercase mb-2">Author Authority</p>
          <h3 class="text-2xl font-black text-black mb-3">Jason Chen, Founder of Fitclo</h3>
          <p class="text-gray-600 text-[15px] leading-relaxed mb-0">Activewear Manufacturing Specialist with 8+ years of export experience helping global brands plan fabrics, MOQ, private label development, production control and shipping.</p>
        </div>

        <div class="not-prose mt-8 p-8 bg-gray-50 rounded-2xl border border-gray-100 font-['Century_Gothic',sans-serif]">
          <h3 class="text-2xl font-black text-black mb-5">Related Guides</h3>
          <div class="grid md:grid-cols-3 gap-4">
            <a href="/activewear-intelligence/" class="block p-5 bg-white rounded-xl border border-gray-100 text-black no-underline font-bold">Activewear Intelligence Hub</a>
            <a href="/blogs/china-activewear-manufacturer-checklist" class="block p-5 bg-white rounded-xl border border-gray-100 text-black no-underline font-bold">Factory Verification Checklist</a>
            <a href="/private-label" class="block p-5 bg-white rounded-xl border border-gray-100 text-black no-underline font-bold">Private Label Manufacturing</a>
          </div>
        </div>
        
        <div class="mt-10 p-10 bg-gray-50 rounded-2xl border border-gray-100">
          <h3 class="text-2xl font-bold text-black mb-4 font-['Century_Gothic',sans-serif]">Need Help Choosing The Right Manufacturing Solution?</h3>
          <p class="text-gray-500 mb-8">
            Ask Fitclo to recommend fabric, MOQ and production method for your activewear project.
          </p>
          <a href={whatsappIntelligenceUrl} target="_blank" class="inline-block bg-[#C9A84C] text-black px-8 py-4 rounded-lg font-bold uppercase tracking-widest text-sm hover:bg-black hover:text-[#C9A84C] transition-all">
            Ask Fitclo
          </a>
        </div>
      </div>
    </div>
  </section>

  <div id="inquiry">
    <InquiryForm />
  </div>
</BaseLayout>
