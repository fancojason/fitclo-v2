---
import EditorialArticleLayout from './EditorialArticleLayout.astro';
import { intelligenceArticles } from '../data/intelligence';

const {
  title,
  description,
  market,
  date = 'July 11, 2026',
  readTime = '10 min read',
  tags = [],
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const intelligenceEntry = intelligenceArticles.find((article) => article.link === currentPath);
const articleKind = intelligenceEntry?.categorySlug ?? (
  /sustainable|trend|recycled/i.test(`${title} ${description}`)
    ? 'trend-report'
    : /private label|branding|custom/i.test(`${title} ${description}`)
      ? 'private-label-guide'
      : 'buyer-guide'
);
const resolvedType = intelligenceEntry?.category ?? `${market} Sourcing Guide`;

const focus = tags.length > 0 ? tags.join(', ') : 'private label activewear, quality control and landed cost';

const quickAnswerTitle = `${market} buyers should compare suppliers by local market fit, sample quality, MOQ, landed cost and delivery reliability. The right route is the one that protects both launch timing and retail margin.`;

const quickTakeaways = [
  `Define the target customer, size expectations and core product categories for the ${market} market.`,
  'Compare ready-to-ship branding, private label customization and full OEM/ODM by MOQ and product control.',
  'Approve fabric, fit, labels, packaging and a realistic landed-cost plan before bulk production.',
];

const expertParagraphs = [
  `For ${market} sourcing, compare suppliers against the same product brief, quantity, quality standard and delivery location. A factory quotation is only one part of the decision; sizing expectations, labeling, freight responsibility, duty, local delivery and the time between deposit and sellable inventory all affect commercial fit.`,
  `Use a complete sample to validate fabric, fit, measurements, branding and packaging before production. Then work backwards from the required arrival date to allow for material readiness, bulk production, final inspection, customs clearance and local delivery in ${market}. This creates a more reliable launch plan than using factory lead time or transit time alone.`,
];

const commonMistakes = [
  'Comparing factory prices without using the same Incoterm, carton assumptions and destination costs.',
  'Approving model photos instead of garment measurements, fit and size grading for the target market.',
  'Leaving labels, packaging, customs documents or delivery responsibility until shipment is ready.',
];

const planningRows = [
  ['Market fit', `Sizing, preferred product categories and retail expectations for ${market} buyers.`, 'Start with focused leggings, sports bras, yoga sets or gym wear that match local demand.'],
  ['Sourcing route', 'Ready-to-ship private label, low-MOQ customization or full OEM/ODM.', 'Choose the route that protects launch speed, cash flow and useful differentiation.'],
  ['Quality proof', 'Fabric composition, stretch recovery, opacity, stitching, labels, packaging and final inspection.', 'Approve a representative sample and written QC checklist before bulk production.'],
  ['Landed cost', 'Factory cost, branding, packaging, freight, duty and destination delivery.', 'Plan the complete landed cost before setting wholesale or DTC pricing.'],
];

const faqs = [
  {
    question: `What should ${market} activewear brands verify before choosing a manufacturer?`,
    answer: 'Verify factory control, fabric knowledge, MOQ, sampling timeline, production capacity, quality steps, export experience and communication speed before placing an order.',
  },
  {
    question: 'Does Fitclo support private label activewear and OEM/ODM production?',
    answer: 'Yes. Fitclo supports ready-to-ship logo customization, private label activewear and full OEM/ODM development for leggings, sports bras, yoga sets, gym wear and athleisure collections.',
  },
  {
    question: `What should I send for a ${market} sourcing recommendation?`,
    answer: `Share your product category, target customer, quantity, fabric preference, size range, logo method, launch date and delivery location in ${market}.`,
  },
];

const relatedReading = [
  {
    title: 'China Activewear Manufacturer Verification Checklist',
    desc: 'A practical supplier verification checklist for international buyers.',
    link: '/blogs/china-activewear-manufacturer-checklist',
  },
  {
    title: 'MOQ Planning for Private Label Activewear',
    desc: 'Balance launch risk, unit cost and SKU count before ordering.',
    link: '/blogs/moq',
  },
  {
    title: 'Activewear Fabric Guide',
    desc: 'Compare fabric composition, GSM, opacity and performance tests.',
    link: '/blogs/fabrics',
  },
  {
    title: 'Activewear Intelligence Hub',
    desc: `Browse more manufacturing guides for ${focus}.`,
    link: '/activewear-intelligence/',
  },
];
---

<EditorialArticleLayout
  title={title}
  description={description}
  type={resolvedType}
  articleKind={articleKind}
  date={date}
  readTime={readTime}
  articleImage="/images/intelligence/cover-brand-planning.png"
  quickAnswerTitle={quickAnswerTitle}
  quickTakeaways={quickTakeaways}
  expertSectionTitle={`How ${market} buyers should apply this sourcing guide`}
  expertParagraphs={expertParagraphs}
  commonMistakes={commonMistakes}
  planningTableTitle={`What ${market} brands should check before ordering`}
  planningRows={planningRows}
  faqs={faqs}
  relatedReading={relatedReading}
>
  <slot />
</EditorialArticleLayout>
