---
import BaseLayout from './BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { whatsappIntelligenceUrl } from '../data/intelligence';

const {
  title,
  description,
  market,
  date = 'July 07, 2026',
  readTime = '9 min read',
  tags = [],
} = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: 'Jason Chen',
    jobTitle: 'Founder of Fitclo, Activewear Manufacturing Specialist',
    description: 'Activewear manufacturing specialist with 8+ years of export experience.',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fitclo',
    logo: {
      '@type': 'ImageObject',
      url: 'https://sc01.alicdn.com/kf/H8f27abddb40d4300874f693d698ed50dd.png',
    },
  },
  datePublished: '2026-07-07',
  dateModified: '2026-07-07',
  mainEntityOfPage: Astro.url.href,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blogs', item: 'https://www.fitcloo.com/blogs/' },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What should ${market} activewear brands verify before choosing a manufacturer?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Brands should verify factory ownership, fabric knowledge, MOQ, sampling timelines, production capacity, quality control steps, export experience and communication speed before placing an order.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Fitclo support private label activewear and OEM/ODM production?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Fitclo supports ready-to-ship logo customization, private label activewear programs and full OEM/ODM development for leggings, sports bras, yoga sets, gym wear and athleisure collections.',
      },
    },
    {
      '@type': 'Question',
      name: 'What information helps Fitclo recommend the right activewear production plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fitclo can recommend a better plan when buyers share target product category, fabric preference, logo method, quantity, size range, launch timeline, destination market and target retail positioning.',
      },
    },
  ],
};
---

<BaseLayout title={`${title} | Fitclo Blog`} description={description} structuredData={[articleSchema, faqSchema]} autoArticleSchema={false}>
  <article class="market-article bg-white font-['Century_Gothic',sans-serif]">
    <header class="market-hero">
      <div class="market-bg">
        <img
          src="https://sc01.alicdn.com/kf/H884ba8683a5149558bb5623a0bc673b8T.png"
          alt="Fitclo activewear manufacturing for global private label brands"
          loading="eager"
        />
      </div>
      <div class="market-hero-inner">
        <div class="market-copy">
          <p class="market-kicker">{market} Sourcing Guide</p>
          <h1>{title}</h1>
          <p class="market-desc">{description}</p>
          <div class="market-meta">
            <span>{date}</span>
            <span>{readTime}</span>
            <span>Private Label Activewear</span>
          </div>
        </div>
        <aside class="market-panel">
          <p>Buyer Focus</p>
          <strong>{market}</strong>
          <div>
            {tags.map((tag) => <span>{tag}</span>)}
          </div>
        </aside>
      </div>
    </header>

    <section class="market-body-wrap">
      <div class="market-body">
        <slot />

        <section class="market-author">
          <p>Author Authority</p>
          <h2>Jason Chen, Founder of Fitclo</h2>
          <span>Activewear Manufacturing Specialist with 8+ years of export experience helping global brands plan sourcing, fabric selection, MOQ, private label production and shipping.</span>
        </section>

        <section class="related-guides">
          <div>
            <p>Related Guides</p>
            <h2>Continue Your Activewear Manufacturing Research</h2>
          </div>
          <div class="related-grid">
            <a href="/activewear-intelligence/">Activewear Intelligence Hub</a>
            <a href="/blogs/china-activewear-manufacturer-checklist">Factory Verification Checklist</a>
            <a href="/private-label">Private Label Manufacturing</a>
            <a href="/capabilities">Factory Capabilities</a>
          </div>
        </section>

        <section class="ask-fitclo">
          <div>
            <p>AI Conversion CTA</p>
            <h2>Need Help Choosing The Right Manufacturing Solution?</h2>
            <span>Ask Fitclo to recommend fabric, MOQ and production method for your activewear project.</span>
          </div>
          <a href={whatsappIntelligenceUrl} target="_blank" rel="noopener">Ask Fitclo</a>
        </section>
      </div>
    </section>

    <InquiryForm />
  </article>
</BaseLayout>

<style is:global>
  .market-hero {
    position: relative;
    overflow: hidden;
    background: #06060a;
    color: #fff;
    padding: 10rem 1.25rem 4.5rem;
  }

  .market-bg,
  .market-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .market-bg img {
    object-fit: cover;
    opacity: 0.28;
  }

  .market-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #06060a 0%, rgba(6, 6, 10, 0.93) 48%, rgba(6, 6, 10, 0.58) 100%);
  }

  .market-hero-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
  }

  .market-copy {
    max-width: 1120px;
    margin: 0 auto;
    text-align: center;
  }

  .market-kicker {
    margin: 0 0 1.15rem;
    color: #C9A84C;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .market-copy h1 {
    max-width: 1120px;
    margin: 0 auto;
    font-size: clamp(2.85rem, 5.7vw, 5.8rem);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .market-desc {
    max-width: 820px;
    margin: 1.6rem auto 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.72;
  }

  .market-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.65rem;
  }

  .market-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    font-weight: 700;
  }

  .market-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 820px;
    margin: 2rem auto 0;
    padding: 1rem 1.15rem;
    border: 1px solid rgba(201, 168, 76, 0.28);
    border-radius: 14px;
    background: rgba(8, 8, 12, 0.74);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
  }

  .market-panel p {
    margin: 0 0 0.2rem;
    color: #C9A84C;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .market-panel strong {
    display: block;
    color: #fff;
    font-size: 1.15rem;
    line-height: 1.15;
    font-weight: 900;
  }

  .market-panel div {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.45rem;
    margin-top: 0;
  }

  .market-panel span {
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.14);
    color: #C9A84C;
    font-size: 11px;
    font-weight: 900;
  }

  .market-body-wrap {
    padding: 4.5rem 1.25rem;
  }

  .market-author,
  .related-guides,
  .ask-fitclo {
    margin-top: 3rem;
    padding: 2rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
  }

  .market-author p,
  .related-guides p,
  .ask-fitclo p {
    margin: 0 0 0.5rem;
    color: #C9A84C;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .market-author h2,
  .related-guides h2,
  .ask-fitclo h2 {
    margin: 0;
    color: #0f172a;
    font-size: 1.55rem;
    line-height: 1.2;
    font-weight: 900;
  }

  .market-author span,
  .ask-fitclo span {
    display: block;
    margin-top: 0.85rem;
    color: #52525b;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.35rem;
  }

  .related-grid a {
    padding: 1rem;
    border-radius: 10px;
    background: #f7f6f3;
    color: #0f172a;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
  }

  .ask-fitclo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: #f7f6f3;
  }

  .ask-fitclo a {
    flex: 0 0 auto;
    padding: 0.95rem 1.35rem;
    border-radius: 8px;
    background: #C9A84C;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .market-body {
    max-width: 880px;
    margin: 0 auto;
    color: #374151;
    font-size: 17px;
    line-height: 1.82;
  }

  .market-body p {
    margin: 0 0 1.25rem;
  }

  .market-body strong {
    color: #111827;
    font-weight: 850;
  }

  .market-body a {
    color: #8a6a24;
    font-weight: 850;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .market-body h2 {
    margin: 3.4rem 0 1.15rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e5e7eb;
    color: #0f172a;
    font-size: clamp(1.55rem, 2.4vw, 2.05rem);
    line-height: 1.24;
    font-weight: 900;
    letter-spacing: 0;
  }

  .market-body h3 {
    margin: 2.1rem 0 0.8rem;
    color: #111827;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.35;
    font-weight: 900;
    letter-spacing: 0;
  }

  .market-body ul,
  .market-body ol {
    margin: 1rem 0 1.8rem;
    padding: 1.2rem 1.35rem;
    background: #fafafa;
    border: 1px solid #eeeeee;
    border-radius: 12px;
  }

  .market-body li {
    margin: 0.65rem 0 0.65rem 1.15rem;
    line-height: 1.65;
  }

  .market-note {
    margin: 2rem 0;
    padding: 1.4rem;
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 14px;
    background: rgba(201, 168, 76, 0.08);
  }

  .market-table {
    margin: 1.5rem 0 2rem;
    overflow-x: auto;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
  }

  .market-table table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .market-table th {
    background: #0e0e12;
    color: #C9A84C;
    text-align: left;
    padding: 1rem;
    font-weight: 900;
  }

  .market-table td {
    padding: 1rem;
    border-top: 1px solid #e5e7eb;
    vertical-align: top;
  }

  @media (max-width: 820px) {
    .market-hero {
      padding-top: 8.5rem;
    }

    .market-copy h1 {
      font-size: clamp(2.35rem, 12vw, 4rem);
      line-height: 0.98;
    }

    .market-panel {
      display: block;
      max-width: 520px;
      text-align: center;
    }

    .market-panel div {
      justify-content: center;
      margin-top: 0.85rem;
    }

    .market-body {
      font-size: 16px;
      line-height: 1.78;
    }
  }
</style>
