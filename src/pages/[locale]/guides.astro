---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateLinks } from '../../i18n/routes';
import { corePath } from '../../content/core-locales';

export function getStaticPaths() {
  return [
    { params: { locale: 'nl' }, props: { language: 'nl' } },
    { params: { locale: 'pt-br' }, props: { language: 'pt-BR' } },
    { params: { locale: 'ru' }, props: { language: 'ru' } },
  ];
}

const { language } = Astro.props as { language: 'nl' | 'pt-BR' | 'ru' };
const copy = {
  ru: {
    title: 'Руководство по закупке спортивной одежды',
    intro: 'Сравните закупку готовых моделей, выпуск под своим брендом и разработку OEM/ODM. Подготовьте данные для расчёта заказа.',
    sections: [
      ['Наличие и минимальный заказ', 'Укажите артикулы и количество по цветам и размерам. Для комплектов уточните единицу заказа и допустимые сочетания размеров верха и низа.', 'ready-stock-activewear', 'Проверить готовые модели'],
      ['Маркировка и упаковка', 'Перед заказом согласуйте логотип, этикетки, упаковку и макет штрихкода. Для каждой розничной позиции укажите отдельную строку с артикулом, цветом и размером.', 'private-label-activewear', 'Обсудить выпуск под вашим брендом'],
      ['Образец и серийный заказ', 'Утвердите ткань, размеры и внешний вид образца. Запросите отдельно стоимость разработки, сроки производства, дату отправки и условия перевозки до пункта назначения.', 'oem-activewear-manufacturer', 'Обсудить разработку OEM/ODM'],
    ],
    cta: 'Запросить цену',
    related: 'Подробные руководства на английском',
  },
  nl: {
    title: 'Inkoopgids voor sportkleding',
    intro: 'Vergelijk voorraadmodellen, private label en OEM/ODM. Gebruik deze gids om een offerte voor uw collectie voor te bereiden.',
    sections: [
      ['Voorraad en minimumafname', 'Stuur het modelnummer en de verdeling per kleur en maat. De minimumafname en de mogelijkheid om maten of kleuren te combineren hangen af van het model en de actuele voorraad.', 'ready-stock-activewear', 'Voorraadopties bekijken'],
      ['Private label of eigen ontwerp?', 'Wilt u een logo, hangtag of verpakking op een bestaand model? Bespreek dan private label. Voor wijzigingen aan patroon, stof of constructie stuurt u een tekening, referentie of tech pack voor OEM/ODM.', 'private-label-activewear', 'Private label bekijken'],
      ['Monsters, prijs en levertijd', 'Vraag om afzonderlijke informatie over monsterkosten, productietijd, verzenddatum en transport. Geef aan of u aantallen in stuks of sets bedoelt en naar welk land de levering gaat.', 'oem-activewear-manufacturer', 'OEM/ODM bekijken'],
    ],
    cta: 'Offerte aanvragen',
    related: 'Uitgebreide handleidingen in het Engels',
  },
  'pt-BR': {
    title: 'Guia de compra de roupas fitness',
    intro: 'Compare pronta entrega, marca própria e OEM/ODM. Use este guia para preparar a cotação da sua coleção.',
    sections: [
      ['Estoque e pedido mínimo', 'Envie o código do modelo e a grade por cor e tamanho. O pedido mínimo e a possibilidade de combinar tamanhos ou cores dependem do modelo e do estoque disponível.', 'ready-stock-activewear', 'Ver opções de pronta entrega'],
      ['Marca própria ou desenvolvimento?', 'Para aplicar logo, tags ou embalagem a um modelo existente, consulte as opções de marca própria. Para alterar modelagem, tecido ou construção, envie um croqui, referência ou ficha técnica para OEM/ODM.', 'private-label-activewear', 'Ver opções de marca própria'],
      ['Amostras, preço e prazos', 'Peça valores de amostra, prazo de produção, data de despacho e tempo de transporte separadamente. Indique se o volume está em peças ou conjuntos e informe o país de destino.', 'oem-activewear-manufacturer', 'Ver opções de OEM/ODM'],
    ],
    cta: 'Solicitar cotação',
    related: 'Guias detalhados em inglês',
  },
}[language];
const alternateLinks = getAlternateLinks('/guides/', '/es/guias/');
---

<BaseLayout lang={language} title={`${copy.title} | Fitclo`} description={copy.intro} alternateLinks={alternateLinks}>
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-36 text-white">
    <h1 class="text-4xl font-bold md:text-5xl">{copy.title}</h1>
    <p class="mt-5 max-w-2xl text-lg text-white/75">{copy.intro}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {copy.sections.map(([title, description, page, label]) => (
        <section class="border border-white/15 bg-[#141414] p-6">
          <h2 class="text-xl font-semibold">{title}</h2>
          <p class="mt-3 leading-relaxed text-white/75">{description}</p>
          <a class="mt-5 inline-block text-[#d8b456] underline" href={corePath(language, page as 'ready-stock-activewear' | 'private-label-activewear' | 'oem-activewear-manufacturer')}>{label}</a>
        </section>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-6">
      <a class="bg-[#d8b456] px-5 py-3 font-medium text-black" href={corePath(language, 'contact') + '#inquiry'}>{copy.cta}</a>
      <a class="text-white/80 underline" href="/guides/" hreflang="en" lang={language}>{copy.related}</a>
    </div>
  </main>
</BaseLayout>
