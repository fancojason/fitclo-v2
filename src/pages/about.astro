---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/Stats.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout title="About Us | FITCLO - Professional Activewear Manufacturer">
  <!-- Hero Section -->
  <section class="relative h-[40vh] bg-black flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
        alt="About Fitclo" 
        class="w-full h-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-5xl md:text-7xl font-bold text-white mb-4 uppercase tracking-tighter">About <span class="text-accent italic">Fitclo</span></h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">A professional activewear manufacturer and exporter dedicated to quality and innovation.</p>
    </div>
  </section>

  <!-- Company Introduction -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-8 uppercase tracking-tighter">Manufacturing <span class="text-accent italic">Excellence</span></h2>
          <div class="prose prose-lg text-gray-600 space-y-6">
            <p>
              Fitclo is a professional activewear manufacturer and exporter based in Dongguan, China. Established in 2010, we have grown from a small workshop into a leading factory with over 350 skilled employees and a 12,000 square meter production facility.
            </p>

            <p>
              We specialize in high-quality yoga wear, gym wear, and athletic apparel for global brands. Our mission is to make activewear sourcing easier, faster and more reliable for businesses of all sizes, from startups to established retailers.
            </p>
            <div class="flex flex-col space-y-4 pt-4">
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                  <h3 class="font-bold text-xl mb-1">Our Mission</h3>
                  <p class="text-gray-500">To make activewear sourcing easier, faster and more reliable through innovation and efficiency.</p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <div>
                  <h3 class="font-bold text-xl mb-1">Quality Commitment</h3>
                  <p class="text-gray-500">Rigorous quality control at every stage of production to ensure your brand's reputation.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="grid grid-cols-2 gap-4">
            <img src="https://sc02.alicdn.com/kf/Afa390f225edd4d7cadafa64b6ad03c40s.png" alt="Factory" class="rounded-2xl shadow-lg w-full aspect-square object-cover" />
            <img src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" alt="Production" class="rounded-2xl shadow-lg w-full aspect-square object-cover mt-8" />
          </div>
          <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-accent/10 rounded-full blur-3xl -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <Stats />

  <!-- Why Choose Us -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold uppercase tracking-tighter">Why Customers <span class="text-accent italic">Choose Fitclo</span></h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto">We provide comprehensive solutions for activewear brands worldwide.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { title: 'Ready-To-Ship', desc: 'Over 100,000 units in stock for immediate delivery.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
          { title: 'Low MOQ', desc: 'Start your brand with as few as 100 pieces per style.', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
          { title: 'Custom Design', desc: 'Professional design team to help bring your ideas to life.', icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' },
          { title: 'Reliable Quality', desc: 'SGS/ISO certified production standards and 100% inspection.', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' }
        ].map(item => (
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300 group">
            <div class="w-14 h-14 bg-black text-accent rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path></svg>
            </div>
            <h3 class="text-xl font-bold mb-3">{item.title}</h3>
            <p class="text-gray-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
