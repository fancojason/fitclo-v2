---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/Stats.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout title="About Us | FITCLO - Professional Activewear Manufacturer">
  <!-- Hero Section -->
  <section class="relative h-[45vh] bg-black flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
        alt="About Fitclo" 
        class="w-full h-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 uppercase tracking-tighter font-['Montserrat',sans-serif]">About <span class="text-accent italic">Fitclo</span></h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto font-['Century_Gothic',sans-serif] leading-relaxed">
        A professional activewear manufacturer and exporter dedicated to quality and innovation.
      </p>
    </div>
  </section>

  <!-- Company Introduction -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-[32px] md:text-[40px] font-black mb-8 uppercase tracking-tighter font-['Montserrat',sans-serif]">Company <span class="text-accent italic">Introduction</span></h2>
          <div class="space-y-6 text-[18px] text-gray-700 font-['Century_Gothic',sans-serif] leading-relaxed">
            <p>
              Fitclo is a professional activewear manufacturer dedicated to helping brands build and scale their activewear businesses.
            </p>
            <p>
              Founded in 2010, Fitclo has grown into a vertically integrated manufacturing company with over 350 employees, a 12,000㎡ production facility and a monthly capacity of more than 450,000 pieces.
            </p>
            <p>
              We specialize in private label activewear, ready-to-ship programs and OEM manufacturing services for customers worldwide.
            </p>
            
            <div class="flex flex-col space-y-6 pt-10">
              <div class="flex items-start space-x-5 group">
                <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent group-hover:text-black transition-colors duration-300">
                  <svg class="w-7 h-7 text-accent group-hover:text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                  <h3 class="font-black text-xl mb-2 uppercase tracking-tight font-['Montserrat',sans-serif]">Our Mission</h3>
                  <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[16px]">To make activewear sourcing easier, faster and more reliable through innovation and efficiency.</p>
                </div>
              </div>
              <div class="flex items-start space-x-5 group">
                <div class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent group-hover:text-black transition-colors duration-300">
                  <svg class="w-7 h-7 text-accent group-hover:text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <div>
                  <h3 class="font-black text-xl mb-2 uppercase tracking-tight font-['Montserrat',sans-serif]">Quality Commitment</h3>
                  <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[16px]">Rigorous quality control at every stage of production to ensure your brand's reputation.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="relative order-1 lg:order-2">
          <div class="relative z-10 rounded-[40px] overflow-hidden shadow-2xl border-[12px] border-white">
            <img 
              src="https://sc01.alicdn.com/kf/H08b0f9ae720a4061a79917c3d7f739663.png" 
              alt="Fitclo Factory Building" 
              class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
            />
          </div>
          <div class="absolute -bottom-12 -right-12 w-80 h-80 bg-accent/20 rounded-full blur-[100px] -z-10"></div>
          <div class="absolute -top-12 -left-12 w-64 h-64 bg-accent/10 rounded-full blur-[80px] -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <Stats />

  <!-- Why Choose Us -->
  <section class="py-24 bg-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black uppercase tracking-tighter font-['Montserrat',sans-serif]">Why Customers <span class="text-accent italic">Choose Fitclo</span></h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto font-['Century_Gothic',sans-serif] text-[18px]">We provide comprehensive solutions for activewear brands worldwide.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: Factory Photos Grid -->
        <div class="relative group">
          <div class="overflow-hidden shadow-2xl">
            <img 
              src="https://sc01.alicdn.com/kf/Hcc2d5570d1a94d4ea98d26ce3312893dj.png" 
              alt="Fitclo Factory Operations" 
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
          </div>
          <!-- Decorative element -->
          <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-accent/20 rounded-full blur-3xl -z-10"></div>
        </div>

        <!-- Right: Value Props List (XMYoohoo Style) -->
        <div class="space-y-8">
          {[
            { 
              title: 'Ready-To-Ship Program', 
              desc: 'Over 4,000,000 units in stock for immediate delivery.', 
              icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' 
            },
            { 
              title: 'Flexible Low MOQ', 
              desc: 'Start your brand with as few as 100 pieces per style.', 
              icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' 
            },
            { 
              title: 'Professional Custom Design', 
              desc: 'Expert design team to help bring your unique ideas to life.', 
              icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' 
            },
            { 
              title: 'Reliable Global Quality', 
              desc: 'SGS/ISO certified production standards and 100% inspection.', 
              icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' 
            }
          ].map((item, index) => (
            <div class="flex items-start space-x-6 group hover:translate-x-2 transition-transform duration-300">
              <div class="w-14 h-14 bg-white shadow-md rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-[#e60012] group-hover:text-white transition-all duration-300">
                <svg class="w-7 h-7 text-[#e60012] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                </svg>
              </div>
              <div class="pt-1">
                <h3 class="text-[20px] font-black mb-2 font-['Montserrat',sans-serif] uppercase tracking-tight group-hover:text-[#e60012] transition-colors">
                  {index + 1}. {item.title}
                </h3>
                <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[16px] leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Certificates Section (XMYoohoo Style) -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-black uppercase tracking-tighter font-['Montserrat',sans-serif]">Global <span class="text-accent italic">Certifications</span></h2>
      </div>
      <div class="flex justify-center">
        <img 
          src="https://sc01.alicdn.com/kf/Hfd7099e6ab8a449db9590c84b4fdb066I.png" 
          alt="Fitclo Certifications" 
          class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-500 cursor-pointer"
        />
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
