---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/Stats.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout
  title="About Us | FITCLO - Professional Activewear Manufacturer"
  description="Learn about Fitclo, a China-based activewear manufacturer supporting global brands with private label yoga wear, leggings, sports bras, OEM/ODM production and ready-to-ship programs."
>
  <!-- Hero Section -->
  <section class="relative h-[45vh] bg-black flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
        alt="About Fitclo" 
        class="w-full h-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        About <span class="text-[#C9A84C] italic">Fitclo</span>
      </h1>
      <p class="text-lg md:text-xl text-white/70 max-w-3xl mx-auto font-['Century_Gothic',sans-serif] leading-relaxed">
        A professional activewear manufacturer and exporter dedicated to quality and innovation.
      </p>
    </div>
  </section>

  <!-- Company Introduction -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-[1600px] ml-auto mr-0 px-6 lg:px-10 lg:pl-32">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-24 items-center">
        <div class="order-2 lg:order-1 lg:col-span-2 lg:pr-12">
          <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
            WHO WE ARE
          </h3>
          <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-8">
            Company <span class="text-[#C9A84C] italic">Introduction</span>
          </h2>
          <div class="space-y-6 text-[15px] md:text-[16px] text-gray-600 font-['Century_Gothic',sans-serif] leading-relaxed">
            <p>
              Fitclo is a professional activewear manufacturer dedicated to helping brands build and scale their activewear businesses.
            </p>
            <p>
              Founded in 2010, Fitclo has grown into a vertically integrated manufacturing company with over 350 employees, a 16,000㎡ production facility and a monthly capacity of more than 450,000 pieces.
            </p>
            <p>
              We specialize in private label activewear, ready-to-ship programs and OEM manufacturing services for customers worldwide.
            </p>
            
            <div class="flex flex-col space-y-6 pt-10">
              <div class="flex items-start space-x-5 group">
                <div class="w-14 h-14 bg-[#C9A84C]/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-[#C9A84C] group-hover:text-black transition-colors duration-300">
                  <svg class="w-7 h-7 text-[#C9A84C] group-hover:text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[18px] md:text-[20px] text-black mb-2 uppercase tracking-tight font-['Century_Gothic',sans-serif]">Our Mission</h3>
                  <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[14px] md:text-[15px]">To make activewear sourcing easier, faster and more reliable through innovation and efficiency.</p>
                </div>
              </div>
              <div class="flex items-start space-x-5 group">
                <div class="w-14 h-14 bg-[#C9A84C]/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-[#C9A84C] group-hover:text-black transition-colors duration-300">
                  <svg class="w-7 h-7 text-[#C9A84C] group-hover:text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <div>
                  <h3 class="font-bold text-[18px] md:text-[20px] text-black mb-2 uppercase tracking-tight font-['Century_Gothic',sans-serif]">Quality Commitment</h3>
                  <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[14px] md:text-[15px]">Rigorous quality control at every stage of production to ensure your brand's reputation.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="relative order-1 lg:order-2 lg:col-span-3 ml-auto w-full">
          <div class="relative z-10 rounded-[20px] lg:rounded-[40px] overflow-hidden shadow-xl border-[8px] border-white max-w-[90%] ml-auto">
            <img 
              src="https://sc01.alicdn.com/kf/H08b0f9ae720a4061a79917c3d7f739663.png" 
              alt="Fitclo 16,000sqm China Activewear Factory Building - ISO & SGS Certified Manufacturer" 
              class="w-full h-auto transform hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-12 -right-12 w-80 h-80 bg-accent/20 rounded-full blur-[100px] -z-10"></div>
          <div class="absolute -top-12 -left-12 w-64 h-64 bg-accent/10 rounded-full blur-[80px] -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <Stats />

  <!-- Why Choose Us -->
  <section class="py-24 bg-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          WHY CHOOSE US
        </h3>
        <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-4">
          Why Customers <span class="text-[#C9A84C] italic">Choose Fitclo</span>
        </h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto font-['Century_Gothic',sans-serif] text-[16px] md:text-[18px]">
          We provide comprehensive solutions for activewear brands worldwide.
        </p>
      </div>

        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <!-- Left: Factory Photos Grid -->
          <div class="relative group">
            <div class="overflow-hidden shadow-2xl rounded-[32px]">
              <img 
                src="https://sc01.alicdn.com/kf/Hcc2d5570d1a94d4ea98d26ce3312893dj.png" 
                alt="Fitclo Factory Operations" 
                class="w-full h-auto transform group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            <!-- Decorative element -->
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#C9A84C]/20 rounded-full blur-3xl -z-10"></div>
          </div>


        <!-- Right: Value Props List (XMYoohoo Style) -->
        <div class="space-y-8">
          {[
            { 
              title: 'Ready-To-Ship Program', 
              desc: 'Over 4,000,000 units in stock for immediate delivery.', 
              icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' 
            },
            { 
              title: 'Flexible Low MOQ', 
              desc: 'Start your brand with as few as 100 pieces per style.', 
              icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' 
            },
            { 
              title: 'Professional Custom Design', 
              desc: 'Expert design team to help bring your unique ideas to life.', 
              icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z' 
            },
            { 
              title: 'Reliable Global Quality', 
              desc: 'SGS/ISO certified production standards and 100% inspection.', 
              icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' 
            }
          ].map((item, index) => (
            <div class="flex items-start space-x-6 group hover:translate-x-2 transition-transform duration-300">
              <div class="w-14 h-14 bg-white shadow-md rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-[#C9A84C] group-hover:text-black transition-all duration-300">
                <svg class="w-7 h-7 text-[#C9A84C] group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                </svg>
              </div>
              <div class="pt-1">
                <h3 class="text-[18px] md:text-[20px] font-bold mb-2 font-['Century_Gothic',sans-serif] uppercase tracking-tight group-hover:text-[#C9A84C] transition-colors">
                  {index + 1}. {item.title}
                </h3>
                <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[14px] md:text-[15px] leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Certificates Section (XMYoohoo Style) -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          QUALITY ASSURANCE
        </h3>
        <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
          Global <span class="text-[#C9A84C] italic">Certifications</span>
        </h2>
      </div>
      <div class="flex justify-center">
        <img 
          src="https://sc01.alicdn.com/kf/Hfd7099e6ab8a449db9590c84b4fdb066I.png" 
          alt="Fitclo Certifications" 
          class="max-w-[1200px] w-full h-auto transition-all duration-500 cursor-pointer hover:scale-[1.01]"
        />
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>

