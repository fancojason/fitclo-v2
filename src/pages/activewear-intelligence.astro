---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    title: 'Buyer Guide',
    desc: 'Factory vetting, MOQ planning, sourcing risks and supplier selection for private label activewear buyers.',
    count: '12 Articles',
    tone: 'gold',
    icon: 'book',
    link: '/blogs/china-activewear-manufacturer-checklist',
  },
  {
    title: 'Fabric Guide',
    desc: 'Nylon, polyester, recycled yarns, GSM, compression, squat-proof testing and performance fabric choices.',
    count: '10 Articles',
    tone: 'green',
    icon: 'fabric',
    link: '/blogs/fabrics',
  },
  {
    title: 'Private Label Guide',
    desc: 'Logo methods, labels, packaging, ready-to-ship styles and brand launch workflows.',
    count: '9 Articles',
    tone: 'purple',
    icon: 'tag',
    link: '/blogs/private-label-activewear-manufacturer-uk',
  },
  {
    title: 'Business Guide',
    desc: 'Inventory strategy, launch planning, pricing logic, margin protection and scaling activewear brands.',
    count: '11 Articles',
    tone: 'blue',
    icon: 'chart',
    link: '/blogs/wholesale-gym-wear-australia-sourcing-guide',
  },
  {
    title: 'Trend Report',
    desc: 'Market signals, sustainable fabrics, regional demand and product directions for 2026 collections.',
    count: '8 Articles',
    tone: 'rose',
    icon: 'trend',
    link: '/blogs/activewear-trends-2026',
  },
  {
    title: 'Comparison',
    desc: 'Side-by-side guides for construction, fabric, sourcing model and supplier decision making.',
    count: '7 Articles',
    tone: 'gold',
    icon: 'scale',
    link: '/blogs/seamless-vs-cut-sew-product-manager-guide',
  },
];

const popular = [
  {
    tag: 'Buyer Guide',
    title: 'China Activewear Manufacturer Checklist: How to Verify a Real Factory Before You Order',
    desc: 'A practical verification checklist for brands sourcing private label activewear from China.',
    link: '/blogs/china-activewear-manufacturer-checklist',
    image: '/images/intelligence/cover-factory-guide.png',
  },
  {
    tag: 'Australia',
    title: 'Private Label Activewear Manufacturer for Australian Brands',
    desc: 'Low-MOQ sourcing, private label yoga wear, gym wear and shipping planning for Australia.',
    link: '/blogs/private-label-activewear-manufacturer-australia',
    image: '/images/intelligence/cover-brand-planning.png',
  },
  {
    tag: 'United Kingdom',
    title: 'Wholesale Gym Wear UK: Sourcing Guide for Fitness Brands and Boutiques',
    desc: 'A practical launch guide for UK gym wear wholesalers and private label activewear brands.',
    link: '/blogs/wholesale-gym-wear-uk-sourcing-guide',
    image: '/images/intelligence/cover-fabric-guide.png',
  },
  {
    tag: 'Construction',
    title: 'Seamless vs Cut-and-Sew Activewear: Product Manager Decision Guide',
    desc: 'Compare construction methods by fit, MOQ, cost, support, fabric and quality control.',
    link: '/blogs/seamless-vs-cut-sew-product-manager-guide',
    image: '/images/intelligence/cover-private-label.png',
  },
  {
    tag: 'Sustainability',
    title: 'Sustainable Activewear Manufacturer for Australian Brands',
    desc: 'How to plan recycled fabrics, lower-risk MOQ and verified sustainability claims.',
    link: '/blogs/sustainable-activewear-manufacturer-australia',
    image: '/images/intelligence/cover-trend-report.png',
  },
];

const resources = [
  { icon: 'cap', title: 'Expert Knowledge', desc: 'Manufacturing insights written for activewear founders, sourcing teams and product managers.' },
  { icon: 'doc', title: 'Practical Guides', desc: 'Actionable checklists you can use before sampling, production and shipment.' },
  { icon: 'globe', title: 'Global Perspective', desc: 'Region-specific guidance for the US, UK, Australia, Europe and growing markets.' },
];
---

<BaseLayout
  title="Activewear Intelligence Hub | Fitclo Manufacturing Knowledge Base"
  description="Explore Fitclo's Activewear Intelligence Hub for private label activewear sourcing guides, fabric knowledge, buyer checklists, trend reports and manufacturing comparisons."
>
  <section class="hub-hero">
    <div class="hub-hero-media">
      <img src="/images/intelligence/hero-activewear-intelligence.png" alt="Fitclo activewear intelligence knowledge hub" />
    </div>
    <div class="hub-hero-inner">
      <p class="hub-brand">FITCLO</p>
      <h1>Activewear Intelligence</h1>
      <div class="hub-line"></div>
      <p class="hub-lead">Insights for building and scaling private label activewear brands.</p>
      <p class="hub-copy">Your go-to resource for manufacturing knowledge, fabrics, trends, sourcing decisions and business strategy in the activewear industry.</p>
      <form class="hub-search" action="/blogs" method="get">
        <input type="search" name="q" placeholder="Search guides, articles and more..." aria-label="Search guides, articles and more" />
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
          </svg>
        </button>
      </form>
    </div>
  </section>

  <section class="hub-main">
    <div class="hub-container">
      <div class="category-grid">
        {categories.map((category) => (
          <a class={`category-card tone-${category.tone}`} href={category.link}>
            <div class="category-icon">
              {category.icon === 'book' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H7a3 3 0 0 0-3 3V5.5Zm0 0V21m4-14h8m-8 4h8" /></svg>
              )}
              {category.icon === 'fabric' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m4 8 4-4 4 4 4-4 4 4-4 4 4 4-4 4-4-4-4 4-4-4 4-4-4-4Zm4 4 4-4 4 4-4 4-4-4Z" /></svg>
              )}
              {category.icon === 'tag' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 7h.01M4 12V5a1 1 0 0 1 1-1h7l8 8-8 8-8-8Z" /></svg>
              )}
              {category.icon === 'chart' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19h16M7 16V9m5 7V5m5 11v-4M6 8l5-4 4 5 4-3" /></svg>
              )}
              {category.icon === 'trend' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5m0 14h16M7 15l4-4 3 3 5-7" /></svg>
              )}
              {category.icon === 'scale' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v18m-6-7 3-7 3 7a3 3 0 0 1-6 0Zm6-7H5m7 0h7m-1 7 3-7 3 7a3 3 0 0 1-6 0Z" /></svg>
              )}
            </div>
            <h2>{category.title}</h2>
            <p>{category.desc}</p>
            <span class="article-count">{category.count}</span>
            <span class="explore">Explore Guides <strong>-></strong></span>
          </a>
        ))}
      </div>

      <div class="section-title-row">
        <h2>Popular Articles</h2>
        <a href="/blogs">View all articles -></a>
      </div>

      <div class="popular-grid">
        {popular.map((article) => (
          <a class="popular-card" href={article.link}>
            <img src={article.image} alt={article.title} loading="lazy" />
            <div>
              <span>{article.tag}</span>
              <h3>{article.title}</h3>
              <p>{article.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="hub-bottom">
        {resources.map((resource) => (
          <div class="resource-item">
            <div class="resource-mark">
              {resource.icon === 'cap' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M3 8.5 12 4l9 4.5-9 4.5-9-4.5Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M7 10.7v4.1c1.4 1.5 3.1 2.2 5 2.2s3.6-.7 5-2.2v-4.1" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M19 10v4" />
                </svg>
              )}
              {resource.icon === 'doc' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M7 3h7l4 4v14H7V3Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M14 3v5h5M9.5 12h6M9.5 15h6M9.5 18h4" />
                </svg>
              )}
              {resource.icon === 'globe' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.4 3.2 5.4 3.2 9s-1 6.6-3.2 9M12 3C9.8 5.4 8.8 8.4 8.8 12s1 6.6 3.2 9" />
                </svg>
              )}
            </div>
            <div>
              <h3>{resource.title}</h3>
              <p>{resource.desc}</p>
            </div>
          </div>
        ))}
        <div class="contact-box">
          <h3>Need More Information?</h3>
          <p>Our team is here to help you build your activewear brand with factory-direct guidance.</p>
          <a href="https://api.whatsapp.com/send?phone=8617160837538&text=Hello%20Fitclo%2C%20I%20just%20viewed%20your%20Activewear%20Intelligence%20Hub%20and%20would%20like%20to%20discuss%20a%20private%20label%20activewear%20project.%20Can%20we%20chat%3F" target="_blank" rel="noopener">Contact Us -></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero {
    position: relative;
    min-height: 430px;
    padding: 86px 24px 58px;
    overflow: hidden;
    color: #fff;
    background: #08080b;
    font-family: 'Century_Gothic', sans-serif;
  }

  .hub-hero-media,
  .hub-hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hub-hero-media img {
    object-fit: cover;
    object-position: 62% center;
    opacity: 1;
    filter: saturate(1.02) contrast(0.98) brightness(1.08);
  }

  .hub-hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.42) 34%, rgba(0, 0, 0, 0.05) 62%, rgba(0, 0, 0, 0.38) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.16), rgba(0, 0, 0, 0.04) 48%, rgba(0, 0, 0, 0.14));
  }

  .hub-hero-inner {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  .hub-brand {
    margin: 0 0 0.25rem;
    color: #C9A84C;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
  }

  .hub-hero h1 {
    max-width: 650px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.55rem, 5.4vw, 4.65rem);
    line-height: 0.96;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hub-line {
    width: 76px;
    height: 3px;
    margin: 1rem 0 1.2rem;
    background: #C9A84C;
  }

  .hub-lead {
    margin: 0 0 0.75rem;
    color: #fff;
    font-size: 17px;
    line-height: 1.55;
    font-weight: 900;
  }

  .hub-copy {
    max-width: 560px;
    margin: 0 0 1.7rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 15px;
    line-height: 1.75;
  }

  .hub-search {
    display: flex;
    width: min(520px, 100%);
    min-height: 50px;
    overflow: hidden;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.25);
  }

  .hub-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0 24px;
    color: #111827;
    font-size: 15px;
    outline: none;
  }

  .hub-search button {
    width: 56px;
    border: 0;
    background: #C9A84C;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .hub-search svg {
    width: 24px;
    height: 24px;
  }

  .hub-main {
    background: #f7f6f3;
    padding: 38px 24px 80px;
    font-family: 'Century_Gothic', sans-serif;
  }

  .hub-container {
    max-width: 1340px;
    margin: 0 auto;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
    margin-top: -6px;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 320px;
    padding: 28px 20px 22px;
    border: 1px solid rgba(17, 24, 39, 0.06);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.92);
    color: #111827;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 65px rgba(15, 23, 42, 0.12);
  }

  .category-icon {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    margin-bottom: 22px;
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.12);
    color: #C9A84C;
  }

  .category-icon svg {
    width: 32px;
    height: 32px;
  }

  .tone-green .category-icon { background: rgba(113, 135, 83, 0.14); color: #718753; }
  .tone-purple .category-icon { background: rgba(132, 109, 166, 0.14); color: #846da6; }
  .tone-blue .category-icon { background: rgba(105, 122, 150, 0.14); color: #697a96; }
  .tone-rose .category-icon { background: rgba(205, 117, 123, 0.14); color: #cd757b; }

  .category-card h2 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 900;
    text-transform: uppercase;
  }

  .category-card p {
    margin: 0;
    color: #3f3f46;
    font-size: 13px;
    line-height: 1.6;
  }

  .article-count {
    margin-top: auto;
    padding-top: 22px;
    color: #71717a;
    font-size: 13px;
    font-weight: 700;
  }

  .explore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 40px;
    margin-top: 18px;
    border-radius: 7px;
    background: #C9A84C;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
  }

  .tone-green .explore { background: #718753; }
  .tone-purple .explore { background: #846da6; }
  .tone-blue .explore { background: #697a96; }
  .tone-rose .explore { background: #cd757b; }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 56px 0 24px;
  }

  .section-title-row h2 {
    margin: 0;
    color: #0f172a;
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .section-title-row a {
    color: #a77d20;
    font-size: 13px;
    font-weight: 900;
    text-decoration: none;
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 22px;
  }

  .popular-card {
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
    color: #0f172a;
    text-decoration: none;
    box-shadow: 0 14px 38px rgba(15, 23, 42, 0.08);
  }

  .popular-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .popular-card div {
    padding: 18px;
  }

  .popular-card span {
    display: block;
    margin-bottom: 8px;
    color: #C9A84C;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .popular-card h3 {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 900;
  }

  .popular-card p {
    margin: 0;
    color: #666;
    font-size: 12px;
    line-height: 1.55;
  }

  .hub-bottom {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.2fr;
    gap: 24px;
    align-items: stretch;
    margin-top: 58px;
    padding: 28px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 55px rgba(15, 23, 42, 0.07);
  }

  .resource-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .resource-mark {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    flex: 0 0 auto;
    border-radius: 14px;
    background: rgba(201, 168, 76, 0.12);
    color: #C9A84C;
  }

  .resource-mark svg {
    width: 32px;
    height: 32px;
  }

  .resource-item h3,
  .contact-box h3 {
    margin: 0 0 8px;
    color: #111827;
    font-size: 15px;
    font-weight: 900;
  }

  .resource-item p,
  .contact-box p {
    margin: 0;
    color: #52525b;
    font-size: 13px;
    line-height: 1.6;
  }

  .contact-box {
    padding: 24px;
    border-radius: 12px;
    background: linear-gradient(135deg, #C9A84C, #b98924);
    color: #fff;
  }

  .contact-box h3,
  .contact-box p {
    color: #fff;
  }

  .contact-box a {
    display: inline-flex;
    margin-top: 18px;
    padding: 12px 18px;
    border-radius: 7px;
    background: #fff;
    color: #a77d20;
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 1180px) {
    .category-grid,
    .popular-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hub-bottom {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .hub-hero {
      min-height: auto;
      padding-top: 124px;
    }

    .category-grid,
    .popular-grid,
    .hub-bottom {
      grid-template-columns: 1fr;
    }

    .category-card {
      min-height: auto;
    }

    .section-title-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
