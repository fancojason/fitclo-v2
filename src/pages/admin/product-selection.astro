---
import '../../styles/product-selection-admin.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Fitclo Product Selection Admin</title>
  </head>
  <body>
    <main>
      <section id="login-panel" class="admin-card login-card">
        <p class="eyebrow">Fitclo Internal</p>
        <h1>Product Selection Admin</h1>
        <form id="login-form">
          <label>Password<input name="password" type="password" required autocomplete="current-password" /></label>
          <button type="submit">Sign In</button>
          <p id="login-status" class="status" aria-live="polite"></p>
        </form>
      </section>

      <div id="admin-app" class="hidden">
        <header class="admin-header">
          <div><p class="eyebrow">Fitclo Internal</p><h1>Product Selection</h1></div>
          <button id="logout" class="secondary" type="button">Sign Out</button>
        </header>

        <nav class="tabs" aria-label="Admin sections">
          <button class="active" data-tab="styles" type="button">Product Styles</button>
          <button data-tab="submissions" type="button">Submissions</button>
        </nav>

        <section id="styles-panel">
          <div class="admin-grid">
            <section class="admin-card">
              <div class="card-heading"><h2 id="style-form-title">Add Style</h2><button id="cancel-edit" class="secondary hidden" type="button">Cancel Edit</button></div>
              <form id="style-form">
                <input name="id" type="hidden" />
                <label>Style No. *<input name="styleNo" required maxlength="60" placeholder="e.g. TZ3562-8" /></label>
                <fieldset><legend>Available Sizes *</legend><div class="size-checks">
                  {['XXS', 'XS', 'S', 'M', 'L', 'XL', 'XXL'].map((size) => <label><input name="sizes" type="checkbox" value={size} checked={['S', 'M', 'L'].includes(size)} /> {size}</label>)}
                </div></fieldset>
                <label>Main Image *<input name="mainImage" type="file" accept="image/jpeg,image/png,image/webp" /><small>Required when adding. Optional when editing.</small></label>
                <label>Color Charts *<input name="colorCharts" type="file" accept="image/jpeg,image/png,image/webp" multiple /><small>1–3 images. Uploading during edit replaces all current charts.</small></label>
                <button id="save-style" type="submit">Save Style</button>
                <p id="style-status" class="status" aria-live="polite"></p>
              </form>
            </section>
            <section class="admin-card wide-card">
              <div class="card-heading"><h2>Product Styles</h2><button id="refresh-styles" class="secondary" type="button">Refresh</button></div>
              <div class="table-wrap"><table><thead><tr><th>Style</th><th>Main Image</th><th>Sizes</th><th>Charts</th><th>Status</th><th>Actions</th></tr></thead><tbody id="styles-body"></tbody></table></div>
              <p id="styles-empty" class="empty">No styles added yet.</p>
            </section>
          </div>
        </section>

        <section id="submissions-panel" class="hidden admin-card">
          <div class="card-heading"><h2>Submissions</h2><button id="refresh-submissions" class="secondary" type="button">Refresh</button></div>
          <div class="table-wrap"><table><thead><tr><th>Selection ID</th><th>Date</th><th>Customer</th><th>Company</th><th>WhatsApp</th><th>Country</th><th>Styles</th><th>Total Qty</th><th>Action</th></tr></thead><tbody id="submissions-body"></tbody></table></div>
          <p id="submissions-empty" class="empty">No submissions yet.</p>
        </section>
      </div>
    </main>

    <dialog id="submission-dialog">
      <div class="dialog-heading"><h2>Submission Detail</h2><button id="close-dialog" type="button" aria-label="Close">&times;</button></div>
      <div id="submission-detail"></div>
    </dialog>
    <script src="../../scripts/product-selection-admin.ts"></script>
  </body>
</html>
