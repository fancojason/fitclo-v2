  }

  .fitclo-process-article ul {
    margin: 16px 0 24px;
    padding-left: 1.25rem;
  }

  .fitclo-process-article ul li {
    margin: 8px 0;
    padding-left: 0.1rem;
  }

  .fitclo-answer,
  .fitclo-callout {
    margin: 24px 0;
    padding: 18px 22px;
    border: 1px solid rgba(201, 168, 76, 0.25);
    border-left: 4px solid var(--gold);
    border-radius: 10px;
    background: var(--panel);
  }

  .fitclo-answer p {
