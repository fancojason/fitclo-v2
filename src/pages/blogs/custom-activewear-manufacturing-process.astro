    text-transform: uppercase;
  }

  .fitclo-faq-list {
    margin-top: 8px;
  }

  .fitclo-faq-item {
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }

  .fitclo-faq-q {
    margin-bottom: 8px;
    color: #fff;
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.45;
  }

  .fitclo-faq-a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .fitclo-related {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .fitclo-process-wrap {
      padding: 52px 18px 72px;
    }

    .fitclo-process-article h1 {
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }

    .fitclo-flow-image {
      margin-left: 0;
      margin-right: 0;
      padding: 7px;
    }

    .fitclo-process-list li {
      padding: 17px 16px 17px 59px;
    }

    .fitclo-process-list li::before {
      left: 15px;
    }
  }
</style>
