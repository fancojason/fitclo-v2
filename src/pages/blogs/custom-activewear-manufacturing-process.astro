    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .fitclo-process-article td {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
  }

  .fitclo-cta-box {
    display: grid;
    gap: 12px;
  }

  .fitclo-cta-box span {
    display: block;
    color: rgba(255, 255, 255, 0.76);
