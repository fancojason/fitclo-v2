  }

  .fitclo-flow-image {
    margin: 28px 0;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
  }

  .fitclo-flow-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.79rem;
    line-height: 1.55;
  }

  .fitclo-flow-image figcaption {
