  }

  .fitclo-table-scroll {
    overflow-x: auto;
    margin: 20px 0;
    -webkit-overflow-scrolling: touch;
  }

  .fitclo-lux-article table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 8px;
    background: var(--lux-sec);
    font-size: 0.92rem;
  }

  .fitclo-lux-article th,
  .fitclo-lux-article td {
    border: 1px solid var(--lux-border);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .fitclo-lux-article th {
    background: rgba(201, 168, 76, 0.1);
    color: var(--lux-gold);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .fitclo-lux-article td {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
  }

  .fitclo-cta-box {
    display: grid;
    gap: 12px;
  }

  .fitclo-cta-box span {
    display: block;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .fitclo-cta {
    display: inline-block;
    justify-self: start;
    margin-top: 4px;
    padding: 13px 28px;
    border-radius: 6px;
    background: var(--lux-gold);
    color: #060608 !important;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .fitclo-faq-list {
    margin-top: 8px;
  }

  .fitclo-faq-item {
    border-bottom: 1px solid var(--lux-border);
    padding: 18px 0;
  }

  .fitclo-faq-q {
    margin-bottom: 8px;
    color: #fff;
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.45;
  }

  .fitclo-faq-a {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .fitclo-related {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .fitclo-lux-wrap {
      padding: 52px 18px 72px;
    }

    .fitclo-lux-article h1 {
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }

    .fitclo-image-grid {
      grid-template-columns: 1fr;
    }

    .fitclo-image-grid img {
      aspect-ratio: 4 / 3;
    }

    .fitclo-video-grid {
      grid-template-columns: 1fr;
    }

    .fitclo-video-grid video {
      aspect-ratio: 4 / 5;
    }
  }
</style>
