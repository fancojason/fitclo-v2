---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../content/blogs/french-terry-vs-brushed-fleece-hoodies-joggers.md';

const title = 'French Terry vs Brushed Fleece: Which Fabric Is Better for Hoodies, Joggers and Sweatshirts?';
const canonicalURL = 'https://www.fitcloo.com/blogs/french-terry-vs-brushed-fleece-hoodies-joggers/';
const image = 'https://www.fitcloo.com/images/blogs/french-terry-vs-brushed-fleece-hoodies-joggers/french-terry-loopback-original.webp';
const publishedAt = '2026-10-09';

if (frontmatter.title !== title || frontmatter.proposed_url !== canonicalURL) {
  throw new Error('The approved article metadata does not match this page.');
}

const faqs = [
  ['Is French terry the same as fleece?', 'They are closely related knit constructions, but in common sweatshirt terminology French terry keeps the reverse loops unbrushed, while brushed fleece has a napped, fuzzy reverse surface. Some suppliers use “fleece” broadly, so ask for photographs of both fabric sides and the exact specification.'],
  ['Is French terry always 100% cotton?', 'No. French terry describes a structure, not a mandatory fiber composition. It can be 100% cotton or a blend. The fiber percentages should be stated separately.'],
  ['Is brushed fleece always polyester?', 'No. Brushed sweatshirt fleece can be cotton, cotton/polyester or other fiber mixes. Do not confuse brushed sweatshirt fleece with polyester polar fleece.'],
  ['Which is better for hoodies: French terry or fleece?', 'For adaptable, lighter-feeling layers, French terry is often a good choice. For a plush winter hoodie, brushed fleece may fit the brief better. Compare samples of similar GSM and composition before making the final decision.'],
  ['Which fabric is better for joggers and sweatpants?', 'Both can work. French terry is a practical choice for everyday or transitional-season joggers, while brushed fleece is commonly used for warmer lounge and winter sweatpants. Confirm stretch and recovery, waistband construction, shrinkage and fit during sampling.'],
  ['Does higher GSM always mean better quality?', 'No. GSM measures fabric weight. Fiber quality, knitting consistency, finishing, pilling resistance, shrinkage control and garment workmanship all influence product quality.'],
];

const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalURL}#article`,
  headline: title,
  description: frontmatter.meta_description,
  image: [
    image,
    'https://www.fitcloo.com/images/blogs/french-terry-vs-brushed-fleece-hoodies-joggers/brushed-fleece-inside-original.webp',
  ],
  datePublished: publishedAt,
  dateModified: publishedAt,
  articleSection: frontmatter.category,
  keywords: [frontmatter.primary_keyword, ...frontmatter.secondary_keywords],
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  author: { '@id': 'https://www.fitcloo.com/#organization' },
  publisher: { '@id': 'https://www.fitcloo.com/#organization' },
}, {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}];
---

<BaseLayout
  title={title}
  seoTitle={frontmatter.meta_title}
  description={frontmatter.meta_description}
  canonicalURL={canonicalURL}
  image={image}
  structuredData={structuredData}
  autoArticleSchema={false}
  legacyShell={false}
  publishedDate={publishedAt}
  modifiedDate={publishedAt}
>
  <article class="fitclo-approved-article">
    <div class="fitclo-approved-article__wrap">
      <span class="fitclo-approved-article__tag">Fabric Guide / Activewear Intelligence</span>
      <div class="fitclo-approved-article__content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  body {
    background: #0a0a0f;
  }

  .fitclo-approved-article {
    min-height: 100vh;
    background: radial-gradient(circle at top left, rgba(201, 168, 76, 0.08), transparent 34rem), linear-gradient(180deg, #0a0a0f 0%, #09090d 100%);
    color: rgba(255, 255, 255, 0.82);
    font-family: "Century Gothic", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .fitclo-approved-article__wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 112px 24px 92px;
  }

  .fitclo-approved-article__tag {
    display: inline-block;
    margin-bottom: 18px;
    padding: 5px 14px;
    border: 1px solid rgba(201, 168, 76, 0.32);
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.1);
    color: #c9a84c;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .fitclo-approved-article__content h1 {
    margin: 0 0 24px;
    color: #fff;
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .fitclo-approved-article__content h2 {
    margin: 44px 0 14px;
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.48rem);
    font-weight: 900;
    line-height: 1.3;
  }

  .fitclo-approved-article__content h3 {
    margin: 28px 0 10px;
    color: #c9a84c;
    font-size: 1.08rem;
    font-weight: 850;
    line-height: 1.4;
  }

  .fitclo-approved-article__content p,
  .fitclo-approved-article__content li {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    line-height: 1.8;
  }

  .fitclo-approved-article__content p {
    margin: 0 0 1.15rem;
  }

  .fitclo-approved-article__content strong {
    color: #fff;
    font-weight: 850;
  }

  .fitclo-approved-article__content a {
    color: #c9a84c;
    font-weight: 800;
    text-decoration: none;
  }

  .fitclo-approved-article__content a:hover {
    opacity: 0.82;
  }

  .fitclo-approved-article__content ul,
  .fitclo-approved-article__content ol {
    margin: 16px 0 24px;
    padding-left: 1.25rem;
  }

  .fitclo-approved-article__content li {
    margin: 8px 0;
  }

  .fitclo-approved-article__content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 28px 0 32px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: #12121a;
  }

  .fitclo-approved-article__content hr {
    margin: 38px 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .fitclo-approved-article__content blockquote {
    margin: 22px 0;
    padding: 16px 20px;
    border-left: 4px solid #c9a84c;
    border-radius: 0 8px 8px 0;
    background: #12121a;
  }

  .fitclo-approved-article__content blockquote p:last-child {
    margin-bottom: 0;
  }

  .fitclo-approved-article__content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 20px 0 28px;
    border-radius: 8px;
    border-collapse: collapse;
    background: #12121a;
    -webkit-overflow-scrolling: touch;
  }

  .fitclo-approved-article__content table > thead,
  .fitclo-approved-article__content table > tbody {
    display: table;
    width: 620px;
    table-layout: fixed;
  }

  .fitclo-approved-article__content th,
  .fitclo-approved-article__content td {
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .fitclo-approved-article__content th {
    background: rgba(201, 168, 76, 0.1);
    color: #c9a84c;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .fitclo-approved-article__content td {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
  }

  @media (max-width: 720px) {
    .fitclo-approved-article__wrap {
      padding: 104px 18px 72px;
    }

    .fitclo-approved-article__content h1 {
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }
  }
</style>
