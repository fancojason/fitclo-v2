---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../content/blogs/from-tech-pack-to-final-sample-activewear-development-process.md';

const title = 'From Tech Pack to Final Sample: Complete Activewear Development Process';
const description = 'A practical guide to custom activewear development, from tech pack review and fabric selection to pattern making, sampling, revisions, final approval, and QC.';
const canonicalURL = 'https://www.fitcloo.com/blogs/from-tech-pack-to-final-sample-activewear-development-process/';
const image = 'https://www.fitcloo.com/images/blog/activewear-development-process/01-activewear-tech-pack-review.webp';

if (frontmatter.title !== title || frontmatter.description !== description) {
  throw new Error('The approved article metadata no longer matches the published page wrapper.');
}

const faqs = [
  {
    question: 'How long does it take to develop an activewear sample?',
    answer: "For standard custom developments, Fitclo's normal sample development time is typically 7–10 working days after the required specifications and materials are confirmed. Complex designs may require additional time.",
  },
  {
    question: 'Do I need a Tech Pack to develop custom activewear?',
    answer: 'A complete Tech Pack is the clearest starting point, but brands can also begin with design drawings, reference images, measurements, and product requirements. Missing technical details should be confirmed before sampling.',
  },
  {
    question: 'What fabrics are commonly used for custom yoga wear?',
    answer: 'Common nylon/spandex options include 75% Nylon + 25% Spandex, 78% Nylon + 22% Spandex, and 68% Nylon + 32% Spandex. The appropriate fabric depends on the desired softness, compression, stretch, recovery, GSM, opacity, and surface finish.',
  },
  {
    question: 'Why is fabric selection important before pattern approval?',
    answer: 'Different fabrics stretch and recover differently. Changing fabric after fit approval can change compression, measurements, drape, opacity, and overall fit.',
  },
  {
    question: 'What should I check when I receive the first sample?',
    answer: 'Check fit, measurements, movement, opacity, fabric hand feel, seam construction, stitching, shape, color, logo placement, labels, and other design details.',
  },
  {
    question: 'Can the sample be revised before bulk production?',
    answer: 'Yes. Pattern, measurements, construction, fabric details, and branding elements can be revised based on confirmed feedback. Bulk production should begin only after final sample approval.',
  },
  {
    question: 'Can I customize the logo, labels, and packaging?',
    answer: 'Private label and OEM/ODM projects can include logo application, labels, hangtags, and packaging based on the confirmed project requirements and selected production methods.',
  },
  {
    question: 'What is the difference between a prototype sample and a final sample?',
    answer: 'The prototype is used to test the first development version. The final sample is the approved version that represents the agreed product standard before bulk production.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalURL}#article`,
    headline: title,
    description,
    image,
    datePublished: frontmatter.publishedAt,
    dateModified: frontmatter.updatedAt,
    articleSection: frontmatter.category,
    keywords: frontmatter.focusKeywords,
    inLanguage: 'en',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
    author: { '@id': 'https://www.fitcloo.com/#organization' },
    publisher: { '@id': 'https://www.fitcloo.com/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
      { '@type': 'ListItem', position: 2, name: 'Activewear Intelligence', item: 'https://www.fitcloo.com/blogs/' },
      { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout
  title={title}
  seoTitle={title}
  description={description}
  canonicalURL={canonicalURL}
  image={image}
  structuredData={structuredData}
  autoArticleSchema={false}
  includeBreadcrumbSchema={false}
  legacyShell={false}
  publishedDate={frontmatter.publishedAt}
  modifiedDate={frontmatter.updatedAt}
>
  <article class="fitclo-approved-article">
    <div class="fitclo-approved-article__wrap">
      <span class="fitclo-approved-article__tag">Activewear Intelligence</span>
      <div class="fitclo-approved-article__content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  body {
    background: #0a0a0f;
  }

  .fitclo-approved-article {
    min-height: 100vh;
    background: radial-gradient(circle at top left, rgba(201, 168, 76, 0.08), transparent 34rem), linear-gradient(180deg, #0a0a0f 0%, #09090d 100%);
    color: rgba(255, 255, 255, 0.82);
    font-family: "Century Gothic", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .fitclo-approved-article__wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 112px 24px 92px;
  }

  .fitclo-approved-article__tag {
    display: inline-block;
    margin-bottom: 18px;
    padding: 5px 14px;
    border: 1px solid rgba(201, 168, 76, 0.32);
    border-radius: 999px;
    background: rgba(201, 168, 76, 0.1);
    color: #c9a84c;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .fitclo-approved-article__content h1 {
    margin: 0 0 24px;
    color: #fff;
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .fitclo-approved-article__content h2 {
    margin: 44px 0 14px;
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.48rem);
    font-weight: 900;
    line-height: 1.3;
  }

  .fitclo-approved-article__content h3 {
    margin: 28px 0 10px;
    color: #c9a84c;
    font-size: 1.08rem;
    font-weight: 850;
    line-height: 1.4;
  }

  .fitclo-approved-article__content p,
  .fitclo-approved-article__content li {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    line-height: 1.8;
  }

  .fitclo-approved-article__content p {
    margin: 0 0 1.15rem;
  }

  .fitclo-approved-article__content strong {
    color: #fff;
    font-weight: 850;
  }

  .fitclo-approved-article__content a {
    color: #c9a84c;
    font-weight: 800;
    text-decoration: none;
  }

  .fitclo-approved-article__content a:hover {
    opacity: 0.82;
  }

  .fitclo-approved-article__content ul,
  .fitclo-approved-article__content ol {
    margin: 16px 0 24px;
    padding-left: 1.25rem;
  }

  .fitclo-approved-article__content li {
    margin: 8px 0;
  }

  .fitclo-approved-article__content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 28px 0 32px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: #12121a;
  }

  .fitclo-approved-article__content hr {
    margin: 38px 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .fitclo-approved-article__content blockquote {
    margin: 22px 0;
    padding: 16px 20px;
    border-left: 4px solid #c9a84c;
    border-radius: 0 8px 8px 0;
    background: #12121a;
  }

  .fitclo-approved-article__content blockquote p:last-child {
    margin-bottom: 0;
  }

  .fitclo-approved-article__content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 20px 0 28px;
    border-radius: 8px;
    border-collapse: collapse;
    background: #12121a;
    -webkit-overflow-scrolling: touch;
  }

  .fitclo-approved-article__content table > thead,
  .fitclo-approved-article__content table > tbody {
    display: table;
    width: 620px;
    table-layout: fixed;
  }

  .fitclo-approved-article__content th,
  .fitclo-approved-article__content td {
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .fitclo-approved-article__content th {
    background: rgba(201, 168, 76, 0.1);
    color: #c9a84c;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 1px;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .fitclo-approved-article__content td {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
  }

  @media (max-width: 720px) {
    .fitclo-approved-article__wrap {
      padding: 104px 18px 72px;
    }

    .fitclo-approved-article__content h1 {
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }
  }
</style>
