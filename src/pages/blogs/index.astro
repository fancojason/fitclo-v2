const blogModules = import.meta.glob('./*.astro', { eager: true });
const blogSourceModules = import.meta.glob('./*.astro', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const listedLinks = new Set(guides.map((guide) => guide.link.replace(/\/$/, '')));
const generatedTitleOverrides: Record<string, string> = {
  branding: 'Activewear Branding Guide: Logo, Label and Packaging Decisions',
  'business-models': 'Activewear Business Models: Wholesale, Private Label and OEM Compared',
  construction: 'Activewear Construction Guide: Seamless vs Cut-and-Sew Methods',
  ecommerce: 'Ecommerce Strategy for Activewear Brands: Launch, Inventory and Reorders',
  fabrics: 'Activewear Fabric Guide: Nylon, Polyester, Spandex and Performance Knits',
  leggings: 'Custom Leggings Manufacturing Guide for Private Label Brands',
  logistics: 'Activewear Logistics Guide: Shipping, Duties and Delivery Planning',
  manufacturing: 'Activewear Manufacturing Guide: From Sampling to Bulk Production',
  'moisture-wicking': 'Moisture-Wicking Activewear Fabrics: How Performance Finishes Work',
  moq: 'Activewear MOQ Guide: How Many Pieces Should Your Brand Start With?',
  'oem-odm': 'OEM and ODM Activewear Manufacturing: Which Model Fits Your Brand?',
  packaging: 'Activewear Packaging Guide: Poly Bags, Hangtags and Premium Presentation',
  pricing: 'Activewear Manufacturing Cost Guide: Fabric, Labor, MOQ and Margins',
  'private-label-vs-oem': 'Private Label vs OEM Activewear: Manufacturing Model Comparison',
  'quality-control': 'Activewear Quality Control Guide: Fabric, Stitching and Final Inspection',
  shipping: 'Shipping Activewear from China: Air, Sea, DDP and Duty Planning',
  'sizing-guide': 'Activewear Sizing Guide: Fit, Grading and Measurement Control',
  'sport-bras': 'Sports Bra Manufacturing Guide: Support, Fit, Fabric and Construction',
  sustainability: 'Sustainable Activewear Manufacturing Guide: Fabrics, Claims and Certifications',
  'tech-pack': 'Activewear Tech Pack Guide: Specs, Measurements and Sample Accuracy',
  trends: 'Activewear Trend Report: Fabrics, Colors and Product Directions',
  'yoga-sets': 'Yoga Set Manufacturing Guide: Leggings, Bras, Tops and Private Label Launch',
};
const titleFromSlug = (slug: string) =>
  generatedTitleOverrides[slug] ??
  slug
    .split('-')
    .map((word) => {
      const upperWords: Record<string, string> = {
        b2b: 'B2B',
        bsci: 'BSCI',
        ddp: 'DDP',
        esg: 'ESG',
        gsm: 'GSM',
        grs: 'GRS',
        odm: 'ODM',
        oem: 'OEM',
        qc: 'QC',
        roi: 'ROI',
        uk: 'UK',
        us: 'US',
      };

      return upperWords[word] ?? word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');

const generatedGuides = Object.keys(blogModules)
  .map((path) => path.replace('./', '').replace(/\.astro$/, ''))
  .filter((slug) => slug !== 'index')
  .filter((slug) => !slug.includes('.'))
  .map((slug) => ({
    type: 'ACTIVEWEAR GUIDE',
    title: titleFromSlug(slug),
    date: 'Updated July 10, 2026',
    readTime: '7 min read',
    desc: 'A Fitclo activewear manufacturing guide covering sourcing, fabric selection, private label production, quality control and scalable brand planning.',
    link: `/blogs/${slug}`,
    linkText: 'Read Article',
  }))
  .filter((guide) => !listedLinks.has(guide.link.replace(/\/$/, '')))
  .sort((a, b) => a.title.localeCompare(b.title));

const titleFromSource = (source: string, fallback: string) => {
  const propTitle = source.match(/\btitle=(["'])(.*?)\1/s)?.[2];
  const constTitle = source.match(/const\s+title\s*=\s*(["'`])([\s\S]*?)\1\s*;/)?.[2];

  return (constTitle ?? propTitle ?? fallback)
    .replace(/\s*\|\s*Fitclo.*$/i, '')
    .replace(/\s*\|\s*FITCLO.*$/i, '')
    .trim();
};

const articleTitleByLink = Object.fromEntries(
  Object.entries(blogSourceModules)
    .map(([path, source]) => {
      const slug = path.replace('./', '').replace(/\.astro$/, '');
      return [`/blogs/${slug}`, titleFromSource(String(source), titleFromSlug(slug))];
    })
    .filter(([link]) => link !== '/blogs/index' && !link.includes('.')),
);
const intelligenceTitleByLink = Object.fromEntries(
  intelligenceArticles.map((article) => [article.link.replace(/\/$/, ''), article.title]),
);

const dedupedGuides = [...guides, ...generatedGuides].filter((guide, index, list) => {
  const normalizedLink = guide.link.replace(/\/$/, '');
  return list.findIndex((item) => item.link.replace(/\/$/, '') === normalizedLink) === index;
});

const allGuides = dedupedGuides.map((guide) => {
  const normalizedLink = guide.link.replace(/\/$/, '');
  return {
    ...guide,
    title: intelligenceTitleByLink[normalizedLink] ?? articleTitleByLink[normalizedLink] ?? guide.title,
  };
});
