---

<BaseLayout title="The Fitclo Activewear Blog | Expert Manufacturing Guides">
  <div class="bg-[#0e0e12] min-h-screen">
    <!-- Hero Section -->
    <section class="pt-48 pb-16 text-center">
      <div class="max-w-[1400px] mx-auto px-6">
        <h1 class="text-[40px] md:text-[56px] font-bold text-white mb-4 font-['Century_Gothic',sans-serif] tracking-tight">
          The Fitclo <span class="italic">Activewear Blog</span>
        </h1>
        <p class="text-[15px] md:text-[16px] text-white/60 max-w-2xl mx-auto leading-relaxed font-['Century_Gothic',sans-serif] font-light">
          Expert guides on custom activewear sourcing, premium fabric strategy,
          and unboxing experience design — written by factory specialists.
        </p>
      </div>
    </section>

    <!-- Blog Grid -->
    <section class="pb-32">
      <div class="max-w-[1000px] mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-8">
          {guides.map(guide => (
            <a href={guide.link} class="group block bg-[#131317] border border-white/5 p-6 md:p-8 rounded-2xl hover:border-[#C9A84C]/30 transition-all duration-500">
              <div class="mb-4 flex">
                <span class="inline-block px-4 py-1.5 bg-[#1a1c2e] rounded-full text-[10px] font-bold tracking-[0.2em] text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">
                  {guide.type}
                </span>
              </div>
              
              <h2 class="text-[19px] md:text-[21px] font-bold text-white mb-4 font-['Century_Gothic',sans-serif] leading-tight group-hover:text-[#C9A84C] transition-colors">
                {guide.title}
              </h2>
              
              <div class="flex items-center space-x-4 mb-5 text-[12px] text-white/50 font-['Century_Gothic',sans-serif]">
                <div class="flex items-center">
                  <div class="w-4 h-4 mr-2 relative bg-white rounded-[2px] overflow-hidden flex flex-col shadow-sm">
                    <div class="h-1.5 bg-[#ff4b4b] w-full"></div>
                    <div class="flex-grow flex items-center justify-center">
                      <div class="w-2 h-2 border-[1.5px] border-gray-300 rounded-[1px]"></div>
                    </div>
                  </div>
                  <span>{guide.date}</span>
                </div>
                <span>•</span>
                <span>{guide.readTime}</span>
              </div>
              
              <p class="text-[14px] text-white/60 font-['Century_Gothic',sans-serif] mb-6 leading-relaxed line-clamp-3">
                {guide.desc}
              </p>
              
              <span class="text-[13px] font-bold text-[#C9A84C] font-['Century_Gothic',sans-serif] tracking-widest border-b border-transparent group-hover:border-[#C9A84C] group-hover:text-white pb-0.5 transition-all">
                {guide.linkText}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
