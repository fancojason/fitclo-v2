<BaseLayout title="B2B Activewear Manufacturing Guides | Fitclo Insights">
  <div class="pt-32 pb-24 bg-[#050505] min-h-screen text-white">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      
      <!-- Page Header -->
      <div class="mb-20">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-[#C9A84C]/20 bg-[#C9A84C]/5 text-[#C9A84C] mb-8">
          <div class="w-2 h-2 rounded-full bg-[#C9A84C] animate-pulse"></div>
          <span class="text-[12px] font-bold uppercase tracking-[0.2em]">Knowledge Hub</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold mb-8 tracking-tight">
          B2B GROWTH <span class="text-[#C9A84C]">INSIGHTS.</span>
        </h1>
        <p class="text-xl text-white/50 max-w-2xl leading-relaxed">
          Technical manufacturing guides, supply chain strategies, and market trends curated for professional activewear brand directors.
        </p>
        <div class="mt-10 max-w-3xl">
          <label for="blog-search" class="sr-only">Search blog articles</label>
          <div class="relative">
            <input
              id="blog-search"
              type="search"
              autocomplete="off"
              placeholder="Search articles by topic, keyword or market..."
              class="w-full rounded-full border border-[#C9A84C]/35 bg-[#0e0e12] px-6 py-4 pr-14 text-[15px] text-white outline-none transition placeholder:text-white/35 focus:border-[#C9A84C] focus:ring-2 focus:ring-[#C9A84C]/20"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute right-5 top-1/2 h-5 w-5 -translate-y-1/2 text-[#C9A84C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
            </svg>
          </div>
          <p id="blog-search-count" class="mt-3 text-[12px] font-bold uppercase tracking-[0.18em] text-white/35">
            Showing all articles
          </p>
        </div>
      </div>

      <!-- Article Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allGuides.map((guide) => (
          <div
            class="group relative bg-[#0e0e12] border border-white/5 rounded-2xl overflow-hidden hover:border-[#C9A84C]/30 transition-all duration-500"
            data-blog-card
            data-blog-search={`${guide.type} ${guide.title} ${guide.desc} ${guide.date} ${guide.readTime}`.toLowerCase()}
          >
            <!-- Decorative Background Element -->
            <div class="absolute -right-20 -top-20 w-40 h-40 bg-[#C9A84C]/5 rounded-full blur-[80px] group-hover:bg-[#C9A84C]/10 transition-all duration-500"></div>
            
            <div class="p-7 md:p-8 relative z-10 flex h-full min-h-[360px] flex-col">
              <div class="mb-5">
                <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#C9A84C] px-3 py-1 rounded border border-[#C9A84C]/20 bg-[#C9A84C]/5">
                  {guide.type}
                </span>
              </div>

              <h2 class="text-[19px] md:text-[20px] font-bold mb-4 group-hover:text-[#C9A84C] transition-colors duration-300 leading-[1.25] tracking-normal">
                {guide.title}
              </h2>

              <div class="mb-6 flex items-center gap-2 text-white/45 text-[12px]">
                <span class="relative inline-flex h-3.5 w-3.5 overflow-hidden rounded-[2px] bg-white shadow-[0_0_0_1px_rgba(255,255,255,0.25)]" aria-hidden="true">
                  <span class="absolute inset-x-0 top-0 h-[5px] bg-[#ff6b5f]"></span>
                  <span class="absolute bottom-[3px] left-[3px] h-[2px] w-[2px] rounded-full bg-[#C9A84C]"></span>
                  <span class="absolute bottom-[3px] right-[3px] h-[2px] w-[2px] rounded-full bg-[#C9A84C]"></span>
                </span>
                <span>{guide.date}</span>
                <span class="text-white/25">•</span>
                <span>{guide.readTime}</span>
              </div>

              <p class="text-white/45 text-sm leading-relaxed mb-8">
                {guide.desc}
              </p>

              <div class="mt-auto flex items-center justify-start gap-4 pt-6 border-t border-white/5">
                <a 
                  href={guide.link} 
                  class="inline-flex items-center gap-2 text-[13px] font-black text-[#C9A84C] transition-all hover:text-white"
                >
                  Read Article
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div id="blog-empty-state" class="mt-12 hidden rounded-2xl border border-white/10 bg-[#0e0e12] px-8 py-10 text-center">
        <p class="text-lg font-bold text-white">No matching articles found.</p>
        <p class="mt-2 text-sm text-white/45">Try another keyword such as fabric, leggings, Russia, MOQ, private label or sports bra.</p>
      </div>
    </div>
  </div>

  <script>
    const blogSearchInput = document.getElementById('blog-search');
    const blogCards = Array.from(document.querySelectorAll('[data-blog-card]'));
    const blogEmptyState = document.getElementById('blog-empty-state');
    const blogSearchCount = document.getElementById('blog-search-count');

    const updateBlogSearch = () => {
      const query = String(blogSearchInput?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;

      blogCards.forEach((card) => {
        const haystack = card.getAttribute('data-blog-search') ?? '';
        const isVisible = query.length === 0 || haystack.includes(query);
        card.toggleAttribute('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });

      blogEmptyState?.classList.toggle('hidden', visibleCount !== 0);
      if (blogSearchCount) {
        blogSearchCount.textContent = query
          ? `${visibleCount} article${visibleCount === 1 ? '' : 's'} found`
          : 'Showing all articles';
      }
    };

    blogSearchInput?.addEventListener('input', updateBlogSearch);
  </script>
</BaseLayout>
