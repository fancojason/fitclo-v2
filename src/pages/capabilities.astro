---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Manufacturing Capabilities | FITCLO">
  <div class="py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-5xl font-bold mb-12 italic">Our Capabilities</h1>
    <div class="grid md:grid-cols-2 gap-16">
      <div class="bg-gray-50 p-10 rounded-3xl">
        <h2 class="text-2xl font-bold mb-6">OEM / Private Label</h2>
        <p class="text-gray-600 leading-relaxed">
          We provide full-service private label manufacturing. From your initial design sketches to the final shelf-ready product, we handle every step with precision.
        </p>
      </div>
      <div class="bg-gray-50 p-10 rounded-3xl">
        <h2 class="text-2xl font-bold mb-6">ODM / Custom Development</h2>
        <p class="text-gray-600 leading-relaxed">
          Leverage our in-house R&D team to develop unique silhouettes and proprietary fabric blends that set your brand apart in the market.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
