---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout
  title="Contact Us | FITCLO"
  description="Contact Fitclo for private label activewear manufacturing, OEM/ODM sportswear production, ready-to-ship wholesale stock, sampling, MOQ planning and global shipping support."
>
  <!-- Hero Section -->
  <section class="relative h-[45vh] bg-black flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
        alt="Contact Us" 
        class="w-full h-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-4 uppercase font-['Century_Gothic',sans-serif]">
        CONTACT US
      </h3>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        Get in <span class="text-[#C9A84C] italic">Touch</span>
      </h1>
      <p class="text-lg md:text-xl text-white/50 font-['Century_Gothic',sans-serif] max-w-2xl mx-auto leading-relaxed">
        Global Head Office & Manufacturing Center. Our consultants are ready to assist your brand's growth.
      </p>
    </div>
  </section>

  <div class="py-24 bg-white">
    <InquiryForm />
  </div>
</BaseLayout>
