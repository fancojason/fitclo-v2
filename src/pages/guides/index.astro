---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    type: "PRICE GUIDE",
    title: "How Much Do Custom Activewear Cost in China?",
    date: "June 15, 2026",
    readTime: "10 min read",
    desc: "Real factory-direct price ranges for yoga sets, leggings, and sport bras. Includes fabric costs, finishing costs and MOQ price tiers.",
    link: "/guides/pricing",
    linkText: "Read Article →"
  },
  {
    type: "MOQ GUIDE",
    title: "Custom Activewear MOQ Guide: 100 vs 500 vs 1000 pcs",
    date: "June 16, 2026",
    readTime: "9 min read",
    desc: "Understand when 100 pcs is enough, why 500 pcs is often the best first commercial order, and how 1000 pcs improves unit pricing.",
    link: "/guides/moq",
    linkText: "Read Article →"
  },
  {
    type: "ACTIVEWEAR COMPARISON",
    title: "Private Label vs OEM Manufacturing: Which is Right for You?",
    date: "June 14, 2026",
    readTime: "8 min read",
    desc: "Compare structure, cost, customization depth and lead times to choose the right manufacturing model for your brand.",
    link: "/guides/private-label-vs-oem",
    linkText: "Read Article →"
  },
  {
    type: "FABRIC GUIDE",
    title: "Why Nulu-Feel Fabric is the Standard for Premium Yoga Wear",
    date: "June 12, 2026",
    readTime: "7 min read",
    desc: "Explain how premium fabrics from Fitclo solve the comfort and durability requirements for high-end yoga brands.",
    link: "/guides/yoga-sets",
    linkText: "Read Article →"
  }
];
---

<BaseLayout title="The Fitclo Activewear Blog | Expert Manufacturing Guides">
  <div class="bg-[#0e0e12] min-h-screen">
    <!-- Hero Section -->
    <section class="pt-56 pb-28 text-center">
      <div class="max-w-[1400px] mx-auto px-6">
        <h1 class="text-[55px] md:text-[85px] font-bold text-white mb-12 font-['Century_Gothic',sans-serif] tracking-tight">
          The Fitclo <span class="italic">Activewear Blog</span>
        </h1>
        <p class="text-[18px] text-white/50 max-w-2xl mx-auto leading-relaxed font-['Century_Gothic',sans-serif]">
          Expert guides on custom activewear sourcing, premium fabric strategy,
          and manufacturing excellence — written by factory specialists.
        </p>
      </div>
    </section>

    <!-- Blog Grid -->
    <section class="pb-40">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
          {guides.map(guide => (
            <a href={guide.link} class="group block bg-[#131317] border border-white/5 p-12 rounded-[32px] hover:border-[#C9A84C]/30 transition-all duration-500">
              <div class="mb-10 flex items-center space-x-4">
                <span class="text-[11px] font-bold tracking-[0.3em] text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">
                  {guide.type}
                </span>
                <div class="flex-grow h-[1px] bg-white/5 group-hover:bg-[#C9A84C]/20 transition-colors"></div>
              </div>
              
              <h2 class="text-[30px] font-bold text-white mb-8 font-['Century_Gothic',sans-serif] leading-tight group-hover:text-[#C9A84C] transition-colors">
                {guide.title}
              </h2>
              
              <div class="flex items-center space-x-6 mb-10 text-[14px] text-white/30 font-['Century_Gothic',sans-serif]">
                <div class="flex items-center">
                  <span class="mr-3 text-lg">📅</span>
                  <span>{guide.date}</span>
                </div>
                <div class="w-1.5 h-1.5 rounded-full bg-white/10"></div>
                <span>{guide.readTime}</span>
              </div>
              
              <p class="text-[16px] text-white/50 font-['Century_Gothic',sans-serif] mb-12 leading-relaxed">
                {guide.desc}
              </p>
              
              <span class="text-[15px] font-bold text-[#C9A84C] font-['Century_Gothic',sans-serif] tracking-widest border-b border-[#C9A84C]/30 group-hover:border-[#C9A84C] group-hover:text-white pb-1.5 transition-all">
                {guide.linkText}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
