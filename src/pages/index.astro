
---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LiveProduction from '../components/LiveProduction.astro';
import Stats from '../components/Stats.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WholesaleSolutions from '../components/WholesaleSolutions.astro';
import AccessoriesBanner from '../components/AccessoriesBanner.astro';
import CustomizationFlow from '../components/CustomizationFlow.astro';
import BrandingOptions from '../components/BrandingOptions.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout title="Professional Activewear Manufacturer | FITCLO">
  <Hero />
  <LiveProduction />
  <Stats />
  
  <section class="py-24 bg-black text-white overflow-hidden border-t border-white/5">
    <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-32">
        <!-- Left Image -->
        <div class="w-full lg:w-[48%] relative group lg:-translate-x-12">
          <div class="relative rounded-xl overflow-hidden shadow-2xl bg-white">
            <img 
              src="https://sc01.alicdn.com/kf/H46ed3fe349ab48c2afc8e8066a7bc4517.png" 
              alt="Innovative Fabric Research & Development" 
              class="w-full aspect-[5/3] h-auto object-contain transition-transform duration-1000 group-hover:scale-105"
            />
            <!-- FITCLO Overlay in the top-left blank grid cell -->
            <div class="absolute top-0 left-0 w-1/2 h-1/3 flex flex-col items-center justify-center p-4 z-20">
              <span class="font-['Montserrat',sans-serif] font-black text-[20px] md:text-[24px] lg:text-[28px] text-black tracking-widest uppercase">FC | FITCLO</span>
              <span class="font-['Century_Gothic',sans-serif] font-bold text-[9px] md:text-[11px] text-gray-500 tracking-[0.2em] uppercase mt-1">Innovative Lab</span>
            </div>
          </div>
          <!-- Decorative Glow -->
          <div class="absolute -top-16 -left-16 w-64 h-64 bg-[#C9A84C]/10 blur-[100px] rounded-full pointer-events-none opacity-50"></div>
        </div>

        <!-- Right Content -->
        <div class="w-full lg:w-[44%] text-center lg:text-left lg:translate-x-6">
          <h3 class="text-[#C9A84C] font-bold tracking-[0.3em] text-[12px] md:text-[13px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
            R&D Innovation
          </h3>
          <h2 class="text-[26px] md:text-[32px] lg:text-[36px] font-bold text-white mb-8 leading-tight font-['Montserrat',sans-serif] tracking-tight whitespace-nowrap">
            Innovative Fabric <span class="text-[#C9A84C] italic">R&D</span>
          </h2>
          <p class="text-gray-400 text-[17px] mb-12 max-w-xl leading-relaxed font-['Century_Gothic',sans-serif]">
            We don't just sew apparel; we engineer textiles. Our in-house lab develops proprietary knits that offer superior breathability, 4-way stretch, and durability that lasts.
          </p>
          <ul class="space-y-4 mb-10 font-['Century_Gothic',sans-serif]">
            {[
              'Anti-Microbial Treatment',
              'Quick-Dry Technology',
              'Sustainable/Recycled Fibers',
              'Custom Color Matching (Pantone)'
            ].map(item => (
              <li class="flex items-center space-x-3">
                <div class="w-1.5 h-1.5 bg-[#C9A84C] rounded-full"></div>
                <span class="font-bold text-gray-300">{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-block border border-[#C9A84C] text-[#C9A84C] font-extrabold py-3.5 px-8 rounded-md transition-all hover:bg-[#C9A84C] hover:text-black hover:scale-[1.02] active:scale-95 text-[14px] uppercase tracking-wider font-['Century_Gothic',sans-serif]">
            Explore Capabilities
          </a>
        </div>
      </div>
    </div>
  </section>

  <ProductGrid />
  <WholesaleSolutions />
  <AccessoriesBanner />
  <CustomizationFlow />
  <BrandingOptions />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-black mb-16 font-['Montserrat',sans-serif] uppercase tracking-tighter">Global <span class="text-[#C9A84C] italic">Manufacturing</span> Excellence</h2>
      <div class="rounded-3xl overflow-hidden shadow-2xl relative">
        <img 
          src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
          alt="Our Factory" 
          class="w-full h-[500px] object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-12">
          <div class="text-left text-white max-w-2xl">
            <h3 class="text-3xl font-black mb-4 italic font-['Montserrat',sans-serif] uppercase">State-of-the-art Production</h3>
            <p class="text-gray-300 font-['Century_Gothic',sans-serif] text-lg">
              Operating out of our 16,000m² facility in Dongguan, we combine traditional craftsmanship with advanced automation to deliver consistent quality at scale.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-black text-white">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <h2 class="text-4xl font-bold mb-4 uppercase tracking-tighter">Factory Tour</h2>
          <p class="text-gray-400 max-w-lg text-lg">
            Witness our commitment to manufacturing excellence. Modern facilities and rigorous quality control at every stage.
          </p>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Sewing Department</p>
        </div>
        
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Precision Cutting</p>
        </div>

        <div class="space-y-6 lg:row-span-2">
          <div class="rounded-2xl overflow-hidden h-full bg-gray-900 shadow-xl min-h-[400px]">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/warehouse.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Global Logistics Center</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Quality Inspection</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Fabric Preparation</p>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
