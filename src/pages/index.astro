---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LiveProduction from '../components/LiveProduction.astro';
import Stats from '../components/Stats.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WholesaleSolutions from '../components/WholesaleSolutions.astro';
import SampleCTA from '../components/SampleCTA.astro';
import BrandingOptions from '../components/BrandingOptions.astro';
import FactoryAdvantage from '../components/FactoryAdvantage.astro';
import WhyFitclo from '../components/WhyFitclo.astro';
import Certifications from '../components/Certifications.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CommonQuestions from '../components/CommonQuestions.astro';
import WholesaleFAQ from '../components/WholesaleFAQ.astro';
import Testimonials from '../components/Testimonials.astro';
import Intelligence from '../components/Intelligence.astro';
import BlogIntelligence from '../components/BlogIntelligence.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import TrustStats from '../components/TrustStats.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout title="Professional Activewear Manufacturer | FITCLO">
  <Hero />
  <LiveProduction />
  <Stats />
  
  <ProductGrid />
  <WholesaleSolutions />
  <SampleCTA />
  <BrandingOptions />
  <FactoryAdvantage />
  <WhyFitclo />
  <Certifications />

  <section id="factory-tour" class="py-24 bg-black text-white">
    <!-- Factory Tour Content -->
    <div class="max-w-[1700px] mx-auto px-6 lg:px-16">
      <div class="flex flex-col mb-10">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.1em] text-[11px] md:text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          FACTORY TOUR
        </h3>
        <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-white leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
          Factory Tour
        </h2>
        <p class="text-white/60 mt-4 max-w-xl text-[15px] md:text-[16px] leading-relaxed font-['Century_Gothic',sans-serif]">
          Witness our commitment to manufacturing excellence. Modern facilities and rigorous quality control at every stage.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-[11px] font-bold tracking-widest text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">Sewing Department</p>
        </div>
        
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-[11px] font-bold tracking-widest text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">Precision Cutting</p>
        </div>

        <div class="space-y-6 lg:row-span-2">
          <div class="rounded-2xl overflow-hidden h-full bg-gray-900 shadow-xl min-h-[400px]">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/warehouse.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-[11px] font-bold tracking-widest text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">Global Logistics Center</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-[11px] font-bold tracking-widest text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">Quality Inspection</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-[11px] font-bold tracking-widest text-[#C9A84C] uppercase font-['Century_Gothic',sans-serif]">Fabric Preparation</p>
        </div>
      </div>
    </div>
  </section>

  <HowItWorks />
  <Testimonials />
  <TrustStats />
  <GlobalPresence />
  <Intelligence />
  <BlogIntelligence />
  <CommonQuestions />
  
  <InquiryForm />
</BaseLayout>
