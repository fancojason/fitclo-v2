---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LiveProduction from '../components/LiveProduction.astro';
import Stats from '../components/Stats.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WholesaleSolutions from '../components/WholesaleSolutions.astro';
import SampleCTA from '../components/SampleCTA.astro';
import BrandingOptions from '../components/BrandingOptions.astro';
import FactoryAdvantage from '../components/FactoryAdvantage.astro';
import WhyFitclo from '../components/WhyFitclo.astro';
import Certifications from '../components/Certifications.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout title="Professional Activewear Manufacturer | FITCLO">
  <Hero />
  <LiveProduction />
  <Stats />
  
  <ProductGrid />
  <WholesaleSolutions />
  <SampleCTA />
  <BrandingOptions />
  <FactoryAdvantage />
  <WhyFitclo />
  <Certifications />

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-black mb-16 font-['Montserrat',sans-serif] uppercase tracking-tighter">Global <span class="text-[#C9A84C] italic">Manufacturing</span> Excellence</h2>
      <div class="rounded-3xl overflow-hidden shadow-2xl relative">
        <img 
          src="https://sc02.alicdn.com/kf/A04428d73312944d383b8fa9d917bc4b60.png" 
          alt="Our Factory" 
          class="w-full h-[500px] object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-12">
          <div class="text-left text-white max-w-2xl">
            <h3 class="text-3xl font-black mb-4 italic font-['Montserrat',sans-serif] uppercase">State-of-the-art Production</h3>
            <p class="text-gray-300 font-['Century_Gothic',sans-serif] text-lg">
              Operating out of our 16,000m² facility in Dongguan, we combine traditional craftsmanship with advanced automation to deliver consistent quality at scale.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-black text-white">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <h2 class="text-4xl font-bold mb-4 uppercase tracking-tighter">Factory Tour</h2>
          <p class="text-gray-400 max-w-lg text-lg">
            Witness our commitment to manufacturing excellence. Modern facilities and rigorous quality control at every stage.
          </p>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Sewing Department</p>
        </div>
        
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-1.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Precision Cutting</p>
        </div>

        <div class="space-y-6 lg:row-span-2">
          <div class="rounded-2xl overflow-hidden h-full bg-gray-900 shadow-xl min-h-[400px]">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/warehouse.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Global Logistics Center</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/sewing-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Quality Inspection</p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden aspect-video bg-gray-900 shadow-xl">
            <video autoplay muted loop playsinline class="w-full h-full object-cover">
              <source src="/videos/cutting-2.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-sm font-bold tracking-widest text-accent uppercase">Fabric Preparation</p>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
