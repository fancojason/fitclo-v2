---
import BaseLayout from '../layouts/BaseLayout.astro';

const inputClass = "mt-2 w-full border border-white/15 bg-[#171717] px-5 py-[14px] text-[14px] text-white outline-none placeholder:text-white/40 transition focus:border-white/45 font-['TeX_Gyre_Adventor',sans-serif]";
const labelClass = "block text-[12px] font-bold text-white/75 font-['TeX_Gyre_Adventor',sans-serif]";
const contactPageSchema = {
  '@context': 'https://schema.org', '@type': 'ContactPage', '@id': 'https://www.fitcloo.com/inquiry/#webpage',
  url: 'https://www.fitcloo.com/inquiry/', name: 'Activewear Wholesale Inquiry and Quote Request',
  description: 'Submit an activewear sourcing inquiry to Fitclo for ready-stock wholesale, private label branding or OEM and ODM product development.',
  about: { '@id': 'https://www.fitcloo.com/#organization' },
};
---

<BaseLayout title="Get in Touch | Activewear Wholesale Inquiry | Fitclo" description="Contact Fitclo about ready-stock activewear, private label branding, or OEM and ODM product development." canonicalURL="https://www.fitcloo.com/inquiry/" structuredData={[contactPageSchema]}>
  <main class="inquiry-page min-h-screen bg-[#080808] text-white">
    <section class="border-b border-white/10">
      <div class="mx-auto grid max-w-[1400px] gap-10 px-6 py-20 lg:grid-cols-[1.1fr_.9fr] lg:gap-20 lg:px-10 lg:py-24">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#d6b55a] font-['TeX_Gyre_Adventor',sans-serif]">Contact Fitclo</p>
          <h1 class="mt-5 max-w-[920px] text-4xl font-bold leading-[0.98] tracking-[-0.025em] sm:text-5xl lg:text-[60px] font-['TeX_Gyre_Adventor',sans-serif]"><span class="block">Let’s plan your next</span><span class="block">activewear collection.</span></h1>
        </div>
        <div class="self-end border-l border-white/15 pl-6 lg:pb-1 lg:pl-8">
          <p class="text-[15px] leading-7 text-white/62 font-['TeX_Gyre_Adventor',sans-serif]">Tell us whether you need ready-stock styles or a private-label collection. Share the product direction, quantity and timing, and our team will route your request to the right sourcing path.</p>
          <div class="mt-7 flex flex-wrap gap-x-7 gap-y-3 text-[12px] font-bold uppercase tracking-[0.08em] text-white/48 font-['TeX_Gyre_Adventor',sans-serif]"><span>Ready stock</span><span>Private label</span><span>OEM / ODM</span></div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10 lg:py-24">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="text-3xl font-bold leading-none tracking-[-0.025em] sm:text-[36px] font-['TeX_Gyre_Adventor',sans-serif]">Get in touch</h2>
          <p class="mt-4 max-w-[610px] text-[15px] leading-[1.5] text-white/65 sm:text-[16px] font-['TeX_Gyre_Adventor',sans-serif]">The fastest way to reach us is WhatsApp. We typically reply within a few hours during business days.</p>

          <div class="mt-8 space-y-6">
            <a href="https://api.whatsapp.com/send?phone=8617160837538&amp;text=Hello%20Fitclo%2C%20I%20would%20like%20to%20discuss%20an%20activewear%20project." target="_blank" rel="noopener noreferrer" class="group flex min-h-[104px] items-center border border-[#0e7040] bg-[#0a2615] px-6 transition hover:border-[#22c765] hover:bg-[#0b2e19] sm:px-7">
              <span class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full bg-[#25d366] text-white"><svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.4 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.4ZM12.2 21.7a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.8-9.8 2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.5-4.4 9.9-9.7 9.9Zm5.4-7.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.6l-.9-2.2c-.2-.6-.5-.5-.7-.5H8c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.2 0-.4-.1-.7-.2h-1.3Z"></path></svg></span><span class="ml-6"><span class="block text-[16px] font-bold font-['TeX_Gyre_Adventor',sans-serif]">Chat on WhatsApp</span><span class="mt-1 block text-[13px] text-white/65 font-['TeX_Gyre_Adventor',sans-serif]">+86 171 6083 7538 · Fastest response</span></span><span class="ml-auto text-3xl font-light text-white/50 transition-transform group-hover:translate-x-1">›</span>
            </a>
            <a href="mailto:jason@dgfanco.com?subject=Activewear%20Sourcing%20Inquiry" class="group flex min-h-[104px] items-center border border-white/15 bg-[#121212] px-6 transition hover:border-white/35 sm:px-7"><span class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border border-[#731b1f] bg-[#370b0e] text-[#ff595f]"><svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span><span class="ml-6"><span class="block text-[16px] font-bold font-['TeX_Gyre_Adventor',sans-serif]">Send an email</span><span class="mt-1 block text-[13px] text-white/65 font-['TeX_Gyre_Adventor',sans-serif]">jason@dgfanco.com</span></span><span class="ml-auto text-3xl font-light text-white/50 transition-transform group-hover:translate-x-1">›</span></a>
            <div class="flex min-h-[104px] items-center border border-white/15 bg-[#121212] px-6 sm:px-7"><span class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border border-white/15 bg-[#202020] text-white/55"><svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><span class="ml-6"><span class="block text-[16px] font-bold font-['TeX_Gyre_Adventor',sans-serif]">Global sourcing support</span><span class="mt-1 block text-[13px] text-white/65 font-['TeX_Gyre_Adventor',sans-serif]">Guangzhou, China · serving buyers worldwide</span></span></div>
          </div>

          <div class="mt-8 border-t border-white/15 pt-6"><p class="text-[11px] font-bold uppercase tracking-[0.12em] text-white/60 font-['TeX_Gyre_Adventor',sans-serif]">What happens next</p><ol class="mt-4 space-y-2 text-[12px] leading-5 text-white/52 font-['TeX_Gyre_Adventor',sans-serif]"><li><span class="mr-3 text-white">01</span>We review your product brief and sourcing route.</li><li><span class="mr-3 text-white">02</span>We confirm the suitable ready-stock or custom option.</li><li><span class="mr-3 text-white">03</span>You receive the next practical step: availability, sample or quote.</li></ol></div>
        </div>

        <div class="pt-1">
          <h2 class="text-3xl font-bold leading-none tracking-[-0.025em] sm:text-[36px] font-['TeX_Gyre_Adventor',sans-serif]">Send a message</h2>
          <p class="mt-4 text-[15px] leading-[1.5] text-white/65 sm:text-[16px] font-['TeX_Gyre_Adventor',sans-serif]">We’ll get back to you within 24 hours.</p>
          <form id="inquiry-form" class="mt-8 font-['TeX_Gyre_Adventor',sans-serif]">
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute left-[-9999px]" aria-hidden="true" /><input type="hidden" name="page_url" value="https://www.fitcloo.com/inquiry/" />
            <div class="grid gap-5 sm:grid-cols-2"><div><label for="name" class={labelClass}>Your Name *</label><input id="name" name="name" type="text" required autocomplete="name" placeholder="John Doe" class={inputClass} /></div><div><label for="company" class={labelClass}>Brand / Company *</label><input id="company" name="company" type="text" required autocomplete="organization" placeholder="Acme Studios" class={inputClass} /></div></div>
            <div class="mt-5"><label for="email" class={labelClass}>Email Address *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="john@example.com" class={inputClass} /></div>
            <fieldset class="mt-5"><legend class={labelClass}>I’m looking for *</legend><div class="mt-2 grid grid-cols-2 border border-white/15 bg-[#171717] p-1"><label class="cursor-pointer"><input type="radio" name="inquiry_type" value="Ready-stock wholesale" class="peer sr-only" required checked /><span class="block px-3 py-2.5 text-center text-[12px] font-bold text-white/45 transition peer-checked:bg-white peer-checked:text-black">Ready to ship (RTS)</span></label><label class="cursor-pointer"><input type="radio" name="inquiry_type" value="Custom / private label / OEM" class="peer sr-only" required /><span class="block px-3 py-2.5 text-center text-[12px] font-bold text-white/45 transition peer-checked:bg-white peer-checked:text-black">Custom activewear</span></label></div></fieldset>
            <div class="mt-5"><label for="message" class={labelClass}>Tell us what you need *</label><textarea id="message" name="message" rows="4" required placeholder="E.g. 200 ready-stock yoga sets with private labels, or a custom sports bra and leggings range. Tell us your target quantity, sizes, colours, logo needs and timeline…" class={inputClass + ' resize-y'}></textarea></div>
            <div class="hidden"><input name="country" value="Not specified" /><input name="product_type" value="See message" /><input name="quantity" value="Not specified" /></div>
            <button type="submit" class="mt-6 min-h-[64px] w-full bg-[#f2090e] px-8 text-[13px] font-black uppercase tracking-[0.14em] text-white transition hover:bg-[#ff2a2e] disabled:cursor-wait disabled:opacity-70"><span data-submit-label>Send message</span></button>
            <p id="form-status" class="mt-5 min-h-5 text-center text-[12px] leading-5 text-white/42 font-['TeX_Gyre_Adventor',sans-serif]" aria-live="polite">Or message us directly on <a href="https://api.whatsapp.com/send?phone=8617160837538" target="_blank" rel="noopener noreferrer" class="text-[#25d366]">WhatsApp</a> for the fastest reply.</p>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const submitLabel = submitButton?.querySelector('[data-submit-label]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submitButton || !submitLabel) return;
    submitButton.disabled = true; submitLabel.textContent = 'Sending…'; status.textContent = 'Securely sending your request…'; status.className = 'mt-6 min-h-5 text-center text-[13px] leading-5 text-white/55 font-[TeX_Gyre_Adventor,sans-serif]';
    try {
      const response = await fetch('/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form).entries())) });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.error || 'Unable to send your inquiry.');
      form.reset(); status.textContent = 'Thank you — your message has been sent. We will reply within 24 business hours.'; status.className = 'mt-6 min-h-5 text-center text-[13px] leading-5 text-[#25d366] font-[TeX_Gyre_Adventor,sans-serif]'; submitLabel.textContent = 'Message sent';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Unable to send your inquiry. Please use WhatsApp or email.'; status.className = 'mt-6 min-h-5 text-center text-[13px] leading-5 text-red-400 font-[TeX_Gyre_Adventor,sans-serif]'; submitButton.disabled = false; submitLabel.textContent = 'Send message';
    }
  });
</script>

<style>
  :global(body:has(.inquiry-page) .floating-controls) { display: none; }
</style>
