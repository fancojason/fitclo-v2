---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getAlternateLinks } from '../i18n/routes';

const privateLabelSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Private Label Activewear Manufacturing',
  serviceType: 'Private Label Activewear Manufacturing',
  provider: {
    '@id': 'https://www.fitcloo.com/#organization',
  },
  areaServed: ['United States', 'United Kingdom', 'Australia', 'Canada', 'European Union'],
  description:
    'Fitclo provides private label activewear manufacturing with logo customization, labels, hang tags, packaging, sampling, OEM/ODM development and bulk production.',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Fitness apparel brands, yoga wear brands, gym wear retailers and activewear startups',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Private Label Activewear Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Logo Customization',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Custom Labels and Packaging',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'OEM/ODM Activewear Development',
        },
      },
    ],
  },
};
---

<BaseLayout
  title="Private Label Activewear Manufacturer | Custom Sportswear Solutions"
  description="Compare ready-stock plus logo, private-label finishing and custom OEM activewear. Review real styles, 50-piece or 50-set stock MOQ, samples, labels, packaging and quotation inputs."
  structuredData={[privateLabelSchema]}
  alternateLinks={getAlternateLinks('/private-label/', '/es/private-label-activewear/')}
>
  <!-- Hero Section -->
  <section class="relative min-h-[45vh] py-20 bg-black flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/migrated/third-party/hcc2d5570d1a94d4ea98d26ce3312893dj-2b46b82f20.webp"
        alt="Private Label Manufacturing"
        width="1400" height="852" fetchpriority="high" class="w-full h-full object-cover opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
        Your Brand,<br /><span class="text-[#C9A84C] italic">Our Expertise</span>
      </h1>
      <p class="text-lg md:text-xl text-white/70 max-w-2xl mx-auto font-['Century_Gothic',sans-serif] leading-relaxed">
        Choose existing activewear with your branding, or develop a new product through OEM/ODM. Qualifying ready-stock styles start at 50 pcs or 50 sets; custom development has a separately confirmed MOQ.
      </p>
    </div>
  </section>

  <!-- Service Overview (AI/SEO Context) -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-20 items-center">
        <div>
          <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
            OEM/ODM SOLUTIONS
          </h3>
          <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight mb-8">
            What is <span class="text-[#C9A84C] italic">Private Label?</span>
          </h2>
          <div class="space-y-6 text-[15px] md:text-[16px] text-gray-600 font-['Century_Gothic',sans-serif] leading-relaxed">
            <p>
              Private labeling allows you to sell high-quality activewear manufactured by Fitclo under your own brand name. We provide the infrastructure, technology, and craftsmanship, while you focus on marketing and growth.
            </p>
            <p>
              Whether you need <strong class="text-black">custom logo application</strong>, specialized <strong class="text-black">hang tags</strong>, or fully bespoke <a href="/oem-activewear-manufacturer/" class="text-black underline underline-offset-4"><strong>OEM designs</strong></a>, our team ensures your brand identity is reflected in every stitch.
            </p>
            <div class="pt-4">
              <a href="/products" class="text-[#C9A84C] font-bold hover:underline font-['Century_Gothic',sans-serif] text-[14px] md:text-[15px] uppercase tracking-widest">View our product catalog for inspiration →</a>
            </div>
          </div>

          <div class="mt-12 grid grid-cols-2 gap-8">
            <div class="border-l-4 border-[#C9A84C] pl-6 group">
              <span class="block text-3xl font-bold font-['Century_Gothic',sans-serif] group-hover:text-[#C9A84C] transition-colors">50</span>
              <span class="text-gray-500 uppercase text-[11px] font-bold tracking-widest font-['Century_Gothic',sans-serif]">Pcs / sets from qualifying stock styles</span>
            </div>
            <div class="border-l-4 border-[#C9A84C] pl-6 group">
              <span class="block text-3xl font-bold font-['Century_Gothic',sans-serif] group-hover:text-[#C9A84C] transition-colors">By brief</span>
              <span class="text-gray-500 uppercase text-[11px] font-bold tracking-widest font-['Century_Gothic',sans-serif]">Custom MOQ and sample timing</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <img
            src="/images/migrated/third-party/hcc2d5570d1a94d4ea98d26ce3312893dj-2b46b82f20.webp"
            alt="Custom Labeling Process"
            width="1400" height="852" loading="lazy" decoding="async" class="rounded-[40px] shadow-2xl relative z-10"
          />
          <div class="absolute -top-10 right-0 xl:-right-10 w-40 h-40 bg-[#C9A84C]/10 rounded-full blur-3xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Process (Step-by-Step for AI/SEO) -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          THE WORKFLOW
        </h3>
        <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
          Our <span class="text-[#C9A84C] italic">Manufacturing Process</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-5 gap-4">
        {[
          { step: '01', title: 'Consult', desc: 'Discussing your design concepts and fabric requirements.' },
          { step: '02', title: 'Design', href: '/activewear-tech-pack-pattern-development/', desc: 'Creating tech packs and CAD drawings for your approval.' },
          { step: '03', title: 'Sample', href: '/activewear-sampling-product-development/', desc: 'Producing a physical prototype for fit and quality testing.' },
          { step: '04', title: 'Bulk', href: '/activewear-quality-control-inspection/', desc: 'Mass production with 100% rigorous quality control.' },
          { step: '05', title: 'Ship', desc: 'Global logistics and secure door-to-door delivery.' }
        ].map((item) => (
          <div class="bg-white p-8 rounded-3xl hover:bg-[#C9A84C] group transition-all duration-300 shadow-sm hover:shadow-xl">
            <span class="block text-4xl font-bold text-[#C9A84C] group-hover:text-black mb-4 font-['Century_Gothic',sans-serif]">{item.step}</span>
            <h3 class="text-[18px] font-bold mb-2 uppercase group-hover:text-black font-['Century_Gothic',sans-serif] tracking-tight">{item.href ? <a href={item.href} class="underline underline-offset-4">{item.title}</a> : item.title}</h3>
            <p class="text-gray-500 group-hover:text-black/80 text-[13px] font-['Century_Gothic',sans-serif] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Customization Options -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h3 class="text-[#C9A84C] font-bold tracking-[0.2em] text-[12px] mb-3 uppercase font-['Century_Gothic',sans-serif]">
          BRANDING OPTIONS
        </h3>
        <h2 class="text-[30px] md:text-[38px] lg:text-[44px] font-bold text-black leading-tight font-['Century_Gothic',sans-serif] tracking-tight">
          Branding <span class="text-[#C9A84C] italic">Customization</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center group">
          <div class="w-20 h-20 bg-[#C9A84C]/10 rounded-full flex items-center justify-center mx-auto mb-6 text-[#C9A84C] group-hover:bg-[#C9A84C] group-hover:text-black transition-all">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
          </div>
          <h3 class="text-[20px] font-bold mb-4 font-['Century_Gothic',sans-serif] uppercase tracking-tight"><a href="/custom-activewear-labels-packaging/" class="underline underline-offset-4">Custom Labels & Tags</a></h3>
          <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[15px] leading-relaxed">Woven labels, heat-transfer neck labels, and premium hang tags to elevate your brand presence.</p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-[#C9A84C]/10 rounded-full flex items-center justify-center mx-auto mb-6 text-[#C9A84C] group-hover:bg-[#C9A84C] group-hover:text-black transition-all">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          </div>
          <h3 class="text-[20px] font-bold mb-4 font-['Century_Gothic',sans-serif] uppercase tracking-tight">Branded Packaging</h3>
          <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[15px] leading-relaxed">Eco-friendly poly bags, custom boxes, and sustainable shipping materials with your logo.</p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-[#C9A84C]/10 rounded-full flex items-center justify-center mx-auto mb-6 text-[#C9A84C] group-hover:bg-[#C9A84C] group-hover:text-black transition-all">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-[20px] font-bold mb-4 font-['Century_Gothic',sans-serif] uppercase tracking-tight">Custom Prints & Colors</h3>
          <p class="text-gray-500 font-['Century_Gothic',sans-serif] text-[15px] leading-relaxed">Sublimation printing, screen printing, embroidery, and custom Pantone color matching.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#111218] py-20 text-white font-['Century_Gothic',sans-serif]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-[.2em] text-[#C9A84C]">CHOOSE THE RIGHT SOURCING ROUTE</p>
      <h2 class="mt-4 max-w-3xl text-3xl font-bold leading-tight md:text-5xl">Your brand can start with an existing style or a new product brief.</h2>
      <p class="mt-5 max-w-3xl leading-7 text-white/70">Private label describes how the garment is presented under your brand. The actual work depends on what you want changed. Confirm the selected SKU, customization method and approved sample before comparing quotes.</p>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-white/70">Sourcing for an Australian brand? See the <a class="font-bold text-[#C9A84C] underline" href="/wholesale-to/australia/">Australia activewear wholesale and private-label guide</a> for a country-specific brief and import handoff checklist.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="border border-white/15 p-6"><h3 class="text-xl font-bold">Ready-stock wholesale</h3><p class="mt-4 text-sm leading-6 text-white/70">Choose an existing style, confirm live colors and sizes, and order the garment as supplied. Qualifying sets start at 50 sets; individual garments at 50 pcs.</p><a class="mt-5 inline-block text-sm font-bold text-[#C9A84C]" href="/ready-to-ship/">Browse current programme →</a></article>
        <article class="border border-white/15 p-6"><h3 class="text-xl font-bold">Existing style + your brand</h3><p class="mt-4 text-sm leading-6 text-white/70">Discuss logo placement, brand and care labels, hang tags and packaging for the chosen SKU. Branding feasibility, cost and timing are confirmed for that style.</p><a class="mt-5 inline-block text-sm font-bold text-[#C9A84C]" href="/custom-activewear-labels-packaging/">Compare branding options →</a></article>
        <article class="border border-white/15 p-6"><h3 class="text-xl font-bold">Custom OEM / ODM</h3><p class="mt-4 text-sm leading-6 text-white/70">Specify a new fit, pattern, fabric, colors or construction. Send a reference or tech pack for a separate sample plan, MOQ and production quote.</p><a class="mt-5 inline-block text-sm font-bold text-[#C9A84C]" href="/oem-activewear-manufacturer/">Plan custom development →</a></article>
      </div>
      <h3 class="mt-12 text-xl font-bold">Start with the product category</h3>
      <nav aria-label="Private label product categories" class="mt-5 flex flex-wrap gap-x-7 gap-y-3 text-sm font-bold text-[#C9A84C]"><a href="/private-label-sports-bras/">Sports bras</a><a href="/private-label-leggings/">Leggings</a><a href="/private-label-yoga-sets/">Yoga sets</a><a href="/private-label-pilates-clothing/">Pilates clothing</a><a href="/wholesale-flare-yoga-pants/">Flare yoga pants</a></nav>
    </div>
  </section>

  <InquiryForm />
</BaseLayout>
