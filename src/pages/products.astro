---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogBrowser from '../components/CatalogBrowser.astro';
import { productCatalog } from '../data/productCatalog';
import { productCategories } from '../data/productCategories';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fitclo Activewear Style Library',
  description: 'Browse Fitclo activewear styles by category, product type and style code. Confirm current availability, MOQ and private label options with the Fitclo team.',
  url: 'https://www.fitcloo.com/products/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: productCatalog.length,
    itemListElement: productCatalog.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: product.name,
        image: product.image,
        sku: product.styleCode,
        category: product.category,
      },
    })),
  },
};
---

<BaseLayout
  title="Activewear Style Library | FITCLO"
  description="Browse Fitclo activewear styles by category, product type and style code. Explore leggings, sports bras, gym shorts, matching sets and more."
  image="https://www.fitcloo.com/images/product-categories/matching-sets-hero.png"
  structuredData={productSchema}
  autoArticleSchema={false}
>
  <section class="relative min-h-[430px] overflow-hidden bg-[#0c0c0c] pt-[80px]">
    <img src="/images/product-categories/matching-sets-hero.png" alt="Fitclo activewear style library" class="absolute inset-0 h-full w-full object-cover object-center opacity-70" fetchpriority="high" />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative mx-auto flex min-h-[430px] max-w-[1240px] items-end px-6 pb-14 pt-20 lg:px-10 lg:pb-16">
      <div class="max-w-[700px]">
        <p class="text-[11px] font-bold tracking-[0.22em] text-[#d8b456] font-['Century_Gothic',sans-serif]">FITCLO PRODUCT CATALOG</p>
        <h1 class="mt-5 text-[42px] font-bold leading-[1.04] text-white sm:text-[56px] lg:text-[66px] font-['Century_Gothic',sans-serif]">Browse activewear styles for your next collection.</h1>
        <p class="mt-6 max-w-[590px] text-[16px] leading-[1.75] text-white/85 md:text-[18px] font-['Century_Gothic',sans-serif]">Search by style name or code, or use the category navigation to compare silhouettes before requesting availability, branding and factory pricing.</p>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[12px] font-bold tracking-[0.1em] text-white/80 font-['Century_Gothic',sans-serif]">
          <span>{productCatalog.length} CURRENT STYLES</span><span>{productCategories.length} CORE CATEGORIES</span><span>PRIVATE LABEL READY</span>
        </div>
      </div>
    </div>
  </section>

  <CatalogBrowser />

  <section class="bg-[#111111] py-16 text-white">
    <div class="mx-auto grid max-w-[1240px] gap-8 px-6 md:grid-cols-3 lg:px-10">
      <div class="border-t border-[#d8b456] pt-5">
        <p class="text-[12px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">01</p>
        <h2 class="mt-4 text-[21px] font-bold font-['Century_Gothic',sans-serif]">Find a reference style</h2>
        <p class="mt-3 text-[14px] leading-[1.65] text-white/65 font-['Century_Gothic',sans-serif]">Use the sidebar and search to narrow down silhouettes, product families and details.</p>
      </div>
      <div class="border-t border-[#d8b456] pt-5">
        <p class="text-[12px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">02</p>
        <h2 class="mt-4 text-[21px] font-bold font-['Century_Gothic',sans-serif]">Confirm availability</h2>
        <p class="mt-3 text-[14px] leading-[1.65] text-white/65 font-['Century_Gothic',sans-serif]">Ask Fitclo for the current stock, colour, sample and lead-time status of the selected style.</p>
      </div>
      <div class="border-t border-[#d8b456] pt-5">
        <p class="text-[12px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">03</p>
        <h2 class="mt-4 text-[21px] font-bold font-['Century_Gothic',sans-serif]">Add your brand</h2>
        <p class="mt-3 text-[14px] leading-[1.65] text-white/65 font-['Century_Gothic',sans-serif]">Discuss logo, labels, packaging, colours and quantity for a ready-to-ship or custom production route.</p>
      </div>
    </div>
  </section>
</BaseLayout>
