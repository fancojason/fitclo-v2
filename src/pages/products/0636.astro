anged?', 'Payment methods are T/T, Credit Card and PayPal. Express, air or sea shipping can be planned after the destination, quantity and delivery requirements are confirmed.']];
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', '@id': `${productUrl}#product`, name: productName, description: 'Wholesale women’s cross-back sports bra and V-waist leggings set in 230gsm nylon-spandex fabric for yoga, gym, running and private-label activewear collections.', sku: productCode, mpn: productCode, category: 'Women’s Activewear Matching Sets', url: productUrl, image: galleryImages.map((image) => `https://www.fitcloo.com${image.src}`), brand: { '@type': 'Brand', name: 'FITCLO' }, manufacturer: { '@type': 'Organization', name: 'FITCLO', url: 'https://www.fitcloo.com/' }, material: '68% Nylon / 32% Spandex, 230gsm', additionalProperty: [{ '@type': 'PropertyValue', name: 'Sizes', value: '4, 6, 8, 10 + or Customization' }, { '@type': 'PropertyValue', name: 'MOQ', value: '50 Sets' }, { '@type': 'PropertyValue', name: 'Features', value: 'Breathable, Quick Dry, Lightweight' }, { '@type': 'PropertyValue', name: 'Private Label', value: 'Logo, labels, hang tags, packaging, etc.' }] };
