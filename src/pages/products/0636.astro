const specifications = [['Product Type', 'Cross-Back Sports Bra & V-Waist Leggings Set', 'Sample', 'Request a sample review before bulk confirmation'], ['Fabric', '68% Nylon / 32% Spandex, 230gsm', 'Feature', 'Breathable, Quick Dry, Lightweight'], ['Sizes', '4, 6, 8, 10 + or Customization', 'MOQ', '50 Sets'], ['Set Includes', 'Cross-back sports bra + V-waist full-length leggings', 'Colors Shown', 'Damson Purple, Van Dyke Brown, Fawn, Caramel Brown, Magic Forest Green, Pumpkin Yellow, Bluebird, Smoky Purple, Mint Green, Blossom Pink, Fuchsia, Pine Green, Raven Grey, Crushed Limestone, Lemon Yellow, Rose Bloom, Coffee Brown, Pomegranate Red, Dress Blues and Black'], ['Branding', 'Logo, labels, hang tags, packaging, etc.', 'Logo Position', 'Bra, back, waist, legs, etc.'], ['Applications', 'Yoga, gym training, running, fitness and daily activewear', 'Packaging', 'Standard or customized packaging after review'], ['Customization', 'Color, logo, labels, packaging and size development', 'Payment', 'T/T, Credit Card, PayPal']];
