  ['/images/products/0636/0636-color-chart.webp', '0636 color chart showing twenty colors including Damson Purple, Fawn, Pine Green, Bluebird and Black'],
  ['/images/products/0636/0636-cross-back-and-v-waist-details.webp', '0636 cross-back sports bra cutout and crossover V-waist leggings construction details'],
