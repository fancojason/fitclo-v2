<section class="py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">KEY DESIGN FEATURES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Focused details for a cross-back yoga leggings set.</h2><div class="mt-10 grid gap-7 md:grid-cols-3">{[['Cross-strap hollow-out sports bra', 'The supplied images show a clean square front, slim crossing shoulder straps and a back cutout for a distinctive two-piece fitness silhouette.'], ['Crossover V-waist leggings', 'The overlapping front waistband creates a V-shaped waistline, paired with full-length fitted legs for yoga, gym and activewear collections.'], ['230gsm nylon-spandex fabric', 'The supplied 68% Nylon / 32% Spandex specification supports a close stretch fit; sample review should confirm recovery, coverage and comfort for the intended activity.']].map(([title, text], index) => <article class="border-t-2 border-[#d8b456] pt-5"><p class="text-[12px] font-bold text-[#d8b456]">0{index + 1}</p><h3 class="mt-4 text-[19px] font-bold">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>
    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">THREE WAYS TO ORDER</p><h2 class="mt-4 max-w-[700px] text-[30px] font-bold sm:text-[38px]">Choose the route that fits your launch plan.</h2><div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">{[['01 - READY STOCK WHOLESALE', 'For confirmed existing colors and sizes', 'Discuss current availability, size mix and delivery requirements with Fitclo.'], ['02 - STOCK STYLE + PRIVATE LABEL', 'For a faster branded launch', 'Add logo, labels, hang tags or packaging to the selected style after review.'], ['03 - FULL OEM DEVELOPMENT', 'For a custom product program', 'Discuss color, fit, sizing, construction and packaging requirements for your project.']].map(([number, title, text]) => <article class="bg-[#111218] p-7"><p class="text-[11px] font-bold tracking-[.15em] text-[#d8b456]">{number}</p><h3 class="mt-4 text-[20px] font-bold">{title}</h3><p class="mt-4 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>
