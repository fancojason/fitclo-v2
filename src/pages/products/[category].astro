---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryProductCollection from '../../components/CategoryProductCollection.astro';
import { productCategories, type ProductCategory } from '../../data/productCategories';

export function getStaticPaths() {
  return productCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: ProductCategory };
const whatsappMessage = encodeURIComponent(
  `Hello Fitclo, I am interested in developing ${category.title.toLowerCase()} for my brand. Can we discuss MOQ, sampling and fabric options?`,
);
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${category.title} Manufacturing`,
  description: category.description,
  image: `https://www.fitcloo.com${category.heroImage}`,
  brand: { '@type': 'Brand', name: 'Fitclo' },
  manufacturer: { '@id': 'https://www.fitcloo.com/#organization' },
  category: category.title,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    offerCount: category.styles.length,
    seller: { '@id': 'https://www.fitcloo.com/#organization' },
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: category.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={`${category.title} Manufacturer | FITCLO`}
  description={category.shortDescription}
  image={`https://www.fitcloo.com${category.heroImage}`}
  structuredData={[productSchema, faqSchema]}
  autoArticleSchema={false}
>
  <section class="relative min-h-[650px] pt-[80px] overflow-hidden bg-[#0a0a0a] flex items-end">
    <img
      src={category.heroImage}
      alt={category.heroAlt}
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="relative z-10 w-full border-t border-white/10 bg-black/20">
      <div class="mx-auto max-w-[1240px] px-6 pb-16 pt-24 lg:px-10 lg:pb-20">
        <p class="mb-5 text-[11px] font-bold tracking-[0.22em] text-[#d8b456] font-['Century_Gothic',sans-serif]">{category.eyebrow}</p>
        <h1 class="max-w-[760px] text-[42px] font-bold leading-[1.04] text-white sm:text-[56px] lg:text-[68px] font-['Century_Gothic',sans-serif]">
          {category.title}
        </h1>
        <p class="mt-7 max-w-[650px] text-[16px] leading-[1.75] text-white/85 md:text-[18px] font-['Century_Gothic',sans-serif]">
          {category.shortDescription}
        </p>
        <a
          href={`https://api.whatsapp.com/send?phone=8617160837538&text=${whatsappMessage}`}
          target="_blank"
          rel="noreferrer"
          class="mt-9 inline-flex items-center gap-3 border border-[#d8b456] bg-[#d8b456] px-6 py-3.5 text-[12px] font-bold tracking-[0.12em] text-black transition-colors hover:bg-white hover:border-white font-['Century_Gothic',sans-serif]"
        >
          REQUEST PRODUCT DEVELOPMENT <span aria-hidden="true" class="text-[18px] leading-none">&#8594;</span>
        </a>
      </div>
    </div>
  </section>

  <CategoryProductCollection categorySlug={category.slug} />

  <section class="bg-[#090909] py-18 text-white md:py-24">
    <div class="mx-auto grid max-w-[1120px] gap-12 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#b0882f] font-['Century_Gothic',sans-serif]">PRODUCT DEVELOPMENT</p>
        <h2 class="mt-4 text-[31px] font-bold leading-[1.15] text-white md:text-[40px] font-['Century_Gothic',sans-serif]">Designed around your brand’s performance brief.</h2>
        <p class="mt-6 text-[16px] leading-[1.8] text-white/60 font-['Century_Gothic',sans-serif]">{category.description}</p>
      </div>
      <aside class="border-l-2 border-[#d8b456] bg-[#171717] px-7 py-8 md:px-9">
        <p class="text-[11px] font-bold tracking-[0.18em] text-[#d8b456] font-['Century_Gothic',sans-serif]">WHAT WE PRIORITIZE</p>
        <p class="mt-4 text-[20px] font-bold leading-[1.45] text-white font-['Century_Gothic',sans-serif]">{category.focus}</p>
      </aside>
    </div>
  </section>

  <section class="bg-[#111111] py-18 text-white md:py-24">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">COLLECTION ARCHITECTURE</p>
      <div class="mt-4 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <h2 class="max-w-[680px] text-[31px] font-bold leading-[1.12] md:text-[42px] font-['Century_Gothic',sans-serif]">Build one clear category or a complete product family.</h2>
        <a href="/products" class="text-[12px] font-bold tracking-[0.12em] text-[#d8b456] transition-colors hover:text-white font-['Century_Gothic',sans-serif]">VIEW ALL CATEGORIES &#8594;</a>
      </div>
      <div class="mt-12 grid gap-px bg-white/20 md:grid-cols-3">
        {category.styles.map((style, index) => (
          <article id={style.id} class="scroll-mt-28 bg-[#111111] p-7 md:p-8">
            <p class="text-[12px] font-bold text-[#d8b456] font-['Century_Gothic',sans-serif]">0{index + 1}</p>
            <h3 class="mt-10 text-[23px] font-bold leading-[1.24] font-['Century_Gothic',sans-serif]">{style.name}</h3>
            <p class="mt-4 text-[15px] leading-[1.7] text-white/70 font-['Century_Gothic',sans-serif]">{style.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#090909] py-18 text-white md:py-24">
    <div class="mx-auto grid max-w-[1120px] gap-12 px-6 lg:grid-cols-2 lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#b0882f] font-['Century_Gothic',sans-serif]">CUSTOMIZATION OPTIONS</p>
        <h2 class="mt-4 text-[30px] font-bold leading-[1.15] text-white md:text-[39px] font-['Century_Gothic',sans-serif]">Construction details that make the line yours.</h2>
        <ul class="mt-8 space-y-4">
          {category.capabilities.map((capability) => (
            <li class="flex gap-4 text-[16px] leading-[1.6] text-white/70 font-['Century_Gothic',sans-serif]">
              <span class="mt-[8px] h-2 w-2 shrink-0 bg-[#d8b456]"></span>{capability}
            </li>
          ))}
        </ul>
      </div>
      <div class="border-t border-[#d8b456] bg-[#171717] p-8 md:p-10">
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#b0882f] font-['Century_Gothic',sans-serif]">FABRIC DIRECTION</p>
        <div class="mt-7 space-y-6">
          {category.fabricNotes.map((fabric, index) => (
            <div class="border-b border-white/10 pb-6 last:border-b-0 last:pb-0">
              <p class="text-[12px] font-bold text-[#b0882f] font-['Century_Gothic',sans-serif]">0{index + 1}</p>
              <p class="mt-2 text-[18px] font-bold leading-[1.45] text-white font-['Century_Gothic',sans-serif]">{fabric}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#090909] py-18 text-white md:py-24">
    <div class="mx-auto max-w-[900px] px-6 lg:px-10">
      <p class="text-center text-[11px] font-bold tracking-[0.2em] text-[#b0882f] font-['Century_Gothic',sans-serif]">BUYER QUESTIONS</p>
      <h2 class="mt-4 text-center text-[30px] font-bold leading-[1.15] text-white md:text-[40px] font-['Century_Gothic',sans-serif]">Common questions about {category.navLabel.toLowerCase()}.</h2>
      <div class="mt-12 divide-y divide-white/10 border-y border-white/10">
        {category.faq.map((item) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-8 text-[18px] font-bold leading-[1.45] text-white font-['Century_Gothic',sans-serif]">
              {item.question}<span class="text-[#b0882f] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-[760px] pt-4 text-[16px] leading-[1.75] text-white/60 font-['Century_Gothic',sans-serif]">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#111111] py-16">
    <div class="mx-auto flex max-w-[1120px] flex-col gap-8 px-6 md:flex-row md:items-center md:justify-between lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">START A PRODUCT BRIEF</p>
        <h2 class="mt-3 text-[30px] font-bold leading-[1.12] text-white md:text-[40px] font-['Century_Gothic',sans-serif]">Let’s develop your {category.navLabel.toLowerCase()} collection.</h2>
      </div>
      <a href={`https://api.whatsapp.com/send?phone=8617160837538&text=${whatsappMessage}`} target="_blank" rel="noreferrer" class="inline-flex shrink-0 items-center justify-center bg-[#d8b456] px-6 py-4 text-[12px] font-bold tracking-[0.12em] text-black transition-colors hover:bg-white font-['Century_Gothic',sans-serif]">TALK TO FITCLO &#8594;</a>
    </div>
  </section>
</BaseLayout>
