---
import BaseLayout from '../../layouts/BaseLayout.astro';

const productName = 'Capri Workout Set';
const productCode = 'TZ4549-6';
const productUrl = 'https://www.fitcloo.com/products/capri-workout-set/';
const productImage = 'https://www.fitcloo.com/images/products/capri-workout-set/capri-workout-set-main.webp';
const whatsAppMessage = `Hello Fitclo, I'm interested in the ${productName} (${productCode}). Please send the current colors, sizes, MOQ, sample cost and wholesale pricing.`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(whatsAppMessage)}`;

const galleryImages = [
  {
    src: '/images/products/capri-workout-set/capri-workout-set-main.webp',
    alt: 'Capri Workout Set matching series with sports bra, tank top and capri legging options',
    label: 'Matching series',
  },
  {
    src: '/images/products/capri-workout-set/capri-workout-set-ivory.webp',
    alt: 'Ivory Capri Workout Set with layered halter neckline and fold-over dotted waistband',
    label: 'Ivory colorway',
  },
  {
    src: '/images/products/womens-yoga-set/womens-yoga-set-custom-branding.png',
    alt: 'Private label logo, tag and packaging customization options',
    label: 'Private label options',
  },
  {
    src: '/images/products/womens-yoga-set/womens-yoga-set-stockroom.png',
    alt: 'Fitclo ready-stock activewear storage and packing area',
    label: 'Ready-stock program',
  },
];

const quickFacts = [
  ['Set includes', 'Layered top + mid-calf capri leggings'],
  ['Colors shown', 'Coffee Brown / Ivory / Navy + more, etc.'],
  ['Fabric', 'Brushed 78% Nylon / 22% Spandex'],
  ['Sizes', 'S, M, L, XL + or Customization'],
  ['Branding', 'Logo, labels, hang tags, packaging, etc.'],
  ['Samples', 'Available before bulk production'],
];

const specificationRows = [
  ['Product Type', '2 Piece Capri Workout Set', 'Sample', 'Available before bulk production'],
  ['Fabric', 'Brushed 78% Nylon / 22% Spandex', 'Private Label', 'Logo, labels, hang tags, packaging, etc.'],
  ['Design', 'Layered-look top + fold-over waist capri leggings', 'Logo & Labels', 'Heat transfer, silicone, embroidery or woven label'],
  ['Sizes', 'S, M, L, XL + or Customization', 'OEM / ODM', 'Custom fabric, colors, fit, sizing, pattern, packaging, etc.'],
  ['Colors', 'Coffee Brown, Ivory, Navy + custom colors, etc.', 'Shipping', 'Express, air freight or sea freight'],
  ['Applications', 'Yoga, Pilates, studio, light gym, dance and athleisure', 'Features', 'Brushed soft feel, breathable, moisture management, four-way stretch'],
  ['Logo Position', 'Front, back, waistband, legs, etc.', 'Payment', 'T/T, Credit Card, PayPal'],
];

const faqs = [
  {
    question: 'What is the MOQ for this Capri Workout Set?',
    answer: 'The MOQ depends on the sourcing route. Ready-stock and private label quantities are confirmed according to current stock, color, size mix and branding method. Full OEM production typically starts from 200 pcs per style/color within 4 sizes.',
  },
  {
    question: 'Can I order a sample before bulk production?',
    answer: 'Yes. Samples are available so you can evaluate the product, fit, stitching and branding direction before placing a bulk order.',
  },
  {
    question: 'Can I mix colors and sizes?',
    answer: 'Size and color mixing depends on current stock and the selected order type. Send the quantity and size breakdown you need for confirmation.',
  },
  {
    question: 'Can you add my logo to this set?',
    answer: 'Yes. Logo options may include heat transfer, silicone and embroidery on the front, back, waistband or leg, depending on the artwork, placement and order route.',
  },
  {
    question: 'Can you add custom labels and packaging?',
    answer: 'Yes. Fitclo can support inside labels, sewn care labels, woven labels, hang tags, custom polybags and custom zipper bags.',
  },
  {
    question: 'Can I customize the fabric or color?',
    answer: 'Yes. Custom fabric, GSM, finish, Pantone color, pattern and fit are available through full OEM development after the project requirements are reviewed.',
  },
  {
    question: 'How fast can ready-stock orders ship?',
    answer: 'Ready-stock orders can be prepared in as little as 7 days, subject to stock availability, branding requirements and order confirmation.',
  },
  {
    question: 'How long does full OEM development take?',
    answer: 'The timeline depends on fabric sourcing, pattern development, sample revisions and quantity. Share your tech pack or reference so Fitclo can map the appropriate production path.',
  },
  {
    question: 'Can you manufacture from my tech pack?',
    answer: 'Yes. Send the tech pack, measurements, grading, fabric requirements, color references, logo artwork and construction details for review.',
  },
  {
    question: 'Can you ship worldwide?',
    answer: 'Yes. Shipping can be arranged by express, air or sea after the order, destination and required delivery window are confirmed.',
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: productName,
  description:
    'A two-piece capri activewear set with a layered-look top, fold-over contrast waistband and mid-calf leggings. Available for ready-stock wholesale, private label branding and OEM development.',
  url: productUrl,
  image: galleryImages.map((image) => `https://www.fitcloo.com${image.src}`),
  sku: productCode,
  mpn: productCode,
  material: 'Brushed 78% Nylon / 22% Spandex',
  size: 'S, M, L, XL + or Customization',
  brand: {
    '@type': 'Brand',
    name: 'Fitclo',
  },
  manufacturer: {
    '@id': 'https://www.fitcloo.com/#organization',
  },
  category: 'Matching Sets / Capri Workout Sets / Yoga Sets',
  countryOfOrigin: {
    '@type': 'Country',
    name: 'China',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Components', value: 'Layered-look top + mid-calf capri leggings' },
    { '@type': 'PropertyValue', name: 'Design', value: 'Contrast halter neckline, fold-over waistband and capri silhouette' },
    { '@type': 'PropertyValue', name: 'Fabric', value: 'Brushed 78% Nylon / 22% Spandex' },
    { '@type': 'PropertyValue', name: 'Sizes', value: 'S, M, L, XL + or Customization' },
    { '@type': 'PropertyValue', name: 'Sample', value: 'Available' },
    { '@type': 'PropertyValue', name: 'Private label', value: 'Logo, labels, hang tags, packaging, etc.' },
    { '@type': 'PropertyValue', name: 'Logo position', value: 'Front, back, waist, legs, etc.' },
    { '@type': 'PropertyValue', name: 'Payment', value: 'T/T, Credit Card, PayPal' },
    { '@type': 'PropertyValue', name: 'OEM development', value: 'Custom fabric, color, pattern, fit and grading available' },
  ],
};

const productBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.fitcloo.com/products/' },
    { '@type': 'ListItem', position: 3, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' },
    { '@type': 'ListItem', position: 4, name: productName, item: productUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Capri Workout Set TZ4549-6 | Wholesale & Private Label"
  description="Wholesale brushed nylon-spandex Capri Workout Set TZ4549-6 with layered top and mid-calf leggings. Samples, custom logos, labels and OEM options available."
  canonicalURL={productUrl}
  image={productImage}
  structuredData={[productSchema, productBreadcrumbSchema, faqSchema]}
  autoArticleSchema={false}
  includeBreadcrumbSchema={false}
>
  <div class="product-detail-page bg-[#090a0c] text-white">
  <section class="bg-[#090a0c] pt-[112px] text-white">
    <div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20">
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-white/55 font-['Century_Gothic',sans-serif]" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-[#d8b456]">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/products/" class="transition-colors hover:text-[#d8b456]">Products</a>
        <span aria-hidden="true">›</span>
        <a href="/products/matching-sets/" class="transition-colors hover:text-[#d8b456]">Matching Sets</a>
        <span aria-hidden="true">›</span>
        <span class="text-white/85" aria-current="page">{productName}</span>
      </nav>

      <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(400px,0.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16" data-product-gallery>
        <figure class="min-w-0">
          <div class="relative aspect-square overflow-hidden border border-white/15 bg-[#111218]">
            <img
              src={galleryImages[0].src}
              alt={galleryImages[0].alt}
              width="800"
              height="800"
              class="h-full w-full object-contain"
              fetchpriority="high"
              data-gallery-main
            />
          </div>
          <div class="mt-4 grid grid-cols-[32px_repeat(4,minmax(0,1fr))_32px] items-center gap-2 sm:grid-cols-[40px_repeat(4,minmax(0,1fr))_40px]">
            <button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] leading-none text-white/80 transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" aria-label="Show previous product image" data-gallery-previous>‹</button>
            {galleryImages.map((image, index) => (
              <button type="button" class="gallery-thumbnail relative aspect-square overflow-hidden border border-white/20 bg-[#111218] transition-colors hover:border-[#d8b456]" aria-label={`View ${image.label}`} aria-pressed={index === 0 ? 'true' : 'false'} data-gallery-thumbnail={index}>
                <img src={image.src} alt="" width="180" height="180" loading="lazy" class="h-full w-full object-cover" />
              </button>
            ))}
            <button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] leading-none text-white/80 transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" aria-label="Show next product image" data-gallery-next>›</button>
          </div>
          <figcaption class="mt-4 flex items-start justify-between gap-5 border-t border-white/15 pt-4 font-['Century_Gothic',sans-serif]">
            <span class="text-[12px] font-bold text-white" data-gallery-label>{galleryImages[0].label}</span>
            <span class="text-right text-[11px] text-white/45">Style code<br />{productCode}</span>
          </figcaption>
        </figure>

        <div class="pt-1">
          <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">READY STOCK · PRIVATE LABEL · OEM</p>
          <h1 class="mt-5 max-w-[740px] text-[38px] font-bold leading-[1.06] text-white sm:text-[50px] font-['Century_Gothic',sans-serif]">Capri Workout Set</h1>
          <p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75 md:text-[17px] font-['Century_Gothic',sans-serif]">A coordinated capri activewear set with a layered-look top, contrast halter detail and mid-calf leggings with a fold-over waistband. Source selected stock colors, add your private label, or customize the fabric, color, fit and packaging for your collection.</p>

          <dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">
            {quickFacts.map(([label, value]) => (
              <div>
                <dt class="text-[10px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">{label}</dt>
                <dd class="mt-2 text-[13px] leading-[1.55] text-white/85 font-['Century_Gothic',sans-serif]">{value}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-wrap items-center gap-3 font-['Century_Gothic',sans-serif]">
            <a href="#product-inquiry" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d8b456] px-6 py-3 text-[13px] font-bold text-[#101010] transition-colors hover:bg-[#efd078]" data-product-track="click_quote_cta">Request Wholesale Quote</a>
            <a href="#product-inquiry" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 px-6 py-3 text-[13px] font-bold text-white transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" data-product-track="click_sample_cta">Order a TZ4549-6 Sample</a>
            <a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456] transition-colors hover:text-white">View Customization Options <span class="ml-2" aria-hidden="true">→</span></a>
          </div>
          <p class="mt-4 text-[12px] leading-[1.55] text-white/45 font-['Century_Gothic',sans-serif]">Current stock, exact MOQ and pricing are confirmed according to the selected color, size mix and branding requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="buyer-summary-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">BUYER SUMMARY</p>
        <h2 id="buyer-summary-heading" class="mt-4 max-w-[420px] text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Capri Workout Set for activewear brands and wholesale buyers.</h2>
      </div>
      <div class="border-l-2 border-[#d8b456] pl-6">
        <p class="text-[16px] leading-[1.8] text-[#3f4248] font-['Century_Gothic',sans-serif]">Fitclo's Capri Workout Set combines a fitted layered-look top with mid-calf leggings and a wide fold-over contrast waistband. The striped and polka-dot trims give buyers a recognizable retro studio direction while the brushed nylon-spandex base supports yoga, Pilates, dance and athleisure collections. Buyers may source selected ready-stock colors, add private label branding, or develop a customized version around their own fabric, color, print, fit and packaging requirements.</p>
        <p class="mt-4 text-[16px] leading-[1.8] text-[#3f4248] font-['Century_Gothic',sans-serif]">Samples are available before bulk production, and worldwide shipping can be arranged by express, air or sea.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#090a0c] py-16 text-white lg:py-20" aria-labelledby="specifications-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">PRODUCT SPECIFICATIONS</p>
          <h2 id="specifications-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">Product specifications</h2>
        </div>
        <p class="max-w-[420px] text-[14px] leading-[1.65] text-white/60 font-['Century_Gothic',sans-serif]">Confirmed fabric, GSM, size range and customization information for style {productCode}.</p>
      </div>
      <div class="mt-9 overflow-x-auto border border-white/25 bg-[#0d0f13]">
        <table class="min-w-[920px] w-full border-collapse text-left font-['Century_Gothic',sans-serif]">
          <tbody>
            {specificationRows.map(([leftLabel, leftValue, rightLabel, rightValue]) => (
              <tr class="border-b border-white/15 last:border-b-0">
                <th scope="row" class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold tracking-[0.04em] text-[#d8b456]">{leftLabel}</th>
                <td class="w-[34%] border-r border-white/15 px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{leftValue}</td>
                <th scope="row" class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold tracking-[0.04em] text-[#d8b456]">{rightLabel}</th>
                <td class="w-[34%] px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{rightValue}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-12 border-t border-white/15 pt-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">PRODUCT DETAILS</p>
            <h3 class="mt-3 text-[24px] font-bold text-white font-['Century_Gothic',sans-serif]">Colorway, fit and construction views.</h3>
          </div>
          <p class="max-w-[380px] text-[13px] leading-[1.65] text-white/55 font-['Century_Gothic',sans-serif]">Reference images show the full capri silhouette, front and back fit, fold-over waistband and layered neckline construction without cropping.</p>
        </div>
        <div class="mt-7 grid gap-4 md:grid-cols-3">
          {[
            ['/images/products/capri-workout-set/capri-workout-set-detail-brown-front.webp', 'Coffee brown Capri Workout Set front view'],
            ['/images/products/capri-workout-set/capri-workout-set-detail-brown-side.webp', 'Coffee brown Capri Workout Set three-quarter view'],
            ['/images/products/capri-workout-set/capri-workout-set-detail-navy-back.webp', 'Navy Capri Workout Set back view'],
          ].map(([src, alt]) => (
            <figure class="overflow-hidden border border-white/15 bg-[#111218] p-2">
              <img src={src} alt={alt} width="1320" height="1920" loading="lazy" class="h-auto w-full object-contain" />
            </figure>
          ))}
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          {[
            ['/images/products/capri-workout-set/capri-workout-set-detail-waist-cuffs.webp', 'Navy capri leggings fold-over waistband and cuff construction details'],
            ['/images/products/capri-workout-set/capri-workout-set-detail-neckline.webp', 'Navy layered workout top neckline and strap construction details'],
          ].map(([src, alt]) => (
            <figure class="overflow-hidden border border-white/15 bg-[#111218] p-2">
              <img src={src} alt={alt} width="645" height="880" loading="lazy" class="h-auto w-full object-contain" />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="features-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">KEY DESIGN FEATURES</p>
      <h2 id="features-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">A distinctive capri set built for studio-to-street collections.</h2>
      <div class="mt-10 grid gap-7 md:grid-cols-3">
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">01</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">Layered neckline detail</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">A fitted scoop-neck tank is paired with a contrast halter insert in stripe or polka-dot patterns, creating a layered look without adding a separate styling step.</p>
        </div>
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">02</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">Fold-over contrast waistband</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">The wide waistband can be folded to reveal a coordinated stripe or polka-dot print, giving brands a clear color-story detail across the matching set.</p>
        </div>
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">03</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">Mid-calf capri length</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">The below-knee silhouette offers a lighter alternative to full-length leggings for warm-weather, studio, dance and trend-led activewear capsules.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#111218] py-16 text-white lg:py-20" aria-labelledby="order-options-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">THREE WAYS TO ORDER</p>
      <h2 id="order-options-heading" class="mt-4 max-w-[700px] text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Choose the route that fits your launch plan.</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">01 · READY STOCK WHOLESALE</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For faster delivery and market testing</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Use confirmed existing colors and sizes without branding. MOQ depends on current stock; timing can be as fast as 7 days after confirmation.</p>
        </article>
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">02 · STOCK STYLE + PRIVATE LABEL</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For a faster branded launch</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Add a logo, inside label, care label, woven label, hang tag or packaging to an existing style. Quantity and timing depend on the branding method.</p>
        </article>
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">03 · FULL OEM DEVELOPMENT</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For a fully custom product</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Develop the fabric, GSM, Pantone color, pattern, fit, grading and packaging. A typical starting point is 200 pcs per style/color within 4 sizes after review.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="customization" class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="customization-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-10">
