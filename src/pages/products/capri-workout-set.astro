<script>
  const form = document.querySelector<HTMLFormElement>('[data-product-inquiry-form]');
  const status = document.querySelector<HTMLElement>('[data-product-form-status]');
  const pageUrlInput = form?.querySelector<HTMLInputElement>('[data-page-url]');
  let inquiryStarted = false;

  const track = (eventName: string, parameters: Record<string, string> = {}) => {
    const analyticsWindow = window as Window & {
      gtag?: (command: string, event: string, params: Record<string, string>) => void;
      dataLayer?: Array<Record<string, string>>;
    };

    if (typeof analyticsWindow.gtag === 'function') {
      analyticsWindow.gtag('event', eventName, parameters);
      return;
    }

    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.dataLayer.push({ event: eventName, ...parameters });
  };

  const gallery = document.querySelector<HTMLElement>('[data-product-gallery]');
  const galleryMain = gallery?.querySelector<HTMLImageElement>('[data-gallery-main]');
  const galleryLabel = gallery?.querySelector<HTMLElement>('[data-gallery-label]');
  const galleryPrevious = gallery?.querySelector<HTMLButtonElement>('[data-gallery-previous]');
  const galleryNext = gallery?.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const galleryThumbnails = Array.from(gallery?.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]') || []);

  if (gallery && galleryMain && galleryLabel) {
    const galleryItems = galleryThumbnails.map((thumbnail) => {
      const image = thumbnail.querySelector('img');
      return {
        src: image?.getAttribute('src') || '',
        alt: thumbnail.getAttribute('aria-label')?.replace(/^View\s+/, '') || '',
        label: thumbnail.getAttribute('aria-label')?.replace(/^View\s+/, '') || '',
      };
    });
    let activeGalleryIndex = Math.max(0, galleryItems.findIndex((item) => item.src === galleryMain.getAttribute('src')));

    const selectGalleryImage = (nextIndex: number) => {
      activeGalleryIndex = (nextIndex + galleryItems.length) % galleryItems.length;
      const item = galleryItems[activeGalleryIndex];
      galleryMain.src = item.src;
      galleryMain.alt = item.alt;
      galleryLabel.textContent = item.label;
      galleryThumbnails.forEach((thumbnail) => {
        const isActive = Number(thumbnail.dataset.galleryThumbnail) === activeGalleryIndex;
        thumbnail.setAttribute('aria-pressed', String(isActive));
      });
      track('select_product_image', {
        product_name: 'Capri Workout Set',
        product_code: 'TZ4549-6',
        image_position: String(activeGalleryIndex + 1),
      });
    };

    galleryThumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => selectGalleryImage(Number(thumbnail.dataset.galleryThumbnail || '0')));
    });
    galleryPrevious?.addEventListener('click', () => selectGalleryImage(activeGalleryIndex - 1));
    galleryNext?.addEventListener('click', () => selectGalleryImage(activeGalleryIndex + 1));
  }

  document.querySelectorAll<HTMLElement>('[data-product-track]').forEach((element) => {
    element.addEventListener('click', () => {
      const eventName = element.dataset.productTrack;
      if (eventName) track(eventName, { product_name: 'Capri Workout Set', product_code: 'TZ4549-6' });
    });
  });

  if (form && pageUrlInput) {
    pageUrlInput.value = window.location.href;
    track('view_product', { product_name: 'Capri Workout Set', product_code: 'TZ4549-6' });

    form.addEventListener('focusin', () => {
      if (!inquiryStarted) {
        inquiryStarted = true;
        track('start_product_inquiry', { product_name: 'Capri Workout Set', product_code: 'TZ4549-6' });
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = form.elements.namedItem('email') as HTMLInputElement | null;
      const phone = form.elements.namedItem('phone') as HTMLInputElement | null;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (!email?.value.trim() && !phone?.value.trim()) {
        if (status) {
          status.textContent = 'Please enter a business email or WhatsApp number so our team can reply.';
          status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        email?.focus();
        return;
      }

      if (!form.reportValidity()) return;
      const originalLabel = submitButton?.textContent || 'Send Product Inquiry';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending inquiry...';
      }
      if (status) {
        status.textContent = 'Sending your product inquiry...';
        status.className = 'text-[13px] text-white/60 sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
      }

      try {
        const response = await fetch('/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.');

        track('submit_product_inquiry', { product_name: 'Capri Workout Set', product_code: 'TZ4549-6' });
        form.reset();
        if (pageUrlInput) pageUrlInput.value = window.location.href;
        if (status) {
          status.textContent = 'Thank you. Your inquiry has been sent. The Fitclo team will reply with current details.';
          status.className = 'text-[13px] text-[#c6e4ae] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        if (submitButton) submitButton.textContent = 'Inquiry Sent';
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp instead.';
          status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      }
    });
  }
</script>
