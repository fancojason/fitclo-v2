---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fixedProductGalleryImages } from '../../data/productGalleryDefaults';

const productName = 'Knee-Length Capri Leggings Workout Set';
const productCode = 'TZ7655-7';
const productUrl = 'https://www.fitcloo.com/products/knee-length-capri-leggings-workout-set/';
const productImage = 'https://www.fitcloo.com/images/products/desktop-stock/tz7655-7-knee-length-capri-workout-set.jpg';
const whatsAppMessage = `Hello Fitclo, I'm interested in the ${productName} (${productCode}). Please send current colors, sizes, MOQ, sample cost and wholesale pricing.`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(whatsAppMessage)}`;

const galleryImages = [
  {
    src: '/images/products/desktop-stock/tz7655-7-knee-length-capri-workout-set.jpg',
    alt: 'Knee-Length Capri Leggings Workout Set TZ7655-7 cover with V-neck racerback tank top and capri leggings',
    label: 'Product cover',
  },
  {
    src: '/images/products/knee-length-capri-leggings-workout-set/tz7655-7-feature-board.png',
    alt: 'Seamless V-neck racerback tank top and high waist knee-length capri leggings workout set feature board',
    label: 'Feature board',
  },
  {
    src: '/images/products/knee-length-capri-leggings-workout-set/tz7655-7-matching-series.png',
    alt: 'TZ7655-7 matching series showing seamless sports bra, tank top and knee-length capri leggings options',
    label: 'Matching series',
  },
  ...fixedProductGalleryImages,
];

const detailImages = [
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-raspberry-side.png', 'Raspberry red seamless V-neck tank top and knee-length capri leggings side view'],
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-espresso-front.png', 'Espresso brown knee-length capri leggings workout set front view'],
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-black-back.png', 'Black racerback tank top and knee-length capri leggings back view'],
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-color-chart.png', 'Color chart for TZ7655-7 seamless capri workout set'],
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-construction-details.png', 'Construction details for seamless racerback tank, V-neckline and waistband'],
  ['/images/products/knee-length-capri-leggings-workout-set/tz7655-7-seamless-fabric.png', 'Seamless knitted nylon spandex fabric for capri workout set'],
];

const quickFacts = [
  ['Set includes', 'V-neck racerback tank top + high waist knee-length capri leggings'],
  ['Fabric', 'Seamless 90% Nylon / 10% Spandex'],
  ['Sizes', 'S, M, L, XL + or Customization'],
  ['MOQ', '50 Sets'],
  ['Branding', 'Logo, labels, hang tags, packaging, etc.'],
  ['Samples', 'Available before bulk production'],
];

const specificationRows = [
  ['Product Type', 'Women Two-Piece Seamless Capri Workout Set', 'Style Code', productCode],
  ['Fabric', 'Seamless 90% Nylon / 10% Spandex', 'Sample', 'Available before bulk production'],
  ['Design', 'V-neck racerback tank top + high waist knee-length capri leggings', 'Private Label', 'Logo, labels, hang tags, packaging, etc.'],
  ['Sizes', 'S, M, L, XL + or Customization', 'OEM / ODM', 'Custom fabric, colors, fit, pattern and packaging, etc.'],
  ['Colors', 'Terracotta, Raspberry Red, Espresso Brown, Plum Purple, Black + customization, etc.', 'Logo Position', 'Front, back, waist, legs, hang tags and packaging, etc.'],
  ['Applications', 'Yoga, Pilates, gym workout, running, summer fitness, studio training and athleisure', 'Features', 'Seamless knitted, breathable, moisture-wicking, high elasticity, wrinkle-resistant and wear-resistant'],
  ['Construction', 'V-neck, racerback design, invisible scrunch, high waist and knee-length 3/4 capri leggings', 'Payment', 'T/T, Credit Card, PayPal'],
];

const faqs = [
  {
    question: 'What is the fabric for TZ7655-7?',
    answer:
      'TZ7655-7 uses seamless 90% Nylon / 10% Spandex. The fabric is designed for stretch recovery, smooth compression, moisture-wicking performance and a soft knitted hand feel.',
  },
  {
    question: 'Is this a capri workout set or a knee-length leggings set?',
    answer:
      'It can be positioned as both. Buyers can list it as a capri workout set, knee-length leggings set, 3/4 workout leggings set, seamless yoga outfit or two-piece Pilates set depending on the sales channel.',
  },
  {
    question: 'What sizes are available?',
    answer:
      'Ready-stock sizing is S, M, L and XL. Custom sizing, grading and fit adjustments can be reviewed for private label or OEM production.',
  },
  {
    question: 'Can the product use private label branding?',
    answer:
      'Yes. Fitclo can support logo placement, woven labels, heat transfer labels, hang tags, packaging bags and other brand assets based on your artwork and order requirements.',
  },
  {
    question: 'What buyer search terms fit this product?',
    answer:
      'Relevant search terms include Seamless V-neck Racerback Tank Top Yoga Outfit, High Waist Pants, Women Two-piece Knee-Length Capri Leggings Workout Set, capri workout set, knee-length leggings set and 3/4 workout leggings.',
  },
  {
    question: 'Can I request sample approval before a bulk order?',
    answer:
      'Yes. Sample approval helps check fabric hand feel, opacity, V-neck fit, racerback construction, waistband compression, capri length and branding position before bulk production.',
  },
  {
    question: 'Can Fitclo customize the color?',
    answer:
      'Yes. Existing colors are faster for ready-stock programs. Custom colors can be reviewed for OEM development after confirming target Pantone, MOQ, lead time and fabric requirements.',
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: productName,
  description:
    'Knee-Length Capri Leggings Workout Set TZ7655-7 is a seamless women two-piece activewear outfit with a V-neck racerback tank top, high waist knee-length 3/4 capri leggings and seamless 90% nylon / 10% spandex fabric for wholesale, private label and OEM activewear brands.',
  url: productUrl,
  image: [...galleryImages.map((image) => `https://www.fitcloo.com${image.src}`), ...detailImages.map(([src]) => `https://www.fitcloo.com${src}`)],
  sku: productCode,
  mpn: productCode,
  material: 'Seamless 90% Nylon / 10% Spandex',
  size: 'S, M, L, XL + or Customization',
  brand: {
    '@type': 'Brand',
    name: 'Fitclo',
  },
  manufacturer: {
    '@id': 'https://www.fitcloo.com/#organization',
  },
  category: 'Matching Sets / Capri Workout Sets / Knee-Length Leggings Sets',
  countryOfOrigin: {
    '@type': 'Country',
    name: 'China',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Product type', value: 'Women Two-Piece Seamless Capri Workout Set' },
    { '@type': 'PropertyValue', name: 'Fabric', value: 'Seamless 90% Nylon / 10% Spandex' },
    { '@type': 'PropertyValue', name: 'Sizes', value: 'S, M, L, XL + or Customization' },
    { '@type': 'PropertyValue', name: 'MOQ', value: '50 Sets' },
    { '@type': 'PropertyValue', name: 'Applications', value: 'Yoga, Pilates, gym workout, running, summer fitness, studio training and athleisure' },
    { '@type': 'PropertyValue', name: 'Features', value: 'Seamless knitted, breathable, moisture-wicking, high elasticity, wrinkle-resistant and wear-resistant' },
    { '@type': 'PropertyValue', name: 'Private label', value: 'Logo, labels, hang tags, packaging, etc.' },
    { '@type': 'PropertyValue', name: 'Payment', value: 'T/T, Credit Card, PayPal' },
  ],
};

const productBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.fitcloo.com/products/' },
    { '@type': 'ListItem', position: 3, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' },
    { '@type': 'ListItem', position: 4, name: productName, item: productUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Knee-Length Capri Leggings Workout Set TZ7655-7 | Seamless 3/4 Yoga Outfit"
  description="Wholesale TZ7655-7 seamless capri workout set with V-neck racerback tank top, high waist knee-length 3/4 leggings, 90% nylon / 10% spandex fabric and private label options."
  canonicalURL={productUrl}
  image={productImage}
  structuredData={[productSchema, productBreadcrumbSchema, faqSchema]}
  autoArticleSchema={false}
  includeBreadcrumbSchema={false}
>
  <div class="product-detail-page bg-[#090a0c] text-white">
    <section class="pt-[112px]">
      <div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20">
        <nav class="flex flex-wrap items-center gap-2 text-[12px] text-white/55 font-['Century_Gothic',sans-serif]" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-[#d8b456]">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/products/" class="transition-colors hover:text-[#d8b456]">Products</a>
          <span aria-hidden="true">/</span>
          <a href="/products/matching-sets/" class="transition-colors hover:text-[#d8b456]">Matching Sets</a>
          <span aria-hidden="true">/</span>
          <span class="text-white/85" aria-current="page">{productName}</span>
        </nav>

        <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(400px,0.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16" data-product-gallery>
          <figure class="min-w-0">
            <div class="relative aspect-square overflow-hidden rounded-[12px] border border-white/15 bg-[#111218]">
              <img
                src={galleryImages[0].src}
                alt={galleryImages[0].alt}
                width="800"
                height="800"
                class="h-full w-full object-contain"
                fetchpriority="high"
                data-gallery-main
              />
            </div>
            <div class="mt-4 grid grid-cols-[32px_repeat(5,minmax(0,1fr))_32px] items-center gap-2 sm:grid-cols-[40px_repeat(5,minmax(0,1fr))_40px]">
              <button type="button" class="gallery-arrow grid aspect-square place-items-center rounded-full border border-white/20 text-[24px] leading-none text-white/80 transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" aria-label="Show previous product image" data-gallery-previous>&lsaquo;</button>
              {galleryImages.map((image, index) => (
                <button
                  type="button"
                  class="gallery-thumbnail relative aspect-square overflow-hidden rounded-[10px] border border-white/20 bg-[#111218] transition-colors hover:border-[#d8b456]"
                  aria-label={`View ${image.label}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-gallery-thumbnail={index}
                  data-gallery-src={image.src}
                  data-gallery-alt={image.alt}
                  data-gallery-label={image.label}
                >
                  <img src={image.src} alt="" width="180" height="180" loading="lazy" class="h-full w-full object-cover" />
                </button>
              ))}
              <button type="button" class="gallery-arrow grid aspect-square place-items-center rounded-full border border-white/20 text-[24px] leading-none text-white/80 transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" aria-label="Show next product image" data-gallery-next>&rsaquo;</button>
            </div>
            <figcaption class="mt-4 flex items-start justify-between gap-5 border-t border-white/15 pt-4 font-['Century_Gothic',sans-serif]">
              <span class="text-[12px] font-bold text-white" data-gallery-label>{galleryImages[0].label}</span>
              <span class="text-right text-[11px] text-white/45">Style code<br />{productCode}</span>
            </figcaption>
          </figure>

          <div class="pt-1">
            <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">READY STOCK - PRIVATE LABEL - OEM</p>
            <h1 class="mt-5 max-w-[760px] text-[36px] font-bold leading-[1.06] text-white sm:text-[48px] font-['Century_Gothic',sans-serif]">{productName}</h1>
            <p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75 md:text-[17px] font-['Century_Gothic',sans-serif]">
              A seamless capri workout set built around a V-neck racerback tank top and high waist knee-length capri leggings. It is designed for yoga, Pilates, gym training, summer running outfits and private label activewear brands that need a clean 3/4 workout leggings story.
            </p>
            <p class="mt-4 max-w-[720px] text-[13px] leading-[1.65] text-white/52 font-['Century_Gothic',sans-serif]">
              Buyer search direction: Seamless V-neck Racerback Tank Top Yoga Outfit High Waist Pants Women's Two-piece Knee-Length Capri Leggings Workout Set.
            </p>

            <dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">
              {quickFacts.map(([label, value]) => (
                <div>
                  <dt class="text-[10px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">{label}</dt>
                  <dd class="mt-2 text-[13px] leading-[1.55] text-white/85 font-['Century_Gothic',sans-serif]">{value}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-8 flex flex-wrap items-center gap-3 font-['Century_Gothic',sans-serif]">
              <a href="#product-inquiry" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d8b456] px-6 py-3 text-[13px] font-bold text-[#101010] transition-colors hover:bg-[#efd078]">Request Wholesale Quote</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 px-6 py-3 text-[13px] font-bold text-white transition-colors hover:border-[#d8b456] hover:text-[#d8b456]">Order a TZ7655-7 Sample</a>
              <a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456] transition-colors hover:text-white">View Customization Options <span class="ml-2" aria-hidden="true">-&gt;</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 py-16 lg:py-20" aria-labelledby="buyer-summary-heading">
      <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:px-10">
        <div>
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">BUYER SUMMARY</p>
          <h2 id="buyer-summary-heading" class="mt-4 max-w-[500px] text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">A seamless knee-length leggings set for warmer-season drops.</h2>
        </div>
        <div class="border-l-2 border-[#d8b456] pl-6">
          <p class="text-[16px] leading-[1.8] text-white/68 font-['Century_Gothic',sans-serif]">
            TZ7655-7 is useful when buyers want a capri workout set that feels lighter than full-length leggings but still looks like a coordinated performance outfit. The V-neck racerback top helps the set read sporty, while the knee-length 3/4 leggings support yoga, Pilates, gym and casual summer fitness merchandising.
          </p>
          <p class="mt-4 text-[16px] leading-[1.8] text-white/68 font-['Century_Gothic',sans-serif]">
            For activewear brands, this product can be positioned as a seamless yoga set, knee-length leggings set, 3/4 workout leggings outfit, racerback tank top set or private label capri activewear program.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-20" aria-labelledby="specifications-heading">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">PRODUCT SPECIFICATIONS</p>
            <h2 id="specifications-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">Product specifications</h2>
          </div>
          <p class="max-w-[430px] text-[14px] leading-[1.65] text-white/60 font-['Century_Gothic',sans-serif]">Key details for buyers comparing seamless capri workout sets, knee-length leggings sets and private label 3/4 workout leggings.</p>
        </div>
        <div class="mt-9 overflow-x-auto border border-white/25 bg-[#0d0f13]">
          <table class="min-w-[920px] w-full border-collapse text-left font-['Century_Gothic',sans-serif]">
            <tbody>
              {specificationRows.map(([leftLabel, leftValue, rightLabel, rightValue]) => (
                <tr class="border-b border-white/15 last:border-b-0">
                  <th scope="row" class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold tracking-[0.04em] text-[#d8b456]">{leftLabel}</th>
                  <td class="w-[34%] border-r border-white/15 px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{leftValue}</td>
                  <th scope="row" class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold tracking-[0.04em] text-[#d8b456]">{rightLabel}</th>
                  <td class="w-[34%] px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{rightValue}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 py-16 lg:py-20" aria-labelledby="details-heading">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
        <div class="max-w-[760px]">
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">PRODUCT DETAILS</p>
          <h2 id="details-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">Detail views and color options</h2>
          <p class="mt-4 text-[15px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">
            Use these images to evaluate silhouette, V-neck depth, racerback construction, seamless fabric texture, waistband height, invisible scrunch shaping and knee-length capri proportion.
          </p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {detailImages.map(([src, alt]) => (
            <figure class="overflow-hidden rounded-[12px] border border-white/12 bg-white">
              <img src={src} alt={alt} loading="lazy" class="h-full w-full object-contain" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="customization" class="py-16 lg:py-20" aria-labelledby="customization-heading">
      <div class="mx-auto grid max-w-[1240px] gap-8 px-6 lg:grid-cols-3 lg:px-10">
        <div>
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">CUSTOMIZATION</p>
          <h2 id="customization-heading" class="mt-4 text-[30px] font-bold leading-[1.15] sm:text-[38px] font-['Century_Gothic',sans-serif]">Private label ready.</h2>
        </div>
        <div class="rounded-[12px] border border-white/12 bg-[#0d0f13] p-6">
          <h3 class="text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">Branding options</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">Heat transfer logo, woven label, silicone patch, hang tag, packaging bag, carton label and custom color card support can be reviewed before production.</p>
        </div>
        <div class="rounded-[12px] border border-white/12 bg-[#0d0f13] p-6">
          <h3 class="text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">OEM development</h3>
          <p class="mt-3 text-[14px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">For custom programs, Fitclo can adjust color, GSM, seamless texture, compression level, neckline, back design, capri length and size grading.</p>
        </div>
      </div>
    </section>

    <section id="product-inquiry" class="border-y border-white/10 bg-[#0d0f13] py-16 lg:py-20" aria-labelledby="inquiry-heading">
      <div class="mx-auto grid max-w-[1120px] gap-8 px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:px-10">
        <div>
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">WHOLESALE INQUIRY</p>
          <h2 id="inquiry-heading" class="mt-4 text-[30px] font-bold leading-[1.15] sm:text-[38px] font-['Century_Gothic',sans-serif]">Request colors, MOQ and sample details for TZ7655-7.</h2>
          <p class="mt-4 max-w-[720px] text-[15px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">Send your target market, color mix, size ratio, branding method and estimated order quantity. Fitclo will confirm current stock, sample options, production lead time and shipping route.</p>
        </div>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d8b456] px-7 py-3 text-[14px] font-bold text-[#101010] transition-colors hover:bg-[#efd078] font-['Century_Gothic',sans-serif]">Chat on WhatsApp</a>
      </div>
    </section>

    <section class="py-16 lg:py-20" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-[980px] px-6 lg:px-10">
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">FAQ</p>
        <h2 id="faq-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">Frequently asked questions</h2>
        <div class="mt-8 divide-y divide-white/12 border-y border-white/12">
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[16px] font-bold text-white font-['Century_Gothic',sans-serif]">
                {faq.question}
                <span class="text-[#d8b456] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-4 max-w-[820px] text-[14px] leading-[1.8] text-white/65 font-['Century_Gothic',sans-serif]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
      const mainImage = gallery.querySelector('[data-gallery-main]');
      const label = gallery.querySelector('[data-gallery-label]');
      const thumbnails = Array.from(gallery.querySelectorAll('[data-gallery-thumbnail]'));
      const previous = gallery.querySelector('[data-gallery-previous]');
      const next = gallery.querySelector('[data-gallery-next]');
      let activeIndex = 0;

      const setActive = (index) => {
        if (!mainImage || thumbnails.length === 0) return;
        activeIndex = (index + thumbnails.length) % thumbnails.length;
        const active = thumbnails[activeIndex];
        mainImage.src = active.dataset.gallerySrc;
        mainImage.alt = active.dataset.galleryAlt;
        if (label) label.textContent = active.dataset.galleryLabel;
        thumbnails.forEach((button, buttonIndex) => {
          button.setAttribute('aria-pressed', buttonIndex === activeIndex ? 'true' : 'false');
        });
      };

      thumbnails.forEach((button, index) => button.addEventListener('click', () => setActive(index)));
      previous?.addEventListener('click', () => setActive(activeIndex - 1));
      next?.addEventListener('click', () => setActive(activeIndex + 1));
    });
  </script>

  <style>
    .gallery-thumbnail[aria-pressed='true'] {
      border-color: #d8b456;
      box-shadow: 0 0 0 1px #d8b456;
    }

    details summary::-webkit-details-marker {
      display: none;
    }
  </style>
</BaseLayout>
