  <script is:inline>
    const productTrackingData = {
      product_name: 'Premium 3-Piece Yoga Set',
      product_code: 'TZ3562-10',
    };

    const trackProductEvent = (eventName, parameters = {}) => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, { ...productTrackingData, ...parameters });
        return;
      }

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName, ...productTrackingData, ...parameters });
    };

    document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
      const mainImage = gallery.querySelector('[data-gallery-main]');
      const label = gallery.querySelector('[data-gallery-current-label]');
      const thumbnails = Array.from(gallery.querySelectorAll('[data-gallery-thumbnail]'));
      const previous = gallery.querySelector('[data-gallery-previous]');
      const next = gallery.querySelector('[data-gallery-next]');
      let activeIndex = 0;

      const setActive = (index) => {
        if (!mainImage || thumbnails.length === 0) return;
        activeIndex = (index + thumbnails.length) % thumbnails.length;
        const active = thumbnails[activeIndex];
        mainImage.src = active.dataset.gallerySrc;
        mainImage.alt = active.dataset.galleryAlt;
        if (label) label.textContent = active.dataset.galleryLabel;
        thumbnails.forEach((button, buttonIndex) => {
          button.setAttribute('aria-pressed', buttonIndex === activeIndex ? 'true' : 'false');
        });
        trackProductEvent('select_product_image', { image_position: String(activeIndex + 1) });
      };

      thumbnails.forEach((button, index) => button.addEventListener('click', () => setActive(index)));
      previous?.addEventListener('click', () => setActive(activeIndex - 1));
      next?.addEventListener('click', () => setActive(activeIndex + 1));
    });

    const form = document.querySelector('[data-product-inquiry-form]');
    const status = document.querySelector('[data-product-form-status]');
    const pageUrlInput = form?.querySelector('[data-page-url]');
    let inquiryStarted = false;

    if (form && pageUrlInput) {
      pageUrlInput.value = window.location.href;
      trackProductEvent('view_product');

      form.addEventListener('focusin', () => {
        if (!inquiryStarted) {
          inquiryStarted = true;
          trackProductEvent('start_product_inquiry');
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = form.elements.namedItem('email');
        const phone = form.elements.namedItem('phone');
        const submitButton = form.querySelector('button[type="submit"]');

        if (!email?.value.trim() && !phone?.value.trim()) {
          if (status) {
            status.textContent = 'Please enter a business email or WhatsApp number so our team can reply.';
            status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-sans';
          }
          email?.focus();
          return;
        }

        if (!form.reportValidity()) return;
        const originalLabel = submitButton?.textContent || 'Send Product Inquiry';
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending inquiry...';
        }
        if (status) {
          status.textContent = 'Sending your product inquiry...';
          status.className = 'text-[13px] text-white/60 sm:col-span-2 font-sans';
        }

        try {
          const response = await fetch('/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.');

          trackProductEvent('submit_product_inquiry');
          form.reset();
          pageUrlInput.value = window.location.href;
          if (status) {
            status.textContent = 'Thank you. Your inquiry has been sent. The Fitclo team will reply with current details.';
            status.className = 'text-[13px] text-[#c6e4ae] sm:col-span-2 font-sans';
          }
          if (submitButton) submitButton.textContent = 'Inquiry Sent';
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp instead.';
            status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-sans';
          }
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        }
      });
    }
  </script>

