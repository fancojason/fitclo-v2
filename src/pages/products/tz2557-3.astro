---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWhatsAppUrl } from '../../lib/whatsapp';
import { productThumbnail } from '../../lib/product-thumbnail';

const sku = 'TZ2557-3';
const productName = 'Backless Halter Sports Bra & Flare Pants Set';
const url = 'https://www.fitcloo.com/products/tz2557-3/';
const imageRoot = '/images/products/TZ2557-3/';
const images = [
  { file: 'tz2557-3-cover.webp', alt: 'TZ2557-3 halter bra and flare pants in Date Brown and Delicate Red, front and back', label: 'Product cover' },
  { file: 'tz2557-3-feature-guide.webp', alt: 'Delicate Red halter sports bra and high-waist flare pants with back strap and design details', label: 'Design features' },
  { file: 'tz2557-3-matching-series.webp', alt: 'Matching series reference with additional tops, shorts and leggings, not included in this two-piece set', label: 'Matching series reference' },
  { file: 'tz2557-3-graish-blue-front.webp', alt: 'Graish Blue halter bra and flare yoga pants, front view', label: 'Graish Blue front' },
  { file: 'tz2557-3-date-brown-front.webp', alt: 'Date Brown halter bra and flare yoga pants, front view', label: 'Date Brown front' },
  { file: 'tz2557-3-black-back.webp', alt: 'Black halter bra open back and high-waist flare pants, back view', label: 'Black back view' },
  { file: 'tz2557-3-color-chart.webp', alt: 'TZ2557-3 color chart: Pink Drink, Graish Blue, Delicate Red, Date Brown and Black', label: 'Color chart' },
  { file: 'tz2557-3-construction-details.webp', alt: 'Close-up views of halter strap, bra and flare pants waistband and hems', label: 'Construction details' },
  { file: 'tz2557-3-fabric-detail.webp', alt: 'Close-up of seamless knitted polyamide elastane fabric', label: 'Fabric close-up' },
].map((image) => ({ ...image, src: imageRoot + image.file }));
const colors = ['Pink Drink', 'Graish Blue', 'Delicate Red', 'Date Brown', 'Black'];
const facts = [
  ['Style', 'Halter sports bra + high-waist flare pants'],
  ['Fabric', '90% Polyamide / 10% Elastane; seamless knitted nylon-spandex fabric'],
  ['Sizes', 'S / M / L / XL'],
  ['Colors shown', colors.join(' / ')],
  ['Stock & MOQ', 'Ready stock; 50 sets'],
  ['Features', 'Breathable, Quick Dry, Lightweight'],
];
const specifications = [
  ['Model', sku, 'Set includes', 'Halter sports bra + flare pants'],
  ['Fabric', '90% Polyamide / 10% Elastane, seamless knitted nylon-spandex fabric', 'Feature', 'Breathable, Quick Dry, Lightweight'],
  ['Sizes', 'S / M / L / XL', 'MOQ', '50 sets'],
  ['Bra', 'Halter strap, open back and removable padding shown in the supplied product guide', 'Pants', 'High-waist waistband and flared leg'],
  ['Colors', colors.join(', '), 'Stock', 'Ready stock; confirm current color and size availability'],
];
const faqs = [
  ['What comes in the TZ2557-3 set?', 'This two-piece set comprises the halter sports bra and matching high-waist flare pants. The matching-series picture also shows other tops, shorts and fitted leggings; those are styling references and are not included in this set.'],
  ['Is the bra backless?', 'The halter bra has an open-back design with a narrow back strap, as shown in the product images. Ask for a sample to assess support and coverage for your intended use; no high-impact support rating is specified.'],
  ['Are the pants flared or straight?', 'They are high-waist flare pants: the leg widens toward the hem. The color chart shows Pink Drink, Graish Blue, Delicate Red, Date Brown and Black.'],
  ['What fabric and sizes are specified?', 'The supplied specification is 90% Polyamide / 10% Elastane seamless knitted nylon-spandex fabric in S, M, L and XL. The listed features are Breathable, Quick Dry and Lightweight.'],
  ['What is the wholesale minimum order?', 'The ready-stock MOQ is 50 sets. Send your preferred colors, size breakdown and destination so Fitclo can confirm current availability and a quote.'],
];
const productSchema = {
  '@context': 'https://schema.org', '@type': 'Product', '@id': url + '#product',
  name: productName, sku, mpn: sku, url,
  description: 'TZ2557-3 two-piece seamless knit yoga set with a backless halter sports bra and high-waist flare pants. 90% Polyamide / 10% Elastane; sizes S, M, L, XL; wholesale MOQ 50 sets.',
  image: images.slice(0, 3).map(({ src }) => 'https://www.fitcloo.com' + src),
  brand: { '@type': 'Brand', name: 'Fitclo' }, category: 'Matching Sets / Yoga Sets',
  material: '90% Polyamide / 10% Elastane, seamless knitted nylon-spandex fabric',
  size: ['S', 'M', 'L', 'XL'], color: colors,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Feature', value: 'Breathable, Quick Dry, Lightweight' },
    { '@type': 'PropertyValue', name: 'MOQ', value: '50 sets' },
  ],
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
  { '@type': 'ListItem', position: 2, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' },
  { '@type': 'ListItem', position: 3, name: productName, item: url },
] };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
const whatsappUrl = getWhatsAppUrl({ productCode: sku, productName });
---

<BaseLayout whatsappProductCode={sku} whatsappProductName={productName}
  title="Backless Halter Bra & Flare Pants Set TZ2557-3 | Wholesale Fitclo"
  description="TZ2557-3 seamless knitted halter sports bra and high-waist flare pants set. 90% polyamide/10% elastane, S–XL, ready stock, MOQ 50 sets. Request a wholesale quote."
  canonicalURL={url}
  image={'https://www.fitcloo.com' + images[0].src}
  structuredData={[productSchema, breadcrumbSchema, faqSchema]}
  autoArticleSchema={false}
  includeBreadcrumbSchema={false}
>
  <main class="bg-[#090a0c] text-white">
    <section class="pt-[112px]">
      <div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10">
        <nav class="flex flex-wrap gap-2 text-[12px] text-white/55" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#d8b456]">Home</a><span>/</span>
          <a href="/products/matching-sets/" class="hover:text-[#d8b456]">Matching Sets</a><span>/</span><span>{sku}</span>
        </nav>
        <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(0,.92fr)_minmax(0,1.08fr)] lg:gap-16">
          <div class="min-w-0" data-product-gallery>
            <div class="aspect-square overflow-hidden border border-white/15 bg-[#111218]">
              <img src={images[0].src} alt={images[0].alt} class="h-full w-full object-contain" width="800" height="800" fetchpriority="high" data-gallery-main />
            </div>
            <div class="mt-4 grid grid-cols-5 gap-2 sm:grid-cols-6">
              {images.map((image, index) => <button type="button" class:list={['aspect-square overflow-hidden border bg-[#111218] hover:border-[#d8b456]', index === 0 ? 'border-[#d8b456]' : 'border-white/20']} data-gallery-thumb data-src={image.src} data-alt={image.alt} data-label={image.label} aria-label={`Show ${image.label}`}>
                <img src={image.src} {...(index === 0 ? {} : productThumbnail(image.src))} alt="" class="h-full w-full object-contain" loading="lazy" />
              </button>)}
            </div>
            <p class="mt-3 text-[12px] text-white/55" data-gallery-label>{images[0].label}</p>
            <p class="mt-2 text-[12px] leading-relaxed text-white/55">The matching-series image includes optional separate styles for reference. This set includes the halter bra and flare pants only.</p>
          </div>
          <div>
            <p class="text-[11px] font-bold tracking-[.2em] text-[#d8b456]">READY STOCK · WHOLESALE ACTIVEWEAR</p>
            <h1 class="mt-5 text-[38px] font-bold leading-[1.08] sm:text-[50px]">{productName}</h1>
            <p class="mt-3 text-[15px] font-semibold text-[#d8b456]">Style {sku}</p>
            <p class="mt-6 max-w-[660px] text-[16px] leading-[1.75] text-white/75">A two-piece women's yoga and workout set pairing an open-back halter sports bra with high-waist flare pants. The wide ribbed waistband and flared leg give it a distinct studio-to-athleisure profile. The supplied specification is seamless knitted 90% Polyamide / 10% Elastane.</p>
            <dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2">{facts.map(([label, value]) => <div><dt class="text-[11px] font-bold tracking-[.12em] text-[#d8b456]">{label}</dt><dd class="mt-2 text-[14px] leading-[1.55] text-white/85">{value}</dd></div>)}</dl>
            <div class="mt-8 flex flex-wrap gap-3"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full bg-[#d8b456] px-6 text-[13px] font-bold text-[#101010]">Request Wholesale Quote</a><a href="#product-inquiry" class="inline-flex min-h-12 items-center rounded-full border border-white/35 px-6 text-[13px] font-bold">Send Product Inquiry</a></div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 py-16 lg:py-20">
      <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10">
        <div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER SUMMARY</p><h2 class="mt-4 text-[30px] font-bold leading-[1.15] sm:text-[38px]">A halter bra and flare-pants set for yoga collections.</h2></div>
        <div class="border-l-2 border-[#d8b456] pl-6 text-[16px] leading-[1.8] text-white/75">
          <p>Buyers looking for a backless activewear set, halter sports bra with flare leggings, or seamless knit yoga outfit can compare the front, back, construction and five supplied colorways on this page. The halter strap and narrow back band create the open-back look; the pants retain a high waist and widen toward the hem.</p>
          <p class="mt-4">For yoga, Pilates, fitness or athleisure assortments, request a sample to assess the fit, coverage and support required for your customers. No support-impact rating or opacity test is specified.</p>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-20">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
        <p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT SPECIFICATIONS</p>
        <h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">TZ2557-3 specifications</h2>
        <div class="mt-8 overflow-x-auto border border-white/20"><table class="min-w-[760px] w-full border-collapse text-left"><tbody>{specifications.map(([a,b,c,d]) => <tr class="border-b border-white/15 last:border-0"><th class="w-[17%] bg-[#15171c] px-4 py-4 text-[12px] font-bold text-[#d8b456]">{a}</th><td class="w-[33%] px-4 py-4 text-[14px] leading-[1.6] text-white/75">{b}</td><th class="w-[17%] bg-[#15171c] px-4 py-4 text-[12px] font-bold text-[#d8b456]">{c}</th><td class="w-[33%] px-4 py-4 text-[14px] leading-[1.6] text-white/75">{d}</td></tr>)}</tbody></table></div>
        <div class="mt-12"><h3 class="text-[24px] font-bold">Color and construction views</h3><p class="mt-3 max-w-[760px] text-[14px] leading-[1.7] text-white/60">These supplied images show the remaining product angles, color chart, bra strap, waistband, flare hem and fabric. Confirm the current color and size mix before ordering.</p>
          <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{images.slice(3).map((image) => <figure class="border border-white/15 bg-[#111218] p-2"><img src={image.src} alt={image.alt} class="h-auto w-full object-contain" loading="lazy" /><figcaption class="px-2 py-3 text-[12px] text-white/60">{image.label}</figcaption></figure>)}</div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">SOURCING NOTES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">What to confirm before placing an order</h2><div class="mt-9 grid gap-5 md:grid-cols-3">
      {[
        ['01', 'Color and size mix', 'Choose from the pictured colors and send the S/M/L/XL quantity breakdown. Current availability should be confirmed for each variant.'],
        ['02', 'Sample and fit', 'Review bra coverage, removable padding, back strap fit, waistband comfort and flare length against your market needs.'],
        ['03', 'Branding requirements', 'Share any logo, label, hang-tag or packaging brief. Fitclo can review the available private-label or OEM route separately from the stock set.'],
      ].map(([n, title, copy]) => <article class="border-t-2 border-[#d8b456] pt-5"><span class="text-[12px] font-bold text-[#d8b456]">{n}</span><h3 class="mt-4 text-[19px] font-bold">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">{copy}</p></article>)}
    </div></div></section>

    <section class="py-16 lg:py-20"><div class="mx-auto max-w-[900px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER FAQ</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Questions about TZ2557-3</h2><div class="mt-8 divide-y divide-white/15 border-y border-white/15">{faqs.map(([question, answer]) => <div class="py-6"><h3 class="text-[17px] font-bold">{question}</h3><p class="mt-3 text-[14px] leading-[1.75] text-white/65">{answer}</p></div>)}</div></div></section>

    <section id="product-inquiry" class="border-t border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.8fr_1.2fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">REQUEST A QUOTE</p><h2 class="mt-4 text-[32px] font-bold leading-[1.16] sm:text-[42px]">Ask about colors, samples and pricing.</h2><p class="mt-5 text-[15px] leading-[1.75] text-white/65">Tell us your destination, quantities and preferred colors. Your inquiry will include style {sku}.</p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 items-center border border-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#d8b456]">Ask on WhatsApp</a></div>
      <form class="grid gap-5 border border-white/15 bg-[#0d0f13] p-6 sm:grid-cols-2 sm:p-8" data-product-inquiry-form>
        <input type="hidden" name="product_name" value={productName} /><input type="hidden" name="product_code" value={sku} /><input type="hidden" name="product_type" value={`${productName} (${sku})`} /><input type="hidden" name="page_url" value={url} data-page-url />
        <label class="text-[12px] font-bold">NAME *<input name="name" required class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold">COMPANY<input name="company" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold">BUSINESS EMAIL<input name="email" type="email" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold">WHATSAPP / PHONE<input name="phone" type="tel" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold">COUNTRY / REGION<input name="country" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold">ESTIMATED QUANTITY<input name="quantity" placeholder="For example: 50 sets" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold sm:col-span-2">COLORS & SIZES<input name="colors_sizes" placeholder="Preferred colors and size mix" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white" /></label>
        <label class="text-[12px] font-bold sm:col-span-2">MESSAGE<textarea name="message" rows="4" class="mt-2 w-full border border-white/20 bg-[#090a0c] px-4 py-3 text-white"></textarea></label>
        <button type="submit" class="min-h-12 bg-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#101010] sm:col-span-2">Send Product Inquiry</button>
        <p class="hidden text-[13px] sm:col-span-2" data-product-form-status aria-live="polite"></p>
      </form>
    </div></section>
  </main>
</BaseLayout>

<script>
  import { submitInquiry } from '../../lib/inquiry-client';
  const gallery = document.querySelector<HTMLElement>('[data-product-gallery]');
  if (gallery) {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const label = gallery.querySelector<HTMLElement>('[data-gallery-label]');
    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((button) => button.addEventListener('click', () => {
      if (main) { main.src = button.dataset.src || main.src; main.alt = button.dataset.alt || main.alt; }
      if (label) label.textContent = button.dataset.label || '';
      gallery.querySelectorAll('[data-gallery-thumb]').forEach((item) => item.classList.toggle('border-[#d8b456]', item === button));
    }));
  }
  const form = document.querySelector<HTMLFormElement>('[data-product-inquiry-form]');
  const status = form?.querySelector<HTMLElement>('[data-product-form-status]');
  const pageUrl = form?.querySelector<HTMLInputElement>('[data-page-url]');
  if (form && pageUrl) {
    pageUrl.value = location.href;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const phone = form.elements.namedItem('phone') as HTMLInputElement;
      if (!email.value.trim() && !phone.value.trim()) { if (status) { status.textContent = 'Enter a business email or WhatsApp number so we can reply.'; status.className = 'text-[13px] text-red-300 sm:col-span-2'; } email.focus(); return; }
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) { button.disabled = true; button.textContent = 'Sending inquiry...'; }
      try {
        const response = await submitInquiry(Object.fromEntries(new FormData(form).entries()));
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.');
        form.reset(); pageUrl.value = location.href;
        if (status) { status.textContent = 'Thank you. Your inquiry has been sent.'; status.className = 'text-[13px] text-green-300 sm:col-span-2'; }
        if (button) button.textContent = 'Inquiry Sent';
      } catch (error) {
        if (status) { status.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp.'; status.className = 'text-[13px] text-red-300 sm:col-span-2'; }
        if (button) { button.disabled = false; button.textContent = 'Send Product Inquiry'; }
      }
    });
  }
</script>
