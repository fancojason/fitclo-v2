---
import { productThumbnail } from '../../lib/product-thumbnail';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fixedProductGalleryImages } from '../../data/productGalleryDefaults';
const productName = 'Color Block Workout Set: Double-Strap Crop Tank & Fold-Over Flare Pants';
const productCode = 'TZ2570-4';
const productUrl = 'https://www.fitcloo.com/products/tz2570-4/';
const coverImage = "/images/products/TZ2570-4/contrast-trim-tank-flare-pants-set-tz2570-4.webp";
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(`Hello Fitclo, I am interested in ${productCode}, the color-block crop tank and fold-over flare pants set. Please confirm colors, sizes, MOQ, sample options and wholesale pricing.`)}`;
const galleryImages = [...[{"src": "/images/products/TZ2570-4/contrast-trim-tank-flare-pants-set-tz2570-4.webp", "alt": "TZ2570-4 color-block double-strap tank and fold-over flare pants set", "label": "Product cover"}, {"src": "/images/products/TZ2570-4/tz2570-4-feature-guide.webp", "alt": "Double-strap crop tank and fold-over waistband design guide", "label": "Design features"}, {"src": "/images/products/TZ2570-4/tz2570-4-matching-series.webp", "alt": "Matching series reference; additional separates are not included", "label": "Matching series reference"}], ...fixedProductGalleryImages];
const detailImages = [["/images/products/TZ2570-4/tz2570-4-black-front.webp", "Black color-block tank and flare pants set, front view"], ["/images/products/TZ2570-4/tz2570-4-black-coffee-front.webp", "Black Coffee crop tank and fold-over flare pants, front view"], ["/images/products/TZ2570-4/tz2570-4-blue-ribbon-back.webp", "Blue Ribbon double-strap crop tank and flare pants, back view"], ["/images/products/TZ2570-4/tz2570-4-construction-details.webp", "TZ2570-4 neckline, fold-over waist, lining and flared hem details"], ["/images/products/TZ2570-4/tz2570-4-color-chart.webp", "TZ2570-4 Black, Pencil Gray, Blue Ribbon and Black Coffee color chart"], ["/images/products/TZ2570-4/tz2570-4-nylon-spandex-fabric.webp", "Nylon-spandex bare-skin fabric with soft four-way stretch"]];
const quickFacts = [["Set includes", "Double-strap crop tank top + fold-over waist flare pants"], ["Colors", "Black / Pencil Gray / Blue Ribbon / Black Coffee"], ["Fabric", "78% Nylon / 22% Spandex, bare-skin fabric"], ["Sizes", "S / M / L / XL"], ["Stock & MOQ", "Ready stock; 50 sets"], ["Branding", "Discuss logo, labels, hang tags and packaging"]];
const specifications = [["Model", "TZ2570-4", "Product Type", "2-piece color-block workout set"], ["Fabric", "78% Nylon / 22% Spandex, bare-skin fabric", "Feature", "Breathable, Quick Dry, Lightweight"], ["Sizes", "S / M / L / XL", "MOQ", "50 sets"], ["Top", "Double-strap crop tank with contrast neckline", "Pants", "Contrast fold-over waistband and flared legs"], ["Colors", "Black, Pencil Gray, Blue Ribbon, Black Coffee", "Stock", "Ready stock; confirm current color and size availability"], ["Private Label", "Logo, labels, hang tags and packaging by request", "Sample", "Contact Fitclo to confirm sample options"]];
const faqs = [["What is included in the TZ2570-4 two-piece workout set?", "The set includes a double-strap crop tank top and matching fold-over waist flare yoga pants. The matching-series image also shows a bandeau top and shorts for reference; those additional separates are not included in this two-piece set."], ["What fabric is used?", "TZ2570-4 uses 78% Nylon / 22% Spandex bare-skin fabric with a soft feel and four-way stretch. Its specified features are Breathable, Quick Dry and Lightweight."], ["What makes this a color-block yoga set?", "Contrasting straps and neckline trim create a layered look on the crop tank. The pants repeat the contrast color in the wide fold-over waistband."], ["Is the waistband fold-over, and are the pants flared?", "Yes. The pants have a contrast fold-over waistband and legs that widen toward the hem. Ask for garment measurements to review the rise, inseam and fit."], ["Which sizes and colors can I request?", "Sizes are S, M, L and XL. The supplied color chart lists Black, Pencil Gray, Blue Ribbon and Black Coffee. Confirm the current availability of your chosen color and size mix."], ["Can I source this set for yoga, Pilates or an athleisure collection?", "The soft-stretch tank-and-flare-pants design is an option for yoga, Pilates and athleisure ranges. Review a sample for the movement, fit and coverage your customers need; no high-impact support rating is specified."], ["What is the wholesale MOQ?", "TZ2570-4 is a ready-stock style with an MOQ of 50 sets. Confirm the allocation across colors and sizes and any separate branding requirements when requesting a quote."], ["Can I add my brand or request an OEM version?", "Contact Fitclo about logo placement, labels, hang tags and packaging for the stock style. For a custom version, share your design, color references, sizing and quantities so feasibility, MOQ and sampling can be quoted."]];
const designFeatures = [["Double-strap layered neckline", "Contrast double straps and a mock-layered neckline add definition to the cropped tank without changing the two-piece outfit into a multi-top bundle."], ["Contrast fold-over waist", "The wide contrasting waistband repeats the top’s color accent and creates the fold-waist look shown in the product images."], ["Soft-stretch flare silhouette", "The 78% nylon / 22% spandex bare-skin fabric offers a soft feel and four-way stretch, while the flared hem gives the outfit its distinct shape."]];
const productSchema = { '@context':'https://schema.org', '@type':'Product', '@id':`${productUrl}#product`, name:productName, description:'TZ2570-4 two-piece color-block workout set with a double-strap crop tank and fold-over waist flare yoga pants. 78% Nylon / 22% Spandex bare-skin fabric, sizes S/M/L/XL, ready-stock wholesale MOQ 50 sets.', url:productUrl, image:galleryImages.slice(0,3).map(image=>`https://www.fitcloo.com${image.src}`), sku:productCode, mpn:productCode, material:'78% Nylon / 22% Spandex, bare-skin fabric', size:['S','M','L','XL'], color:['Black','Pencil Gray','Blue Ribbon','Black Coffee'], brand:{'@type':'Brand',name:'Fitclo'}, category:'Matching Sets / Yoga Sets', additionalProperty:[{'@type':'PropertyValue',name:'Feature',value:'Breathable, Quick Dry, Lightweight'},{'@type':'PropertyValue',name:'MOQ',value:'50 sets'}] };
const breadcrumbSchema = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:'https://www.fitcloo.com/'},{'@type':'ListItem',position:2,name:'Matching Sets',item:'https://www.fitcloo.com/products/matching-sets/'},{'@type':'ListItem',position:3,name:productName,item:productUrl}] };
const faqSchema = { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}})) };
const sections = [['SAMPLING & ORDER PROCESS','From your shortlist to a confirmed order.',[['01','Product review','Share SKU TZ2570-4, quantity, destination and color preferences.'],['02','Sample planning','Confirm sample options and the required size.'],['03','Sample review','Review fit, coverage, fabric feel and branding.'],['04','Order confirmation','Confirm available variants, quantities, branding and timing.'],['05','Inspection & shipping','Agree inspection, packing and delivery requirements.']]]];
---


<BaseLayout title="Color Block Flare Yoga Set TZ2570-4 | Wholesale FITCLO" description="TZ2570-4 color-block workout set: double-strap crop tank and fold-over flare pants. 78% nylon/22% spandex, S–XL, ready stock, MOQ 50 sets. Request a quote." canonicalURL={productUrl} image={`https://www.fitcloo.com${coverImage}`} structuredData={[productSchema, breadcrumbSchema, faqSchema]} autoArticleSchema={false} includeBreadcrumbSchema={false}>
  <main class="bg-[#090a0c] text-white">
    <section class="pt-[112px]"><div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20">
      <nav class="flex flex-wrap gap-2 text-[12px] text-white/55" aria-label="Breadcrumb"><a href="/" class="hover:text-[#d8b456]">Home</a><span>/</span><a href="/products/" class="hover:text-[#d8b456]">Products</a><span>/</span><a href="/products/matching-sets/" class="hover:text-[#d8b456]">Matching Sets</a><span>/</span><span>{productName}</span></nav>
      <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(400px,.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16" data-product-gallery>
        <figure class="min-w-0"><div class="aspect-square overflow-hidden border border-white/15 bg-[#111218]"><img src={galleryImages[0].src} alt={galleryImages[0].alt} class="h-full w-full object-contain" width="800" height="800" fetchpriority="high" data-gallery-main /></div><div class="mt-4 grid grid-cols-[32px_repeat(5,minmax(0,1fr))_32px] items-center gap-2 sm:grid-cols-[40px_repeat(5,minmax(0,1fr))_40px]"><button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-previous>&lsaquo;</button>{galleryImages.map((image, index) => <button type="button" class:list={['gallery-thumbnail aspect-square overflow-hidden border bg-[#111218] hover:border-[#d8b456]', index === 0 ? 'border-[#d8b456]' : 'border-white/20']} data-gallery-thumb data-src={image.src} data-alt={image.alt} data-label={image.label} aria-label={`Show ${image.label}`}><img src={image.src} {...(index === 0 ? {} : productThumbnail(image.src))} alt="" class="h-full w-full object-cover" loading="lazy" /></button>)}<button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-next>&rsaquo;</button></div><figcaption class="mt-4 flex justify-between gap-5 border-t border-white/15 pt-4"><span class="text-[12px] font-bold" data-gallery-label>{galleryImages[0].label}</span><span class="text-right text-[11px] text-white/45">Style code<br />{productCode}</span></figcaption><p class="mt-3 text-[12px] leading-relaxed text-white/60">The matching-series image includes other separates for reference. TZ2570-4 includes the double-strap tank and flare pants only.</p></figure>
        <div class="pt-1"><p class="text-[11px] font-bold tracking-[.2em] text-[#d8b456]">READY STOCK &bull; PRIVATE LABEL &bull; OEM</p><h1 class="mt-5 text-[38px] font-bold leading-[1.06] sm:text-[50px]">{productName}</h1><p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75">A 2-piece color-block workout set with a double-strap crop tank top and fold-waist flare yoga pants. Soft-stretch bare-skin fabric, a mock-layered neckline and a contrasting waistband bring a coordinated look to yoga, Pilates and athleisure collections.</p><dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">{quickFacts.map(([label, value]) => <div><dt class="text-[10px] font-bold tracking-[.15em] text-[#d8b456]">{label}</dt><dd class="mt-2 text-[13px] leading-[1.55] text-white/85">{value}</dd></div>)}</dl><div class="mt-8 flex flex-wrap items-center gap-3"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full bg-[#d8b456] px-6 text-[13px] font-bold text-[#101010]">Request Wholesale Quote</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full border border-white/35 px-6 text-[13px] font-bold">Request a {productCode} Sample</a><a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456]">View Customization Options <span class="ml-2">&rarr;</span></a></div></div>
      </div>
    </div></section>

    <section class="border-y border-white/10 py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER SUMMARY</p><h2 class="mt-4 max-w-[470px] text-[30px] font-bold leading-[1.16] sm:text-[38px]">TZ2570-4 for color-block yoga and Pilates collections.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[16px] leading-[1.8] text-white/75">The double-strap crop top and fold-over flare yoga pants form a coordinated two-piece outfit. Contrast trim outlines the neckline and square back, while a wide contrasting waistband links the top and pants visually.</p><p class="mt-4 text-[16px] leading-[1.8] text-white/75">Source this ready-stock style for a soft-stretch gym outfit or a fashion-led studio range. Start with the four listed sizes and the supplied color chart, then confirm your size mix, samples and branding before ordering. Browse <a href="/products/matching-sets/" class="text-[#d8b456]">matching sets</a> or our <a href="/blogs/polka-dot-contrast-trim-activewear-wholesale/" class="text-[#d8b456]">contrast-trim activewear buying guide</a> for related options.</p></div></div></section>

    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT SPECIFICATIONS</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Product specifications</h2></div><p class="max-w-[420px] text-[14px] leading-[1.65] text-white/60">Confirmed product information and customization points for style {productCode}.</p></div><div class="mt-9 overflow-x-auto border border-white/25 bg-[#0d0f13]"><table class="min-w-[920px] w-full border-collapse text-left"><tbody>{specifications.map(([leftLabel, leftValue, rightLabel, rightValue]) => <tr class="border-b border-white/15 last:border-b-0"><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{leftLabel}</th><td class="w-[34%] border-r border-white/15 px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{leftValue}</td><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{rightLabel}</th><td class="w-[34%] px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{rightValue}</td></tr>)}</tbody></table></div><div class="mt-12 border-t border-white/15 pt-8"><div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT DETAILS</p><h3 class="mt-3 text-[24px] font-bold">Colorway, fit and construction views.</h3></div><p class="max-w-[420px] text-[13px] leading-[1.65] text-white/55">The supplied product imagery shows color options, front and back views, fabric and construction details in a three-column layout.</p></div><div class="mt-7 grid gap-4 md:grid-cols-3">{detailImages.map(([src, alt]) => <figure class="overflow-hidden border border-white/15 bg-[#111218] p-2"><img src={src} alt={alt} class="h-auto w-full object-contain" loading="lazy" /></figure>)}</div></div></div></section>

    <section class="py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">KEY DESIGN FEATURES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Design details that define this color-block set.</h2><div class="mt-10 grid gap-7 md:grid-cols-3">{designFeatures.map(([title, text], index) => <article class="border-t-2 border-[#d8b456] pt-5"><p class="text-[12px] font-bold text-[#d8b456]">0{index + 1}</p><h3 class="mt-4 text-[19px] font-bold">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>

    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">THREE WAYS TO ORDER</p><h2 class="mt-4 max-w-[700px] text-[30px] font-bold sm:text-[38px]">Choose the route that fits your launch plan.</h2><div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">{[['01 - READY STOCK WHOLESALE', 'For confirmed existing colors and sizes', 'Discuss current availability, size mix and delivery requirements with Fitclo.'], ['02 - STOCK STYLE + PRIVATE LABEL', 'For a faster branded launch', 'Add logo, labels, hang tags or packaging to the selected style after review.'], ['03 - FULL OEM DEVELOPMENT', 'For a custom product program', 'Discuss color, fit, sizing, construction and packaging requirements for your project.']].map(([number, title, text]) => <article class="bg-[#111218] p-7"><p class="text-[11px] font-bold tracking-[.15em] text-[#d8b456]">{number}</p><h3 class="mt-4 text-[20px] font-bold">{title}</h3><p class="mt-4 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>

    <section id="customization" class="py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRIVATE LABEL &amp; CUSTOMIZATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Make this color-block set recognizably yours.</h2><p class="mt-5 text-[15px] leading-[1.75] text-white/65">Fitclo can apply branding to TZ2570-4 or review your brief for a custom activewear development project.</p></div><div class="grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2">{[['Logo application', 'Front, back, waist, legs, etc.'], ['Labels', 'Brand label, care label or woven label'], ['Packaging', 'Hang tags and packaging options'], ['Color direction', 'Supplied colors or custom color direction'], ['Fabric review', '78% Nylon / 22% Spandex, bare-skin fabric'], ['Fit development', 'Custom fit and size grading discussion']].map(([label, value]) => <div class="bg-[#111218] p-5"><h3 class="text-[15px] font-bold">{label}</h3><p class="mt-2 text-[13px] leading-[1.6] text-white/65">{value}</p></div>)}</div></div></section>

    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">FABRIC &amp; QUALITY INFORMATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Confirm construction before commitment.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[17px] leading-[1.75] text-white/80">TZ2570-4 uses 78% Nylon / 22% Spandex, bare-skin fabric.</p><p class="mt-4 text-[14px] leading-[1.7] text-white/65">A sample review lets your team assess fit, workmanship and branding direction against the selected product before bulk production confirmation.</p></div></div></section>

    {sections.map(([eyebrow, title, steps]) => <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">{eyebrow}</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">{title}</h2><ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-5">{steps.map(([number, stepTitle, text]) => <li class="border-t border-[#d8b456] pt-5"><span class="text-[12px] font-bold text-[#d8b456]">{number}</span><h3 class="mt-4 text-[18px] font-bold">{stepTitle}</h3><p class="mt-3 text-[13px] leading-[1.65] text-white/65">{text}</p></li>)}</ol></div></section>)}
    <section class="border-b border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">QUALITY EVIDENCE</p><h2 class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px]">Make decisions against the approved product.</h2></div><ul class="grid gap-4 border-l border-white/20 pl-6 text-[14px] leading-[1.65] text-white/70"><li>Sample review provides a checkpoint for fit, workmanship and branding direction.</li><li>Confirm color, size mix and private-label requirements for the selected order route before proceeding.</li><li>For full OEM, the approved sample and project requirements guide the bulk production plan.</li></ul></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">SHIPPING &amp; PAYMENT</p><h2 class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px]">Plan the order around your destination.</h2></div><div class="grid gap-5 sm:grid-cols-2"><div class="border-t-2 border-[#d8b456] pt-5"><h3 class="text-[18px] font-bold">Worldwide logistics</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">Express, air and sea shipping can be arranged after the destination, order quantity and delivery requirements are confirmed.</p></div><div class="border-t-2 border-[#d8b456] pt-5"><h3 class="text-[18px] font-bold">Order confirmation</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">Payment methods are T/T, Credit Card and PayPal. The appropriate payment route is confirmed with your order details.</p></div></div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[900px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER FAQ</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Questions buyers ask before ordering.</h2><div class="mt-9 border-y border-white/15">{faqs.map(([question, answer]) => <details class="group border-b border-white/15 last:border-b-0"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-[16px] font-bold"><span>{question}</span><span class="text-[#d8b456] group-open:rotate-45">+</span></summary><p class="max-w-[780px] pb-6 text-[14px] leading-[1.75] text-white/65">{answer}</p></details>)}</div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">RELATED GUIDES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Continue your sourcing research.</h2></div><a href="/blogs/" class="text-[13px] font-bold text-[#d8b456]">Explore all guides &rarr;</a></div><div class="mt-9 grid gap-5 md:grid-cols-3">{[['/guides/yoga-sets/', 'Yoga Sets Sourcing Guide', 'Compare the sourcing questions that shape a yoga set program.'], ['/private-label/', 'Private Label Activewear', 'Review logo, label and packaging options for an activewear collection.'], ['/blogs/activewear-sizing-and-grading-guide/', 'Activewear Sizing & Grading Guide', 'Understand size grading questions before building your next activewear collection.']].map(([href, title, text]) => <a href={href} class="group border border-white/15 p-6 hover:border-[#d8b456]"><p class="text-[10px] font-bold tracking-[.16em] text-[#d8b456]">FITCLO INTELLIGENCE</p><h3 class="mt-4 text-[19px] font-bold leading-[1.3]">{title}</h3><p class="mt-3 text-[14px] leading-[1.65] text-white/65">{text}</p><span class="mt-6 inline-flex text-[13px] font-bold text-[#d8b456]">Read guide &rarr;</span></a>)}</div></div></section>
    <section id="product-inquiry" class="py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.8fr_1.2fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">REQUEST CURRENT DETAILS</p><h2 class="mt-4 text-[32px] font-bold leading-[1.16] sm:text-[42px]">Request the current colors, MOQ and wholesale quote.</h2><p class="mt-5 max-w-[450px] text-[15px] leading-[1.75] text-white/65">Send your quantity, color and size plan. Fitclo will confirm the most suitable sourcing route for {productName}, SKU {productCode}.</p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 items-center border border-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#d8b456] hover:bg-[#d8b456] hover:text-[#101010]">Ask about {productCode} on WhatsApp</a></div><form class="grid gap-5 border border-white/15 bg-[#111218] p-6 sm:grid-cols-2 sm:p-8" data-product-inquiry-form novalidate><input type="hidden" name="product_name" value={productName} /><input type="hidden" name="product_code" value={productCode} /><input type="hidden" name="product_type" value={`${productName} (${productCode})`} /><input type="hidden" name="page_url" value={productUrl} data-page-url /><div><label for="product-name" class="block text-[11px] font-bold tracking-[.12em]">NAME *</label><input id="product-name" name="name" type="text" required class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-company" class="block text-[11px] font-bold tracking-[.12em]">COMPANY</label><input id="product-company" name="company" type="text" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-email" class="block text-[11px] font-bold tracking-[.12em]">BUSINESS EMAIL OR WHATSAPP *</label><input id="product-email" name="email" type="email" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-phone" class="block text-[11px] font-bold tracking-[.12em]">WHATSAPP / PHONE</label><input id="product-phone" name="phone" type="tel" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-country" class="block text-[11px] font-bold tracking-[.12em]">COUNTRY / REGION</label><input id="product-country" name="country" type="text" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-type" class="block text-[11px] font-bold tracking-[.12em]">INQUIRY TYPE</label><select id="product-type" name="inquiry_type" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]"><option>Sample</option><option>Ready Stock</option><option>Private Label</option><option>Full OEM</option></select></div><div><label for="product-quantity" class="block text-[11px] font-bold tracking-[.12em]">ESTIMATED QUANTITY</label><input id="product-quantity" name="quantity" type="text" placeholder="For example: 200 sets" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div><label for="product-colors" class="block text-[11px] font-bold tracking-[.12em]">COLORS &amp; SIZES</label><input id="product-colors" name="colors_sizes" type="text" placeholder="Colors and size mix" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div class="sm:col-span-2"><label for="product-branding" class="block text-[11px] font-bold tracking-[.12em]">BRANDING REQUIREMENTS</label><input id="product-branding" name="branding_requirements" type="text" placeholder="Logo, labels, hang tags or packaging" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div class="sm:col-span-2"><label for="product-message" class="block text-[11px] font-bold tracking-[.12em]">MESSAGE</label><textarea id="product-message" name="message" rows="4" placeholder="Tell us your target launch date, reference requirements or questions." class="mt-2 w-full resize-y border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]"></textarea></div><div class="sm:col-span-2 flex flex-col gap-4 border-t border-white/15 pt-5 sm:flex-row sm:items-center sm:justify-between"><p class="text-[12px] leading-[1.55] text-white/50">Your inquiry will include {productName}, {productCode} and this page URL.</p><button type="submit" class="min-h-12 bg-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#101010]">Send Product Inquiry</button></div><p class="hidden text-[13px] sm:col-span-2" data-product-form-status aria-live="polite"></p></form></div></section>
  </main>
</BaseLayout>

<script>
  import { submitInquiry } from '../../lib/inquiry-client';
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => { const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]'); const label = gallery.querySelector<HTMLElement>('[data-gallery-label]'); const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')); let active = 0; const show = (index: number) => { active = (index + thumbs.length) % thumbs.length; const thumb = thumbs[active]; if (!main) return; main.src = thumb.dataset.src || main.src; main.alt = thumb.dataset.alt || main.alt; if (label) label.textContent = thumb.dataset.label || ''; thumbs.forEach((item, itemIndex) => { item.classList.toggle('border-[#d8b456]', itemIndex === active); item.classList.toggle('border-white/20', itemIndex !== active); }); }; thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index))); gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(active - 1)); gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(active + 1)); });
  const inquiryForm = document.querySelector<HTMLFormElement>('[data-product-inquiry-form]'); const inquiryStatus = document.querySelector<HTMLElement>('[data-product-form-status]'); const pageUrlInput = inquiryForm?.querySelector<HTMLInputElement>('[data-page-url]'); if (inquiryForm && pageUrlInput) { pageUrlInput.value = window.location.href; inquiryForm.addEventListener('submit', async (event) => { event.preventDefault(); const email = inquiryForm.elements.namedItem('email') as HTMLInputElement | null; const phone = inquiryForm.elements.namedItem('phone') as HTMLInputElement | null; const button = inquiryForm.querySelector<HTMLButtonElement>('button[type="submit"]'); if (!email?.value.trim() && !phone?.value.trim()) { if (inquiryStatus) { inquiryStatus.textContent = 'Please enter a business email or WhatsApp number so our team can reply.'; inquiryStatus.className = 'text-[13px] text-red-300 sm:col-span-2'; } email?.focus(); return; } if (!inquiryForm.reportValidity()) return; const originalText = button?.textContent || 'Send Product Inquiry'; if (button) { button.disabled = true; button.textContent = 'Sending inquiry...'; } try { const response = await submitInquiry(Object.fromEntries(new FormData(inquiryForm).entries())); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.'); inquiryForm.reset(); pageUrlInput.value = window.location.href; if (inquiryStatus) { inquiryStatus.textContent = 'Thank you. Your inquiry has been sent. The Fitclo team will reply with current details.'; inquiryStatus.className = 'text-[13px] text-green-300 sm:col-span-2'; } if (button) button.textContent = 'Inquiry Sent'; } catch (error) { if (inquiryStatus) { inquiryStatus.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp instead.'; inquiryStatus.className = 'text-[13px] text-red-300 sm:col-span-2'; } if (button) { button.disabled = false; button.textContent = originalText; } } }); }
</script>
