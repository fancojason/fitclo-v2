---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { fixedProductGalleryImages } from '../../data/productGalleryDefaults';

const productName = "Women's 3 Piece Activewear Set Jacket Leggings Bra";
const productCode = 'TZ4510-14';
const productUrl = 'https://www.fitcloo.com/products/tz4510-14/';
const coverImage = '/images/products/TZ4510-14/womens-three-piece-activewear-set-jacket-leggings-bra.webp';
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(`Hello Fitclo, I'm interested in ${productName} (${productCode}). Please send the current colors, MOQ, sample options and wholesale pricing.`)}`;
const galleryImages = [
  { src: coverImage, alt: "TZ4510-14 women's three piece activewear set with jacket, sports bra and leggings", label: 'Product cover' },
  { src: '/images/products/TZ4510-14/tz4510-14-jacket-bra-leggings-feature-guide.webp', alt: 'TZ4510-14 jacket, bra and legging feature guide', label: 'Jacket, bra and legging features' },
  { src: '/images/products/TZ4510-14/tz4510-14-matching-series.webp', alt: 'TZ4510-14 matching three piece yoga set series', label: 'Matching series' },
  ...fixedProductGalleryImages,
];
const detailImages = [
  ['/images/products/TZ4510-14/tz4510-14-aubergine-three-piece-set.webp', 'Aubergine TZ4510-14 three piece yoga set front view'],
  ['/images/products/TZ4510-14/tz4510-14-black-coffee-three-piece-set.webp', 'Black coffee TZ4510-14 three piece yoga set view'],
  ['/images/products/TZ4510-14/tz4510-14-black-back-view.webp', 'Black TZ4510-14 jacket and leggings back view'],
  ['/images/products/TZ4510-14/tz4510-14-zip-pocket-detail.webp', 'TZ4510-14 fitted jacket zip pocket detail'],
  ['/images/products/TZ4510-14/tz4510-14-color-chart.webp', 'TZ4510-14 available color chart'],
  ['/images/products/TZ4510-14/tz4510-14-construction-details.webp', 'TZ4510-14 collar, zip pocket, thumbhole and ruched bra construction details'],
];
const quickFacts = [
  ['Set includes', 'Fitted zip jacket + sports bra + high-waist leggings'],
  ['Colors shown', 'Green Sheen / Raspberry Red / Black Coffee / Aubergine / Black, etc.'],
  ['Fabric', 'Naked Feel 78% Nylon / 22% Spandex'],
  ['Sizes', 'S, M, L, XL + or Customization'],
  ['Branding', 'Logo, labels, hang tags, packaging, etc.'],
  ['MOQ', '50 Sets'],
];
const specificationRows = [
  ['Product Type', '3 Piece Activewear Set', 'Sample', 'Available before bulk production'],
  ['Fabric', 'Naked Feel 78% Nylon / 22% Spandex', 'Private Label', 'Logo, labels, hang tags, packaging, etc.'],
  ['Design', 'Fitted zip jacket + ruched sports bra + high-waist leggings', 'Logo Position', 'Front, back, waist, legs, etc.'],
  ['Sizes', 'S, M, L, XL + or Customization', 'MOQ', '50 Sets'],
  ['Colors', 'Green Sheen, Raspberry Red, Black Coffee, Aubergine, Black, etc.', 'Payment', 'T/T, Credit Card, PayPal'],
  ['Order Support', 'Discuss color, size mix and branding requirements with Fitclo.', 'Shipping', 'Express, air freight or sea freight'],
];
const faqs = [
  { question: 'What is included in TZ4510-14?', answer: 'This set includes a fitted zip jacket, a ruched sports bra and high-waist leggings.' },
  { question: 'What fabric is used?', answer: 'TZ4510-14 uses Naked Feel 78% Nylon / 22% Spandex fabric.' },
  { question: 'What is the MOQ?', answer: 'The MOQ for this set is 50 Sets.' },
  { question: 'Can I order a sample?', answer: 'Yes. Samples are available before bulk production.' },
  { question: 'Can I add a private label logo?', answer: 'Yes. Discuss logo placement, labels, hang tags and packaging with Fitclo.' },
];
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', '@id': `${productUrl}#product`, name: productName, description: "Women's three piece activewear set TZ4510-14 with fitted zip jacket, ruched sports bra and high-waist leggings in 78% nylon and 22% spandex.", url: productUrl, image: galleryImages.map((image) => `https://www.fitcloo.com${image.src}`), sku: productCode, mpn: productCode, material: 'Naked Feel 78% Nylon / 22% Spandex', size: 'S, M, L, XL + or Customization', brand: { '@type': 'Brand', name: 'Fitclo' }, category: 'Matching Sets / Three Piece Activewear Sets' };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' }, { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.fitcloo.com/products/' }, { '@type': 'ListItem', position: 3, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' }, { '@type': 'ListItem', position: 4, name: productName, item: productUrl }] };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<BaseLayout title="Women's 3 Piece Activewear Set TZ4510-14 | Wholesale & Private Label" description="Wholesale TZ4510-14 three piece activewear set with fitted zip jacket, ruched sports bra and high-waist leggings in 78% Nylon / 22% Spandex." canonicalURL={productUrl} image={`https://www.fitcloo.com${coverImage}`} structuredData={[productSchema, breadcrumbSchema, faqSchema]} autoArticleSchema={false} includeBreadcrumbSchema={false}>
  <main class="product-detail-page bg-[#090a0c] text-white">
    <section class="pt-[112px]"><div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20">
      <nav class="flex flex-wrap gap-2 text-[12px] text-white/55" aria-label="Breadcrumb"><a href="/" class="hover:text-[#d8b456]">Home</a><span>/</span><a href="/products/" class="hover:text-[#d8b456]">Products</a><span>/</span><a href="/products/matching-sets/" class="hover:text-[#d8b456]">Matching Sets</a><span>/</span><span>{productName}</span></nav>
      <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(400px,.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16" data-product-gallery>
        <figure class="min-w-0"><div class="aspect-square overflow-hidden border border-white/15 bg-[#111218]"><img src={galleryImages[0].src} alt={galleryImages[0].alt} width="800" height="800" class="h-full w-full object-contain" fetchpriority="high" data-gallery-main /></div><div class="mt-4 grid grid-cols-[32px_repeat(5,minmax(0,1fr))_32px] items-center gap-2 sm:grid-cols-[40px_repeat(5,minmax(0,1fr))_40px]"><button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-previous aria-label="Previous image">&lsaquo;</button>{galleryImages.map((image, index) => <button type="button" class:list={['gallery-thumbnail aspect-square overflow-hidden border bg-[#111218] hover:border-[#d8b456]', index === 0 ? 'border-[#d8b456]' : 'border-white/20']} data-gallery-thumb data-src={image.src} data-alt={image.alt} data-label={image.label} aria-label={`Show ${image.label}`}><img src={image.src} alt="" width="180" height="180" class="h-full w-full object-cover" loading="lazy" /></button>)}<button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-next aria-label="Next image">&rsaquo;</button></div><figcaption class="mt-4 flex justify-between gap-5 border-t border-white/15 pt-4"><span class="text-[12px] font-bold" data-gallery-label>{galleryImages[0].label}</span><span class="text-right text-[11px] text-white/45">Style code<br />{productCode}</span></figcaption></figure>
        <div class="pt-1"><p class="text-[11px] font-bold tracking-[.2em] text-[#d8b456]">READY STOCK &bull; PRIVATE LABEL &bull; OEM</p><h1 class="mt-5 text-[38px] font-bold leading-[1.06] sm:text-[50px]">Women's 3 Piece Activewear Set</h1><p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75">New Comfort 3 Piece Set Yoga Sports Bra Slim Fit Breathable Gym Jacket High Waist Yoga Pants Women Leggings Sportswear. A coordinated three-piece set for yoga, Pilates, gym training and private label collections.</p><dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">{quickFacts.map(([label, value]) => <div><dt class="text-[10px] font-bold tracking-[.15em] text-[#d8b456]">{label}</dt><dd class="mt-2 text-[13px] leading-[1.55] text-white/85">{value}</dd></div>)}</dl><div class="mt-8 flex flex-wrap items-center gap-3"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full bg-[#d8b456] px-6 text-[13px] font-bold text-[#101010]">Request Wholesale Quote</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full border border-white/35 px-6 text-[13px] font-bold">Order a {productCode} Sample</a><a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456]">View Customization Options <span class="ml-2">&rarr;</span></a></div></div>
      </div>
    </div></section>

    <section class="border-y border-white/10 py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER SUMMARY</p><h2 class="mt-4 max-w-[470px] text-[30px] font-bold leading-[1.16] sm:text-[38px]">TZ4510-14 for activewear brands and wholesale buyers.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[16px] leading-[1.8] text-white/75">TZ4510-14 combines a slim-fit zip jacket, a ruched sports bra and high-waist leggings. The supplied images show thumbhole cuffs, a zip pocket and colorway reference for yoga, Pilates, gym and private label collections.</p><p class="mt-4 text-[16px] leading-[1.8] text-white/75">Samples are available before bulk production. Discuss the selected color, size mix, branding direction and shipping needs with Fitclo.</p></div></div></section>

    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT SPECIFICATIONS</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Product specifications</h2></div><p class="max-w-[420px] text-[14px] leading-[1.65] text-white/60">Confirmed product information and customization points for style {productCode}.</p></div><div class="mt-9 overflow-x-auto border border-white/25 bg-[#0d0f13]"><table class="min-w-[920px] w-full border-collapse text-left"><tbody>{specificationRows.map(([leftLabel, leftValue, rightLabel, rightValue]) => <tr class="border-b border-white/15 last:border-b-0"><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{leftLabel}</th><td class="w-[34%] border-r border-white/15 px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{leftValue}</td><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{rightLabel}</th><td class="w-[34%] px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{rightValue}</td></tr>)}</tbody></table></div><div class="mt-12 border-t border-white/15 pt-8"><div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT DETAILS</p><h3 class="mt-3 text-[24px] font-bold">Colorway, fit and construction views.</h3></div><p class="max-w-[420px] text-[13px] leading-[1.65] text-white/55">Reference images show full set views, the color chart and jacket details without unnecessary cropping.</p></div><div class="mt-7 grid gap-4 md:grid-cols-3">{detailImages.map(([src, alt]) => <figure class="overflow-hidden border border-white/15 bg-[#111218] p-2"><img src={src} alt={alt} class="h-auto w-full object-contain" loading="lazy" /></figure>)}</div></div></div></section>

    <section class="py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">KEY DESIGN FEATURES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">A three-piece set built for coordinated activewear collections.</h2><div class="mt-10 grid gap-7 md:grid-cols-3">{[['Ruched sports bra', 'The supplied feature image shows the ruched front bra as part of the matching set.'], ['Fitted zip jacket', 'Front zip, stand collar, thumbhole cuffs and zip pocket are visible in the supplied images.'], ['High-waist leggings', 'The matching leggings create a coordinated high-rise silhouette with the jacket and bra.']].map(([title, text], index) => <article class="border-t-2 border-[#d8b456] pt-5"><p class="text-[12px] font-bold text-[#d8b456]">0{index + 1}</p><h3 class="mt-4 text-[19px] font-bold">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>

    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">THREE WAYS TO ORDER</p><h2 class="mt-4 max-w-[700px] text-[30px] font-bold sm:text-[38px]">Choose the route that fits your launch plan.</h2><div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">{[['01 - READY STOCK WHOLESALE', 'For confirmed existing colors and sizes', 'Discuss current availability, size mix and delivery requirements with Fitclo.'], ['02 - STOCK STYLE + PRIVATE LABEL', 'For a faster branded launch', 'Add logo, labels, hang tags or packaging to the selected style after review.'], ['03 - FULL OEM DEVELOPMENT', 'For a custom product program', 'Discuss color, fit, sizing, construction and packaging requirements for your project.']].map(([number, title, text]) => <article class="bg-[#111218] p-7"><p class="text-[11px] font-bold tracking-[.15em] text-[#d8b456]">{number}</p><h3 class="mt-4 text-[20px] font-bold">{title}</h3><p class="mt-4 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>

    <section id="customization" class="py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRIVATE LABEL &amp; CUSTOMIZATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Make the set recognizably yours.</h2><p class="mt-5 text-[15px] leading-[1.75] text-white/65">Fitclo can apply branding to this three-piece set or review your brief for a custom development project.</p></div><div class="grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2">{[['Logo application', 'Front, back, waist, legs, etc.'], ['Labels', 'Brand label, care label or woven label'], ['Packaging', 'Hang tags and packaging options'], ['Color direction', 'Supplied colors or custom color direction'], ['Fabric review', 'Naked Feel 78% Nylon / 22% Spandex'], ['Fit development', 'Custom fit and size grading discussion']].map(([label, value]) => <div class="bg-[#111218] p-5"><h3 class="text-[15px] font-bold">{label}</h3><p class="mt-2 text-[13px] leading-[1.6] text-white/65">{value}</p></div>)}</div></div></section>

    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">FABRIC &amp; QUALITY INFORMATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Confirm the construction before you commit.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[17px] leading-[1.75] text-white/80">TZ4510-14 uses Naked Feel 78% Nylon / 22% Spandex fabric.</p><p class="mt-4 text-[14px] leading-[1.7] text-white/65">Samples let your team review the supplied product's fit, workmanship and branding direction before bulk production.</p></div></div></section>

    <section class="py-16 lg:py-20"><div class="mx-auto max-w-[900px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER FAQ</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Questions buyers ask before ordering.</h2><div class="mt-9 border-y border-white/15">{faqs.map((faq) => <details class="group border-b border-white/15 last:border-b-0"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-[16px] font-bold"><span>{faq.question}</span><span class="text-[#d8b456] group-open:rotate-45">+</span></summary><p class="max-w-[780px] pb-6 text-[14px] leading-[1.75] text-white/65">{faq.answer}</p></details>)}</div></div></section>
    <InquiryForm />
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const label = gallery.querySelector<HTMLElement>('[data-gallery-label]');
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    let active = 0;
    const show = (index: number) => { active = (index + thumbs.length) % thumbs.length; const thumb = thumbs[active]; if (!main) return; main.src = thumb.dataset.src || main.src; main.alt = thumb.dataset.alt || main.alt; if (label) label.textContent = thumb.dataset.label || ''; thumbs.forEach((item, itemIndex) => { item.classList.toggle('border-[#d8b456]', itemIndex === active); item.classList.toggle('border-white/20', itemIndex !== active); }); };
    thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index)));
    gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(active - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(active + 1));
  });
</script>
