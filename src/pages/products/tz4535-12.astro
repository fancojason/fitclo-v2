---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fixedProductGalleryImages } from '../../data/productGalleryDefaults';

const productName = "Women's Seamless Short-Sleeve Flare Leggings Set";
const productCode = 'TZ4535-12';
const productUrl = 'https://www.fitcloo.com/products/tz4535-12/';
const coverImage = '/images/products/TZ4535-12/tz4535-12-seamless-short-sleeve-flare-leggings-set-cover.webp';
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(`Hello Fitclo, I'm interested in ${productName} (${productCode}). Please send the current colors, MOQ, sample options and wholesale pricing.`)}`;
const galleryImages = [
  { src: coverImage, alt: 'TZ4535-12 seamless short-sleeve crop top and flare leggings set cover', label: 'Product cover' },
  { src: '/images/products/TZ4535-12/tz4535-12-short-sleeve-flare-set-feature-guide.webp', alt: 'TZ4535-12 crew-neck short-sleeve top and contour flare leggings feature guide', label: 'Top and flare-leg features' },
  { src: '/images/products/TZ4535-12/tz4535-12-matching-series.webp', alt: 'TZ4535-12 matching seamless activewear series', label: 'Matching series' },
  ...fixedProductGalleryImages,
];
const detailImages = [
  ['/images/products/TZ4535-12/tz4535-12-reddish-brown-front-view.webp', 'Reddish Brown TZ4535-12 short-sleeve crop top and flare leggings front view'],
  ['/images/products/TZ4535-12/tz4535-12-smoky-blue-front-view.webp', 'Smoky Blue TZ4535-12 seamless fitted top and flare leggings angled front view'],
  ['/images/products/TZ4535-12/tz4535-12-misty-dusk-blue-back-view.webp', 'Misty Dusk Blue TZ4535-12 contour back seam and flare leggings back view'],
  ['/images/products/TZ4535-12/tz4535-12-color-chart.webp', 'TZ4535-12 Light Khaki, Smoky Blue, Misty Dusk Blue, Reddish Brown and Black color chart'],
  ['/images/products/TZ4535-12/tz4535-12-construction-details.webp', 'TZ4535-12 crew neck, curved hem, waistband and flare-leg construction details'],
  ['/images/products/TZ4535-12/tz4535-12-seamless-lycra-fabric.webp', 'TZ4535-12 Seamless LYCRA 90% polyamide and 10% elastane fabric information'],
];
const quickFacts = [['Set includes', 'Fitted short-sleeve crop top + high-waist flare leggings'], ['Fabric', 'Seamless LYCRA 90% Polyamide (Nylon) / 10% Elastane (Spandex)'], ['Sizes', 'S, M, L, XL + or Customization'], ['MOQ', '50 Sets'], ['Colors shown', 'Light Khaki / Smoky Blue / Misty Dusk Blue / Reddish Brown / Black, etc.'], ['Branding', 'Logo, labels, hang tags, packaging, etc.']];
const specifications = [['Product Type', 'Seamless Short-Sleeve Crop Top & Flare Leggings Set', 'Sample', 'Request a sample review before bulk confirmation'], ['Fabric', 'Seamless LYCRA 90% Polyamide (Nylon) / 10% Elastane (Spandex)', 'Private Label', 'Logo, labels, hang tags, packaging, etc.'], ['Design', 'Crew-neck fitted short-sleeve top, curved hem, high waist, contour back seam and flare legs', 'Logo Position', 'Front, back, waist, legs, etc.'], ['Sizes', 'S, M, L, XL + or Customization', 'MOQ', '50 Sets'], ['Colors', 'Light Khaki, Smoky Blue, Misty Dusk Blue, Reddish Brown, Black, etc.', 'Payment', 'T/T, Credit Card, PayPal'], ['Applications', 'Yoga, Pilates, running, gym training and active lifestyle collections', 'Shipping', 'Express, air freight or sea freight']];
const faqs = [['What is included in TZ4535-12?', 'TZ4535-12 includes a fitted short-sleeve crop top and full-length high-waist flare leggings.'], ['What fabric is used for TZ4535-12?', 'The supplied product information specifies Seamless LYCRA 90% Polyamide (Nylon) / 10% Elastane (Spandex).'], ['What does Seamless LYCRA mean for this set?', 'It identifies the supplied knitted fabric and LYCRA elastane specification. Buyers should review a sample for hand feel, stretch recovery, opacity and fit against their own requirements.'], ['What design details are shown?', 'The supplied images show a small crew neck, short raglan-style sleeves, an extended curved top hem, a high waistband, a center-back contour seam and flare legs.'], ['Which collection categories suit this style?', 'The silhouette is relevant to women’s seamless flare leggings sets, short-sleeve yoga outfits, Pilates sets, running sets and lifestyle activewear collections.'], ['What sizes are available?', 'Sizes are S, M, L and XL, with customization discussion available.'], ['What is the MOQ?', 'The MOQ for this ready-stock set is 50 Sets.'], ['Can I order a sample?', 'Yes. Ask Fitclo to review the sample color, size and any branding requirements before bulk confirmation.'], ['Can I add private label branding?', 'Yes. Fitclo can discuss logo placement, labels, hang tags and packaging for TZ4535-12.'], ['Which colors are shown?', 'The supplied color chart shows Light Khaki, Smoky Blue, Misty Dusk Blue, Reddish Brown and Black. Confirm the selected color and size mix with Fitclo.'], ['What should buyers check on the flare-leg fit?', 'Use the sample to assess rise, inseam, flare opening, drape and size grading across the required size range.'], ['What payment and shipping options are available?', 'Payment methods are T/T, Credit Card and PayPal. Express, air freight or sea freight can be discussed according to destination and order details.']];
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', '@id': `${productUrl}#product`, name: productName, description: 'Wholesale and private-label women’s seamless short-sleeve crop top and flare leggings set in Seamless LYCRA 90% Polyamide / 10% Elastane for yoga, Pilates, running and gym collections.', url: productUrl, image: galleryImages.map((image) => `https://www.fitcloo.com${image.src}`), sku: productCode, mpn: productCode, material: 'Seamless LYCRA 90% Polyamide (Nylon) / 10% Elastane (Spandex)', size: 'S, M, L, XL + or Customization', brand: { '@type': 'Brand', name: 'Fitclo' }, category: 'Matching Sets / Yoga Sets / Seamless Activewear' };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' }, { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.fitcloo.com/products/' }, { '@type': 'ListItem', position: 3, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' }, { '@type': 'ListItem', position: 4, name: productName, item: productUrl }] };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---

<BaseLayout title="Seamless Short-Sleeve Flare Leggings Set TZ4535-12 | Fitclo" description="Wholesale TZ4535-12 women’s seamless short-sleeve crop top and flare leggings set in Seamless LYCRA 90% Polyamide / 10% Elastane for yoga, Pilates and private-label activewear." canonicalURL={productUrl} image={`https://www.fitcloo.com${coverImage}`} structuredData={[productSchema, breadcrumbSchema, faqSchema]} autoArticleSchema={false} includeBreadcrumbSchema={false}>
  <main class="bg-[#090a0c] text-white">
    <section class="pt-[112px]"><div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20"><nav class="flex flex-wrap gap-2 text-[12px] text-white/55" aria-label="Breadcrumb"><a href="/" class="hover:text-[#d8b456]">Home</a><span>/</span><a href="/products/" class="hover:text-[#d8b456]">Products</a><span>/</span><a href="/products/matching-sets/" class="hover:text-[#d8b456]">Matching Sets</a><span>/</span><span>{productName}</span></nav><div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(400px,.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16" data-product-gallery><figure class="min-w-0"><div class="aspect-square overflow-hidden border border-white/15 bg-[#111218]"><img src={galleryImages[0].src} alt={galleryImages[0].alt} class="h-full w-full object-contain" width="800" height="800" fetchpriority="high" data-gallery-main /></div><div class="mt-4 grid grid-cols-[32px_repeat(5,minmax(0,1fr))_32px] items-center gap-2 sm:grid-cols-[40px_repeat(5,minmax(0,1fr))_40px]"><button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-previous>&lsaquo;</button>{galleryImages.map((image, index) => <button type="button" class:list={['gallery-thumbnail aspect-square overflow-hidden border bg-[#111218] hover:border-[#d8b456]', index === 0 ? 'border-[#d8b456]' : 'border-white/20']} data-gallery-thumb data-src={image.src} data-alt={image.alt} data-label={image.label} aria-label={`Show ${image.label}`}><img src={image.src} alt="" class="h-full w-full object-cover" loading="lazy" /></button>)}<button type="button" class="grid aspect-square place-items-center border border-white/20 text-[25px] hover:border-[#d8b456]" data-gallery-next>&rsaquo;</button></div><figcaption class="mt-4 flex justify-between gap-5 border-t border-white/15 pt-4"><span class="text-[12px] font-bold" data-gallery-label>{galleryImages[0].label}</span><span class="text-right text-[11px] text-white/45">Style code<br />{productCode}</span></figcaption></figure><div class="pt-1"><p class="text-[11px] font-bold tracking-[.2em] text-[#d8b456]">READY STOCK &bull; PRIVATE LABEL &bull; OEM</p><h1 class="mt-5 text-[38px] font-bold leading-[1.06] sm:text-[50px]">Women's Seamless Short-Sleeve Flare Leggings Set</h1><p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75">TZ4535-12 is a high-stretch seamless activewear set pairing a fitted short-sleeve crop top with high-waist flare leggings. It is designed for buyers sourcing women’s two-piece yoga, Pilates, running, gym and private-label workout collections in 90% polyamide / 10% elastane Seamless LYCRA fabric.</p><dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">{quickFacts.map(([label, value]) => <div><dt class="text-[10px] font-bold tracking-[.15em] text-[#d8b456]">{label}</dt><dd class="mt-2 text-[13px] leading-[1.55] text-white/85">{value}</dd></div>)}</dl><div class="mt-8 flex flex-wrap items-center gap-3"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full bg-[#d8b456] px-6 text-[13px] font-bold text-[#101010]">Request Wholesale Quote</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full border border-white/35 px-6 text-[13px] font-bold">Order a {productCode} Sample</a><a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456]">View Customization Options <span class="ml-2">&rarr;</span></a></div></div></div></div></section>
    <section class="border-y border-white/10 py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER SUMMARY</p><h2 class="mt-4 max-w-[470px] text-[30px] font-bold leading-[1.16] sm:text-[38px]">TZ4535-12 for seamless flare-set buyers.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[16px] leading-[1.8] text-white/75">TZ4535-12 is a women’s two-piece seamless activewear set pairing a fitted crew-neck short-sleeve crop top with high-waist flare leggings. The supplied images show a curved top hem, supportive waistband and center-back contour seam that defines the flare-leg silhouette.</p><p class="mt-4 text-[16px] leading-[1.8] text-white/75">It is a focused option for buyers sourcing seamless flare leggings sets, short-sleeve yoga outfits, Pilates workout sets and private-label activewear. Use a sample to assess the hand feel, stretch recovery, opacity, top length, rise, inseam and flare grading for your collection.</p></div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT SPECIFICATIONS</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Product specifications</h2></div><p class="max-w-[420px] text-[14px] leading-[1.65] text-white/60">Confirmed product information and customization points for style {productCode}.</p></div><div class="mt-9 overflow-x-auto border border-white/25 bg-[#0d0f13]"><table class="min-w-[920px] w-full border-collapse text-left"><tbody>{specifications.map(([leftLabel, leftValue, rightLabel, rightValue]) => <tr class="border-b border-white/15 last:border-b-0"><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{leftLabel}</th><td class="w-[34%] border-r border-white/15 px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{leftValue}</td><th class="w-[16%] border-r border-white/15 bg-[#15171c] px-4 py-4 text-center text-[12px] font-bold text-[#d8b456]">{rightLabel}</th><td class="w-[34%] px-5 py-4 text-center text-[14px] leading-[1.65] text-white/75">{rightValue}</td></tr>)}</tbody></table></div><div class="mt-12 border-t border-white/15 pt-8"><div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRODUCT DETAILS</p><h3 class="mt-3 text-[24px] font-bold">Colorway, fit and construction views.</h3></div><p class="max-w-[420px] text-[13px] leading-[1.65] text-white/55">Supplied product imagery covers front and back fit, available colorways, crew-neck and curved-hem construction, waistband and flare-leg details, plus the Seamless LYCRA fabric specification.</p></div><div class="mt-7 grid gap-4 md:grid-cols-3">{detailImages.map(([src, alt]) => <figure class="overflow-hidden border border-white/15 bg-[#111218] p-2"><img src={src} alt={alt} class="h-auto w-full object-contain" loading="lazy" /></figure>)}</div></div></div></section>
    <section class="py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">KEY DESIGN FEATURES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Defined details for a seamless short-sleeve flare set.</h2><div class="mt-10 grid gap-7 md:grid-cols-3">{[['Crew-neck short-sleeve crop top', 'The supplied images show a close crew neckline, fitted short sleeves and a clean cropped silhouette for coordinated studio and lifestyle sets.'], ['Extended curved hem', 'A curved front hem shapes the top-to-waist transition while preserving the fitted two-piece look.'], ['High-waist contour flare leggings', 'The leggings combine a wide high waistband, center-back contour seam and full flare leg for a defined silhouette.']].map(([title, text], index) => <article class="border-t-2 border-[#d8b456] pt-5"><p class="text-[12px] font-bold text-[#d8b456]">0{index + 1}</p><h3 class="mt-4 text-[19px] font-bold">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>
    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">THREE WAYS TO ORDER</p><h2 class="mt-4 max-w-[700px] text-[30px] font-bold sm:text-[38px]">Choose the route that fits your launch plan.</h2><div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">{[['01 - READY STOCK WHOLESALE', 'For confirmed existing colors and sizes', 'Discuss current availability, size mix and delivery requirements with Fitclo.'], ['02 - STOCK STYLE + PRIVATE LABEL', 'For a faster branded launch', 'Add logo, labels, hang tags or packaging to the selected style after review.'], ['03 - FULL OEM DEVELOPMENT', 'For a custom product program', 'Discuss color, fit, sizing, construction and packaging requirements for your project.']].map(([number, title, text]) => <article class="bg-[#111218] p-7"><p class="text-[11px] font-bold tracking-[.15em] text-[#d8b456]">{number}</p><h3 class="mt-4 text-[20px] font-bold">{title}</h3><p class="mt-4 text-[14px] leading-[1.7] text-white/65">{text}</p></article>)}</div></div></section>
    <section id="customization" class="py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">PRIVATE LABEL &amp; CUSTOMIZATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Build the set around your brand direction.</h2><p class="mt-5 text-[15px] leading-[1.75] text-white/65">Fitclo can apply branding to TZ4535-12 or review color, fit, sizing and packaging requirements for a custom activewear development project.</p></div><div class="grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2">{[['Logo application', 'Front, back, waist, legs, etc.'], ['Labels', 'Brand label, care label or woven label'], ['Packaging', 'Hang tags and packaging options'], ['Color direction', 'Supplied colors or custom color direction'], ['Fabric review', 'Seamless LYCRA 90% Polyamide / 10% Elastane'], ['Fit development', 'Top length, rise, inseam, flare opening and size grading discussion']].map(([label, value]) => <div class="bg-[#111218] p-5"><h3 class="text-[15px] font-bold">{label}</h3><p class="mt-2 text-[13px] leading-[1.6] text-white/65">{value}</p></div>)}</div></div></section>
    <section class="border-y border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">FABRIC &amp; QUALITY INFORMATION</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Confirm fabric, recovery and flare fit before commitment.</h2></div><div class="border-l-2 border-[#d8b456] pl-6"><p class="text-[17px] leading-[1.75] text-white/80">The supplied specification for TZ4535-12 is Seamless LYCRA 90% Polyamide (Nylon) / 10% Elastane (Spandex).</p><p class="mt-4 text-[14px] leading-[1.7] text-white/65">Use a sample to assess hand feel, stretch recovery, opacity, seam appearance, waistband fit and flare drape against your collection requirements before bulk confirmation.</p></div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">SAMPLING &amp; PRODUCTION PROCESS</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">A clear path from inquiry to shipment.</h2><ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-5">{[['01', 'Project review', 'Confirm quantity, colors, sizes, branding and delivery needs.'], ['02', 'Sample planning', 'Review the selected style and requested development details.'], ['03', 'Sample approval', 'Review fit, workmanship and branding before bulk confirmation.'], ['04', 'Bulk production', 'Proceed with the approved production plan.'], ['05', 'Inspection & shipping', 'Pack the confirmed order and arrange suitable shipping.']].map(([number, title, text]) => <li class="border-t border-[#d8b456] pt-5"><span class="text-[12px] font-bold text-[#d8b456]">{number}</span><h3 class="mt-4 text-[18px] font-bold">{title}</h3><p class="mt-3 text-[13px] leading-[1.65] text-white/65">{text}</p></li>)}</ol></div></section>
    <section class="border-b border-white/10 bg-[#111218] py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">QUALITY EVIDENCE</p><h2 class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px]">Make decisions against the approved product.</h2></div><ul class="grid gap-4 border-l border-white/20 pl-6 text-[14px] leading-[1.65] text-white/70"><li>Sample review provides a checkpoint for fit, workmanship and branding direction.</li><li>Confirm color, size mix and private-label requirements for the selected order route before proceeding.</li><li>For full OEM, the approved sample and project requirements guide the bulk production plan.</li></ul></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">SHIPPING &amp; PAYMENT</p><h2 class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px]">Plan the order around your destination.</h2></div><div class="grid gap-5 sm:grid-cols-2"><div class="border-t-2 border-[#d8b456] pt-5"><h3 class="text-[18px] font-bold">Worldwide logistics</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">Express, air and sea shipping can be arranged after the destination, order quantity and delivery requirements are confirmed.</p></div><div class="border-t-2 border-[#d8b456] pt-5"><h3 class="text-[18px] font-bold">Order confirmation</h3><p class="mt-3 text-[14px] leading-[1.7] text-white/65">Payment methods are T/T, Credit Card and PayPal. The appropriate payment route is confirmed with your order details.</p></div></div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[900px] px-6 lg:px-10"><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">BUYER FAQ</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Questions buyers ask before ordering.</h2><div class="mt-9 border-y border-white/15">{faqs.map(([question, answer]) => <details class="group border-b border-white/15 last:border-b-0"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-[16px] font-bold"><span>{question}</span><span class="text-[#d8b456] group-open:rotate-45">+</span></summary><p class="max-w-[780px] pb-6 text-[14px] leading-[1.75] text-white/65">{answer}</p></details>)}</div></div></section>
    <section class="border-b border-white/10 py-16 lg:py-20"><div class="mx-auto max-w-[1240px] px-6 lg:px-10"><div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">RELATED GUIDES</p><h2 class="mt-4 text-[30px] font-bold sm:text-[38px]">Continue your seamless activewear research.</h2></div><a href="/blogs/" class="text-[13px] font-bold text-[#d8b456]">Explore all guides &rarr;</a></div><div class="mt-9 grid gap-5 md:grid-cols-3">{[['/seamless-activewear-manufacturer/', 'Seamless Activewear Manufacturer', 'Review seamless product development, sampling, branding and order planning.'], ['/blogs/seamless-knit-activewear-quality-testing-fit-stretch-and-recovery/', 'Seamless Knit Quality Testing', 'Use fit, stretch and recovery checkpoints when reviewing seamless activewear.'], ['/blogs/activewear-sizing-and-grading-guide/', 'Activewear Sizing & Grading Guide', 'Plan size grading and sample review for fitted tops and flare leggings.']].map(([href, title, text]) => <a href={href} class="group border border-white/15 p-6 hover:border-[#d8b456]"><p class="text-[10px] font-bold tracking-[.16em] text-[#d8b456]">FITCLO INTELLIGENCE</p><h3 class="mt-4 text-[19px] font-bold leading-[1.3]">{title}</h3><p class="mt-3 text-[14px] leading-[1.65] text-white/65">{text}</p><span class="mt-6 inline-flex text-[13px] font-bold text-[#d8b456]">Read guide &rarr;</span></a>)}</div></div></section>
    <section id="product-inquiry" class="py-16 lg:py-20"><div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[.8fr_1.2fr] lg:px-10"><div><p class="text-[11px] font-bold tracking-[.19em] text-[#d8b456]">REQUEST CURRENT DETAILS</p><h2 class="mt-4 text-[32px] font-bold leading-[1.16] sm:text-[42px]">Request the current colors, MOQ and wholesale quote.</h2><p class="mt-5 max-w-[450px] text-[15px] leading-[1.75] text-white/65">Send your quantity, color and size plan. Fitclo will confirm the most suitable sourcing route for {productName}, SKU {productCode}.</p><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 items-center border border-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#d8b456] hover:bg-[#d8b456] hover:text-[#101010]">Ask about {productCode} on WhatsApp</a></div><form class="grid gap-5 border border-white/15 bg-[#111218] p-6 sm:grid-cols-2 sm:p-8" data-product-inquiry-form novalidate><input type="hidden" name="product_name" value={productName} /><input type="hidden" name="product_code" value={productCode} /><input type="hidden" name="product_type" value={`${productName} (${productCode})`} /><input type="hidden" name="page_url" value={productUrl} data-page-url /><div><label for="product-name" class="block text-[11px] font-bold tracking-[.12em]">NAME *</label><input id="product-name" name="name" type="text" required class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-company" class="block text-[11px] font-bold tracking-[.12em]">COMPANY</label><input id="product-company" name="company" type="text" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-email" class="block text-[11px] font-bold tracking-[.12em]">BUSINESS EMAIL OR WHATSAPP *</label><input id="product-email" name="email" type="email" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-phone" class="block text-[11px] font-bold tracking-[.12em]">WHATSAPP / PHONE</label><input id="product-phone" name="phone" type="tel" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-country" class="block text-[11px] font-bold tracking-[.12em]">COUNTRY / REGION</label><input id="product-country" name="country" type="text" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]" /></div><div><label for="product-type" class="block text-[11px] font-bold tracking-[.12em]">INQUIRY TYPE</label><select id="product-type" name="inquiry_type" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none focus:border-[#d8b456]"><option>Sample</option><option>Ready Stock</option><option>Private Label</option><option>Full OEM</option></select></div><div><label for="product-quantity" class="block text-[11px] font-bold tracking-[.12em]">ESTIMATED QUANTITY</label><input id="product-quantity" name="quantity" type="text" placeholder="For example: 200 sets" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div><label for="product-colors" class="block text-[11px] font-bold tracking-[.12em]">COLORS &amp; SIZES</label><input id="product-colors" name="colors_sizes" type="text" placeholder="Colors and size mix" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div class="sm:col-span-2"><label for="product-branding" class="block text-[11px] font-bold tracking-[.12em]">BRANDING REQUIREMENTS</label><input id="product-branding" name="branding_requirements" type="text" placeholder="Logo, labels, hang tags or packaging" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]" /></div><div class="sm:col-span-2"><label for="product-message" class="block text-[11px] font-bold tracking-[.12em]">MESSAGE</label><textarea id="product-message" name="message" rows="4" placeholder="Tell us your target launch date, reference requirements or questions." class="mt-2 w-full resize-y border border-white/20 bg-[#0b0c0f] px-4 py-3 text-white outline-none placeholder:text-white/30 focus:border-[#d8b456]"></textarea></div><div class="sm:col-span-2 flex flex-col gap-4 border-t border-white/15 pt-5 sm:flex-row sm:items-center sm:justify-between"><p class="text-[12px] leading-[1.55] text-white/50">Your inquiry will include {productName}, {productCode} and this page URL.</p><button type="submit" class="min-h-12 bg-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#101010]">Send Product Inquiry</button></div><p class="hidden text-[13px] sm:col-span-2" data-product-form-status aria-live="polite"></p></form></div></section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => { const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]'); const label = gallery.querySelector<HTMLElement>('[data-gallery-label]'); const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')); let active = 0; const show = (index: number) => { active = (index + thumbs.length) % thumbs.length; const thumb = thumbs[active]; if (!main) return; main.src = thumb.dataset.src || main.src; main.alt = thumb.dataset.alt || main.alt; if (label) label.textContent = thumb.dataset.label || ''; thumbs.forEach((item, itemIndex) => { item.classList.toggle('border-[#d8b456]', itemIndex === active); item.classList.toggle('border-white/20', itemIndex !== active); }); }; thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index))); gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(active - 1)); gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(active + 1)); });
  const inquiryForm = document.querySelector<HTMLFormElement>('[data-product-inquiry-form]'); const inquiryStatus = document.querySelector<HTMLElement>('[data-product-form-status]'); const pageUrlInput = inquiryForm?.querySelector<HTMLInputElement>('[data-page-url]'); if (inquiryForm && pageUrlInput) { pageUrlInput.value = window.location.href; inquiryForm.addEventListener('submit', async (event) => { event.preventDefault(); const email = inquiryForm.elements.namedItem('email') as HTMLInputElement | null; const phone = inquiryForm.elements.namedItem('phone') as HTMLInputElement | null; const button = inquiryForm.querySelector<HTMLButtonElement>('button[type="submit"]'); if (!email?.value.trim() && !phone?.value.trim()) { if (inquiryStatus) { inquiryStatus.textContent = 'Please enter a business email or WhatsApp number so our team can reply.'; inquiryStatus.className = 'text-[13px] text-red-300 sm:col-span-2'; } email?.focus(); return; } if (!inquiryForm.reportValidity()) return; const originalText = button?.textContent || 'Send Product Inquiry'; if (button) { button.disabled = true; button.textContent = 'Sending inquiry...'; } try { const response = await fetch('/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(inquiryForm).entries())) }); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.'); inquiryForm.reset(); pageUrlInput.value = window.location.href; if (inquiryStatus) { inquiryStatus.textContent = 'Thank you. Your inquiry has been sent. The Fitclo team will reply with current details.'; inquiryStatus.className = 'text-[13px] text-green-300 sm:col-span-2'; } if (button) button.textContent = 'Inquiry Sent'; } catch (error) { if (inquiryStatus) { inquiryStatus.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp instead.'; inquiryStatus.className = 'text-[13px] text-red-300 sm:col-span-2'; } if (button) { button.disabled = false; button.textContent = originalText; } } }); }
</script>
