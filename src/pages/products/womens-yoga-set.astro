        <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">REQUEST CURRENT DETAILS</p>
        <h2 id="inquiry-heading" class="mt-4 text-[32px] font-bold leading-[1.16] sm:text-[42px] font-['Century_Gothic',sans-serif]">Request the current colors, MOQ and wholesale quote.</h2>
        <p class="mt-5 max-w-[450px] text-[15px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">Send your quantity, color and size plan. Fitclo will confirm the most suitable sourcing route for the Women's Yoga Set, SKU FC-YS001.</p>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="mt-7 inline-flex min-h-12 items-center border border-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#d8b456] transition-colors hover:bg-[#d8b456] hover:text-[#101010] font-['Century_Gothic',sans-serif]" data-product-track="click_whatsapp">Ask about FC-YS001 on WhatsApp</a>
      </div>

      <form class="grid gap-5 border border-white/15 bg-[#111218] p-6 sm:grid-cols-2 sm:p-8" data-product-inquiry-form novalidate>
        <input type="hidden" name="product_name" value={productName} />
        <input type="hidden" name="product_code" value={productCode} />
        <input type="hidden" name="product_type" value={`${productName} (${productCode})`} />
        <input type="hidden" name="page_url" value={productUrl} data-page-url />

        <div>
          <label for="product-name" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">NAME *</label>
          <input id="product-name" name="name" type="text" autocomplete="name" required class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-company" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">COMPANY</label>
          <input id="product-company" name="company" type="text" autocomplete="organization" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-email" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">BUSINESS EMAIL OR WHATSAPP *</label>
          <input id="product-email" name="email" type="email" autocomplete="email" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-phone" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">WHATSAPP / PHONE</label>
          <input id="product-phone" name="phone" type="tel" autocomplete="tel" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-country" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">COUNTRY / REGION</label>
          <input id="product-country" name="country" type="text" autocomplete="country-name" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-inquiry-type" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">INQUIRY TYPE</label>
          <select id="product-inquiry-type" name="inquiry_type" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors focus:border-[#d8b456] font-['Century_Gothic',sans-serif]">
            <option value="Sample">Sample</option>
            <option value="Ready Stock">Ready Stock</option>
            <option value="Private Label">Private Label</option>
            <option value="Full OEM">Full OEM</option>
          </select>
        </div>
        <div>
          <label for="product-quantity" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">ESTIMATED QUANTITY</label>
          <input id="product-quantity" name="quantity" type="text" placeholder="For example: 200 sets" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors placeholder:text-white/30 focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div>
          <label for="product-colors-sizes" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">COLORS &amp; SIZES</label>
          <input id="product-colors-sizes" name="colors_sizes" type="text" placeholder="Colors and size mix" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors placeholder:text-white/30 focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div class="sm:col-span-2">
          <label for="product-branding" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">BRANDING REQUIREMENTS</label>
          <input id="product-branding" name="branding_requirements" type="text" placeholder="Logo, labels, hang tags or packaging" class="mt-2 w-full border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors placeholder:text-white/30 focus:border-[#d8b456] font-['Century_Gothic',sans-serif]" />
        </div>
        <div class="sm:col-span-2">
          <label for="product-message" class="block text-[11px] font-bold tracking-[0.12em] text-white/85 font-['Century_Gothic',sans-serif]">MESSAGE</label>
          <textarea id="product-message" name="message" rows="4" placeholder="Tell us your target launch date, reference requirements or questions." class="mt-2 w-full resize-y border border-white/20 bg-[#0b0c0f] px-4 py-3 text-[14px] text-white outline-none transition-colors placeholder:text-white/30 focus:border-[#d8b456] font-['Century_Gothic',sans-serif]"></textarea>
        </div>
        <div class="sm:col-span-2 flex flex-col gap-4 border-t border-white/15 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-[12px] leading-[1.55] text-white/50 font-['Century_Gothic',sans-serif]">Your inquiry will include {productName}, {productCode} and this page URL.</p>
          <button type="submit" class="min-h-12 bg-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#101010] transition-colors hover:bg-[#efd078] font-['Century_Gothic',sans-serif]">Send Product Inquiry</button>
        </div>
        <p class="hidden text-[13px] sm:col-span-2 font-['Century_Gothic',sans-serif]" data-product-form-status aria-live="polite"></p>
