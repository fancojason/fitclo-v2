---
import BaseLayout from '../../layouts/BaseLayout.astro';

const productName = "Women's Yoga Set";
const productCode = 'FC-YS001';
const productUrl = 'https://www.fitcloo.com/products/womens-yoga-set/';
const productImage = 'https://www.fitcloo.com/images/products/womens-yoga-set/womens-yoga-set-reference.png';
const whatsAppMessage = `Hello Fitclo, I'm interested in the ${productName} (${productCode}). Please send the current colors, sizes, MOQ, sample cost and wholesale pricing.`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${encodeURIComponent(whatsAppMessage)}`;

const quickFacts = [
  ['Set includes', 'Strappy sports bra + high-waist leggings'],
  ['Colors shown', 'Black / Coffee Brown / Light Blue'],
  ['Samples', 'Available before bulk production'],
  ['Branding', 'Logo, labels, hang tags and packaging'],
  ['Ready-stock timing', 'As fast as 7 days, subject to confirmation'],
  ['Full OEM starting point', 'Typically 200 pcs per style/color within 4 sizes'],
];

const specificationRows = [
  ['Product name', productName],
  ['Style code', productCode],
  ['Category', 'Matching Sets / Yoga Sets / Gym Sets'],
  ['Components', 'Strappy sports bra + high-waist full-length leggings'],
  ['Design direction', 'Multi-strap open back with a clean coordinated silhouette'],
  ['Colors shown', 'Black, Coffee Brown and Light Blue'],
  ['Fabric & GSM', 'Request the current fabric composition, GSM and construction specifications.'],
  ['Sizes', 'Request the current available sizes and size-mix options.'],
  ['Sample', 'Available'],
  ['Origin', 'China'],
];

const faqs = [
  {
    question: "What is the MOQ for this women's yoga set?",
    answer: 'The MOQ depends on the sourcing route. Ready-stock and private label quantities are confirmed according to current stock, color, size mix and branding method. Full OEM production typically starts from 200 pcs per style/color within 4 sizes.',
  },
  {
    question: 'Can I order a sample before bulk production?',
    answer: 'Yes. Samples are available so you can evaluate the product, fit, stitching and branding direction before placing a bulk order.',
  },
  {
    question: 'Can I mix colors and sizes?',
    answer: 'Size and color mixing depends on current stock and the selected order type. Send the quantity and size breakdown you need for confirmation.',
  },
  {
    question: 'Can you add my logo to this set?',
    answer: 'Yes. Logo options may include heat transfer, silicone and embroidery, depending on the artwork, placement and order route.',
  },
  {
    question: 'Can you add custom labels and packaging?',
    answer: 'Yes. Fitclo can support inside labels, sewn care labels, woven labels, hang tags, custom polybags and custom zipper bags.',
  },
  {
    question: 'Can I customize the fabric or color?',
    answer: 'Yes. Custom fabric, GSM, finish, Pantone color, pattern and fit are available through full OEM development after the project requirements are reviewed.',
  },
  {
    question: 'How fast can ready-stock orders ship?',
    answer: 'Ready-stock orders can be prepared in as little as 7 days, subject to stock availability, branding requirements and order confirmation.',
  },
  {
    question: 'How long does full OEM development take?',
    answer: 'The timeline depends on fabric sourcing, pattern development, sample revisions and quantity. Share your tech pack or reference so Fitclo can map the appropriate production path.',
  },
  {
    question: 'Can you manufacture from my tech pack?',
    answer: 'Yes. Send the tech pack, measurements, grading, fabric requirements, color references, logo artwork and construction details for review.',
  },
  {
    question: 'Can you ship worldwide?',
    answer: 'Yes. Shipping can be arranged by express, air or sea after the order, destination and required delivery window are confirmed.',
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: productName,
  description:
    'A coordinated two-piece activewear set featuring a multi-strap sports bra and high-waist leggings. Available for wholesale, private label branding and full OEM development.',
  url: productUrl,
  image: [productImage],
  sku: productCode,
  brand: {
    '@type': 'Brand',
    name: 'Fitclo',
  },
  manufacturer: {
    '@id': 'https://www.fitcloo.com/#organization',
  },
  category: 'Matching Sets / Yoga Sets / Gym Sets',
  countryOfOrigin: {
    '@type': 'Country',
    name: 'China',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Components', value: 'Strappy sports bra + high-waist full-length leggings' },
    { '@type': 'PropertyValue', name: 'Design', value: 'Multi-strap open back; coordinated silhouette' },
    { '@type': 'PropertyValue', name: 'Sample', value: 'Available' },
    { '@type': 'PropertyValue', name: 'Private label', value: 'Logo, labels, hang tags and packaging' },
    { '@type': 'PropertyValue', name: 'OEM development', value: 'Custom fabric, color, pattern, fit and grading available' },
  ],
};

const productBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.fitcloo.com/products/' },
    { '@type': 'ListItem', position: 3, name: 'Matching Sets', item: 'https://www.fitcloo.com/products/matching-sets/' },
    { '@type': 'ListItem', position: 4, name: productName, item: productUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Women's Yoga Set Wholesale & Private Label | Fitclo"
  description="Wholesale a strappy sports bra and high-waist leggings set in selected stock colors. Samples, custom logos, labels, packaging and OEM development available."
  canonicalURL={productUrl}
  image={productImage}
  structuredData={[productSchema, productBreadcrumbSchema, faqSchema]}
  autoArticleSchema={false}
  includeBreadcrumbSchema={false}
>
  <section class="bg-[#090a0c] pt-[112px] text-white">
    <div class="mx-auto max-w-[1240px] px-6 pb-16 lg:px-10 lg:pb-20">
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-white/55 font-['Century_Gothic',sans-serif]" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-[#d8b456]">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/products/" class="transition-colors hover:text-[#d8b456]">Products</a>
        <span aria-hidden="true">›</span>
        <a href="/products/matching-sets/" class="transition-colors hover:text-[#d8b456]">Matching Sets</a>
        <span aria-hidden="true">›</span>
        <span class="text-white/85" aria-current="page">{productName}</span>
      </nav>

      <div class="mt-8 grid gap-10 border-t border-white/15 pt-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-center lg:gap-16">
        <div>
          <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">READY STOCK · PRIVATE LABEL · OEM</p>
          <h1 class="mt-5 max-w-[740px] text-[40px] font-bold leading-[1.06] text-white sm:text-[54px] font-['Century_Gothic',sans-serif]">Women's Yoga Set - Wholesale &amp; Private Label</h1>
          <p class="mt-6 max-w-[710px] text-[16px] leading-[1.75] text-white/75 md:text-[17px] font-['Century_Gothic',sans-serif]">A coordinated two-piece activewear set featuring a multi-strap sports bra and high-waist leggings. Source selected stock colors, add your private label, or develop a fully customized version around your fabric, color, fit and packaging requirements.</p>

          <dl class="mt-8 grid gap-x-8 gap-y-5 border-y border-white/15 py-6 sm:grid-cols-2 lg:grid-cols-3">
            {quickFacts.map(([label, value]) => (
              <div>
                <dt class="text-[10px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">{label}</dt>
                <dd class="mt-2 text-[13px] leading-[1.55] text-white/85 font-['Century_Gothic',sans-serif]">{value}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-wrap items-center gap-3 font-['Century_Gothic',sans-serif]">
            <a href="#product-inquiry" class="inline-flex min-h-12 items-center justify-center bg-[#d8b456] px-5 py-3 text-[13px] font-bold text-[#101010] transition-colors hover:bg-[#efd078]" data-product-track="click_quote_cta">Request Wholesale Quote</a>
            <a href="#product-inquiry" class="inline-flex min-h-12 items-center justify-center border border-white/35 px-5 py-3 text-[13px] font-bold text-white transition-colors hover:border-[#d8b456] hover:text-[#d8b456]" data-product-track="click_sample_cta">Order an FC-YS001 Sample</a>
            <a href="#customization" class="inline-flex min-h-12 items-center text-[13px] font-bold text-[#d8b456] transition-colors hover:text-white">View Customization Options <span class="ml-2" aria-hidden="true">→</span></a>
          </div>
          <p class="mt-4 text-[12px] leading-[1.55] text-white/45 font-['Century_Gothic',sans-serif]">Current stock, exact MOQ and pricing are confirmed according to the selected color, size mix and branding requirements.</p>
        </div>

        <figure class="border border-white/15 bg-[#f3f4f6] p-5 text-[#171717]">
          <div class="flex min-h-[360px] items-center justify-center border border-black/10 bg-white p-5">
            <img src="/images/products/womens-yoga-set/womens-yoga-set-reference.png" width="211" height="267" alt="Women's yoga set style reference showing black, coffee brown and light blue strappy bra and high-waist leggings colorways" class="h-auto max-w-full object-contain" fetchpriority="high" />
          </div>
          <figcaption class="mt-4 flex items-start justify-between gap-5 font-['Century_Gothic',sans-serif]">
            <span class="text-[12px] font-bold">Women's Yoga Set</span>
            <span class="text-right text-[11px] text-black/55">Style reference<br />FC-YS001</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="buyer-summary-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">BUYER SUMMARY</p>
        <h2 id="buyer-summary-heading" class="mt-4 max-w-[420px] text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Women's Yoga Set for activewear brands and wholesale buyers.</h2>
      </div>
      <div class="border-l-2 border-[#d8b456] pl-6">
        <p class="text-[16px] leading-[1.8] text-[#3f4248] font-['Century_Gothic',sans-serif]">Fitclo's Women's Yoga Set combines a distinctive multi-strap sports bra with full-length high-waist leggings in a coordinated two-piece design. It is suitable for yoga, gym, studio and athleisure collections. Buyers may source selected ready-stock colors, add private label branding to an existing style, or develop a fully customized version based on their own fabric, color, fit and packaging requirements.</p>
        <p class="mt-4 text-[16px] leading-[1.8] text-[#3f4248] font-['Century_Gothic',sans-serif]">Samples are available before bulk production, and worldwide shipping can be arranged by express, air or sea.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-[#dfe1e4] bg-[#f5f6f7] py-16 text-[#171717] lg:py-20" aria-labelledby="specifications-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">PRODUCT AT A GLANCE</p>
          <h2 id="specifications-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">Product specifications</h2>
        </div>
        <p class="max-w-[420px] text-[14px] leading-[1.65] text-[#555a63] font-['Century_Gothic',sans-serif]">Only confirmed product information is listed here. Contact Fitclo for live fabric, GSM, size and availability details.</p>
      </div>
      <div class="mt-9 overflow-x-auto border border-[#d9dce0] bg-white">
        <table class="min-w-[720px] w-full border-collapse text-left font-['Century_Gothic',sans-serif]">
          <tbody>
            {specificationRows.map(([label, value]) => (
              <tr class="border-b border-[#e4e6e9] last:border-b-0">
                <th scope="row" class="w-[32%] bg-[#fafbfc] px-5 py-4 text-[12px] font-bold tracking-[0.06em] text-[#26282d]">{label}</th>
                <td class="px-5 py-4 text-[14px] leading-[1.6] text-[#555a63]">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="features-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">KEY DESIGN FEATURES</p>
      <h2 id="features-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">A set built around a coordinated silhouette.</h2>
      <div class="mt-10 grid gap-7 md:grid-cols-3">
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">01</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">Multi-strap sports bra</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">The reference style pairs a clean front with an open, multi-strap back detail for a more distinctive activewear set direction.</p>
        </div>
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">02</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">High-waist full-length leggings</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">A full-length bottom creates a versatile two-piece set suitable for yoga, gym, studio and athleisure product assortments.</p>
        </div>
        <div class="border-t-2 border-[#d8b456] pt-5">
          <p class="text-[12px] font-bold tracking-[0.12em] text-[#a77e25] font-['Century_Gothic',sans-serif]">03</p>
          <h3 class="mt-4 text-[19px] font-bold font-['Century_Gothic',sans-serif]">Private-label ready path</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">Choose an existing style route for a faster launch, or use the reference as a starting point for a fully customized program.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#111218] py-16 text-white lg:py-20" aria-labelledby="order-options-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">THREE WAYS TO ORDER</p>
      <h2 id="order-options-heading" class="mt-4 max-w-[700px] text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Choose the route that fits your launch plan.</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-white/15 bg-white/15 lg:grid-cols-3">
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">01 · READY STOCK WHOLESALE</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For faster delivery and market testing</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Use confirmed existing colors and sizes without branding. MOQ depends on current stock; timing can be as fast as 7 days after confirmation.</p>
        </article>
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">02 · STOCK STYLE + PRIVATE LABEL</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For a faster branded launch</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Add a logo, inside label, care label, woven label, hang tag or packaging to an existing style. Quantity and timing depend on the branding method.</p>
        </article>
        <article class="bg-[#111218] p-7">
          <p class="text-[11px] font-bold tracking-[0.15em] text-[#d8b456] font-['Century_Gothic',sans-serif]">03 · FULL OEM DEVELOPMENT</p>
          <h3 class="mt-4 text-[20px] font-bold font-['Century_Gothic',sans-serif]">For a fully custom product</h3>
          <p class="mt-4 text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Develop the fabric, GSM, Pantone color, pattern, fit, grading and packaging. A typical starting point is 200 pcs per style/color within 4 sizes after review.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="customization" class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="customization-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">PRIVATE LABEL &amp; CUSTOMIZATION</p>
        <h2 id="customization-heading" class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Make the set recognizably yours.</h2>
        <p class="mt-5 text-[15px] leading-[1.75] text-[#5b6068] font-['Century_Gothic',sans-serif]">Fitclo can apply your brand to an existing stock style or use your brief as the start of a custom development project.</p>
      </div>
      <div class="grid gap-px border border-[#d9dce0] bg-[#d9dce0] sm:grid-cols-2">
        {[
          ['Logo application', 'Heat transfer, silicone or embroidery'],
          ['Labels', 'Inside brand label, care label or woven label'],
          ['Packaging', 'Hang tag, polybag or zipper bag options'],
          ['Color direction', 'Existing colors or custom Pantone colors'],
          ['Fabric development', 'Custom fabric, GSM and finish after review'],
          ['Fit development', 'Custom pattern, fit and size grading'],
        ].map(([label, value]) => (
          <div class="bg-white p-5">
            <h3 class="text-[15px] font-bold font-['Century_Gothic',sans-serif]">{label}</h3>
            <p class="mt-2 text-[13px] leading-[1.6] text-[#5b6068] font-['Century_Gothic',sans-serif]">{value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#dfe1e4] bg-[#f5f6f7] py-16 text-[#171717] lg:py-20" aria-labelledby="fabric-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">FABRIC &amp; QUALITY INFORMATION</p>
        <h2 id="fabric-heading" class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Confirm the construction before you commit.</h2>
      </div>
      <div class="border-l-2 border-[#d8b456] pl-6">
        <p class="text-[17px] leading-[1.75] text-[#3f4248] font-['Century_Gothic',sans-serif]">Request the current fabric composition, GSM and construction specifications.</p>
        <p class="mt-4 text-[14px] leading-[1.7] text-[#5b6068] font-['Century_Gothic',sans-serif]">Fitclo confirms fabric, sizing and product details against the selected order route. Samples let your team review the physical product, fit, stitching and branding before bulk production.</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="process-heading">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
      <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">SAMPLING &amp; PRODUCTION PROCESS</p>
      <h2 id="process-heading" class="mt-4 text-[30px] font-bold sm:text-[38px] font-['Century_Gothic',sans-serif]">A clear path from inquiry to shipment.</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
        {[
          ['01', 'Project review', 'Confirm your order route, target quantity, colors, sizes, branding and delivery needs.'],
          ['02', 'Sample planning', 'Review the current style or custom development requirements before making a sample.'],
          ['03', 'Sample approval', 'Assess fit, workmanship and branding details; revise where required before bulk confirmation.'],
          ['04', 'Bulk production', 'Arrange materials and proceed with the approved production plan.'],
          ['05', 'Inspection & shipping', 'Check the confirmed order requirements, pack and arrange express, air or sea shipping.'],
        ].map(([number, title, description]) => (
          <li class="border-t border-[#d8b456] pt-5">
            <span class="text-[12px] font-bold tracking-[0.14em] text-[#a77e25] font-['Century_Gothic',sans-serif]">{number}</span>
            <h3 class="mt-4 text-[18px] font-bold font-['Century_Gothic',sans-serif]">{title}</h3>
            <p class="mt-3 text-[13px] leading-[1.65] text-[#5b6068] font-['Century_Gothic',sans-serif]">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[#111218] py-16 text-white lg:py-20" aria-labelledby="quality-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-2 lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#d8b456] font-['Century_Gothic',sans-serif]">QUALITY EVIDENCE</p>
        <h2 id="quality-heading" class="mt-4 text-[30px] font-bold leading-[1.16] sm:text-[38px] font-['Century_Gothic',sans-serif]">Make decisions against the approved product.</h2>
      </div>
      <ul class="grid gap-4 border-l border-white/20 pl-6 text-[14px] leading-[1.65] text-white/70 font-['Century_Gothic',sans-serif]">
        <li>Sample review provides a physical checkpoint for fit, workmanship and branding direction.</li>
        <li>Current stock, color, size mix and private-label feasibility are confirmed for the selected sourcing route.</li>
        <li>For full OEM, the approved sample and project requirements guide the bulk production plan.</li>
      </ul>
    </div>
  </section>

  <section class="bg-white py-16 text-[#171717] lg:py-20" aria-labelledby="shipping-heading">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.19em] text-[#a77e25] font-['Century_Gothic',sans-serif]">SHIPPING &amp; PAYMENT</p>
