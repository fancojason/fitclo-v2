  <section class="bg-[#090a0c] pb-28 text-white">
    <div class="mx-auto max-w-[1240px] border-t border-white/15 px-6 pt-6 lg:px-10">
      <p class="text-[12px] text-white/45 font-['Century_Gothic',sans-serif]">Updated July 16, 2026 <span class="px-2" aria-hidden="true">·</span> Reviewed by Fitclo Activewear Team</p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-product-inquiry-form]');
  const status = document.querySelector<HTMLElement>('[data-product-form-status]');
  const pageUrlInput = form?.querySelector<HTMLInputElement>('[data-page-url]');
  let inquiryStarted = false;

  const track = (eventName: string, parameters: Record<string, string> = {}) => {
    const analyticsWindow = window as Window & {
      gtag?: (command: string, event: string, params: Record<string, string>) => void;
      dataLayer?: Array<Record<string, string>>;
    };

    if (typeof analyticsWindow.gtag === 'function') {
      analyticsWindow.gtag('event', eventName, parameters);
      return;
    }

    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.dataLayer.push({ event: eventName, ...parameters });
  };

  document.querySelectorAll<HTMLElement>('[data-product-track]').forEach((element) => {
    element.addEventListener('click', () => {
      const eventName = element.dataset.productTrack;
      if (eventName) track(eventName, { product_name: "Women's Yoga Set", product_code: 'FC-YS001' });
    });
  });

  if (form && pageUrlInput) {
    pageUrlInput.value = window.location.href;
    track('view_product', { product_name: "Women's Yoga Set", product_code: 'FC-YS001' });

    form.addEventListener('focusin', () => {
      if (!inquiryStarted) {
        inquiryStarted = true;
        track('start_product_inquiry', { product_name: "Women's Yoga Set", product_code: 'FC-YS001' });
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = form.elements.namedItem('email') as HTMLInputElement | null;
      const phone = form.elements.namedItem('phone') as HTMLInputElement | null;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (!email?.value.trim() && !phone?.value.trim()) {
        if (status) {
          status.textContent = 'Please enter a business email or WhatsApp number so our team can reply.';
          status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        email?.focus();
        return;
      }

      if (!form.reportValidity()) return;
      const originalLabel = submitButton?.textContent || 'Send Product Inquiry';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending inquiry...';
      }
      if (status) {
        status.textContent = 'Sending your product inquiry...';
        status.className = 'text-[13px] text-white/60 sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
      }

      try {
        const response = await fetch('/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || result.message || 'Unable to send inquiry.');

        track('submit_product_inquiry', { product_name: "Women's Yoga Set", product_code: 'FC-YS001' });
        form.reset();
        if (pageUrlInput) pageUrlInput.value = window.location.href;
        if (status) {
          status.textContent = 'Thank you. Your inquiry has been sent. The Fitclo team will reply with current details.';
          status.className = 'text-[13px] text-[#c6e4ae] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        if (submitButton) submitButton.textContent = 'Inquiry Sent';
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Unable to send inquiry. Please try WhatsApp instead.';
          status.className = 'text-[13px] text-[#f3b1a6] sm:col-span-2 font-[\'Century_Gothic\',sans-serif]';
        }
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      }
    });
  }
</script>
