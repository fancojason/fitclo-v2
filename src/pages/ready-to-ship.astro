---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ReadyStockCatalog from '../components/ReadyStockCatalog.astro';
import { readyStockCatalog } from '../data/readyStockCatalog';
import { getAlternateLinks } from '../i18n/routes';
import { businessFacts } from '../data/businessFacts';

const pageUrl = 'https://www.fitcloo.com/ready-to-ship/';
const readyStockSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ready-Stock Activewear Catalog',
  description: 'Browse Fitclo ready-stock activewear programme styles by category and MOQ. Request current colours, size mixes, samples, logo options and a wholesale quote.',
  url: pageUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: readyStockCatalog.length,
    itemListElement: readyStockCatalog.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Thing',
        name: product.name,
        identifier: product.styleCode,
        image: `https://www.fitcloo.com${product.image}`,
        description: product.description,
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the MOQ for Fitclo ready-stock activewear?',
      acceptedAnswer: { '@type': 'Answer', text: businessFacts.readyStock.trial },
    },
    {
      '@type': 'Question',
      name: 'Can I add my logo to ready-stock activewear?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Buyers can discuss logo application, labels, hang tags and packaging for selected ready-stock programme styles. Fitclo confirms the practical branding route before order.' },
    },
    {
      '@type': 'Question',
      name: 'Can I order a sample before a wholesale order?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Send the style reference, preferred colour and size so Fitclo can confirm the suitable sample option before a wholesale order.' },
    },
    {
      '@type': 'Question',
      name: 'Are all colours and sizes shown online currently available?',
      acceptedAnswer: { '@type': 'Answer', text: 'Availability is confirmed before order because the current colour and size mix can change. Send your style, quantity, colour and size plan for a current check.' },
    },
  ],
};
---

<BaseLayout
  title="Ready-Stock Activewear Catalog | FITCLO"
  description="Filter Fitclo ready-stock activewear by category and MOQ. Request current colours and size mixes, logo customization, samples, a wholesale quote or the ready-stock line sheet."
  image="https://www.fitcloo.com/images/ready-stock/ready-stock-activewear-open-carton-warehouse-hero.webp"
  canonicalURL={pageUrl}
  alternateLinks={getAlternateLinks('/ready-to-ship/', '/es/ready-stock-activewear/')}
  structuredData={[readyStockSchema, faqSchema]}
  autoArticleSchema={false}
>
  <section class="relative overflow-hidden bg-[#090909] pt-[82px] text-white">
    <img src="/images/ready-stock/ready-stock-activewear-open-carton-warehouse-hero.webp" alt="Ready-stock activewear warehouse shelves with open cartons of organized yoga apparel" class="absolute inset-0 h-full w-full object-cover object-[60%_center] opacity-75" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,5,5,.98)_0%,rgba(5,5,5,.9)_42%,rgba(5,5,5,.36)_100%)]"></div>
    <div class="relative mx-auto grid min-h-[590px] max-w-[1320px] content-end gap-10 px-6 pb-16 pt-28 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-10 lg:pb-20">
      <div class="max-w-[790px]">
        <p class="text-[11px] font-bold tracking-[0.22em] text-[#d8b456] font-['Century_Gothic',sans-serif]">READY-STOCK ACTIVEWEAR WHOLESALE</p>
        <h1 class="mt-5 text-[43px] font-bold leading-[1.04] text-white sm:text-[57px] lg:text-[70px] font-['Century_Gothic',sans-serif]">A practical ready-stock catalog for your next activewear drop.</h1>
        <p class="mt-6 max-w-[660px] text-[16px] leading-[1.75] text-white/85 md:text-[19px] font-['Century_Gothic',sans-serif]">{businessFacts.readyStock.trial} Add logo, labels, hang tags and packaging where suitable.</p>
        <div class="mt-8 flex flex-wrap gap-3 text-[12px] font-bold font-['Century_Gothic',sans-serif]">
          <span class="rounded-full border border-white/20 bg-black/45 px-4 py-2.5 text-white"><span class="mr-2 text-[#d8b456]">01</span>Trial quantity: confirm by style</span>
          <span class="rounded-full border border-white/20 bg-black/45 px-4 py-2.5 text-white"><span class="mr-2 text-[#d8b456]">02</span>Logo options</span>
          <span class="rounded-full border border-white/20 bg-black/45 px-4 py-2.5 text-white"><span class="mr-2 text-[#d8b456]">03</span>Sample request</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-4 font-['Century_Gothic',sans-serif]">
          <a href="#ready-stock-catalog" class="inline-flex min-h-[54px] items-center justify-center rounded-full bg-[#d8b456] px-7 text-[13px] font-bold text-black transition-colors hover:bg-white">Browse Ready-Stock Styles</a>
          <a href="#inquiry" class="inline-flex min-h-[54px] items-center justify-center rounded-full border border-white/40 px-7 text-[13px] font-bold text-white transition-colors hover:border-[#d8b456] hover:text-[#d8b456]">Request Current Availability</a>
        </div>
      </div>
      <aside class="border border-white/15 bg-[#101010]/90 p-6 backdrop-blur-sm font-['Century_Gothic',sans-serif]">
        <p class="text-[11px] font-bold tracking-[0.16em] text-[#d8b456]">BUYER CHECKLIST</p>
        <ol class="mt-5 space-y-4 text-[14px] leading-[1.55] text-white/75">
          <li><span class="mr-3 font-bold text-[#d8b456]">01</span>Choose styles and estimated quantity.</li>
          <li><span class="mr-3 font-bold text-[#d8b456]">02</span>Send colour and size breakdown.</li>
          <li><span class="mr-3 font-bold text-[#d8b456]">03</span>Confirm sample and branding route.</li>
          <li><span class="mr-3 font-bold text-[#d8b456]">04</span>Receive the current availability check.</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="bg-[#111111] py-10 text-white">
    <div class="mx-auto grid max-w-[1320px] gap-6 px-6 md:grid-cols-3 lg:px-10">
      <div class="border-l-2 border-[#d8b456] pl-5"><p class="text-[12px] font-bold tracking-[0.12em] text-[#d8b456]">MOQ</p><p class="mt-2 text-[15px] leading-[1.55] text-white/75">{businessFacts.readyStock.trial}</p></div>
      <div class="border-l-2 border-[#d8b456] pl-5"><p class="text-[12px] font-bold tracking-[0.12em] text-[#d8b456]">BRANDING</p><p class="mt-2 text-[15px] leading-[1.55] text-white/75">Discuss logo, labels, hang tags and packaging alongside the selected stock route.</p></div>
      <div class="border-l-2 border-[#d8b456] pl-5"><p class="text-[12px] font-bold tracking-[0.12em] text-[#d8b456]">AVAILABILITY</p><p class="mt-2 text-[15px] leading-[1.55] text-white/75">Current colours and size mixes are checked before order, not assumed from a website image.</p></div>
    </div>
  </section>

  <ReadyStockCatalog />

  <section class="border-t border-white/10 bg-[#090909] py-20 text-white font-['Century_Gothic',sans-serif]">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-10">
      <p class="text-xs font-bold tracking-[.2em] text-[#d8b456]">PLAN A BUYABLE ASSORTMENT</p>
      <h2 class="mt-4 max-w-3xl text-3xl font-bold md:text-5xl">Turn the line sheet into a SKU-level order request.</h2>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        <div class="border border-white/15 p-6"><h3 class="text-xl font-bold">1. Pick the product shape</h3><p class="mt-3 text-sm leading-6 text-white/70">Compare <a class="text-[#d8b456] underline" href="/private-label-pilates-clothing/">Pilates sets</a>, <a class="text-[#d8b456] underline" href="/wholesale-flare-yoga-pants/">flare pants</a> or <a class="text-[#d8b456] underline" href="/printed-contrast-activewear-wholesale/">patterned and contrast styles</a>. Use the full style code when you inquire.</p></div>
        <div class="border border-white/15 p-6"><h3 class="text-xl font-bold">2. Specify the size mix</h3><p class="mt-3 text-sm leading-6 text-white/70">List requested quantities by color and size for each SKU. A catalog image shows a product direction; it does not confirm that every photographed color and size remains available.</p></div>
        <div class="border border-white/15 p-6"><h3 class="text-xl font-bold">3. State the finishing scope</h3><p class="mt-3 text-sm leading-6 text-white/70">Say whether you need unbranded stock, a logo, labels, hang tags or packaging. Branding methods and sample requirements are reviewed against the chosen garment.</p></div>
      </div>
      <p class="mt-7 max-w-4xl text-sm leading-6 text-white/60">{businessFacts.readyStock.trial} Different SKUs are not automatically pooled into one minimum. New fabric, pattern or color development follows the OEM/ODM quote.</p>
      <p class="mt-3 max-w-4xl text-sm leading-6 text-white/60">{businessFacts.readyStock.dispatch} {businessFacts.shipping}</p>
      <p class="mt-3 max-w-4xl text-sm leading-6 text-white/60">Buying for Australia? Use the <a class="font-bold text-[#d8b456] underline" href="/wholesale-to/australia/">Australia wholesale activewear sourcing guide</a> to prepare your assortment, delivery destination and quotation details.</p>
    </div>
  </section>

  <section class="bg-[#111111] py-20 text-white md:py-24">
    <div class="mx-auto grid max-w-[1320px] gap-12 px-6 lg:grid-cols-[.85fr_1.15fr] lg:px-10">
      <div>
        <p class="text-[11px] font-bold tracking-[0.2em] text-[#d8b456] font-['Century_Gothic',sans-serif]">READY-STOCK BUYER FAQ</p>
        <h2 class="mt-4 text-[34px] font-bold leading-[1.1] text-white md:text-[47px] font-['Century_Gothic',sans-serif]">The details buyers usually confirm first.</h2>
        <p class="mt-5 text-[16px] leading-[1.75] text-white/65 font-['Century_Gothic',sans-serif]">A fast route still needs the right information. Send the style, quantity, colour and size plan so the recommendation is based on your actual order.</p>
      </div>
      <div class="divide-y divide-white/15 border-y border-white/15">
        <details class="group py-5" open><summary class="cursor-pointer list-none pr-8 text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">What is the ready-stock MOQ?<span class="float-right text-[#d8b456] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-[760px] text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">{businessFacts.readyStock.trial}</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">Can I add a logo or my own packaging?<span class="float-right text-[#d8b456] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-[760px] text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Yes. Logo, labels, hang tags and packaging can be discussed for selected styles. Fitclo confirms the workable branding route before you proceed.</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">Can I request a sample?<span class="float-right text-[#d8b456] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-[760px] text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Yes. Share the style, preferred colour and size so Fitclo can advise on the appropriate sample option before a wholesale order.</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-[17px] font-bold text-white font-['Century_Gothic',sans-serif]">Why is availability checked before order?<span class="float-right text-[#d8b456] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-[760px] text-[14px] leading-[1.7] text-white/65 font-['Century_Gothic',sans-serif]">Current colours and size mixes change. A live check prevents a buyer from planning around an image that does not match the required assortment.</p></details>
      </div>
    </div>
  </section>

  <InquiryForm id="inquiry" />
</BaseLayout>
