---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marketLandingPages, type MarketLandingPage } from '../../data/marketLandingPages';
import { getCatalogProductByStyleCode, type CatalogProduct } from '../../data/productCatalog';

export function getStaticPaths() {
  return marketLandingPages.map((market) => ({
    params: { country: market.slug },
    props: { market },
  }));
}

const { market } = Astro.props as { market: MarketLandingPage };
const pageUrl = `https://www.fitcloo.com/wholesale-to/${market.slug}/`;
const pageTitle = `Wholesale Activewear Manufacturer for ${market.name} | Fitclo`;
const pageDescription = `Source ready-stock, private-label and OEM activewear for ${market.name}. Compare MOQ, samples, fabrics, branding, quality checks and shipping responsibilities with Fitclo.`;
const whatsappMessage = encodeURIComponent(
  `Hello Fitclo, I am sourcing activewear for ${market.name}. Please share suitable ready-stock styles, MOQ, sample and private-label options.`,
);
const whatsappUrl = `https://api.whatsapp.com/send?phone=8617160837538&text=${whatsappMessage}`;

const productSelections = [
  { styleCode: 'TZ4510-14', href: '/products/tz4510-14/' },
  { styleCode: 'TZ5555-4', href: '/products/tz5555-4/' },
  { styleCode: 'TZ5560-2', href: '/products/tz5560-2/' },
  { styleCode: 'TZ2557-6', href: '/products/tz2557-6/' },
  { styleCode: 'TZ4506-4', href: '/products/tz4506-4/' },
  { styleCode: 'TZ4549-6', href: '/products/capri-workout-set/' },
];
const featuredProducts = productSelections
  .map((selection) => {
    const product = getCatalogProductByStyleCode(selection.styleCode);
    return product ? { ...product, href: selection.href } : null;
  })
  .filter((product): product is CatalogProduct & { href: string } => Boolean(product));

const quickAnswer = `Fitclo supplies ${market.name} activewear buyers through three practical routes: ready-stock styles for focused assortments, private-label branding for selected products, and OEM/ODM development for defined custom briefs. Ready-stock MOQ starts from 50 sets for coordinated sets or 50 pcs for individual garments. Samples, final specifications, shipment scope and destination requirements are confirmed against the actual order.`;

const faq = [
  {
    question: `Can Fitclo supply wholesale activewear to ${market.name}?`,
    answer: `Yes. Fitclo supports ${market.faqFocus} with ready-stock activewear, private-label branding and OEM/ODM development. The appropriate route depends on the selected styles, quantities, fabric, colours and customisation requirements.`,
  },
  {
    question: 'Which sourcing route should a new activewear buyer choose?',
    answer: 'Ready stock is a practical starting point for a focused assortment. Private label adds brand components to suitable existing products. OEM/ODM is intended for a defined custom brief involving new fabrics, measurements, construction or design details.',
  },
  {
    question: 'What is the MOQ for ready-stock activewear?',
    answer: 'For suitable ready-stock programmes, MOQ starts from 50 sets for coordinated sets or 50 pcs for individual garments. Current colour, size and style availability should be checked before the order is confirmed.',
  },
  {
    question: 'Can Fitclo add a logo, labels, hang tags and packaging?',
    answer: 'Yes. Available private-label options can include logo application, woven or care labels, hang tags and packaging. The recommended method and applicable MOQ depend on the selected product and branding brief.',
  },
  {
    question: 'Can I review a sample before bulk production?',
    answer: 'Yes. A sample route can be planned for new developments and selected custom projects. Use the sample to record fit, measurement, construction, colour and branding comments before a bulk decision.',
  },
  {
    question: `How should a ${market.name} buyer plan shipping, duty and import documents?`,
    answer: 'Confirm the Incoterm, exact named place, consignee or importer details, carton information, document scope and excluded charges before dispatch. Duties, taxes and destination requirements vary, so they should be checked with the appointed freight forwarder, customs broker or qualified local adviser.',
  },
  {
    question: 'Which payment methods are available?',
    answer: 'Fitclo supports T/T, Credit Card and PayPal. The applicable payment arrangement should be confirmed on the quotation or order documents before payment.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.fitcloo.com/' },
      { '@type': 'ListItem', position: 2, name: market.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': pageUrl,
    url: pageUrl,
    name: pageTitle,
    description: pageDescription,
    isPartOf: { '@id': 'https://www.fitcloo.com/#website' },
    about: { '@id': 'https://www.fitcloo.com/#organization' },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: 'https://www.fitcloo.com/images/products/shared/ready-stock-warehouse.webp',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Wholesale Activewear Supply for ${market.name}`,
    serviceType: 'Ready-stock, private label and OEM/ODM activewear sourcing',
    provider: { '@id': 'https://www.fitcloo.com/#organization' },
    areaServed: { '@type': 'Country', name: market.name },
    audience: { '@type': 'BusinessAudience', audienceType: 'Activewear brands, retailers, studios, ecommerce sellers and distributors' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Activewear sourcing routes',
      itemListElement: ['Ready-stock activewear', 'Private-label activewear', 'OEM/ODM activewear development'].map((name) => ({
        '@type': 'OfferCatalog',
        name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];

const routeRows = [
  ['Ready stock', 'Current programme styles', 'Focused assortment or market test', '50 sets or 50 pcs for suitable styles'],
  ['Private label', 'Suitable styles plus brand components', 'A branded collection with controlled complexity', 'Logo, labels, hang tags and packaging reviewed per brief'],
  ['OEM / ODM', 'Tech pack or defined development brief', 'New silhouettes, fabrics or construction details', 'Sampling and MOQ depend on development scope'],
];

const sourcingChecks = [
  ['Product brief', 'Category, intended use, quantity, target customer and reference styles.'],
  ['Fit and fabric', 'Size range, measurements, hand feel, stretch, coverage and recovery expectations.'],
  ['Brand components', 'Logo position, labels, hang tags, packaging and required artwork files.'],
  ['Quality review', 'Approved sample, measurement tolerances, workmanship points and pack-out checks.'],
  ['Shipping scope', 'Incoterm, named place, carton data, consignee details and required documents.'],
  ['Payment', 'T/T, Credit Card or PayPal, confirmed on the quotation or order documents.'],
];
---

<BaseLayout
  title={pageTitle}
  seoTitle={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl}
  image="https://www.fitcloo.com/images/products/shared/ready-stock-warehouse.webp"
  structuredData={structuredData}
  autoArticleSchema={false}
>
  <article class="bg-[#070707] text-white font-['Century_Gothic',sans-serif]">
    <div class="mx-auto max-w-[1320px] px-6 pt-10 md:px-10 xl:px-4">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[12px] text-white/45">
        <a href="/" class="transition hover:text-[#d8b456]">Home</a><span>/</span>
        <span>Wholesale Markets</span><span>/</span>
        <span class="text-white/75" aria-current="page">{market.name}</span>
      </nav>
    </div>

    <section class="mx-auto max-w-[1320px] px-6 pb-20 pt-12 md:px-10 md:pb-24 xl:px-4">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-stretch">
        <div class="flex flex-col justify-center border-t border-[#d8b456] py-8 lg:py-12">
          <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">WHOLESALE ACTIVEWEAR TO {market.name.toUpperCase()}</p>
          <h1 class="mt-5 max-w-[820px] text-[43px] font-black leading-[1.02] md:text-[66px]">Wholesale activewear manufacturer for {market.name} brands.</h1>
          <p class="mt-7 max-w-[750px] text-[17px] leading-[1.75] text-white/70">Fitclo helps {market.buyerFocus}</p>

          <div class="mt-8 border-l-2 border-[#d8b456] bg-[#111] p-6 md:p-7">
            <p class="text-[10px] font-bold uppercase tracking-[.2em] text-[#d8b456]">QUICK ANSWER</p>
            <p class="mt-3 text-[14px] leading-[1.75] text-white/72">{quickAnswer}</p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d8b456] px-7 py-3 text-[13px] font-bold text-black transition hover:bg-white">GET A {market.name.toUpperCase()} SOURCING PLAN</a>
            <a href="#products" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/25 px-7 py-3 text-[13px] font-bold transition hover:border-[#d8b456] hover:text-[#d8b456]">VIEW PRODUCT STARTING POINTS</a>
          </div>
        </div>

        <figure class="relative min-h-[520px] overflow-hidden border border-white/10 bg-[#111]">
          <img src="/images/products/shared/ready-stock-warehouse.webp" alt={`Ready-stock activewear warehouse for ${market.name} wholesale sourcing`} class="absolute inset-0 h-full w-full object-cover object-center" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 grid grid-cols-2 gap-px bg-white/10 p-px sm:grid-cols-4">
            {[['2010', 'Fitclo established'], ['50', 'MOQ sets or pcs'], ['3', 'Sourcing routes'], ['1', 'Sample review route']].map(([value, label]) => (
              <div class="bg-[#0d0d0d]/95 p-4"><strong class="block text-[24px] text-[#d8b456]">{value}</strong><span class="mt-1 block text-[10px] uppercase tracking-[.1em] text-white/55">{label}</span></div>
            ))}
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="products" class="border-y border-white/10 bg-[#0d0d0d]">
      <div class="mx-auto max-w-[1320px] px-6 py-20 md:px-10 xl:px-4">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">CURRENT PRODUCT STARTING POINTS</p><h2 class="mt-4 max-w-[820px] text-[36px] font-black leading-[1.08] md:text-[50px]">Activewear styles to shape a {market.name} assortment.</h2></div>
          <a href="/products/" class="text-[12px] font-bold tracking-[.12em] text-[#d8b456] hover:text-white">BROWSE ALL PRODUCTS &rarr;</a>
        </div>
        <p class="mt-5 max-w-[900px] text-[15px] leading-[1.75] text-white/60">Use these products as a sourcing reference, then request the current colour and size mix. Product selection should follow your target customer, intended activity, price architecture and launch plan.</p>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProducts.map((product) => (
            <article class="group overflow-hidden border border-white/10 bg-[#111] transition hover:border-[#d8b456]/65">
              <a href={product.href} class="block">
                <div class="aspect-square overflow-hidden bg-[#e9e9e9]"><img src={product.image} alt={product.name} class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></div>
                <div class="p-5">
                  <div class="flex items-start justify-between gap-4"><h3 class="text-[17px] font-bold leading-[1.4]">{product.name}</h3><span class="shrink-0 rounded-full border border-[#d8b456]/35 px-3 py-1 text-[10px] font-bold text-[#d8b456]">{product.moq}</span></div>
                  <p class="mt-3 line-clamp-2 text-[13px] leading-[1.65] text-white/55">{product.description}</p>
                  <span class="mt-5 inline-block text-[11px] font-bold tracking-[.12em] text-[#d8b456]">VIEW PRODUCT &rarr;</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="sourcing-route" class="mx-auto max-w-[1320px] px-6 py-20 md:px-10 xl:px-4">
      <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">BUYER SUMMARY</p>
          <h2 class="mt-4 text-[38px] font-black leading-[1.08] md:text-[51px]">Choose the order route before comparing quotations.</h2>
          <p class="mt-6 text-[15px] leading-[1.8] text-white/62">{market.launchContext}</p>
        </div>
        <div class="overflow-x-auto border border-white/12">
          <table class="w-full min-w-[760px] border-collapse text-left text-[13px]">
            <thead class="bg-[#d8b456] text-black"><tr>{['Route', 'Start with', 'Best for', 'Order logic'].map((heading) => <th class="px-5 py-4 text-[10px] uppercase tracking-[.14em]">{heading}</th>)}</tr></thead>
            <tbody class="divide-y divide-white/10 bg-[#101010] text-white/68">
              {routeRows.map((row) => <tr>{row.map((cell, index) => <td class:list={['px-5 py-5 leading-[1.6]', index === 0 && 'font-bold text-white']}>{cell}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#0d0d0d]">
      <div class="mx-auto max-w-[1320px] px-6 py-20 md:px-10 xl:px-4">
        <div class="grid gap-12 lg:grid-cols-2">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">IMPORT AND DELIVERY PLANNING</p>
            <h2 class="mt-4 text-[36px] font-black leading-[1.08] md:text-[48px]">Build the shipping brief around responsibilities, not assumptions.</h2>
            <p class="mt-6 text-[15px] leading-[1.8] text-white/62">For a shipment to {market.name}, compare quotations using the same product value, carton information, transport mode, named place and service scope. Confirm who is responsible for export handling, main carriage, import clearance, duties, taxes, unloading and final delivery.</p>
            <a href="/blogs/fob-vs-ddp-vs-dap-activewear-imports/" class="mt-6 inline-flex text-[12px] font-bold tracking-[.1em] text-[#d8b456] hover:text-white">READ THE FOB VS DAP VS DDP GUIDE &rarr;</a>
          </div>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">COUNTRY BUYER PRIORITIES</p>
            <div class="mt-5 divide-y divide-white/10 border-y border-white/10">
              {market.planningPriorities.map((item, index) => <div class="grid grid-cols-[42px_1fr] gap-4 py-5"><span class="font-bold text-[#d8b456]">0{index + 1}</span><p class="text-[15px] leading-[1.65] text-white/72">{item}</p></div>)}
            </div>
          </div>
        </div>

        <div class="mt-14 grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
          {sourcingChecks.map(([title, text]) => <div class="bg-[#111] p-6"><h3 class="text-[16px] font-bold">{title}</h3><p class="mt-3 text-[13px] leading-[1.7] text-white/58">{text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1320px] px-6 py-20 md:px-10 xl:px-4">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">WHY FITCLO</p>
          <h2 class="mt-4 text-[38px] font-black leading-[1.06] md:text-[52px]">A sourcing partner for the decisions behind the product.</h2>
          <p class="mt-6 max-w-[520px] text-[15px] leading-[1.8] text-white/62">Fitclo was established in 2010 and serves activewear buyers globally. The sourcing plan can cover ready-stock selection, private-label components and OEM/ODM development without treating every order as the same process.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            ['Clear starting MOQ', 'Ready-stock MOQ starts from 50 sets for coordinated sets or 50 pcs for individual garments.'],
            ['Sample-led decisions', 'Review fit, measurements, fabric, workmanship and brand details before bulk approval.'],
            ['Private-label options', 'Logo, labels, hang tags and packaging can be planned for suitable products and briefs.'],
            ['Order-specific logistics', 'Shipment scope and documentation are aligned to the confirmed order and destination route.'],
          ].map(([title, text], index) => <div class="border-t border-[#d8b456] bg-[#111] p-6"><span class="text-[11px] font-bold text-[#d8b456]">0{index + 1}</span><h3 class="mt-8 text-[18px] font-bold">{title}</h3><p class="mt-3 text-[13px] leading-[1.7] text-white/58">{text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#0d0d0d]">
      <div class="mx-auto max-w-[1320px] px-6 py-20 md:px-10 xl:px-4">
        <p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">FROM BRIEF TO BULK</p>
        <h2 class="mt-4 max-w-[850px] text-[36px] font-black leading-[1.08] md:text-[50px]">A practical activewear sourcing process for {market.name} buyers.</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['01', 'Send the brief', 'Share product category, quantity, sizes, colours, branding and destination.'],
            ['02', 'Select the route', 'Compare suitable ready-stock, private-label or OEM/ODM options.'],
            ['03', 'Review the sample', 'Record fit, fabric, measurement, construction and branding comments.'],
            ['04', 'Confirm bulk and dispatch', 'Approve specifications, quality checkpoints, packing and shipment scope.'],
          ].map(([number, title, text]) => <div class="border border-white/10 p-6"><span class="text-[12px] font-bold text-[#d8b456]">{number}</span><h3 class="mt-8 text-[18px] font-bold">{title}</h3><p class="mt-3 text-[13px] leading-[1.7] text-white/58">{text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-[1180px] gap-10 px-6 py-20 md:px-10 lg:grid-cols-[.7fr_1.3fr]">
      <div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">{market.name.toUpperCase()} BUYER FAQ</p><h2 class="mt-4 text-[38px] font-black leading-[1.08] md:text-[50px]">Questions before ordering wholesale activewear.</h2></div>
      <div class="space-y-3">
        {faq.map((item, index) => (
          <details class="group border border-white/10 bg-[#111] p-5" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-7 text-[16px] font-bold leading-[1.5]">{item.question}<span class="text-[#d8b456] transition group-open:rotate-45">+</span></summary>
            <p class="pt-4 text-[14px] leading-[1.75] text-white/62">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="border-t border-white/10 bg-[#111]">
      <div class="mx-auto grid max-w-[1320px] gap-10 px-6 py-20 md:px-10 lg:grid-cols-[1fr_.8fr] lg:items-center xl:px-4">
        <div><p class="text-[11px] font-bold uppercase tracking-[.25em] text-[#d8b456]">REQUEST CURRENT DETAILS</p><h2 class="mt-4 max-w-[760px] text-[38px] font-black leading-[1.06] md:text-[54px]">Request products, MOQ and a sourcing plan for {market.name}.</h2><p class="mt-6 max-w-[720px] text-[15px] leading-[1.8] text-white/62">Send your category, estimated quantity, colour and size mix, branding requirement and destination. Fitclo will use the actual brief to recommend the next step.</p></div>
        <div class="flex flex-wrap gap-3 lg:justify-end"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d8b456] px-7 py-3 text-[13px] font-bold text-black transition hover:bg-white">ASK ON WHATSAPP</a><a href="/contact/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/25 px-7 py-3 text-[13px] font-bold transition hover:border-[#d8b456] hover:text-[#d8b456]">SEND AN INQUIRY</a></div>
      </div>
    </section>
  </article>
</BaseLayout>
